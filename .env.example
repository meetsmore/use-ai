# AI Provider (at least one required)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4-turbo

# Dify Workflow Runner (optional)
DIFY_API_URL=http://localhost:3001/v1

# Local MCP Server Configuration (URL should include full path)
MCP_ENDPOINT_LOCALDEV_URL=http://localhost:3002/mcp
MCP_ENDPOINT_LOCALDEV_NAMESPACE=mcp

# Server Configuration (optional)
# PORT=8081
# LOG_FORMAT=pretty
# CORS_ORIGIN=*  # Set to '*' for local dev, or specific origin for production
# RUNTIME=auto  # 'auto' (default), 'bun', or 'node'
# ENABLE_EXAMPLE_SERVER_TOOLS=true

# Rate Limiting (optional)
# RATE_LIMIT_MAX_REQUESTS=0
# RATE_LIMIT_WINDOW_MS=60000

# Langfuse Observability (optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_RELEASE=use-ai-test

# Vercel AI Gateway (optional, preferred when set)
# When AI_GATEWAY_API_KEY is set, both Claude and GPT agents are
# routed through Vercel AI Gateway (https://vercel.com/ai-gateway),
# and the direct provider keys above (ANTHROPIC_API_KEY / OPENAI_API_KEY)
# are ignored.
# AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_GATEWAY_CLAUDE_MODEL=anthropic/claude-haiku-4.5
# AI_GATEWAY_OPENAI_MODEL=openai/gpt-5.4-mini

# Extended thinking (reasoning) configuration
# Token budget for Anthropic extended thinking (e.g. 10000). Omit to disable.
# USE_AI_ANTHROPIC_REASONING_BUDGET_TOKEN=10000

# OpenAI reasoning configuration (opt-in)
# Reasoning effort level for OpenAI models (none|minimal|low|medium|high|xhigh).
# Models like gpt-5.4 default to none (reasoning disabled). Omit to use model default.
# USE_AI_OPENAI_REASONING_EFFORT=low
# Reasoning summary for OpenAI models (auto|detailed|concise). Omit to disable.
# USE_AI_OPENAI_REASONING_SUMMARY=detailed

# Mock agent for UI development (no API key needed)
# Set to any value to enable mock reasoning agent
# USE_AI_ENABLE_MOCK_AGENT=true
