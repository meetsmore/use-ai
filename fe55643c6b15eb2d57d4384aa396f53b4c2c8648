('client1');\n    rateLimiter.checkLimit('client1');\n\n    const blocked = rateLimiter.checkLimit('client1');\n    expect(blocked.allowed).toBe(false);\n\n    rateLimiter.removeClient('client1');\n\n    const allowed = rateLimiter.checkLimit('client1');\n    expect(allowed.allowed).toBe(true);\n  });\n\n  test('should be disabled when maxRequests is 0', () => {\n    const disabledLimiter = new RateLimiter({\n      maxRequests: 0,\n      windowMs: 1000,\n    });\n\n    expect(disabledLimiter.isEnabled()).toBe(false);\n\n    for (let i = 0; i < 100; i++) {\n      const result = disabledLimiter.checkLimit('client1');\n      expect(result.allowed).toBe(true);\n    }\n  });\n\n  test('should cleanup old requests', async () => {\n    rateLimiter.checkLimit('client1');\n\n    await new Promise(resolve => setTimeout(resolve, 1100));\n\n    rateLimiter.cleanup();\n\n    rateLimiter.checkLimit('client1');\n    rateLimiter.checkLimit('client1');\n    rateLimiter.checkLimit('client1');\n\n    const allowed = rateLimiter.checkLimit('client1');\n    expect(allowed.allowed).toBe(false);\n  });\n});\n",
