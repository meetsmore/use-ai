          "text": "     1→import { Server as SocketIOServer, Socket } from 'socket.io';\n     2→import { CoreMessage, CoreToolMessage } from 'ai';\n     3→import { createServer } from 'http';\n     4→import { EventType } from '@use-ai/core';\n     5→import type {\n     6→  UseAIServerConfig,\n     7→  McpEndpointConfig,\n     8→  ToolDefinition,\n     9→  UseAIClientMessage,\n    10→  RunAgentMessage,\n    11→  RunWorkflowMessage,\n    12→  ToolResultMessage,\n    13→  AbortRunMessage,\n    14→  Message,\n    15→  AGUIEvent,\n    16→} from './types';\n    17→import { RateLimiter } from './rateLimiter';\n    18→import { logger } from './logger';\n    19→import { v4 as uuidv4 } from 'uuid';\n    20→import type { Agent, EventEmitter } from './agents/types';\n    21→import type { ClientSession } from './agents/types';\n    22→import type { UseAIServerPlugin, MessageHandler } from './plugins/types';\n    23→import { RemoteMcpToolsProvider, type RemoteToolDefinition } from './mcp';\n    24→import { sanitizeMessages } from './utils/message-sanitization';\n    25→\n    26→// Re-export ClientSession type for external use\n    27→export type { ClientSession } from './agents/types';\n    28→\n    29→/**\n    30→ * WebSocket server that coordinates between client applications and AI agents.\n    31→ * Supports pluggable agents (AISDKAgent, etc.) via AG-UI protocol.\n    32→ *\n    33→ * Responsibilities:\n    34→ * - Manages WebSocket connections from clients\n    35→ * - Accepts RunAgentInput messages\n    36→ * - Delegates to pluggable agents (AISDKAgent, etc.)\n    37→ * - Emits AG-UI events (TEXT_MESSAGE_*, TOOL_CALL_*, etc.)\n    38→ * - Routes tool execution requests back to clients\n    39→ * - Maintains conversation history and state per session\n    40→ * - Handles rate limiting\n    41→ * - Supports plugins for extending functionality\n    42→ *\n    43→ * @example\n    44→ * ```typescript\n    45→ * import { UseAIServer, AISDKAgent } from '@use-ai/server';\n    46→ * import { createAnthropic } from '@ai-sdk/anthropic';\n    47→ * import { openai } from '@ai-sdk/openai';\n    48→ *\n    49→ * // Single agent (Claude)\n    50→ * const anthropic = createAnthropic({\n    51→ *   apiKey: process.env.ANTHROPIC_API_KEY,\n    52→ * });\n    53→ * const claudeAgent = new AISDKAgent({\n    54→ *   model: anthropic('claude-sonnet-4-20250514'),\n    55→ * });\n    56→ * const server = new UseAIServer({\n    57→ *   port: 8080,\n    58→ *   agents: { claude: claudeAgent },\n    59→ *   defaultAgent: 'claude', // Default agent name\n    60→ * });\n    61→ *\n    62→ * // Multiple agents (Claude + OpenAI)\n    63→ * const gptAgent = new AISDKAgent({\n    64→ *   model: openai('gpt-4-turbo'),\n    65→ * });\n    66→ * const multiServer = new UseAIServer({\n    67→ *   port: 8080,\n    68→ *   agents: {\n    69→ *     claude: claudeAgent,\n    70→ *     'gpt-4': gptAgent,\n    71→ *   },\n    72→ *   runner: 'claude', // Default for chat\n    73→ * });\n    74→ * ```\n    75→ */\n    76→export class UseAIServer {\n    77→  private io: SocketIOServer;\n    78→  private httpServer: ReturnType<typeof createServer>;\n    79→  private agent: Agent; // Default agent for chat (run_agent)\n    80→  private agents: Record<string, Agent>; // Registry of all agents\n    81→  private clients: Map<string, ClientSession> = new Map();\n    82→  private config: Required<Omit<UseAIServerConfig, 'defaultAgent' | 'agents' | 'plugins' | 'mcpEndpoints'>>;\n    83→  private rateLimiter: RateLimiter;\n    84→  private cleanupInterval: NodeJS.Timeout;\n    85→  private clientIdCounter = 0;\n    86→  private plugins: UseAIServerPlugin[] = [];\n    87→  private messageHandlers: Map<string, MessageHandler> = new Map();\n    88→  private mcpEndpoints: RemoteMcpToolsProvider[] = [];\n    89→\n    90→  /**\n    91→   * Creates a new UseAI server instance.\n    92→   *\n    93→   * @param config - Server configuration options\n    94→   * @throws Error if the specified agent name does not exist in the agents map\n    95→   */\n    96→  constructor(config: UseAIServerConfig) {\n    97→    this.config = {\n    98→      port: config.port ?? 8080,\n    99→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n   100→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n   101→    };\n   102→\n   103→    // Set agents registry\n   104→    this.agents = config.agents;\n   105→\n   106→    // Get the default agent by name\n   107→    const defaultAgent = this.agents[config.defaultAgent];\n   108→    if (!defaultAgent) {\n   109→      throw new Error(\n   110→        `Agent \"${config.defaultAgent}\" not found in agents config. Available agents: ${Object.keys(this.agents).join(', ')}`\n   111→      );\n   112→    }\n   113→    this.agent = defaultAgent;\n   114→\n   115→    this.rateLimiter = new RateLimiter({\n   116→      maxRequests: this.config.rateLimitMaxRequests,\n   117→      windowMs: this.config.rateLimitWindowMs,\n   118→    });\n   119→\n   120→    this.cleanupInterval = setInterval(() => {\n   121→      this.rateLimiter.cleanup();\n   122→    }, this.config.rateLimitWindowMs);\n   123→\n   124→    // Create RemoteMcpToolsProvider instances (to reference remote tools)\n   125→    if (config.mcpEndpoints && config.mcpEndpoints.length > 0) {\n   126→      this.mcpEndpoints = config.mcpEndpoints.map(endpoint => new RemoteMcpToolsProvider(endpoint));\n   127→      logger.info('[MCP] Created remote MCP instances', {\n   128→        count: this.mcpEndpoints.length,\n   129→        endpoints: this.mcpEndpoints.map(e => e.getUrl()),\n   130→      });\n   131→    }\n   132→\n   133→    // Initialize plugins\n   134→    this.plugins = config.plugins ?? [];\n   135→    this.initializePlugins();\n   136→\n   137→    // Create HTTP server for health checks\n   138→    this.httpServer = createServer((req, res) => {\n   139→      if (req.url === '/health') {\n   140→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   141→        res.end(JSON.stringify({ status: 'ok' }));\n   142→      } else {\n   143→        res.writeHead(404);\n   144→        res.end();\n   145→      }\n   146→    });\n   147→\n   148→    // Attach Socket.IO server to HTTP server\n   149→    this.io = new SocketIOServer(this.httpServer, {\n   150→      cors: {\n   151→        origin: '*',\n   152→        methods: ['GET', 'POST']\n   153→      }\n   154→    });\n   155→    this.httpServer.listen(this.config.port);\n   156→    this.setupSocketIOServer();\n   157→\n   158→    if (this.rateLimiter.isEnabled()) {\n   159→      logger.info('Rate limiting enabled', {\n   160→        maxRequests: this.config.rateLimitMaxRequests,\n   161→        windowMs: this.config.rateLimitWindowMs,\n   162→      });\n   163→    }\n   164→  }\n   165→\n   166→  /**\n   167→   * Initializes the server by fetching MCP tools from all endpoints.\n   168→   * Must be called before the server starts accepting connections.\n   169→   */\n   170→  async initialize(): Promise<void> {\n   171→    // Initialize all MCP endpoints (fetch tools)\n   172→    if (this.mcpEndpoints.length > 0) {\n   173→      logger.info('[MCP] Initializing MCP endpoints', { count: this.mcpEndpoints.length });\n   174→\n   175→      const results = await Promise.allSettled(\n   176→        this.mcpEndpoints.map(endpoint => endpoint.initialize())\n   177→      );\n   178→\n   179→      // Log results\n   180→      const successful = results.filter(r => r.status === 'fulfilled').length;\n   181→      const failed = results.filter(r => r.status === 'rejected').length;\n   182→\n   183→      if (failed > 0) {\n   184→        logger.warn('[MCP] Some endpoints failed to initialize', { successful, failed });\n   185→      } else {\n   186→        logger.info('[MCP] All endpoints initialized successfully', { count: successful });\n   187→      }\n   188→    }\n   189→  }\n   190→\n   191→  /**\n   192→   * Initialize all plugins by calling their registerHandlers method.\n   193→   * This allows plugins to register custom message handlers.\n   194→   */\n   195→  private initializePlugins() {\n   196→    for (const plugin of this.plugins) {\n   197→      logger.info('Initializing plugin', { pluginName: plugin.getName() });\n   198→\n   199→      plugin.registerHandlers({\n   200→        registerMessageHandler: this.registerMessageHandler.bind(this),\n   201→      });\n   202→    }\n   203→  }\n   204→\n   205→  /**\n   206→   * Register a custom message handler for a specific message type.\n   207→   * Used by plugins to handle custom message types.\n   208→   *\n   209→   * @param type - The message type to handle (e.g., 'run_workflow')\n   210→   * @param handler - The handler function to call when this message type is received\n   211→   */\n   212→  public registerMessageHandler(type: string, handler: MessageHandler): void {\n   213→    if (this.messageHandlers.has(type)) {\n   214→      logger.warn('Overwriting existing message handler', { type });\n   215→    }\n   216→\n   217→    this.messageHandlers.set(type, handler);\n   218→    logger.debug('Registered message handler', { type });\n   219→  }\n   220→\n   221→  private setupSocketIOServer() {\n   222→    this.io.on('connection', (socket: Socket) => {\n   223→      const clientId = `client-${++this.clientIdCounter}`;\n   224→      const threadId = uuidv4();\n   225→      const ipAddress = socket.handshake.address || socket.id;\n   226→      logger.info('Client connected', { clientId, threadId, ipAddress });\n   227→\n   228→      const session: ClientSession = {\n   229→        clientId,\n   230→        ipAddress,\n   231→        socket,\n   232→        threadId,\n   233→        tools: [],\n   234→        state: null,\n   235→        messages: [],\n   236→        conversationHistory: [],\n   237→        pendingToolCalls: new Map(),\n   238→      };\n   239→\n   240→      this.clients.set(socket.id, session);\n   241→\n   242→      // Call plugin lifecycle hooks\n   243→      for (const plugin of this.plugins) {\n   244→        plugin.onClientConnect?.(session);\n   245→      }\n   246→\n   247→      socket.on('message', async (message: UseAIClientMessage) => {\n   248→        try {\n   249→          await this.handleClientMessage(socket, message);\n   250→        } catch (error) {\n   251→          logger.error('Error handling message', {\n   252→            error: error instanceof Error ? error.message : 'Unknown error',\n   253→            clientId,\n   254→          });\n   255→          this.sendEvent(socket, {\n   256→            type: EventType.RUN_ERROR,\n   257→            message: error instanceof Error ? error.message : 'Unknown error',\n   258→            timestamp: Date.now(),\n   259→          });\n   260→        }\n   261→      });\n   262→\n   263→      socket.on('disconnect', () => {\n   264→        logger.info('Client disconnected', { clientId, ipAddress });\n   265→\n   266→        // Call plugin lifecycle hooks\n   267→        for (const plugin of this.plugins) {\n   268→          plugin.onClientDisconnect?.(session);\n   269→        }\n   270→\n   271→        // Note: Rate limiting persists by IP address across connections\n   272→        this.clients.delete(socket.id);\n   273→      });\n   274→    });\n   275→\n   276→    logger.info('UseAI server listening', { port: this.config.port });\n   277→  }\n   278→\n   279→  private async handleClientMessage(socket: Socket, message: UseAIClientMessage) {\n   280→    const session = this.clients.get(socket.id);\n   281→    if (!session) return;\n   282→\n   283→    // Check if a plugin has registered a handler for this message type\n   284→    const pluginHandler = this.messageHandlers.get(message.type);\n   285→    if (pluginHandler) {\n   286→      await pluginHandler(session, message);\n   287→      return;\n   288→    }\n   289→\n   290→    // Core message handlers\n   291→    switch (message.type) {\n   292→      case 'run_agent':\n   293→        await this.handleRunAgent(session, message as RunAgentMessage);\n   294→        break;\n   295→      case 'tool_result':\n   296→        this.handleToolResult(session, message as ToolResultMessage);\n   297→        break;\n   298→      case 'abort_run':\n   299→        this.handleAbortRun(session, message as AbortRunMessage);\n   300→        break;\n   301→      default:\n   302→        logger.warn('Unknown message type', { type: message.type });\n   303→    }\n   304→  }\n   305→\n   306→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   307→    const { threadId, runId, messages, tools, state, context, forwardedProps } = message.data;\n   308→\n   309→    // Extract MCP headers from forwardedProps (AG-UI extension point)\n   310→    const mcpHeaders = forwardedProps?.mcpHeaders as import('@use-ai/core').McpHeadersMap | undefined;\n   311→\n   312→    // Rate limiting by IP address\n   313→    const rateLimitCheck = this.rateLimiter.checkLimit(session.ipAddress);\n   314→    if (!rateLimitCheck.allowed) {\n   315→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   316→      this.sendEvent(session.socket, {\n   317→        type: EventType.RUN_ERROR,\n   318→        message: `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`,\n   319→        timestamp: Date.now(),\n   320→      });\n   321→      return;\n   322→    }\n   323→\n   324→    // Update session\n   325→    // If threadId changed, clear conversation history (new chat started)\n   326→    if (session.threadId && session.threadId !== threadId) {\n   327→      logger.info('ThreadId changed, clearing conversation history', {\n   328→        oldThreadId: session.threadId,\n   329→        newThreadId: threadId,\n   330→      });\n   331→      session.conversationHistory = [];\n   332→      session.messages = [];\n   333→    }\n   334→    session.threadId = threadId;\n   335→    session.currentRunId = runId;\n   336→\n   337→    // Store MCP headers for this request (will be cleared after run completes)\n   338→    session.currentMcpHeaders = mcpHeaders;\n   339→\n   340→    // Merge client tools with MCP tools from all endpoints\n   341→    const clientTools = tools.map(t => ({\n   342→      ...t,\n   343→      parameters: t.parameters || { type: 'object', properties: {}, required: [] },\n   344→    })) as ToolDefinition[];\n   345→\n   346→    // Get tools from all MCP endpoints\n   347→    const mcpTools: RemoteToolDefinition[] = this.mcpEndpoints.flatMap(endpoint => endpoint.getTools());\n   348→\n   349→    // Merge: client tools + MCP tools\n   350→    session.tools = [...clientTools, ...mcpTools];\n   351→\n   352→    if (mcpTools.length > 0) {\n   353→      logger.debug('[MCP] Merged tools', {\n   354→        clientTools: clientTools.length,\n   355→        mcpTools: mcpTools.length,\n   356→        total: session.tools.length,\n   357→      });\n   358→    }\n   359→\n   360→    session.state = state;\n   361→    session.messages = messages;\n   362→\n   363→    // Helper to convert content to string if it's an array (AG-UI format)\n   364→    const getStringContent = (content: string | any[] | Record<string, any> | undefined): string => {\n   365→      if (!content) return '';\n   366→      if (typeof content === 'string') return content;\n   367→      // If it's an array, extract text from text blocks\n   368→      if (Array.isArray(content)) {\n   369→        return content\n   370→          .filter((block: any) => block.type === 'text')\n   371→          .map((block: any) => block.text)\n   372→          .join('');\n   373→      }\n   374→      // If it's an object (Record), convert to JSON string\n   375→      if (typeof content === 'object') {\n   376→        return JSON.stringify(content);\n   377→      }\n   378→      return '';\n   379→    };\n   380→\n   381→    // Convert AG-UI messages to AI SDK CoreMessage format\n   382→    const incomingMessages: CoreMessage[] = messages.map(msg => {\n   383→      if (msg.role === 'user') {\n   384→        return {\n   385→          role: 'user' as const,\n   386→          content: getStringContent(msg.content),\n   387→        };\n   388→      } else if (msg.role === 'assistant') {\n   389→        return {\n   390→          role: 'assistant' as const,\n   391→          content: getStringContent(msg.content),\n   392→        };\n   393→      } else if (msg.role === 'tool') {\n   394→        // Tool messages in AI SDK format\n   395→        const contentStr = getStringContent(msg.content);\n   396→        return {\n   397→          role: 'tool' as const,\n   398→          content: [\n   399→            {\n   400→              type: 'tool-result' as const,\n   401→              toolCallId: (msg as any).tool_call_id || uuidv4(),\n   402→              toolName: (msg as any).tool_name || 'unknown',\n   403→              output: JSON.parse(contentStr),\n   404→            },\n   405→          ],\n   406→        } as CoreToolMessage;\n   407→      }\n   408→      // Default fallback\n   409→      return {\n   410→        role: 'user' as const,\n   411→        content: getStringContent(msg.content),\n   412→      };\n   413→    });\n   414→\n   415→    // Conversation history management:\n   416→    // - The client sends ALL messages it knows about (user + assistant messages from past turns)\n   417→    // - The server maintains the authoritative history including tool results\n   418→    // - We only append NEW user messages to avoid duplicates\n   419→    if (session.conversationHistory.length === 0) {\n   420→      // First run: initialize conversation history with incoming messages\n   421→      // Sanitize messages to remove provider-specific fields like tool_use_id\n   422→      session.conversationHistory = sanitizeMessages(incomingMessages);\n   423→    } else {\n   424→      // Subsequent runs: only append NEW user messages that aren't already in the history\n   425→      // Count how many user messages we already have\n   426→      const existingUserMessageCount = session.conversationHistory.filter(msg => msg.role === 'user').length;\n   427→      const incomingUserMessages = incomingMessages.filter(msg => msg.role === 'user');\n   428→\n   429→      // Only append user messages beyond what we already have\n   430→      const newUserMessages = incomingUserMessages.slice(existingUserMessageCount);\n   431→\n   432→      // Sanitize and append only new user messages to preserve the full conversation context\n   433→      session.conversationHistory.push(...sanitizeMessages(newUserMessages));\n   434→    }\n   435→\n   436→    // Build system prompt\n   437→    const systemPrompt = this.buildSystemPrompt(session, state);\n   438→\n   439→    // Create event emitter that forwards all events to client\n   440→    const eventEmitter: EventEmitter = {\n   441→      emit: <T extends AGUIEvent>(event: T) => {\n   442→        this.sendEvent(session.socket, event);\n   443→      },\n   444→    };\n   445→\n   446→    // Delegate to agent\n   447→    try {\n   448→      await this.agent.run(\n   449→        {\n   450→          session,\n   451→          runId,\n   452→          messages: session.conversationHistory,\n   453→          tools: session.tools,\n   454→          state,\n   455→          systemPrompt,\n   456→          originalInput: message.data,\n   457→        },\n   458→        eventEmitter\n   459→      );\n   460→    } finally {\n   461→      // Clear MCP headers after run completes (success or failure)\n   462→      delete session.currentMcpHeaders;\n   463→    }\n   464→  }\n   465→\n   466→  private buildSystemPrompt(session: ClientSession, state: unknown): string | undefined {\n   467→    const parts: string[] = [];\n   468→\n   469→    // Add state context if available\n   470→    if (state) {\n   471→      parts.push('You are interacting with a web application. Here is the current state:');\n   472→      parts.push('');\n   473→      parts.push(JSON.stringify(state, null, 2));\n   474→      parts.push('');\n   475→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   476→    }\n   477→\n   478→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   479→    if (confirmationTools.length > 0) {\n   480→      if (parts.length > 0) {\n   481→        parts.push('');\n   482→      }\n   483→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   484→      parts.push('');\n   485→      confirmationTools.forEach(tool => {\n   486→        parts.push(`- ${tool.name}`);\n   487→      });\n   488→      parts.push('');\n   489→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   490→      parts.push('1. First, explain to the user exactly what changes will be made');\n   491→      parts.push('2. Then, explicitly ask: \"Do you want me to proceed?\" or similar confirmation question');\n   492→      parts.push('3. STOP and WAIT for the user to respond with explicit confirmation');\n   493→      parts.push('4. ONLY after receiving confirmation, call the tool');\n   494→      parts.push('');\n   495→      parts.push('NEVER ASSUME CONFIRMATION:');\n   496→      parts.push('- Do NOT call these tools without receiving explicit confirmation');\n   497→      parts.push('- Each destructive operation requires its own separate confirmation');\n   498→    }\n   499→\n   500→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   501→  }\n   502→\n   503→  private handleToolResult(session: ClientSession, message: ToolResultMessage) {\n   504→    const { toolCallId, content } = message.data;\n   505→    const resolver = session.pendingToolCalls.get(toolCallId);\n   506→\n   507→    if (resolver) {\n   508→      resolver(content);\n   509→      session.pendingToolCalls.delete(toolCallId);\n   510→    }\n   511→  }\n   512→\n   513→  private handleAbortRun(session: ClientSession, message: AbortRunMessage) {\n   514→    const { runId } = message.data;\n   515→    // Clear pending tool calls for this run\n   516→    session.pendingToolCalls.clear();\n   517→    session.currentRunId = undefined;\n   518→\n   519→    logger.info('Run aborted', { clientId: session.clientId, runId });\n   520→  }\n   521→\n   522→  private sendEvent<T = unknown>(socket: Socket, event: T) {\n   523→    if (socket.connected) {\n   524→      socket.emit('event', event);\n   525→    }\n   526→  }\n   527→\n   528→  /**\n   529→   * Closes the server and cleans up resources.\n   530→   * Stops accepting new connections and terminates all existing connections.\n   531→   */\n   532→  public close() {\n   533→    clearInterval(this.cleanupInterval);\n   534→\n   535→    // Clean up all MCP endpoints\n   536→    this.mcpEndpoints.forEach(endpoint => endpoint.destroy());\n   537→\n   538→    this.io.close();\n   539→    this.httpServer.close();\n   540→  }\n   541→}\n   542→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
