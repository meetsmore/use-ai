211→\n   212→      return {\n   213→        success: true,\n   214→        conversationHistory: session.conversationHistory,\n   215→      };\n   216→    } catch (error) {\n   217→      logger.error('Error calling AI SDK model', {\n   218→        error: error instanceof Error ? error.message : 'Unknown error',\n   219→        clientId: session.clientId,\n   220→      });\n   221→\n   222→      // Detect error type and send error code for client-side message handling\n   223→      let errorCode = ErrorCode.UNKNOWN_ERROR;\n   224→      let errorMessage = error instanceof Error ? error.message : 'Unknown error';\n   225→\n   226→      if (error && typeof error === 'object') {\n   227→        const err = error as any;\n   228→\n   229→        // Check for API overload (529 status code or overloaded_error type)\n   230→        const isOverloaded =\n   231→          err.statusCode === 529 ||\n   232→          err.data?.error?.type === 'overloaded_error' ||\n   233→          (err.message && err.message.toLowerCase().includes('overload'));\n   234→\n   235→        if (isOverloaded) {\n   236→          errorCode = ErrorCode.API_OVERLOADED;\n   237→        }\n   238→\n   239→        // Check for rate limiting (429 status code)\n   240→        const isRateLimited = err.statusCode === 429;\n   241→        if (isRateLimited) {\n   242→          errorCode = ErrorCode.RATE_LIMITED;\n   243→        }\n   244→      }\n   245→\n   246→      events.emit<RunErrorEvent>({\n   247→        type: EventType.RUN_ERROR,\n   248→        message: errorCode, // Send error code instead of user message\n   249→        timestamp: Date.now(),\n   250→      });\n   251→\n   252→      return {\n   253→        success: false,\n   254→        error: errorMessage,\n   255→        conversationHistory: messages,\n   256→      };\n   257→    }\n   258→  }\n   259→\n   260→  /**\n   261→   * Type guard to check if a tool is a remote MCP tool.\n   262→   */\n   263→  private isRemoteTool(tool: ToolDefinition): tool is RemoteToolDefinition {\n   264→    return (tool as RemoteToolDefinition)._remote !== undefined;\n   265→  }\n   266→\n   267→  /**\n   268→   * Helper to emit AG-UI tool call events (START, ARGS, END).\n   269→   * Returns the generated toolCallId for tracking.\n   270→   */\n   271→  private emitToolCallEvents(toolName: string, args: any, events: EventEmitter): string {\n   272→    const toolCallId = uuidv4();\n   273→    const parentMessageId = uuidv4();\n   274→\n   275→    events.emit<ToolCallStartEvent>({\n   276→      type: EventType.TOOL_CALL_START,\n   277→      toolCallId,\n   278→      toolCallName: toolName,\n   279→      parentMessageId,\n   280→      timestamp: Date.now(),\n   281→    });\n   282→\n   283→    events.emit<ToolCallArgsEvent>({\n   284→      type: EventType.TOOL_CALL_ARGS,\n   285→      toolCallId,\n   286→      delta: JSON.stringify(args),\n   287→      timestamp: Date.now(),\n   288→    });\n   289→\n   290→    events.emit<ToolCallEndEvent>({\n   291→      type: EventType.TOOL_CALL_END,\n   292→      toolCallId,\n   293→      timestamp: Date.now(),\n   294→    });\n   295→\n   296→    return toolCallId;\n   297→  }\n   298→\n   299→  /**\n   300→   * Creates execute function for MCP tools.\n   301→   */\n   302→  private createMcpToolExecutor(\n   303→    remoteTool: RemoteToolDefinition,\n   304→    session: ClientSession,\n   305→    events: EventEmitter\n   306→  ): (args: any) => Promise<any> {\n   307→    return async (args: any) => {\n   308→      const toolCallId = this.emitToolCallEvents(remoteTool.name, args, events);\n   309→\n   310→      logger.info('[MCP] Executing remote tool', {\n   311→        toolName: remoteTool.name,\n   312→        toolCallId,\n   313→      });\n   314→\n   315→      try {\n   316→        const result = await remoteTool._remote.provider.executeTool(\n   317→          remoteTool._remote.originalName,\n   318→          args,\n   319→          session.currentMcpHeaders  // Pass MCP headers from