f.confirmationRequired) {\n   373→        toolConfig.needsApproval = true;\n   374→      }\n   375→\n   376→      toolsObject[toolDef.name] = toolConfig;\n   377→    }\n   378→\n   379→    return toolsObject;\n   380→  }\n   381→\n   382→  private async processResponse(\n   383→    session: any,\n   384→    result: Awaited<ReturnType<typeof generateText>>,\n   385→    runId: string,\n   386→    events: EventEmitter\n   387→  ) {\n   388→    // With maxSteps > 1, AI SDK handles all tool execution automatically\n   389→    // We just need to update conversation history and emit the final response\n   390→\n   391→    // Update conversation history with all messages from AI SDK\n   392→    // This includes assistant messages, tool calls, and tool results\n   393→    const newMessages = result.response.messages.slice(session.conversationHistory.length);\n   394→\n   395→    // Sanitize messages to remove provider-specific fields before storing\n   396→    const sanitizedMessages = sanitizeMessages(newMessages);\n   397→    session.conversationHistory.push(...sanitizedMessages);\n   398→\n   399→    // Emit text message events if there's a final text response\n   400→    if (result.text) {\n   401→      const messageId = uuidv4();\n   402→\n   403→      // Emit TEXT_MESSAGE_START\n   404→      events.emit<TextMessageStartEvent>({\n   405→        type: EventType.TEXT_MESSAGE_START,\n   406→        messageId,\n   407→        role: 'assistant',\n   408→        timestamp: Date.now(),\n   409→      });\n   410→\n   411→      // Emit TEXT_MESSAGE_CONTENT\n   412→      events.emit<TextMessageContentEvent>({\n   413→        type: EventType.TEXT_MESSAGE_CONTENT,\n   414→        messageId,\n   415→        delta: result.text,\n   416→        timestamp: Date.now(),\n   417→      });\n   418→\n   419→      // Emit TEXT_MESSAGE_END\n   420→      events.emit<TextMessageEndEvent>({\n   421→        type: EventType.TEXT_MESSAGE_END,\n   422→        messageId,\n   423→        timestamp: Date.now(),\n   424→      });\n   425→\n   426→      logger.aiResponse([result.text]);\n   427→    }\n   428→\n   429→    // Emit RUN_FINISHED\n   430→    events.emit<RunFinishedEvent>({\n   431→      type: EventType.RUN_FINISHED,\n   432→      threadId: session.threadId,\n   433→      runId,\n   434→      result: result.text,\n   435→      timestamp: Date.now(),\n   436→    });\n   437→  }\n   438→}\n   439→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
