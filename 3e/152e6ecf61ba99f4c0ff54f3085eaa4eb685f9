          "text": "     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useAIContext } from './providers/useAIProvider';\n     3→import { type ToolsDefinition } from './defineTool';\n     4→import type { AGUIEvent, RunErrorEvent } from './types';\n     5→import { EventType } from './types';\n     6→\n     7→function namespaceTools(tools: ToolsDefinition, namespace: string): ToolsDefinition {\n     8→  const namespacedTools: ToolsDefinition = {};\n     9→\n    10→  for (const [toolName, tool] of Object.entries(tools)) {\n    11→    const namespacedName = `${namespace}_${toolName}`;\n    12→    namespacedTools[namespacedName] = tool;\n    13→  }\n    14→\n    15→  return namespacedTools;\n    16→}\n    17→\n    18→/**\n    19→ * Options for configuring the useAI hook.\n    20→ */\n    21→export interface UseAIOptions {\n    22→  /** Tools to make available to the AI for this component */\n    23→  tools?: ToolsDefinition;\n    24→  /** Callback function invoked when an error occurs */\n    25→  onError?: (error: Error) => void;\n    26→  /** Optional ID for namespacing tools to avoid naming conflicts */\n    27→  id?: string;\n    28→  /** Optional UI context or description to send to the AI */\n    29→  prompt?: string;\n    30→  /**\n    31→   * Mark this component as invisible (no visual state).\n    32→   * When true, tool responses are sent immediately without waiting for React re-renders.\n    33→   * Use this for provider-type components that expose tools but don't render UI.\n    34→   * @default false\n    35→   */\n    36→  invisible?: boolean;\n    37→  /**\n    38→   * Optional array of suggestion strings to display as call-to-action prompts\n    39→   * when the chat is empty. The chat UI will randomly select up to 4 suggestions\n    40→   * to display to the user.\n    41→   */\n    42→  suggestions?: string[];\n    43→}\n    44→\n    45→/**\n    46→ * Return value from the useAI hook.\n    47→ */\n    48→export interface UseAIResult {\n    49→  /** The AI's response text, or null if no response yet */\n    50→  response: string | null;\n    51→  /** Whether the AI is currently processing a request */\n    52→  loading: boolean;\n    53→  /** Error object if an error occurred, or null */\n    54→  error: Error | null;\n    55→  /** Function to send a prompt to the AI */\n    56→  generate: (prompt: string) => Promise<void>;\n    57→  /** Whether the client is connected to the server */\n    58→  connected: boolean;\n    59→  /** Ref to attach to the component for context extraction */\n    60→  ref: React.RefObject<HTMLDivElement>;\n    61→}\n    62→\n    63→/**\n    64→ * React hook for integrating AI capabilities into a component.\n    65→ * Registers tools with the AI server and provides methods to interact with the AI.\n    66→ *\n    67→ * @param options - Configuration options for the hook\n    68→ * @returns Object containing AI interaction state and methods\n    69→ *\n    70→ * @example\n    71→ * ```typescript\n    72→ * import { useAI, defineTool } from '@meetsmore/use-ai-client';\n    73→ * import { z } from 'zod';\n    74→ *\n    75→ * // Example 1: Visible component with UI state\n    76→ * function MyComponent() {\n    77→ *   const { response, loading, generate, ref } = useAI({\n    78→ *     tools: {\n    79→ *       addTodo: defineTool(\n    80→ *         'Add a new todo item',\n    81→ *         z.object({ text: z.string() }),\n    82→ *         (input) => {\n    83→ *           // Add todo logic\n    84→ *           return { success: true };\n    85→ *         }\n    86→ *       )\n    87→ *     }\n    88→ *   });\n    89→ *\n    90→ *   return (\n    91→ *     <div ref={ref}>\n    92→ *       <button onClick={() => generate('Add a todo for groceries')}>\n    93→ *         Ask AI\n    94→ *       </button>\n    95→ *       {loading && <p>Loading...</p>}\n    96→ *       {response && <p>{response}</p>}\n    97→ *     </div>\n    98→ *   );\n    99→ * }\n   100→ *\n   101→ * // Example 2: Invisible provider component (no UI state)\n   102→ * function AIToolsProvider({ children }) {\n   103→ *   useAI({\n   104→ *     tools: {\n   105→ *       sendEmail: defineTool(\n   106→ *         'Send an email',\n   107→ *         z.object({ to: z.string(), subject: z.string() }),\n   108→ *         async (input) => {\n   109→ *           await sendEmail(input);\n   110→ *           return { success: true };\n   111→ *         }\n   112→ *       )\n   113→ *     },\n   114→ *     invisible: true  // Skip render wait since this has no visual state\n   115→ *   });\n   116→ *\n   117→ *   return <>{children}</>;\n   118→ * }\n   119→ * ```\n   120→ */\n   121→export function useAI(options: UseAIOptions = {}): UseAIResult {\n   122→  const { connected, registerTools, unregisterTools, updatePrompt, client } = useAIContext();\n   123→  const [response, setResponse] = useState<string | null>(null);\n   124→  const [loading, setLoading] = useState(false);\n   125→  const [error, setError] = useState<Error | null>(null);\n   126→\n   127→  const hookId = useRef(`useAI-${Math.random().toString(36).substr(2, 9)}`);\n   128→  const toolsRef = useRef<ToolsDefinition>({});\n   129→  const componentRef = useRef<HTMLDivElement>(null);\n   130→  const renderResolvers = useRef<Array<() => void>>([]);\n   131→\n   132→  useEffect(() => {\n   133→    if (componentRef.current) {\n   134→      componentRef.current.setAttribute('data-useai-context', 'true');\n   135→    }\n   136→  }, []);\n   137→\n   138→  useEffect(() => {\n   139→    const count = renderResolvers.current.length;\n   140→    if (count > 0) {\n   141→      console.log(`[${hookId.current}] Render complete, resolving ${count} promises`);\n   142→      renderResolvers.current.forEach(resolve => resolve());\n   143→      renderResolvers.current = [];\n   144→    }\n   145→  });\n   146→\n   147→  const waitForRender = useCallback(() => {\n   148→    return new Promise<void>(resolve => {\n   149→      console.log(`[${hookId.current}] Adding render promise`);\n   150→      renderResolvers.current.push(resolve);\n   151→    });\n   152→  }, []);\n   153→\n   154→  useEffect(() => {\n   155→    updatePrompt(hookId.current, options.prompt, options.suggestions);\n   156→  }, [options.prompt, options.suggestions, updatePrompt]);\n   157→\n   158→  useEffect(() => {\n   159→    if (options.tools) {\n   160→      const componentId = options.id || componentRef.current?.id;\n   161→      const toolsToRegister = componentId\n   162→        ? namespaceTools(options.tools, componentId)\n   163→        : options.tools;\n   164→\n   165→      // Only pass waitForRender if component is not invisible\n   166→      const renderWaiter = options.invisible ? undefined : waitForRender;\n   167→      registerTools(hookId.current, toolsToRegister, renderWaiter);\n   168→      toolsRef.current = toolsToRegister;\n   169→    }\n   170→\n   171→    return () => {\n   172→      if (options.tools) {\n   173→        unregisterTools(hookId.current);\n   174→      }\n   175→    };\n   176→  }, [options.tools, options.id, options.invisible, registerTools, unregisterTools, waitForRender]);\n   177→\n   178→  useEffect(() => {\n   179→    if (!client) return;\n   180→\n   181→    const unsubscribe = client.onEvent(hookId.current, (event: AGUIEvent) => {\n   182→      handleAGUIEvent(event);\n   183→    });\n   184→\n   185→    return () => {\n   186→      unsubscribe();\n   187→    };\n   188→  }, [client]);\n   189→\n   190→  const handleAGUIEvent = useCallback(async (event: AGUIEvent) => {\n   191→    switch (event.type) {\n   192→      case EventType.TEXT_MESSAGE_END: {\n   193→        const content = client?.currentMessageContent;\n   194→        if (content) {\n   195→          setResponse(content);\n   196→          setLoading(false);\n   197→        }\n   198→        break;\n   199→      }\n   200→\n   201→      case EventType.RUN_ERROR: {\n   202→        const errorEvent = event