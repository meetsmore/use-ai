args: string } | undefined {\n   369→    return this.currentToolCalls.get(toolCallId);\n   370→  }\n   371→\n   372→  /**\n   373→   * Registers an AG-UI event handler for receiving server events.\n   374→   *\n   375→   * @param id - Unique identifier for this handler\n   376→   * @param handler - Callback function to handle incoming AG-UI events\n   377→   * @returns Cleanup function to unregister the handler\n   378→   */\n   379→  onEvent(id: string, handler: AGUIEventHandler) {\n   380→    this.eventHandlers.set(id, handler);\n   381→    return () => {\n   382→      this.eventHandlers.delete(id);\n   383→    };\n   384→  }\n   385→\n   386→  /**\n   387→   * Helper method to listen for text message content.\n   388→   * Aggregates TEXT_MESSAGE_CONTENT events and calls handler with complete messages.\n   389→   *\n   390→   * @param handler - Callback function to handle complete text messages\n   391→   * @returns Cleanup function\n   392→   */\n   393→  onTextMessage(handler: MessageHandler): () => void {\n   394→    return this.onEvent('text-message-handler', (event) => {\n   395→      if (event.type === EventType.TEXT_MESSAGE_END && this._currentMessageContent) {\n   396→        handler(this._currentMessageContent);\n   397→      }\n   398→    });\n   399→  }\n   400→\n   401→  /**\n   402→   * Helper method to listen for tool call requests.\n   403→   * Aggregates TOOL_CALL_* events and calls handler with complete tool calls.\n   404→   *\n   405→   * @param handler - Callback function to handle tool calls\n   406→   * @returns Cleanup function\n   407→   */\n   408→  onToolCall(handler: ToolCallHandler): () => void {\n   409→    return this.onEvent('tool-call-handler', (event) => {\n   410→      if (event.type === EventType.TOOL_CALL_END) {\n   411→        const e = event as ToolCallEndEvent;\n   412→        const toolCall = this.currentToolCalls.get(e.toolCallId);\n   413→        if (toolCall) {\n   414→          try {\n   415→            const args = JSON.parse(toolCall.args);\n   416→            handler(e.toolCallId, toolCall.name, args);\n   417→            this.currentToolCalls.delete(e.toolCallId);\n   418→          } catch (error) {\n   419→            console.error('Error parsing tool call args:', error);\n   420→          }\n   421→        }\n   422→      }\n   423→    });\n   424→  }\n   425→\n   426→  /**\n   427→   * Gets the current accumulated message content (useful during streaming).\n   428→   */\n   429→  get currentMessageContent(): string {\n   430→    return this._currentMessageContent;\n   431→  }\n   432→\n   433→  /**\n   434→   * Gets the current thread ID for this session.\n   435→   * Generates a new one if not set.\n   436→   */\n   437→  get threadId(): string {\n   438→    if (!this._threadId) {\n   439→      this._threadId = uuidv4();\n   440→    }\n   441→    return this._threadId;\n   442→  }\n   443→\n   444→  /**\n   445→   * Gets the current conversation messages.\n   446→   */\n   447→  get messages(): Message[] {\n   448→    return this._messages;\n   449→  }\n   450→\n   451→  /**\n   452→   * Gets the current state.\n   453→   */\n   454→  get state(): unknown {\n   455→    return this._state;\n   456→  }\n   457→\n   458→  /**\n   459→   * Sets the thread ID for this session.\n   460→   * When the thread ID changes, conversation state is cleared to prevent history bleeding.\n   461→   * Use this when switching between different chat conversations.\n   462→   *\n   463→   * @param threadId - The thread/chat ID to use (typically the chatId)\n   464→   */\n   465→  setThreadId(threadId: string) {\n   466→    if (this._threadId !== threadId) {\n   467→      console.log('[Client] ThreadId changed, clearing conversation state', {\n   468→        oldThreadId: this._threadId,\n   469→        newThreadId: threadId,\n   470→      });\n   471→\n   472→      // Clear conversation state when switching threads\n   473→      this._messages = [];\n   474→      this._currentMessageContent = '';