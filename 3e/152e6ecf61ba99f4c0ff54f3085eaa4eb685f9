initions to register\n   262→   * @param state - Optional state object to provide to the AI.\n   263→   */\n   264→  registerTools(tools: ToolDefinition[], state?: unknown) {\n   265→    this._tools = tools;\n   266→    this._state = state;\n   267→  }\n   268→\n   269→  /**\n   270→   * Sets the MCP headers provider.\n   271→   * The provider will be called each time a message is sent to get fresh headers.\n   272→   *\n   273→   * @param provider - Function that returns MCP headers configuration\n   274→   */\n   275→  setMcpHeadersProvider(provider: () => McpHeadersMap | Promise<McpHeadersMap>) {\n   276→    this.mcpHeadersProvider = provider;\n   277→  }\n   278→\n   279→  /**\n   280→   * Sends a user prompt to the AI.\n   281→   *\n   282→   * @param prompt - The user's prompt/question\n   283→   */\n   284→  async sendPrompt(prompt: string) {\n   285→    // Add user message to conversation\n   286→    const userMessage: Message = {\n   287→      id: uuidv4(),\n   288→      role: 'user',\n   289→      content: prompt,\n   290→    };\n   291→    this._messages.push(userMessage);\n   292→\n   293→    // Get MCP headers if provider is set\n   294→    let mcpHeaders: McpHeadersMap | undefined;\n   295→    if (this.mcpHeadersProvider) {\n   296→      try {\n   297→        mcpHeaders = await this.mcpHeadersProvider();\n   298→      } catch (error) {\n   299→        console.error('[UseAIClient] Failed to get MCP headers:', error);\n   300→        // Continue without headers rather than blocking the request\n   301→      }\n   302→    }\n   303→\n   304→    // Create RunAgentInput\n   305→    const runInput: RunAgentInput = {\n   306→      threadId: this.threadId, // Use getter to ensure non-null\n   307→      runId: uuidv4(),\n   308→      messages: this._messages,\n   309→      tools: this._tools.map(t => ({\n   310→        name: t.name,\n   311→        description: t.description,\n   312→        parameters: t.parameters,\n   313→      })),\n   314→      state: this