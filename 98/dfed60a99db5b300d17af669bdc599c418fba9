tion } from '@use-ai/core';\nimport type { McpEndpointConfig } from '../types';\n\ninterface McpSchema {\n  tools: Array<{\n    name: string;\n    description: string;\n    inputSchema: any; // JSON Schema\n  }>;\n}\n\nexport class McpToolsProvider {\n  private toolsByEndpoint = new Map<string, ToolDefinition[]>();\n  private refreshTimers = new Map<string, NodeJS.Timeout>();\n  \n  constructor(private configs: McpEndpointConfig[]) {}\n  \n  async initialize(): Promise<void> {\n    await Promise.all(\n      this.configs.map(config => this.fetchAndRegister(config))\n    );\n  }\n  \n  private async fetchAndRegister(config: McpEndpointConfig): Promise<void> {\n    try {\n      const schema = await this.fetchSchema(config);\n      const tools = this.convertToToolDefinitions(schema, config);\n      this.toolsByEndpoint.set(config.url, tools);\n      \n      // Set up refresh if configured\n      if (config.refreshInterval && config.refreshInterval > 0) {\n        const timer = setInterval(\n          () => this.fetchAndRegister(config),\n          config.refreshInterval\n        );\n        this.refreshTimers.set(config.url, timer);\n      }\n      \n      console.log(`[MCP] Registered ${tools.length} tools from ${config.url}`);\n    } catch (error) {\n      console.error(`[MCP] Failed to fetch tools from ${config.url}:`, error);\n    }\n  }\n  \n  private async fetchSchema(config: McpEndpointConfig): Promise<McpSchema> {\n    const response = await fetch(`${config.url}/tools`, {\n      headers: config.headers,\n      signal: AbortSignal.timeout(config.timeout || 30000),\n    });\n    \n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n    }\n    \n    return await response.json();\n  }\n  \n  private convertToToolDefinitions(\n    schema: McpSchema, \n    config: McpEndpointConfig\n  ): ToolDefinition[] {\n    return schema.tools.map(tool => {\n      const name = config.namespace \n        ? `${config.namespace}_${tool.name}`\n        : tool.name;\n        \n      return {\n        name,\n        description: tool.description,\n        parameters: tool.inputSchema,\n        // Mark as remote for execution routing\n        remote: {\n          endpoint: config.url,\n          headers: config.headers,\n          timeout: config.timeout,\n        },\n      };\n    });\n  }\n  \n  getAllTools(): ToolDefinition[] {\n    const allTools: ToolDefinition[] = [];\n    for (const tools of this.toolsByEndpoint.values()) {\n      allTools.push(...tools);\n    }\n    return allTools;\n  }\n  \n  async executeTool(\n    toolName: string, \n    args: any\n  ): Promise<any> {\n    // Find which endpoint this tool belongs to\n    for (const [endpointUrl, tools] of this.toolsByEndpoint.entries()) {\n      const tool = tools.find(t => t.name === toolName);\n      if (tool && tool.remote) {\n        return await this.executeRemoteTool(tool, args);\n      }\n    }\n    throw new Error(`MCP tool \"${toolName}\" not found`);\n  }\n  \n  private async executeRemoteTool(\n    tool: ToolDefinition, \n    args: any\n  ): Promise<any> {\n    const response = await fetch(`${tool.remote!.endpoint}/execute`, {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        ...tool.remote!.headers,\n      },\n      body: JSON.stringify({\n        tool: tool.name,\n        arguments: args,\n      }),\n      signal: AbortSignal.timeout(tool.remote!.timeout || 30000),\n    });\n    \n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n    }\n    \n    const result = await response.json();\n    return result.result || result; // Handle different response formats\n  }\n  \n  destroy(): void {\n    // Clean up refresh timers\n    for (const timer of this.refreshTimers.values()) {\n      clearInterval(timer);\n    }\n  }\n}\n```\n\n#### **Phase 3: Integrate into Server**\n\n```typescript\n// packages/server/src/server.ts\n\nexport class UseAIServer {\n  private mcpProvider?: McpToolsProvider;\n  \n  constructor(private options: UseAIServerOptions) {\n    // Initialize MCP provider if endpoints configured\n    if (options.mcpEndpoints && options.mcpEndpoints.length > 0) {\n      this.mcpProvider = new McpToolsProvider(options.mcpEndpoints);\n    }\n  }\n  \n  async start(port: number = 8080): Promise<void> {\n    // Fetch MCP tools before starting server\n    if (this.mcpProvider) {\n      console.log('[Server] Fetching MCP tools...');\n      await this.mcpProvider.initialize();\n    }\n    \n    // ... rest of server startup\n  }\n  \n  private setupSocketHandlers(socket: Socket): void {\n    // When client registers tools, merge with MCP tools\n    socket.on('message', async (message: UseAIClientMessage) => {\n      if (message.type === 'run_agent') {\n        const clientTools = message.data.tools || [];\n        const mcpTools = this.mcpProvider?.getAllTools() || [];\n        \n        // Merge tools\n        const allTools = [...clientTools, ...mcpTools];\n        \n        // Send to agent with merged tool set\n        await this.runAgent({\n          ...message.data,\n          tools: allTools,\n        });\n      }\n    });\n  }\n  \n  private async handleToolExecution(\n    toolName: string, \n    args: any\n  ): Promise<any> {\n    // Check if it's an MCP tool\n    const mcpTools = this.mcpProvider?.getAllTools() || [];\n    const isMcpTool = mcpTools.some(t => t.name === toolName);\n    \n    if (isMcpTool) {\n      // Execute on MCP backend\n      return await this.mcpProvider!.executeTool(toolName, args);\n    } else {\n      // Send to client for execution (existing flow)\n      return await this.executeClientTool(toolName, args);\n    }\n  }\n}\n```\n\n---\n\n### **4. Benefits of Server-Only Approach**\n\n| Aspect | Server-Only | Frontend Involved |\n|--------|-------------|-------------------|\n| **Complexity** | ✅ Simple config | ❌ Schema fetching logic in frontend |\n| **Security** | ✅ Credentials stay server-side | ⚠️ URLs exposed to browser |\n| **Performance** | ✅ One fetch on startup | ❌ Fetch per client connection |\n| **Caching** | ✅ Shared across all clients | ❌ Per-client cache |\n| **Error Handling** | ✅ Centralized | ❌ Distributed across clients |\n| **Deployment** | ✅ Config in one place | ❌ Rebuild frontend for new tools |\n\n---\n\n### **5. Example: Real-World Setup**\n\n```typescript\n// server/start.ts\nimport { UseAIServer, AISDKAgent } from '@use-ai/server';\n\nconst server = new UseAIServer({\n  agents: { \n    claude: new AISDKAgent({ \n      model: anthropic('claude-3-5-sonnet-20241022') \n    }) \n  },\n  defaultAgent: 'claude',\n  \n  mcpEndpoints: [\n    // Internal calculation service\n    {\n      url: 'http://calc-service:3000/mcp',\n      namespace: 'calc', // Tools: calc_add, calc_multiply, etc.\n    },\n    \n    // External API with auth\n    {\n      url: 'https://api.example.com/mcp',\n      headers: { \n        'Authorization': `Bearer ${process.env.EXAMPLE_API_TOKEN}` \n      },\n      namespace: 'example',\n      refreshInterval: 300000, // Refresh every 5 min\n    },\n    \n    // Local MCP-Nest backend\n    {\n      url: process.env.MCP_NEST_URL || 'http://localhost:3001/mcp',\n      timeout: 60000, // 60s for slow operations\n    },\n  ],\n});\n\nawait server.start(8080);\n```\n\nFrontend code stays completely unchanged - it just works with the new backend tools automatically!\n\n---\n\n### **6. Migration Path**\n\n**Phase 1**: Server-only MCP configuration (this proposal)\n- Zero frontend changes\n- All configuration in server\n- Simple, clean separation\n\n**Phase 2** (Future, if needed): Optional frontend MCP tools\n- For cases where frontend needs to know about backend capabilities for UI\n- E.g., showing available tools in a UI picker\n- Use query endpoint: `GET /api/available-tools`\n\n---\n\n**Does this simplified approach align with your vision?** The frontend stays completely oblivious to MCP tools - 