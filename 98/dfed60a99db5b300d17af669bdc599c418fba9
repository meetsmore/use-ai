ion[]): void;\n}\n```\n\n---\n\n### **Complete Example: MCP Tools in Both Chat and Dify**\n\n```typescript\n// server/start.ts\nimport { UseAIServer, AISDKAgent } from '@use-ai/server';\nimport { WorkflowsPlugin, DifyWorkflowRunner } from '@use-ai/plugin-workflows';\nimport { anthropic } from '@ai-sdk/anthropic';\n\nconst server = new UseAIServer({\n  agents: { \n    claude: new AISDKAgent({ \n      model: anthropic('claude-3-5-sonnet-20241022') \n    }) \n  },\n  defaultAgent: 'claude',\n  \n  // Configure MCP endpoints once\n  mcpEndpoints: [\n    {\n      url: 'http://mcp-nest-backend:3000/mcp',\n      headers: { 'Authorization': `Bearer ${process.env.MCP_TOKEN}` },\n    },\n  ],\n  \n  // Plugins automatically get access to MCP tools\n  plugins: [\n    new WorkflowsPlugin({\n      runners: new Map([\n        ['dify', new DifyWorkflowRunner({\n          apiBaseUrl: process.env.DIFY_API_URL || 'http://localhost:3001/v1',\n          workflows: {\n            'pdf-processor': process.env.DIFY_PDF_WORKFLOW_KEY!,\n          },\n        })],\n      ]),\n    }),\n  ],\n});\n\nawait server.start(8080);\n```\n\n**What happens now:**\n\n1. **Chat usage (`useAI`)**: \n   - MCP tools automatically available ✅\n   - Tools execute server-side via MCP endpoint\n\n2. **Workflow usage (`useAIWorkflow`)**:\n   - MCP tools automatically available ✅\n   - Dify workflow can call MCP tools\n   - Tools execute server-side via MCP endpoint\n\n3. **Frontend code**:\n   ```typescript\n   // Chat - MCP tools work automatically\n   const { ref } = useAI({\n     tools: { addTodo: defineTool(...) }, // Only frontend tools\n   });\n   \n   // Workflow - MCP tools work automatically\n   const { trigger } = useAIWorkflow('dify', 'pdf-processor');\n   await trigger({\n     inputs: { file: pdfData },\n     tools: { insertText: defineTool(...) }, // Only frontend tools\n   });\n   ```\n\n---\n\n### **How Tool Execution Works in Dify**\n\n```\n┌──────────────────────────────────────────┐\n│ Frontend