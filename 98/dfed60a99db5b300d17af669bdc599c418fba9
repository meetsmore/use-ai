/\n   252→export function UseAIProvider({\n   253→  serverUrl,\n   254→  children,\n   255→  systemPrompt,\n   256→  CustomButton,\n   257→  CustomChat,\n   258→  chatRepository,\n   259→}: UseAIProviderProps) {\n   260→  const [connected, setConnected] = useState(false);\n   261→  const [isChatOpen, setIsChatOpen] = useState(false);\n   262→  const [messages, setMessages] = useState<Message[]>([]);\n   263→  const [loading, setLoading] = useState(false);\n   264→\n   265→  /**\n   266→   * Current active chat where AI responses are saved.\n   267→   * This is the \"source of truth\" for where new AI messages get persisted.\n   268→   */\n   269→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   270→\n   271→  /**\n   272→   * Chat loaded for viewing but not yet active for AI responses.\n   273→   * Becomes currentChatId when user sends their first message.\n   274→   * This prevents race conditions when AI is still responding to the previous chat.\n   275→   */\n   276→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   277→\n   278→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   279→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   280→  const promptsRef = useRef<Map<string, string>>(new Map());\n   281→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   282→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   283→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   284→\n   285→  /**\n   286→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   287→   * Event handlers are created once during mount and don't see updated state values.\n   288→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   289→   */\n   290→  const currentChatIdSnapshot = useRef<string | null>(null);\n   291→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   292→\n   293→  const clientRef = useRef<UseAIClient | null>(null);\n   294→  const repositoryRef = useRef<ChatRepository>(\n   295→    chatRepository || new LocalStorageChatRepository()\n   296→  );\n   297→\n   298→  // Initialize chat storage hook\n   299→  const chatStorage = useChatStorage(repositoryRef.current);\n   300→\n   301→  // Helper function to load messages from storage for display\n   302→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   303→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   304→    setMessages(loadedMessages);\n   305→  }, [chatStorage]);\n   306→\n   307→  const registerTools = useCallback((\n   308→    id: string,\n   309→    tools: ToolsDefinition,\n   310→    waitForRender?: () => Promise<void>\n   311→  ) => {\n   312→    const existingTools = toolRegistryRef.current.get(id);\n   313→\n   314→    // Always update the ref to capture latest closures\n   315→    toolRegistryRef.current.set(id, tools);\n   316→\n   317→    // Only increment version if tool names changed (added/removed tools)\n   318→    if (existingTools) {\n   319→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   320→      const newKeys = Object.keys(tools).sort().join(',');\n   321→      if (existingKeys !== newKeys) {\n   322→        setToolRegistryVersion(v => v + 1);\n   323→      }\n   324→    } else {\n   325→      // First registration\n   326→      setToolRegistryVersion(v => v + 1);\n   327→    }\n   328→\n   329→    Object.keys(tools).forEach(toolName => {\n   330→      toolOwnershipRef.current.set(toolName, id);\n   331→    });\n   332→\n   333→    if (waitForRender) {\n   334→      renderWaitersRef.current.set(id, waitForRender);\n   335→    }\n   336→  }, []);\n   337→\n   338→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   339→    if (prompt) {\n   340→      promptsRef.current.set(id, prompt);\n   341→    } else {\n   342→      promptsRef.current.delete(id);\n   343→    }\n   344→\n   345→    if (suggestions && suggestions.length > 0) {\n   346→      suggestionsRef.current.set(id, suggestions);\n   347→    } else {\n   348→      suggestionsRef.current.delete(id);\n   349→    }\n   350→  }, []);\n   351→\n   352→  const unregisterTools = useCallback((id: string) => {\n   353→    const tools = toolRegistryRef.current.get(id);\n   354→    if (tools) {\n   355→      Object.keys(tools).forEach(toolName => {\n   356→        toolOwnershipRef.current.delete(toolName);\n   357→      });\n   358→    }\n   359→\n   360→    toolRegistryRef.current.delete(id);\n   361→    setToolRegistryVersion(v => v + 1);\n   362→    promptsRef.current.delete(id);\n   363→    suggestionsRef.current.delete(id);\n   364→    renderWaitersRef.current.delete(id);\n   365→  }, []);\n   366→\n   367→  const aggregatedTools = React.useMemo(() => {\n   368→    const tools: ToolsDefinition = {};\n   369→    toolRegistryRef.current.forEach((toolSet) => {\n   370→      Object.assign(tools, toolSet);\n   371→    });\n   372→    return tools;\n   373→  }, [toolRegistryVersion]);\n   374→\n   375→  const aggregatedSuggestions = React.useMemo(() => {\n   376→    const allSuggestions: string[] = [];\n   377→    suggestionsRef.current.forEach((suggestions) => {\n   378→      allSuggestions.push(...suggestions);\n   379→    });\n   380→    return allSuggestions;\n   381→  }, [toolRegistryVersion]);\n   382→\n   383→  const hasTools = toolRegistryRef.current.size > 0;\n   384→  const aggregatedToolsRef = useRef(aggregatedTools);\n   385→  aggregatedToolsRef.current = aggregatedTools;\n   386→\n   387→  // Keep snapshot refs in sync with latest chat IDs\n   388→  useEffect(() => {\n   389→    currentChatIdSnapshot.current = currentChatId;\n   390→  }, [currentChatId]);\n   391→\n   392→  useEffect(() => {\n   393→    pendingChatIdSnapshot.current = pendingChatId;\n   394→  }, [pendingChatId]);\n   395→\n   396→  /**\n   397→   * Handles saving AI response to storage and updating UI.\n   398→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   399→   */\n   400→  const handleAIResponse = useCallback(async (content: string) => {\n   401→    const currentChatIdValue = currentChatIdSnapshot.current;\n   402→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   403→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   404→\n   405→    if (!currentChatIdValue) {\n   406→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   407→      return;\n   408→    }\n   409→\n   410→    // Save AI response to storage\n   411→    const saved = await chatStorage.saveAIResponse(currentChatIdValue, content);\n   412→\n   413→    // Reload UI if save was successful and user is viewing this chat\n   414→    if (saved && displayedChatId === currentChatIdValue) {\n   415→      await loadMessagesFromStorage(currentChatIdValue);\n   416→    }\n   417→  }, [chatStorage, loadMessagesFromStorage]);\n   418→\n   419→  useEffect(() => {\n   420→    const client = new UseAIClient(serverUrl);\n   421→\n   422→    client.connect()\n   423→      .then(() => {\n   424→        setConnected(true);\n   425→      })\n   426→      .catch((err) => {\n   427→        console.error('Failed to connect client:', err);\n   428→        setConnected(false);\n   429→      });\n   430→\n   431→    const unsubscribe = client.onEvent('globalChat', async (event: AGUIEvent) => {\n   432→      if (event.type === EventType.TOOL_CALL_END) {\n   433→        const toolCallEnd = event as ToolCallEndEvent;\n   434→        const toolCallId = toolCallEnd.toolCallId;\n   435→\n   436→        // Get the accumulated tool call data\n   437→        const toolCallData = client['currentToolCalls'].get(toolCallId);\n   438→        if (!toolCallData) {\n   439→          console.error(`[Provider] Tool call ${toolCallId} not found`);\n   440→          return;\n   441→        }\n   442→\n   443→        const name = toolCallData.name;\n   444→        const input = JSON.parse(toolCallData.args);\n   445→\n   446→        // Check if this tool belongs to a useAI hook (not a workflow)\n   447→        // If the tool doesn't exist in our aggregated tools, it's a workflow tool\n   448→        // and will be handled by useAIWorkflow's event listener\n   449→        if (!aggregatedToolsRef.current[name]) {\n   450→          console.log(`[Provider] Tool \"${name}\" not found in useAI tools, skipping (likely a workflow tool)`);\n   451→          return;\n   452→        }\n   453→\n   454→        try {\n   455→          const ownerId = toolOwnershipRef.current.get(name);\n   456→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   457→\n   458→          let renderPromise: Promise<void> | undefined;\n   459→          if (ownerId) {\n   460→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   461→            if (waitForRender) {\n   462→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   463→              renderPromise = waitForRender();\n   464→            }\n   465→          }\n   466→\n   467→          console.log('[useAI] Executing tool...');\n   468→          const result = await executeDefinedTool(aggregatedToolsRef.current, name, input);\n   469→\n   470→          // Check if result indicates an error - if so, skip render wait\n   471→          // Error results typically don't trigger state changes/re-renders\n   472→          const isErrorResult = result && typeof result === 'object' &&\n   473→            ('error' in result || (result as any).success === false);\n   474→\n   475→          if (renderPromise && !isErrorResult) {\n   476→            console.log('[useAI] Tool executed successfully, waiting for render...');\n   477→            await renderPromise;\n   478→            console.log('[useAI] Render complete');\n   479→          } else if (isErrorResult) {\n   480→            console.log('[useAI] Tool returned error, skipping render wait');\n   481→          } else {\n   482→            console.log('[useAI] No render to wait for');\n   483→          }\n   484→\n   485→          // Build updated state\n   486→          let updatedState: unknown = null;\n   487→          if (ownerId) {\n   488→            const prompt = promptsRef.current.get(ownerId);\n   489→            if (prompt) {\n   490→              updatedState = { context: prompt };\n   491→              console.log(`[useAI] Updated state from ${ownerId}`);\n   492→            }\n   493→          }\n   494→\n   495→          client.sendToolResponse(toolCallId, result, updatedState);\n   496→        } catch (err) {\n   497→          console.error('Tool execution error:', err);\n   498→          client.sendToolResponse(toolCallId, {\n   499→            error: err instanceof Error ? err.message : 'Unknown error',\n   500→          });\n   501→        }\n   502→      } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   503→        const content = client.currentMessageContent;\n   504→        if (content) {\n   505→          console.log('[Provider] Received text message:', content.substring(0, 100));\n   506→          handleAIResponse(content); // Fire-and-forget is intentional here\n   507→          setLoading(false);\n   508→        }\n   509→      } else if (event.type === EventType.RUN_ERROR) {\n   510→        const errorEvent = event as RunErrorEvent;\n   511→        console.error('[Provider] Run error:', errorEvent.message);\n   512→        setLoading(false);\n   513→      }\n   514→    });\n   515→\n   516→    clientRef.current = client;\n   517→\n   518→    return () => {\n   519→      unsubscribe();\n   520→      client.disconnect();\n   521→      setConnected(false);\n   522→    };\n   523→  }, [serverUrl]);\n   524→\n   525→  const lastRegisteredToolsRef = useRef<string>('');\n   526→\n   527→  useEffect(() => {\n   528→    const client = clientRef.current;\n   529→    if (!client || !client.isConnected() || !hasTools) return;\n   530→\n   531→    const toolKeys = Object.keys(aggregatedTools).sort().join(',');\n   532→    if (toolKeys === lastRegisteredToolsRef.current) {\n   533→      console.log('[Provider] Skipping re-registration, tools unchanged');\n   534→      return;\n   535→    }\n   536→\n   537→    lastRegisteredToolsRef.current = toolKeys;\n   538→    console.log('[Provider] Registering tools:', toolKeys);\n   539→\n   540→    (async () => {\n   541→      try {\n   542→        const toolDefinitions = convertToolsToDefinitions(aggregatedTools);\n   543→        console.log(`[Provider] Converted ${toolDefinitions.length} tool definitions`);\n   544→\n   545→        const promptParts: string[] = [];\n   546→\n   547→        if (systemPrompt) {\n   548→          promptParts.push(systemPrompt);\n   549→        }\n   550→\n   551→        for (const [id, prompt] of promptsRef.current.entries()) {\n   552→          if (prompt) {\n   553→            promptParts.push(prompt);\n   554→          }\n   555→        }\n   556→\n   557→        // Build state object from prompts\n   558→        const state = promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   559→        console.log(`[Provider] Registering ${toolDefinitions.length} tools with state`);\n   560→        client.registerTools(toolDefinitions, state);\n   561→      } catch (err) {\n   562→        console.error('Failed to register tools:', err);\n   563→      }\n   564→    })();\n   565→  }, [hasTools, aggregatedTools, systemPrompt, connected]);\n   566→\n   567→  // Chat management functions\n   568→  const createNewChat = useCallback(async (): Promise<string> => {\n   569→    console.log('[Provider] createNewChat called - currentChatId:', currentChatId, 'pendingChatId:', pendingChatId, 'messages.length:', messages.length);\n   570→\n   571→    // If we already have a pending blank chat, don't create another one\n   572→    if (pendingChatId && messages.length === 0) {\n   573→      console.log('[Provider] Pending chat is already blank, not creating new chat');\n   574→      return pendingChatId;\n   575→    }\n   576→\n   577→    // If current chat is already blank (and no pending chat), don't create a new one\n   578→    if (currentChatId && !pendingChatId && messages.length === 0) {\n   579→      console.log('[Provider] Current chat is already blank, not creating new chat');\n   580→      return currentChatId;\n   581→    }\n   582→\n   583→    console.log('[Provider] Creating new chat...');\n   584→    const repository = repositoryRef.current;\n   585→    const chatId = await repository.createChat();\n   586→\n   587→    // Set as pending - don't switch currentChatId until user sends a message\n   588→    setPendingChatId(chatId);\n   589→    setMessages([]); // Clear messages for the new blank chat\n   590→    console.log('[Provider] Created pending chat:', chatId, '(will activate on first message)');\n   591→    return chatId;\n   592→  }, [currentChatId, pendingChatId, messages]);\n   593→\n   594→  const loadChat = useCallback(async (chatId: string): Promise<void> => {\n   595→    // Set as pending chat - don't activate until user sends a message\n   596→    // This prevents race condition if AI is still responding to current chat\n   597→    setPendingChatId(chatId);\n   598→\n   599→    // Load messages from storage for display\n   600→    await loadMessagesFromStorage(chatId);\n   601→\n   602→    console.log('[Provider] Loaded pending chat:', chatId, '(will activate on first message)');\n   603→  }, [loadMessagesFromStorage]);\n   604→\n   605→  const deleteChat = useCallback(async (chatId: string): Promise<void> => {\n   606→    const repository = repositoryRef.current;\n   607→    await repository.deleteChat(chatId);\n   608→\n   609→    // Clear current chat if it's the one being deleted\n   610→    if (currentChatId === chatId) {\n   611→      setCurrentChatId(null);\n   612→      setMessages([]);\n   613→    }\n   614→\n   615→    // Clear pending chat if it's the one being deleted\n   616→    if (pendingChatId === chatId) {\n   617→      setPendingChatId(null);\n   618→      setMessages([]);\n   619→    }\n   620→\n   621→    console.log('[Provider] Deleted chat:', chatId);\n   622→  }, [currentChatId, pendingChatId]);\n   623→\n   624→  const listChats = useCallback(async (): Promise<Array<Omit<Chat, 'messages'>>> => {\n   625→    const repository = repositoryRef.current;\n   626→    return await repository.listChats();\n   627→  }, []);\n   628→\n   629→  const clearCurrentChat = useCallback(async (): Promise<void> => {\n   630→    setMessages([]);\n   631→\n   632→    if (currentChatId) {\n   633→      const repository = repositoryRef.current;\n   634→      const chat = await repository.loadChat(currentChatId);\n   635→      if (chat) {\n   636→        chat.messages = [];\n   637→        await repository.saveChat(chat);\n   638→        console.log('[Provider] Cleared current chat:', currentChatId);\n   639→      }\n   640→    }\n   641→  }, [currentChatId]);\n   642→\n   643→  // Initialize: load most recent chat or create new one on mount\n   644→  const initializedRef = useRef(false);\n   645→  useEffect(() => {\n   646→    // Only initialize if we don't have any chat (neither current nor pending)\n   647→    if (currentChatId === null && pendingChatId === null && !initializedRef.current) {\n   648→      initializedRef.current = true;\n   649→\n   650→      (async () => {\n   651→        try {\n   652→          const repository = repositoryRef.current;\n   653→          const chats = await repository.listChats({ limit: 1 });\n   654→\n   655→          if (chats.length > 0) {\n   656→            // Load the most recent chat and activate it immediately (no AI response in progress at startup)\n   657→            const mostRecentChatId = chats[0].id;\n   658→            console.log('[Pr