chat by ID */\n    38→  loadChat: (chatId: string) => Promise<void>;\n    39→  /** Deletes a chat by ID */\n    40→  deleteChat: (chatId: string) => Promise<void>;\n    41→  /** Lists all available chats */\n    42→  listChats: () => Promise<Array<Omit<Chat, 'messages'>>>;\n    43→  /** Clears the current chat messages */\n    44→  clearCurrentChat: () => Promise<void>;\n    45→}\n    46→\n    47→const UseAIContext = createContext<UseAIContextValue | null>(null);\n    48→\n    49→/**\n    50→ * Props for custom floating button component.\n    51→ * Used to customize the appearance and behavior of the AI chat trigger button.\n    52→ */\n    53→export interface FloatingButtonProps {\n    54→  /** Callback when the button is clicked */\n    55→  onClick: () => void;\n    56→  /** Whether the client is connected to the server */\n    57→  connected: boolean;\n    58→  /** Whether there are unread messages */\n    59→  hasUnread?: boolean;\n    60→}\n    61→\n    62→/**\n    63→ * Props for custom chat panel component.\n    64→ * Used to customize the appearance and behavior of the AI chat interface.\n    65→ */\n    66→export interface ChatPanelProps {\n    67→  /** Whether the chat panel is open */\n    68→  isOpen: boolean;\n    69→  /** Callback when the panel should close */\n    70→  onClose: () => void;\n    71→  /** Callback when a message is sent */\n    72→  onSendMessage: (message: string) => void;\n    73→  /** Array of messages in the conversation */\n    74→  messages: Message[];\n    75→  /** Whether the AI is currently processing */\n    76→  loading: boolean;\n    77→  /** Whether the client is connected to the server */\n    78→  connected: boolean;\n    79→}\n    80→\n    81→export interface UseAIProviderProps extends UseAIConfig {\n    82→  children: ReactNode;\n    83→  systemPrompt?: string;\n    84→  CustomButton?: React.ComponentType<FloatingButtonProps>;\n    85→  CustomChat?: React.ComponentType<ChatPanelProps>;\n    86→  /**\n    87→   * Custom chat repository for message persistence.\n    88→   * Defaults to LocalStorageChatRepository if not provided.\n    89→   */\n    90→  chatRepository?: ChatRepository;\n    91→}\n    92→\n    93→/**\n    94→ * Provider component that manages AI client connection and tool registration.\n    95→ * Must wrap all components that use the useAI hook.\n    96→ *\n    97→ * Features:\n    98→ * - Establishes and maintains WebSocket connection to UseAI server\n    99→ * - Aggregates tools from all child useAI hooks\n   100→ * - Handles tool execution requests from the AI\n   101→ * - Provides floating button and chat panel UI\n   102→ *\n   103→ * @param props - Provider configuration and children\n   104→ *\n   105→ * @example\n   106→ * ```typescript\n   107→ * import { UseAIProvider } from '@use-ai/client';\n   108→ *\n   109→ * function App() {\n   110→ *   return (\n   111→ *     <UseAIProvider\n   112→ *       serverUrl=\"ws://localhost:8080\"\n   113→ *       systemPrompt=\"You are a helpful assistant for managing todos\"\n   114→ *     >\n   115→ *       <YourApp />\n   116→ *     </UseAIProvider>\n   117→ *   );\n   118→ * }\n   119→ * ```\n   120→ */\n   121→export function UseAIProvider({\n   122→  serverUrl,\n   123→  children,\n   124→  systemPrompt,\n   125→  CustomButton,\n   126→  CustomChat,\n   127→  chatRepository,\n   128→}: UseAIProviderProps) {\n   129→  const [connected, setConnected] = useState(false);\n   130→  const [isChatOpen, setIsChatOpen] = useState(false);\n   131→  const [messages, setMessages] = useState<Message[]>([]);\n   132→  const [loading, setLoading] = useState(false);\n   133→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   134→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   135→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   136→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   137→  const promptsRef = useRef<Map<string, string>>(new Map());\n   138→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   139→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   140→\n   141→  // Refs to capture latest chat IDs in event handler closure\n   142→  const currentChatIdRef = useRef<string | null>(null);\n   143→  const pendingChatIdRef = useRef<string | null>(null);\n   144→\n   145→  const clientRef = useRef<UseAIClient | null>(null);\n   146→  const repositoryRef = useRef<ChatRepository>(\n   147→    chatRepository || new LocalStorageChatRepository()\n   148→  );\n   149→\n   150→  // Helper function to load messages from storage for display\n   151→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   152→    const repository = repositoryRef.current;\n   153→    const chat = await repository.loadChat(chatId);\n   154→\n   155→    if (chat) {\n   156→      const loadedMessages = chat.messages.map((msg) => ({\n   157→        id: msg.id,\n   158→        role: msg.role as 'user' | 'assistant',\n   159→        content: msg.content,\n   160→        timestamp: msg.createdAt,\n   161→      }));\n   162→      setMessages(loadedMessages);\n   163→      console.log('[Provider] Loaded', loadedMessages.length, 'messages from storage for chat:', chatId);\n   164→    } else {\n   165→      setMessages([]);\n   166→      console.log('[Provider] Chat not found in storage:', chatId);\n   167→    }\n   168→  }, []);\n   169→\n   170→  const registerTools = useCallback((\n   171→    id: string,\n   172→    tools: ToolsDefinition,\n   173→    waitForRender?: () => Promise<void>\n   174→  ) => {\n   175→    const existingTools = toolRegistryRef.current.get(id);\n   176→\n   177→    // Always update the ref to capture latest closures\n   178→    toolRegistryRef.current.set(id, tools);\n   179→\n   180→    // Only increment version if tool names changed (added/removed tools)\n   181→    if (existingTools) {\n   182→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   183→      const newKeys = Object.keys(tools).sort().join(',');\n   184→      if (existingKeys !== newKeys) {\n   185→        setToolRegistryVersion(v => v + 1);\n   186→      }\n   187→    } else {\n   188→      // First registration\n   189→      setToolRegistryVersion(v => v + 1);\n   190→    }\n   191→\n   192→    Object.keys(tools).forEach(toolName => {\n   193→      toolOwnershipRef.current.set(toolName, id);\n   194→    });\n   195→\n   196→    if (waitForRender) {\n   197→      renderWaitersRef.current.set(id, waitForRender);\n   198→    }\n   199→  }, []);\n   200→\n   201→  const updatePrompt = useCallback((id: string, prompt?: string) => {\n   202→    if (prompt) {\n   203→      promptsRef.current.set(id, prompt);\n   204→    } else {\n   205→      promptsRef.current.delete(id);\n   206→    }\n   207→  }, []);\n   208→\n   209→  const unregisterTools = useCallback((id: string) => {\n   210→    const tools = toolRegistryRef.current.get(id);\n   211→    if (tools) {\n   212→      Object.keys(tools).forEach(toolName => {\n   213→        toolOwnershipRef.current.delete(toolName);\n   214→      });\n   215→    }\n   216→\n   217→    toolRegistryRef.current.delete(id);\n   218→    setToolRegistryVersion(v => v + 1);\n   219→    promptsRef.current.delete(id);\n   220→    renderWaitersRef.current.delete(id);\n   221→  }, []);\n   222→\n   223→  const aggregatedTools = React.useMemo(() => {\n   224→    const tools: ToolsDefinition = {};\n   225→    toolRegistryRef.current.forEach((toolSet) => {\n   226→      Object.assign(tools, toolSet);\n   227→    });\n   228→    return tools;\n   229→  }, [toolRegistryVersion]);\n   230→\n   231→  const hasTools = toolRegistryRef.current.size > 0;\n   232→  const aggregatedToolsRef = useRef(aggregatedTools);\n   233→  aggregatedToolsRef.current = aggregatedTools;\n   234→\n   235→  // Keep refs updated with latest chat IDs\n   236→  useEffect(() => {\n   237→    currentChatIdRef.current = currentChatId;\n   238→  }, [currentChatId]);\n   239→\n   240→  useEffect(() => {\n   241→    pendingChatIdRef.current = pendingChatId;\n   242→  }, [pendingChatId]);\n   243→\n   244→  useEffect(() => {\n   245→    const client = new UseAIClient(serverUrl);\n   246→\n   247→    client.connect()\n   248→      .then(() => {\n   249→        setConnected(true);\n   250→      })\n   251→      .catch((err) => {\n   252→        console.error('Failed to connect client:', err);\n   253→        setConnected(false);\n   254→      });\n   255→\n   256→    const unsubscribe = client.onEvent('globalChat', async (event: AGUIEvent) => {\n   257→      if (event.type === EventType.TOOL_CALL_END) {\n   258→        const toolCallEnd = event as ToolCallEndEvent;\n   259→        const toolCallId = toolCallEnd.toolCallId;\n   260→\n   261→        // Get the accumulated tool call data\n   262→        const toolCallData = client['currentToolCalls'].get(toolCallId);\n   263→        if (!toolCallData) {\n   264→          console.error(`[Provider] Tool call ${toolCallId} not found`);\n   265→          return;\n   266→        }\n   267→\n   268→        const name = toolCallData.name;\n   269→        const input = JSON.parse(toolCallData.args);\n   270→\n   271→        try {\n   272→          const ownerId = toolOwnershipRef.current.get(name);\n   273→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   274→\n   275→          let renderPromise: Promise<void> | undefined;\n   276→          if (ownerId) {\n   277→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   278→            if (waitForRender) {\n   279→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   280→              renderPromise = waitForRender();\n   281→            }\n   282→          }\n   283→\n   284→          console.log('[useAI] Executing tool...');\n   285→          const result = await executeDefinedTool(aggregatedToolsRef.current, name, input);\n   286→\n   287→          // Check if result indicates an error - if so, skip render wait\n   288→          // Error results typically don't trigger state changes/re-renders\n   289→          const isErrorResult = result && typeof result === 'object' &&\n   290→            ('error' in result || (result as any).success === false);\n   291→\n   292→          if (renderPromise && !isErrorResult) {\n   293→            console.log('[useAI] Tool executed successfully, waiting for render...');\n   294→            await renderPromise;\n   295→            console.log('[useAI] Render complete');\n   296→          } else if (isErrorResult) {\n   297→            console.log('[useAI] Tool returned error, skipping render wait');\n   298→          } else {\n   299→            console.log('[useAI] No render to wait for');\n   300→          }\n   301→\n   302→          // Build updated state\n   303→          let updatedState: unknown = null;\n   304→          if (ownerId) {\n   305→            const prompt = promptsRef.current.get(ownerId);\n   306→            if (prompt) {\n   307→              updatedState = { context: prompt };\n   308→              console.log(`[useAI] Updated state from ${ownerId}`);\n   309→            }\n   310→          }\n   311→\n   312→          client.sendToolResponse(toolCallId, result, updatedState);\n   313→        } catch (err) {\n   314→          console.error('Tool execution error:', err);\n   315→          client.sendToolResponse(toolCallId, {\n   316→            error: err instanceof Error ? err.message : 'Unknown error',\n   317→          });\n   318→        }\n   319→      } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   320→        const content = client.currentMessageContent;\n   321→        if (content) {\n   322→          console.log('[Provider] Received text message:', content.substring(0, 100));\n   323→\n   324→          // Use refs to get latest chat IDs\n   325→          const latestCurrentChatId = currentChatIdRef.current;\n   326→          const latestPendingChatId = pendingChatIdRef.current;\n   327→          const displayedChatId = latestPendingChatId || latestCurrentChatId;\n   328→\n   329→          // Always save to localStorage first (for currentChatId)\n   330→          if (latestCurrentChatId) {\n   331→            (async () => {\n   332→              const repository = repositoryRef.current;\n   333→              const currentChat = await repository.loadChat(latestCurrentChatId);\n   334→              if (currentChat) {\n   335→                currentChat.messages.push({\n   336→                  id: generateMessageId(),\n   337→                  role: 'assistant',\n   338→                  content,\n   339→                  createdAt: new Date(),\n   340→                });\n   341→\n   342→                // Auto-generate title from first user message if not set\n   343→                if (!currentChat.title) {\n   344→                  const firstUserMessage = currentChat.messages.find(msg => msg.role === 'user');\n   345→                  if (firstUserMessage) {\n   346→                    const maxLength = 50;\n   347→                    currentChat.title = firstUserMessage.content.length > maxLength\n   348→                      ? firstUserMessage.content.substring(0, maxLength) + '...'\n   349→                      : firstUserMessage.content;\n   350→                  }\n   351→                }\n   352→\n   353→                await repository.saveChat(currentChat);\n   354→                console.log('[Provider] Saved AI response to storage for currentChatId:', latestCurrentChatId);\n   355→\n   356→                // Reload UI if user is viewing this chat\n   357→                if (displayedChatId === latestCurrentChatId) {\n   358→                  await loadMessagesFromStorage(latestCurrentChatId);\n   359→                }\n   360→              }\n   361→            })();\n   362→          }\n   363→          setLoading(false);\n   364→        }\n   365→      } else if (event.type === EventType.RUN_ERROR) {\n   366→        const errorEvent = event as RunErrorEvent;\n   367→        console.error('[Provider] Run error:', errorEvent.message);\n   368→        setLoading(false);\n   369→      }\n   370→    });\n   371→\n   372→    clientRef.current = client;\n   373→\n   374→    return () => {\n   375→      unsubscribe();\n   376→      client.disconnect();\n   377→      setConnected(false);\n   378→    };\n   379→  }, [serverUrl]);\n   380→\n   381→  const lastRegisteredToolsRef = useRef<string>('');\n   382→\n   383→  useEffect(() => {\n   384→    const client = clientRef.current;\n   385→    if (!client || !client.isConnected() || !hasTools) return;\n   386→\n   387→    const toolKeys = Object.keys(aggregatedTools).sort().join(',');\n   388→    if (toolKeys === lastRegisteredToolsRef.current) {\n   389→      console.log('[Provider] Skipping re-registration, tools unchanged');\n   390→      return;\n   391→    }\n   392→\n   393→    lastRegisteredToolsRef.current = toolKeys;\n   394→    console.log('[Provider] Registering tools:', toolKeys);\n   395→\n   396→    (async () => {\n   397→      try {\n   398→        const toolDefinitions = convertToolsToDefinitions(aggregatedTools);\n   399→        console.log(`[Provider] Converted ${toolDefinitions.length} tool definitions`);\n   400→\n   401→        const promptParts: string[] = [];\n   402→\n   403→        if (systemPrompt) {\n   404→          promptParts.push(systemPrompt);\n   405→        }\n   406→\n   407→        for (const [id, prompt] of promptsRef.current.entries()) {\n   408→          if (prompt) {\n   409→            promptParts.push(prompt);\n   410→          }\n   411→        }\n   412→\n   413→        // Build state object from prompts\n   414→        const state = promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   415→        console.log(`[Provider] Registering ${toolDefinitions.length} tools with state`);\n   416→        client.registerTools(toolDefinitions, state);\n   417→      } catch (err) {\n   418→        console.error('Failed to register tools:', err);\n   419→      }\n   420→    })();\n   421→  }, [hasTools, aggregatedTools, systemPrompt, connected]);\n   422→\n   423→  // Chat management functions\n   424→  const createNewChat = useCallback(async (): Promise<string> => {\n   425→    console.log('[Provider] createNewChat called - currentChatId:', currentChatId, 'pendingChatId:', pendingChatId, 'messages.length:', messages.length);\n   426→\n   427→    // If we already have a pending blank chat, don't create another one\n   428→    if (pendingChatId && messages.length === 0) {\n   429→      console.log('[Provider] Pending chat is already blank, not creating new chat');\n   430→      return pendingChatId;\n   431→    }\n   432→\n   433→    // If current chat is already blank (and no pending chat), don't create a new one\n   434→    if (currentChatId && !pendingChatId && messages.length === 0) {\n   435→      console.log('[Provider] Current chat is already blank, not creating new chat');\n   436→      return currentChatId;\n   437→    }\n   438→\n   439→    console.log('[Provider] Creating new chat...');\n   440→    const repository = repositoryRef.current;\n   441→    const chatId = await repository.createChat();\n   442→\n   443→    // Set as pending - don't switch currentChatId until user sends a message\n   444→    setPendingChatId(chatId);\n   445→    setMessages([]); // Clear messages for the new blank chat\n   446→    console.log('[Provider] Created pending chat:', chatId, '(will activate on first message)');\n   447→    return chatId;\n   448→  }, [currentChatId, pendingChatId, messages]);\n   449→\n   450→  const loadChat = useCallback(async (chatId: string): Promise<void> => {\n   451→    // Set as pending chat - don't activate until user sends a message\n   452→    // This prevents race condition if AI is still responding to current chat\n   453→    setPendingChatId(chatId);\n   454→\n   455→    // Load messages from storage for display\n   456→    await loadMessagesFromStorage(chatId);\n   457→\n   458→    console.log('[Provider] Loaded pending chat:', chatId, '(will activate on first message)');\n   459→  }, [loadMessagesFromStorage]);\n   460→\n   461→  const deleteChat = useCallback(async (chatId: string): Promise<void> => {\n   462→    const repository = repositoryRef.current;\n   463→    await repository.deleteChat(chatId);\n   464→\n   465→    // Clear current chat if it's the one being deleted\n   466→    if (currentChatId === chatId) {\n   467→      setCurrentChatId(null);\n   468→      setMessages([]);\n   469→    }\n   470→\n   471→    // Clear pending chat if it's the one being deleted\n   472→    if (pendingChatId === chatId) {\n   473→      setPendingChatId(null);\n   474→      setMessages([]);\n   475→    }\n   476→\n   477→    console.log('[Provider] Deleted chat:', chatId);\n   478→  }, [currentChatId, pendingChatId]);\n   479→\n   480→  const listChats = useCallback(async (): Promise<Array<Omit<Chat, 'messages'>>> => {\n   481→    const repository = repositoryRef.current;\n   482→    return await repository.listChats();\n   483→  }, []);\n   484→\n   485→  const clearCurrentChat = useCallback(async (): Promise<void> => {\n   486→    setMessages([]);\n   487→\n   488→    if (currentChatId) {\n   489→      const repository = repositoryRef.current;\n   490→      const chat = await repository.loadChat(currentChatId);\n   491→      if (chat) {\n   492→        chat.messages = [];\n   493→        await repository.saveChat(chat);\n   494→        console.log('[Provider] Cleared current chat:', currentChatId);\n   495→      }\n   496→    }\n   497→  }, [currentChatId]);\n   498→\n   499→  // Initialize: load most recent chat or create new one on mount\n   500→  const initializedRef = useRef(false);\n   501→  useEffect(() => {\n   502→    // Only initialize if we don't have any chat (neither current n