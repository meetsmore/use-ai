          "text": "     1→import React, { createContext, useContext, useState, useEffect, ReactNode, useCallback, useRef } from 'react';\n     2→import type { UseAIConfig, AGUIEvent, ToolCallEndEvent, RunErrorEvent, AgentInfo } from '../types';\n     3→import { EventType, ErrorCode } from '../types';\n     4→import { UseAIFloatingButton } from '../components/UseAIFloatingButton';\n     5→import { UseAIChatPanel, type Message } from '../components/UseAIChatPanel';\n     6→import { UseAIClient } from '../client';\n     7→import { convertToolsToDefinitions, executeDefinedTool, type ToolsDefinition } from '../defineTool';\n     8→import type { ChatRepository, Chat } from './chatRepository/types';\n     9→import { LocalStorageChatRepository } from './chatRepository/LocalStorageChatRepository';\n    10→import { generateMessageId } from './chatRepository/types';\n    11→\n    12→/**\n    13→ * Mapping of error codes to user-friendly error messages.\n    14→ * Used for displaying errors in the chat UI.\n    15→ * Can be customized for internationalization (i18n).\n    16→ */\n    17→export type ErrorMapping = {\n    18→  [K in ErrorCode]: string;\n    19→};\n    20→\n    21→// Constants\n    22→const CHAT_TITLE_MAX_LENGTH = 50;\n    23→\n    24→// Helper functions\n    25→/**\n    26→ * Generates a chat title from a message, truncating if necessary.\n    27→ */\n    28→const generateChatTitle = (message: string): string => {\n    29→  return message.length > CHAT_TITLE_MAX_LENGTH\n    30→    ? message.substring(0, CHAT_TITLE_MAX_LENGTH) + '...'\n    31→    : message;\n    32→};\n    33→\n    34→/**\n    35→ * Transforms storage messages to UI message format.\n    36→ */\n    37→const transformMessagesToUI = (storageMessages: Array<{ id: string; role: string; content: string; createdAt: Date; displayMode?: 'default' | 'error' }>): Message[] => {\n    38→  return storageMessages.map((msg) => ({\n    39→    id: msg.id,\n    40→    role: msg.role as 'user' | 'assistant',\n    41→    content: msg.content,\n    42→    timestamp: msg.createdAt,\n    43→    displayMode: msg.displayMode,\n    44→  }));\n    45→};\n    46→\n    47→/**\n    48→ * Context value provided by UseAIProvider.\n    49→ * Contains connection state and methods for managing tools and prompts.\n    50→ */\n    51→export interface UseAIContextValue {\n    52→  /** The WebSocket URL of the UseAI server */\n    53→  serverUrl: string;\n    54→  /** Whether the client is connected to the server */\n    55→  connected: boolean;\n    56→  /** Registers tools for a specific component */\n    57→  registerTools: (\n    58→    id: string,\n    59→    tools: ToolsDefinition,\n    60→    waitForRender?: () => Promise<void>\n    61→  ) => void;\n    62→  /** Unregisters tools for a specific component */\n    63→  unregisterTools: (id: string) => void;\n    64→  /** Updates the UI context prompt for a specific component */\n    65→  updatePrompt: (id: string, prompt?: string, suggestions?: string[]) => void;\n    66→  /** The underlying WebSocket client instance */\n    67→  client: UseAIClient | null;\n    68→  /** The current chat ID */\n    69→  currentChatId: string | null;\n    70→  /** Creates a new chat and switches to it */\n    71→  createNewChat: () => Promise<string>;\n    72→  /** Loads an existing chat by ID */\n    73→  loadChat: (chatId: string) => Promise<void>;\n    74→  /** Deletes a chat by ID */\n    75→  deleteChat: (chatId: string) => Promise<void>;\n    76→  /** Lists all available chats */\n    77→  listChats: () => Promise<Array<Omit<Chat, 'messages'>>>;\n    78→  /** Clears the current chat messages */\n    79→  clearCurrentChat: () => Promise<void>;\n    80→  /** List of available agents from the server */\n    81→  availableAgents: AgentInfo[];\n    82→  /** The default agent ID from the server */\n    83→  defaultAgent: string | null;\n    84→  /** The currently selected agent ID (null means use server default) */\n    85→  selectedAgent: string | null;\n    86→  /** Sets the agent to use for requests */\n    87→  setAgent: (agentId: string | null) => void;\n    88→}\n    89→\n    90→/**\n    91→ * React context for UseAI provider state.\n    92→ * @internal This is exported only for testing purposes and should not be used directly.\n    93→ * Use the {@link useAIContext} hook instead.\n    94→ */\n    95→export const __UseAIContext = createContext<UseAIContextValue | null>(null);\n    96→\n    97→/**\n    98→ * Flag to track if the \"no provider\" warning has been logged.\n    99→ * Prevents spamming the console with repeated warnings.\n   100→ */\n   101→let hasWarnedAboutMissingProvider = false;\n   102→\n   103→/**\n   104→ * No-op context value returned when UseAIProvider is not present.\n   105→ * Allows hooks to gracefully degrade instead of crashing.\n   106→ */\n   107→const noOpContextValue: UseAIContextValue = {\n   108→  serverUrl: '',\n   109→  connected: false,\n   110→  registerTools: () => {},\n   111→  unregisterTools: () => {},\n   112→  updatePrompt: () => {},\n   113→  client: null,\n   114→  currentChatId: null,\n   115→  createNewChat: async () => '',\n   116→  loadChat: async () => {},\n   117→  deleteChat: async () => {},\n   118→  listChats: async () => [],\n   119→  clearCurrentChat: async () => {},\n   120→  availableAgents: [],\n   121→  defaultAgent: null,\n   122→  selectedAgent: null,\n   123→  setAgent: () => {},\n   124→};\n   125→\n   126→/**\n   127→ * Props for custom floating button component.\n   128→ * Used to customize the appearance and behavior of the AI chat trigger button.\n   129→ */\n   130→export interface FloatingButtonProps {\n   131→  /** Callback when the button is clicked */\n   132→  onClick: () => void;\n   133→  /** Whether the client is connected to the server */\n   134→  connected: boolean;\n   135→  /** Whether there are unread messages */\n   136→  hasUnread?: boolean;\n   137→}\n   138→\n   139→/**\n   140→ * Props for custom chat panel component.\n   141→ * Used to customize the appearance and behavior of the AI chat interface.\n   142→ */\n   143→export interface ChatPanelProps {\n   144→  /** Whether the chat panel is open */\n   145→  isOpen: boolean;\n   146→  /** Callback when the panel should close */\n   147→  onClose: () => void;\n   148→  /** Callback when a message is sent */\n   149→  onSendMessage: (message: string) => void;\n   150→  /** Array of messages in the conversation */\n   151→  messages: Message[];\n   152→  /** Whether the AI is currently processing */\n   153→  loading: boolean;\n   154→  /** Whether the client is connected to the server */\n   155→  connected: boolean;\n   156→  /** Optional array of suggestion strings to display when chat is empty */\n   157→  suggestions?: string[];\n   158→  /** List of available agents from the server */\n   159→  availableAgents?: AgentInfo[];\n   160→  /** The default agent ID from the server */\n   161→  defaultAgent?: string | null;\n   162→  /** The currently selected agent ID */\n   163→  selectedAgent?: string | null;\n   164→  /** Callback when agent is changed */\n   165→  onAgentChange?: (agentId: string | null) => void;\n   166→}\n   167→\n   168→export interface UseAIProviderProps extends UseAIConfig {\n   169→  children: ReactNode;\n   170→  systemPrompt?: string;\n   171→  CustomButton?: React.ComponentType<FloatingButtonProps> | null;\n   172→  CustomChat?: React.ComponentType<ChatPanelProps> | null;\n   173→  /**\n   174→   * Custom chat repository for message persistence.\n   175→   * Defaults to LocalStorageChatRepository if not provided.\n   176→   */\n   177→  chatRepository?: ChatRepository;\n   178→  /**\n   179→   * Custom error messages for different error codes.\n   180→   * Maps error codes (from server) to user-friendly messages.\n   181→   * Useful for internationalization (i18n).\n   182→   * Partial allows overriding only specific messages.\n   183→   *\n   184→   * @example\n   185→   * ```typescript\n   186→   * errorMessages={{\n   187→   *   API_OVERLOADED: \"Le service IA est actuellement surchargé.\",\n   188→   *   RATE_LIMITED: \"Trop de requêtes.\",\n   189→   *   UNKNOWN_ERROR: \"Une erreur s'est produite.\"\n   190→   * }}\n   191→   * ```\n   192→   */\n   193→  errorMessages?: Partial<ErrorMapping>;\n   194→  /**\n   195→   * Callback to provide HTTP headers for MCP endpoints.\n   196→   * Called each time AI is invoked by use-ai.\n   197→   * Returns a mapping of MCP endpoint patterns to header configurations.\n   198→   *\n   199→   * Patterns can be:\n   200→   * - Constant strings: `https://api.example.com` - Exact match\n   201→   * - Glob patterns: `https://*.meetsmore.com` - Wildcard matching using picomatch\n   202→   *\n   203→   * @example\n   204→   * ```typescript\n   205→   * mcpHeadersProvider={() => ({\n   206→   *   // Exact match\n   207→   *   'https://api.example.com': {\n   208→   *     headers: { 'Authorization': `Bearer ${userToken}` }\n   209→   *   },\n   210→   *   // Wildcard subdomain\n   211→   *   'https://*.meetsmore.com': {\n   212→   *     headers: { 'X-API-Key': apiKey }\n   213→   *   },\n   214→   *   // Multiple wildcards\n   215→   *   '*://*.example.com': {\n   216→   *     headers: { 'X-Custom': 'value' }\n   217→   *   }\n   218→   * })}\n   219→   * ```\n   220→   */\n   221→  mcpHeadersProvider?: () => import('@meetsmore/use-ai-core').McpHeadersMap | Promise<import('@meetsmore/use-ai-core').McpHeadersMap>;\n   222→}\n   223→\n   224→/**\n   225→ * Custom hook for managing chat storage operations.\n   226→ * Encapsulates all chat repository interactions for better separation of concerns.\n   227→ */\n   228→function useChatStorage(repository: ChatRepository) {\n   229→  const saveUserMessage = useCallback(async (\n   230→    chatId: string,\n   231→    message: string\n   232→  ): Promise<boolean> => {\n   233→    try {\n   234→      const chat = await repository.loadChat(chatId);\n   235→\n   236→      if (!chat) {\n   237→        console.error('[ChatStorage] Chat not found:', chatId);\n   238→        return false;\n   239→      }\n   240→\n   241→      chat.messages.push({\n   242→        id: generateMessageId(),\n   243→        role: 'user',\n   244→        content: message,\n   245→        createdAt: new Date(),\n   246→      });\n   247→\n   248→      // Auto-generate title using extracted helper\n   249→      if (!chat.title) {\n   250→        chat.title = generateChatTitle(message);\n   251→      }\n   252→\n   253→      await repository.saveChat(chat);\n   254→      console.log('[ChatStorage] Saved user message to storage');\n   255→      return true;\n   256→    } catch (error) {\n   257→      console.error('[ChatStorage] Failed to save user message:', error);\n   258→      return false;\n   259→    }\n   260→  }, [repository]);\n   261→\n   262→  const saveAIResponse = useCallback(async (\n   263→    chatId: string,\n   264→    content: string,\n   265→    displayMode?: 'default' | 'error'\n   266→  ): Promise<boolean> => {\n   267→    try {\n   268→      const chat = await repository.loadChat(chatId);\n   269→\n   270→      if (!chat) {\n   271→        console.error('[ChatStorage] Chat not found:', chatId);\n   272→        return false;\n   273→      }\n   274→\n   275→      chat.messages.push({\n   276→        id: generateMessageId(),\n   277→        role: 'assistant',\n   278→        content,\n   279→        createdAt: new Date(),\n   280→        displayMode,\n   281→      });\n   282→\n   283→      // Auto-generate title from first user message if not set\n   284→      if (!chat.title) {\n   285→        const firstUserMessage = chat.messages.find(msg => msg.role === 'user');\n   286→        if (firstUserMessage) {\n   287→          chat.title = generateChatTitle(firstUserMessage.content);\n   288→        }\n   289→      }\n   290→\n   291→      await repository.saveChat(chat);\n   292→      console.log('[ChatStorage] Saved AI response to storage for chatId:', chatId);\n   293→      return true;\n   294→    } catch (error) {\n   295→      console.error('[ChatStorage] Failed to save AI response:', error);\n   296→      return false;\n   297→    }\n   298→  }, [repository]);\n   299→\n   300→  const loadChatMessages = useCallback(async (chatId: string): Promise<Message[]> => {\n   301→    try {\n   302→      const chat = await repository.loadChat(chatId);\n   303→\n   304→      if (chat) {\n   305→        const loadedMessages = transformMessagesToUI(chat.messages);\n   306→        console.log('[ChatStorage] Loaded', loadedMessages.length, 'messages from storage for chat:', chatId);\n   307→        return loadedMessages;\n   308→      } else {\n   309→        console.log('[ChatStorage] Chat not found in storage:', chatId);\n   310→        return [];\n   311→      }\n   312→    } catch (error) {\n   313→      console.error('[ChatStorage] Failed to load chat messages:', error);\n   314→      return [];\n   315→    }\n   316→  }, [repository]);\n   317→\n   318→  return {\n   319→    saveUserMessage,\n   320→    saveAIResponse,\n   321→    loadChatMessages,\n   322→  };\n   323→}\n   324→\n   325→/**\n   326→ * Provider component that manages AI client connection and tool registration.\n   327→ * Must wrap all components that use the useAI hook.\n   328→ *\n   329→ * Features:\n   330→ * - Establishes and maintains WebSocket connection to UseAI server\n   331→ * - Aggregates tools from all child useAI hooks\n   332→ * - Handles tool execution requests from the AI\n   333→ * - Provides floating button and chat panel UI\n   334→ *\n   335→ * @param props - Provider configuration and children\n   336→ *\n   337→ * @example\n   338→ * ```typescript\n   339→ * import { UseAIProvider } from '@meetsmore/use-ai-client';\n   340→ *\n   341→ * function App() {\n   342→ *   return (\n   343→ *     <UseAIProvider\n   344→ *       serverUrl=\"wss://your-server.com\"\n   345→ *       systemPrompt=\"You are a helpful assistant for managing todos\"\n   346→ *     >\n   347→ *       <YourApp />\n   348→ *     </UseAIProvider>\n   349→ *   );\n   350→ * }\n   351→ * ```\n   352→ */\n   353→export function UseAIProvider({\n   354→  serverUrl,\n   355→  children,\n   356→  systemPrompt,\n   357→  CustomButton,\n   358→  CustomChat,\n   359→  chatRepository,\n   360→  mcpHeadersProvider,\n   361→  errorMessages: customErrorMessages,\n   362→}: UseAIProviderProps) {\n   363→  const [connected, setConnected] = useState(false);\n   364→  const [isChatOpen, setIsChatOpen] = useState(false);\n   365→  const [messages, setMessages] = useState<Message[]>([]);\n   366→  const [loading, setLoading] = useState(false);\n   367→\n   368→  // Agent selection state\n   369→  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);\n   370→  const [defaultAgent, setDefaultAgent] = useState<string | null>(null);\n   371→  const [selectedAgent, setSelectedAgent] = useState<string | null>(null);\n   372→\n   373→  /**\n   374→   * Current active chat where AI responses are saved.\n   375→   * This is the \"source of truth\" for where new AI messages get persisted.\n   376→   */\n   377→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   378→\n   379→  /**\n   380→   * Chat loaded for viewing but not yet active for AI responses.\n   381→   * Becomes currentChatId when user sends their first message.\n   382→   * This prevents race conditions when AI is still responding to the previous chat.\n   383→   */\n   384→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   385→\n   386→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   387→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   388→  const promptsRef = useRef<Map<string, string>>(new Map());\n   389→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   390→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   391→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   392→\n   393→  /**\n   394→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   395→   * Event handlers are created once during mount and don't see updated state values.\n   396→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   397→   */\n   398→  const currentChatIdSnapshot = useRef<string | null>(null);\n   399→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   400→\n   401→  const clientRef = useRef<UseAIClient | null>(null);\n   402→  const repositoryRef = useRef<ChatRepository>(\n   403→    chatRepository || new LocalStorageChatRepository()\n   404→  );\n   405→\n   406→  // Initialize chat storage hook\n   407→  const chatStorage = useChatStorage(repositoryRef.current);\n   408→\n   409→  // Helper function to load messages from storage for display\n   410→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   411→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   412→    setMessages(loadedMessages);\n   413→  }, [chatStorage]);\n   414→\n   415→  const registerTools = useCallback((\n   416→    id: string,\n   417→    tools: ToolsDefinition,\n   418→    waitForRender?: () => Promise<void>\n   419→  ) => {\n   420→    const existingTools = toolRegistryRef.current.get(id);\n   421→\n   422→    // Always update the ref to capture latest closures\n   423→    toolRegistryRef.current.set(id, tools);\n   424→\n   425→    // Only increment version if tool names changed (added/removed tools)\n   426→    if (existingTools) {\n   427→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   428→      const newKeys = Object.keys(tools).sort().join(',');\n   429→      if (existingKeys !== newKeys) {\n   430→        setToolRegistryVersion(v => v + 1);\n   431→      }\n   432→    } else {\n   433→      // First registration\n   434→      setToolRegistryVersion(v => v + 1);\n   435→    }\n   436→\n   437→    Object.keys(tools).forEach(toolName => {\n   438→      toolOwnershipRef.current.set(toolName, id);\n   439→    });\n   440→\n   441→    if (waitForRender) {\n   442→      renderWaitersRef.current.set(id, waitForRender);\n   443→    }\n   444→  }, []);\n   445→\n   446→  // Helper to build state from all prompts\n   447→  const buildStateFromPrompts = useCallback(() => {\n   448→    const promptParts: string[] = [];\n   449→    if (systemPrompt) {\n   450→      promptParts.push(systemPrompt);\n   451→    }\n   452→    for (const [, prompt] of promptsRef.current.entries()) {\n   453→      if (prompt) {\n   454→        promptParts.push(prompt);\n   455→      }\n   456→    }\n   457→    return promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   458→  }, [systemPrompt]);\n   459→\n   460→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   461→    if (prompt) {\n   462→      promptsRef.current.set(id, prompt);\n   463→    } else {\n   464→      promptsRef.current.delete(id);\n   465→    }\n   466→\n   467→    if (suggestions && suggestions.length > 0) {\n   468→      suggestionsRef.current.set(id, suggestions);\n   469→    } else {\n   470→      suggestionsRef.current.delete(id);\n   471→    }\n   472→\n   473→    // Update client state immediately when prompts change\n   474→    if (clientRef.current) {\n   475→      clientRef.current.updateState(buildStateFromPrompts());\n   476→    }\n   477→  }, [buildStateFromPrompts]);\n   478→\n   479→  const unregisterTools = useCallback((id: string) => {\n   480→    const tools = toolRegistryRef.current.get(id);\n   481→    if (tools) {\n   482→      Object.keys(tools).forEach(toolName => {\n   483→        toolOwnershipRef.current.delete(toolName);\n   484→      });\n   485→    }\n   486→\n   487→    toolRegistryRef.current.delete(id);\n   488→    setToolRegistryVersion(v => v + 1);\n   489→    promptsRef.current.delete(id);\n   490→    suggestionsRef.current.delete(id);\n   491→    renderWaitersRef.current.delete(id);\n   492→  }, []);\n   493→\n   494→  const aggregatedTools = React.useMemo(() => {\n   495→    const tools: ToolsDefinition = {};\n   496→    toolRegistryRef.current.forEach((toolSet) => {\n   497→      Object.assign(tools, toolSet);\n   498→    });\n   499→    return tools;\n   500→  }, [toolRegistryVersion]);\n   501→\n   502→  const aggregatedSuggestions = React.useMemo(() => {\n   503→    const allSuggestions: string[] = [];\n   504→    suggestionsRef.current.forEach((suggestions) => {\n   505→      allSuggestions.push(...suggestions);\n   506→    });\n   507→    return allSuggestions;\n   508→  }, [toolRegistryVersion]);\n   509→\n   510→  const hasTools = toolRegistryRef.current.size > 0;\n   511→  const aggregatedToolsRef = useRef(aggregatedTools);\n   512→  aggregatedToolsRef.current = aggregatedTools;\n   513→\n   514→  // Keep snapshot refs in sync with latest chat IDs\n   515→  useEffect(() => {\n   516→    currentChatIdSnapshot.current = currentChatId;\n   517→  }, [currentChatId]);\n   518→\n   519→  useEffect(() => {\n   520→    pendingChatIdSnapshot.current = pendingChatId;\n   521→  }, [pendingChatId]);\n   522→\n   523→  /**\n   524→   * Handles saving AI response to storage and updating UI.\n   525→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   526→   */\n   527→  const handleAIResponse = useCallback(async (content: string, displayMode?: 'default' | 'error') => {\n   528→    const currentChatIdValue = currentChatIdSnapshot.current;\n   529→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   530→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   531→\n   532→    if (!currentChatIdValue) {\n   533→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   534→      return;\n   535→    }\n   536→\n   537→    // Save AI response to storage\n