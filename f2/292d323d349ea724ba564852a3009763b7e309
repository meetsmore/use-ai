  onClick={() => handleLoadChat(chat.id)}\n   427→                    style={{\n   428→                      padding: '10px 12px',\n   429→                      marginBottom: '4px',\n   430→                      background: currentChatId === chat.id ? '#f0f0ff' : 'transparent',\n   431→                      borderRadius: '6px',\n   432→                      cursor: 'pointer',\n   433→                      transition: 'background 0.15s',\n   434→                    }}\n   435→                    onMouseEnter={(e: React.MouseEvent<HTMLDivElement>) => {\n   436→                      if (currentChatId !== chat.id) {\n   437→                        e.currentTarget.style.background = '#f9fafb';\n   438→                      }\n   439→                    }}\n   440→                    onMouseLeave={(e: React.MouseEvent<HTMLDivElement>) => {\n   441→                      if (currentChatId !== chat.id) {\n   442→                        e.currentTarget.style.background = 'transparent';\n   443→                      }\n   444→                    }}\n   445→                  >\n   446→                    <div style={{ fontSize: '13px', fontWeight: '500', color: '#1f2937', marginBottom: '4px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n   447→                      {chat.title || 'New Chat'}\n   448→                    </div>\n   449→                    <div style={{ fontSize: '11px', color: '#6b7280' }}>\n   450→                      {new Date(chat.updatedAt).toLocaleDateString([], { month: 'short', day: 'numeric' })}\n   451→                      {currentChatId === chat.id && (\n   452→                        <span style={{\n   453→                          marginLeft: '8px',\n   454→                          color: '#667eea',\n   455→                          fontWeight: '600',\n   456→                        }}>\n   457→                          • Active\n   458→                        </span>\n   459→                      )}\n   460→             