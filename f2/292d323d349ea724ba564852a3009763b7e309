          "type": "user",
          "text": "     1→import { io, Socket } from 'socket.io-client';\n     2→import { EventType } from '@meetsmore/use-ai-core';\n     3→import type {\n     4→  ToolDefinition,\n     5→  Message,\n     6→  RunAgentInput,\n     7→  AGUIEvent,\n     8→  TextMessageStartEvent,\n     9→  TextMessageContentEvent,\n    10→  ToolCallStartEvent,\n    11→  ToolCallArgsEvent,\n    12→  ToolCallEndEvent,\n    13→  UseAIClientMessage,\n    14→  ToolResultMessage,\n    15→  McpHeadersMap,\n    16→  AgentInfo,\n    17→} from './types';\n    18→import { v4 as uuidv4 } from 'uuid';\n    19→\n    20→/**\n    21→ * Handler for AG-UI events from the server.\n    22→ */\n    23→export type AGUIEventHandler = (event: AGUIEvent) => void;\n    24→\n    25→/**\n    26→ * Simplified message handler for text responses.\n    27→ */\n    28→export type MessageHandler = (content: string) => void;\n    29→\n    30→/**\n    31→ * Tool call handler that receives the tool name, arguments, and a callback to send the result.\n    32→ */\n    33→export type ToolCallHandler = (\n    34→  toolCallId: string,\n    35→  toolName: string,\n    36→  args: Record<string, unknown>\n    37→) => void;\n    38→\n    39→/**\n    40→ * Tool call structure for assistant messages\n    41→ */\n    42→type MessageToolCall = {\n    43→  id: string;\n    44→  type: 'function';\n    45→  function: {\n    46→    name: string;\n    47→    arguments: string;\n    48→  };\n    49→};\n    50→\n    51→/**\n    52→ * Assistant message with optional tool calls\n    53→ */\n    54→type AssistantMessageWithTools = Message & {\n    55→  role: 'assistant';\n    56→  toolCalls?: MessageToolCall[];\n    57→};\n    58→\n    59→/**\n    60→ * Tool result message\n    61→ */\n    62→type ToolResultMessageData = Message & {\n    63→  role: 'tool';\n    64→  toolCallId: string;\n    65→};\n    66→\n    67→/**\n    68→ * Socket.IO client for communicating with the UseAI server.\n    69→ * Uses the AG-UI protocol (https://docs.ag-ui.com/), so will be compatible with other AG-UI compliant servers.\n    70→ *\n    71→ * Handles:\n    72→ * - Connection management and automatic reconnection\n    73→ * - Sending RunAgentInput messages to server\n    74→ * - Parsing AG-UI event streams from server\n    75→ * - Tool execution coordination\n    76→ *\n    77→ * You probably don't need to use this directly, instead use {@link UseAIProvider}.\n    78→ */\n    79→export class UseAIClient {\n    80→  private socket: Socket | null = null;\n    81→  private eventHandlers: Map<string, AGUIEventHandler> = new Map();\n    82→  private reconnectAttempts = 0;\n    83→  private maxReconnectAttempts = 5;\n    84→  private reconnectDelay = 1000;\n    85→\n    86→  // Session state\n    87→  private _threadId: string | null = null;\n    88→  private _tools: ToolDefinition[] = [];\n    89→  private _messages: Message[] = [];\n    90→  private _state: unknown = null;\n    91→\n    92→  // MCP headers provider\n    93→  private mcpHeadersProvider?: () => McpHeadersMap | Promise<McpHeadersMap>;\n    94→\n    95→  // Agent selection\n    96→  private _availableAgents: AgentInfo[] = [];\n    97→  private _defaultAgent: string | null = null;\n    98→  private _selectedAgent: string | null = null;\n    99→  private agentsChangeHandlers: Set<(agents: AgentInfo[], defaultAgent: string | null) => void> = new Set();\n   100→\n   101→  // Text message assembly\n   102→  private _currentMessageId: string | null = null;\n   103→  private _currentMessageContent: string = '';\n   104→\n   105→  // Assistant message assembly (for tracking full conversation history)\n   106→  private _currentAssistantMessage: { id: string; role: 'assistant'; content: string } | null = null;\n   107→  private _currentAssistantToolCalls: Array<{ id: string; type: 'function'; function: { name: string; arguments: string } }> = [];\n   108→\n   109→  // Tool call assembly\n   110→  private currentToolCalls: Map<string, {\n   111→    name: string;\n   112→    args: string;\n   113→  }> = new Map();\n   114→\n   115→  /**\n   116→   * Creates a new UseAI client instance.\n   117→   *\n   118→   * @param serverUrl - The WebSocket URL of the UseAI server\n   119→   */\n   120→  constructor(private serverUrl: string) {}\n   121→\n   122→  /**\n   123→   * Establishes a Socket.IO connection to the server.\n   124→   * Automatically sets up reconnection logic on disconnect.\n   125→   *\n   126→   * @returns Promise that resolves when connected\n   127→   * @throws Error if connection fails\n   128→   */\n   129→  connect(): Promise<void> {\n   130→    return new Promise((resolve, reject) => {\n   131→      try {\n   132→        this.socket = io(this.serverUrl, {\n   133→          transports: ['polling', 'websocket'],\n   134→          reconnection: true,\n   135→          reconnectionAttempts: this.maxReconnectAttempts,\n   136→          reconnectionDelay: this.reconnectDelay,\n   137→        });\n   138→\n   139→        this.socket.on('connect', () => {\n   140→          console.log('Connected to UseAI server');\n   141→          console.log('Transport:', this.socket?.io?.engine?.transport?.name);\n   142→          this.reconnectAttempts = 0;\n   143→\n   144→          // Listen for transport upgrades (only if engine is available)\n   145→          const engine = this.socket?.io?.engine;\n   146→          if (engine) {\n   147→            engine.on('upgrade', (transport: { name: string }) => {\n   148→              console.log('🚀 Upgraded to transport:', transport.name);\n   149→            });\n   150→\n   151→            engine.on('upgradeError', (err: { message: string }) => {\n   152→              console.warn('⚠️  Upgrade error:', err.message);\n   153→            });\n   154→          }\n   155→\n   156→          resolve();\n   157→        });\n   158→\n   159→        this.socket.on('event', (aguiEvent: AGUIEvent) => {\n   160→          try {\n   161→            console.log('[Client] Received event:', aguiEvent.type);\n   162→            this.handleEvent(aguiEvent);\n   163→          } catch (error) {\n   164→            console.error('Error handling event:', error);\n   165→          }\n   166→        });\n   167→\n   168→        // Listen for available agents from server\n   169→        this.socket.on('agents', (data: { agents: AgentInfo[]; defaultAgent: string }) => {\n   170→          console.log('[Client] Received available agents:', data);\n   171→          this._availableAgents = data.agents;\n   172→          this._defaultAgent = data.defaultAgent;\n   173→          // Notify listeners\n   174→          this.agentsChangeHandlers.forEach(handler => handler(data.agents, data.defaultAgent));\n   175→        });\n   176→\n   177→        this.socket.on('connect_error', (error) => {\n   178→          console.error('Socket.IO connection error:', error);\n   179→          reject(error);\n   180→        });\n   181→\n   182→        this.socket.on('disconnect', (reason) => {\n   183→          console.log('Disconnected from UseAI server:', reason);\n   184→        });\n   185→      } catch (error) {\n   186→        reject(error);\n   187→      }\n   188→    });\n   189→  }\n   190→\n   191→\n   192→  private handleEvent(event: AGUIEvent) {\n   193→    // Track assistant message lifecycle for conversation history\n   194→    if (event.type === EventType.RUN_STARTED) {\n   195→      // Start of a new assistant response - initialize message\n   196→      this._currentAssistantMessage = {\n   197→        id: uuidv4(),\n   198→        role: 'assistant' as const,\n   199→        content: '',\n   200→      };\n   201→      this._currentAssistantToolCalls = [];\n   202→    }\n   203→\n   204→    // Handle text message streaming\n   205→    if (event.type === EventType.TEXT_MESSAGE_START) {\n   206→      const e = event as TextMessageStartEvent;\n   207→      this._currentMessageId = e.messageId;\n   208→      this._currentMessageContent = '';\n   209→    } else if (event.type === EventType.TEXT_MESSAGE_CONTENT) {\n   210→      const e = event as TextMessageContentEvent;\n   211→      this._currentMessageContent += e.delta;\n   212→    } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   213→      // Message complete - store content in assistant message\n   214→      if (this._currentAssistantMessage) {\n   215→        this._currentAssistantMessage.content = this._currentMessageContent;\n   216→      }\n   217→      this._currentMessageId = null;\n   218→    }\n   219→\n   220→    // Handle tool call streaming\n   221→    else if (event.type === EventType.TOOL_CALL_START) {\n   222→      const e = event as ToolCallStartEvent;\n   223→      this.currentToolCalls.set(e.toolCallId, {\n   224→        name: e.toolCallName,\n   225→        args: '',\n   226→      });\n   227→    } else if (event.type === EventType.TOOL_CALL_ARGS) {\n   228→      const e = event as ToolCallArgsEvent;\n   229→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   230→      if (toolCall) {\n   231→        toolCall.args += e.delta;\n   232→      }\n   233→    } else if (event.type === EventType.TOOL_CALL_END) {\n   234→      // Tool call args complete - add to assistant message\n   235→      const e = event as ToolCallEndEvent;\n   236→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   237→      if (toolCall) {\n   238→        this._currentAssistantToolCalls.push({\n   239→          id: e.toolCallId,\n   240→          type: 'function',\n   241→          function: {\n   242→            name: toolCall.name,\n   243→            arguments: toolCall.args,\n   244→          },\n   245→        });\n   246→      }\n   247→    }\n   248→\n   249→    // Handle run completion - finalize assistant message\n   250→    else if (event.type === EventType.RUN_FINISHED) {\n   251→      // Add completed assistant message to conversation history\n   252→      if (this._currentAssistantMessage) {\n   253→        const assistantMessage: AssistantMessageWithTools = 