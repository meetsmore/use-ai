ipRef = useRef<Map<string, string>>(new Map());\n   392→\n   393→  /**\n   394→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   395→   * Event handlers are created once during mount and don't see updated state values.\n   396→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   397→   */\n   398→  const currentChatIdSnapshot = useRef<string | null>(null);\n   399→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   400→\n   401→  const clientRef = useRef<UseAIClient | null>(null);\n   402→  const repositoryRef = useRef<ChatRepository>(\n   403→    chatRepository || new LocalStorageChatRepository()\n   404→  );\n   405→\n   406→  // Initialize chat storage hook\n   407→  const chatStorage = useChatStorage(repositoryRef.current);\n   408→\n   409→  // Helper function to load messages from storage for display\n   410→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   411→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   412→    setMessages(loadedMessages);\n   413→  }, [chatStorage]);\n   414→\n   415→  const registerTools = useCallback((\n   416→    id: string,\n   417→    tools: ToolsDefinition,\n   418→    waitForRender?: () => Promise<void>\n   419→  ) => {\n   420→    const existingTools = toolRegistryRef.current.get(id);\n   421→\n   422→    // Always update the ref to capture latest closures\n   423→    toolRegistryRef.current.set(id, tools);\n   424→\n   425→    // Only increment version if tool names changed (added/removed tools)\n   426→    if (existingTools) {\n   427→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   428→      const newKeys = Object.keys(tools).sort().join(',');\n   429→      if (existingKeys !== newKeys) {\n   430→        setToolRegistryVersion(v => v + 1);\n   431→      }\n   432→    } else {\n   433→      // First registration\n   434→      setToolRegistryVersion(v => v + 1);\n   435→    }\n   436→\n   437→    Object.keys(tools).forEach(toolName => {\n   438→      toolOwnershipRef.current.set(toolName, id);\n   439→    });\n   440→\n   441→    if (waitForRender) {\n   442→      renderWaitersRef.current.set(id, waitForRender);\n   443→    }\n   444→  }, []);\n   445→\n   446→  // Helper to build state from all prompts\n   447→  const buildStateFromPrompts = useCallback(() => {\n   448→    const promptParts: string[] = [];\n   449→    if (systemPrompt) {\n   450→      promptParts.push(systemPrompt);\n   451→    }\n   452→    for (const [, prompt] of promptsRef.current.entries()) {\n   453→      if (prompt) {\n   454→        promptParts.push(prompt);\n   455→      }\n   456→    }\n   457→    return promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   458→  }, [systemPrompt]);\n   459→\n   460→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   461→    if (prompt) {\n   462→      promptsRef.current.set(id, prompt);\n   463→    } else {\n   464→      promptsRef.current.delete(id);\n   465→    }\n   466→\n   467→    if (suggestions && suggestions.length > 0) {\n   468→      suggestionsRef.current.set(id, suggestions);\n   469→    } else {\n   470→      suggestionsRef.current.delete(id);\n   471→    }\n   472→\n   473→    // Update client state immediately when prompts change\n   474→    if (clientRef.current) {\n   475→      clientRef.current.updateState(buildStateFromPrompts());\n   476→    }\n   477→  }, [buildStateFromPrompts]);\n   478→\n   479→  const unregisterTools = useCallback((id: string) => {\n   480→    const tools = toolRegistryRef.current.get(id);\n   481→    if (tools) {\n   482→      Object.keys(tools).forEach(toolName => {\n   483→        toolOwnershipRef.current.delete(toolName);\n   484→      });\n   485→    }\n   486→\n   487→    toolRegistryRef.current.delete(id);\n   488→    setToolRegistryVersion(v => v + 1);\n   489→    promptsRef.current.delete(id);\n   490→    suggestionsRef.current.delete(id);\n   491→    renderWaitersRef.current.delete(id);\n   492→  }, []);\n   493→\n   494→  const aggregatedTools = React.useMemo(() => {\n   495→    const tools: ToolsDefinition = {};\n   496→    toolRegistryRef.current.forEach((toolSet) => {\n   497→      Object.assign(tools, toolSet);\n   498→    });\n   499→    return tools;\n   500→  }, [toolRegistryVersion]);\n   501→\n   502→  const aggregatedSuggestions = React.useMemo(() => {\n   503→    const allSuggestions: string[] = [];\n   504→    suggestionsRef.current.forEach((suggestions) => {\n   505→      allSuggestions.push(...suggestions);\n   506→    });\n   507→    return allSuggestions;\n   508→  }, [toolRegistryVersion]);\n   509→\n   510→  const hasTools = toolRegistryRef.current.size > 0;\n   511→  const aggregatedToolsRef = useRef(aggregatedTools);\n   512→  aggregatedToolsRef.current = aggregatedTools;\n   513→\n   514→  // Keep snapshot refs in sync with latest chat IDs\n   515→  useEffect(() => {\n   516→    currentChatIdSnapshot.current = currentChatId;\n   517→  }, [currentChatId]);\n   518→\n   519→  useEffect(() => {\n   520→    pendingChatIdSnapshot.current = pendingChatId;\n   521→  }, [pendingChatId]);\n   522→\n   523→  /**\n   524→   * Handles saving AI response to storage and updating UI.\n   525→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   526→   */\n   527→  const handleAIResponse = useCallback(async (content: string, displayMode?: 'default' | 'error') => {\n   528→    const currentChatIdValue = currentChatIdSnapshot.current;\n   529→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   530→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   531→\n   532→    if (!currentChatIdValue) {\n   533→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   534→      return;\n   535→    }\n   536→\n   537→    // Save AI response to storage\n   538→    const saved = await chatStorage.saveAIResponse(currentChatIdValue, content, displayMode);\n   539→\n   540→    // Reload UI if save was successful and user is viewing this chat\n   541→    if (saved && displayedChatId === currentChatIdValue) {\n   542→      await loadMessagesFromStorage(currentChatIdValue);\n   543→    }\n   544→  }, [chatStorage, loadMessagesFromStorage]);\n   545→\n   546→  useEffect(() => {\n   547→    console.log('[UseAIProvider] Initializing client with serverUrl:', serverUrl);\n   548→    const client = new UseAIClient(serverUrl);\n   549→\n   550→    // Set MCP headers provider if provided\n   551→    if (mcpHeadersProvider) {\n   552→      client.setMcpHeadersProvider(mcpHeadersProvider);\n   553→    }\n   554→\n   555→    console.log('[UseAIProvider] Attempting to connect...');\n   556→    client.connect()\n   557→      .then(() => {\n   558→        console.log('[UseAIProvider] Connected successfully!');\n   559→        setConnected(true);\n   560→      })\n   561→      .catch((err) => {\n   562→        console.error('[UseAIProvider] Failed to connect client:', err);\n   563→        setConnected(false);\n   564→      });\n   565→\n   566→    // Subscribe to agent changes from server\n   567→    const unsubscribeAgents = client.onAgentsChange((agents, defaultAgentId) => {\n   568→      console.log('[UseAIProvider] Received agents:', agents, 'default:', defaultAgentId);\n   569→      setAvailableAgents(agents);\n   570→      setDefaultAgent(defaultAgentId);\n   571→    });\n   572→\n   573→    const unsubscribe = client.onEvent('globalChat', async (event: AGUIEvent) => {\n   574→      if (event.type === EventType.TOOL_CALL_END) {\n   575→        const toolCallEnd = event as ToolCallEndEvent;\n   576→        const toolCallId = toolCallEnd.toolCallId;\n   577→\n   578→        // Get the accumulated tool call data\n   579→        const toolCallData = client['currentToolCalls'].get(toolCallId);\n   580→        if (!toolCallData) {\n   581→          console.error(`[Provider] Tool call ${toolCallId} not found`);\n   582→          return;\n   583→        }\n   584→\n   585→        const name = toolCallData.name;\n   586→        const input = JSON.parse(toolCallData.args);\n   587→\n   588→        // Check if this tool belongs to a useAI hook (not a workflow)\n   589→        // If the tool doesn't exist in our aggregated tools, it's a workflow tool\n   590→        // and will be handled by useAIWorkflow's event listener\n   591→        if (!aggregatedToolsRef.current[name]) {\n   592→          console.log(`[Provider] Tool \"${name}\" not found in useAI tools, skipping (likely a workflow tool)`);\n   593→          return;\n   594→        }\n   595→\n   596→        try {\n   597→          const ownerId = toolOwnershipRef.current.get(name);\n   598→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   599→\n   600→          let renderPromise: Promise<void> | undefined;\n   601→          if (ownerId) {\n   602→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   603→            if (waitForRender) {\n   604→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   605→              renderPromise = waitForRender();\n   606→            }\n   607→          }\n   608→\n   609→          console.log('[useAI] Executing tool...');\n   610→          const result = await executeDefinedTool(aggregatedToolsRef.current, name, input);\n   611→\n   612→          // Check if result indicates an error - if so, skip render wait\n   613→          // Error results typically don't trigger state changes/re-renders\n   614→          const isErrorResult = result && typeof result === 'object' &&\n   615→            ('error' in result || (result as any).success === false);\n   616→\n   617→          if (renderPromise && !isErrorResult) {\n   618→            console.log('[useAI] Tool executed successfully, waiting for render...');\n   619→            await renderPromise;\n   620→            console.log('[useAI] Render complete');\n   621→          } else if (isErrorResult) {\n   622→            console.log('[useAI] Tool returned error, skipping render wait');\n   623→          } else {\n   624→            console.log('[useAI] No render to wait for');\n   625→          }\n   626→\n   627→          // Build updated state\n   628→          let updatedState: unknown = null;\n   629→          if (ownerId) {\n   630→            const prompt = promptsRef.current.get(ownerId);\n   631→            if (prompt) {\n   632→              updatedState = { context: prompt };\n   633→              console.log(`[useAI] Updated state from ${ownerId}`);\n   634→            }\n   635→          }\n   636→\n   637→          client.sendToolResponse(toolCallId, result, updatedState);\n   638→        } catch (err) {\n   639→          console.error('Tool execution error:', err);\n   640→          client.sendToolResponse(toolCallId, {\n   641→            error: err instanceof Error ? err.message : 'Unknown error',\n   642→          });\n   643→        }\n   644→      } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   645→        const content = client.currentMessageContent;\n   646→        if (content) {\n   647→          console.log('[Provider] Received text message:', content.substring(0, 100));\n   648→          handleAIResponse(content); // Fire-and-forget is intentional here\n   649→          setLoading(false);\n   650→        }\n   651→      } else if (event.type === EventType.RUN_ERROR) {\n   652→        const errorEvent = event as RunErrorEvent;\n   653→        const errorCode = errorEvent.message as ErrorCode;\n   654→        console.error('[Provider] Run error:', errorCode);\n   655→\n   656→        // Default error messages (can be overridden via props for i18n)\n   657→        const defaultErrorMessages: ErrorMapping = {\n   658→          [ErrorCode.API_OVERLOADED]: 'The AI service is currently experiencing high demand. Please try again in a moment.',\n   659→          [ErrorCode.RATE_LIMITED]: 'Too many requests. Please wait a moment before trying again.',\n   660→          [ErrorCode.UNKNOWN_ERROR]: 'An unexpected error occurred. Please try again.',\n   661→        };\n   662→\n   663→        // Use custom messages if provided, otherwise fall back to defaults\n   664→        // Filter out undefined values from custom messages\n   665→        const filteredCustomMessages = customErrorMessages\n   666→          ? Object.fromEntries(\n   667→              Object.entries(customErrorMessages).filter(([_, value]) => value !== undefined)\n   668→            ) as Partial<ErrorMapping>\n   669→          : {};\n   670→        const errorMessages: ErrorMapping = { ...defaultErrorMessages, ...filteredCustomMessages };\n   671→        const userMessage = errorMessages[errorCode] || errorMessages[ErrorCode.UNKNOWN_ERROR];\n   672→\n   673→        // Display error message in chat UI with error styling\n   674→        handleAIResponse(userMessage, 'error'); // Fire-and-forget is intentional here\n   675→\n   676→        setLoading(false);\n   677→      }\n   678→    });\n   679→\n   680→    clientRef.current = client;\n   681→\n   682→    return () => {\n   683→      unsubscribe();\n   684→      unsubscribeAgents();\n   685→      client.disconnect();\n   686→      setConnected(false);\n   687→    };\n   688→  }, [serverUrl]);\n   689→\n   690→  // Update MCP headers provider when it changes\n   691→  useEffect(() => {\n   692→    const client = clientRef.current;\n   693→    if (!client) return;\n   694→\n   695→    if (mcpHeadersProvider) {\n   696→      client.setMcpHeadersProvider(mcpHeadersProvider);\n   697→    }\n   698→  }, [mcpHeadersProvider]);\n   699→\n   700→  const lastRegisteredToolsRef = useRef<string>('');\n   701→\n   702→  useEffect(() => {\n   703→    const client = clientRef.current;\n   704→    if (!client || !client.isConnected() || !hasTools) return;\n   705→\n   706→    const toolKeys = Object.keys(aggregatedTools).sort().join(',');\n   707→    if (toolKeys === lastRegisteredToolsRef.current) {\n   708→      console.log('[Provider] Skipping re-registration, tools unchanged');\n   709→      return;\n   710→    }\n   711→\n   712→    lastRegisteredToolsRef.current = toolKeys;\n   713→    console.log('[Provider] Registering tools:', toolKeys);\n   714→\n   715→    try {\n   716→      const toolDefinitions = convertToolsToDefinitions(aggregatedTools);\n   717→      console.log(`[Provider] Registering ${toolDefinitions.length} tools`);\n   718→      // Only register tools here - state is updated separately via updatePrompt\n   719→      client.registerTools(toolDefinitions);\n   720→    } catch (err) {\n   721→      console.error('Failed to register tools:', err);\n   722→    }\n   723→  }, [hasTools, aggregatedTools, connected]);\n   724→\n   725→  // Chat management functions\n   726→  const createNewChat = useCallback(async (): Promise<string> => {\n   727→    console.log('[Provider] createNewChat called - currentChatId:', currentChatId, 'pendingChatId:', pendingChatId, 'messages.length:', messages.length);\n   728→\n   729→    // If we already have a pending blank chat, don't create another one\n   730→    if (pendingChatId && messages.length === 0) {\n   731→      console.log('[Provider] Pending chat is already blank, not creating new chat');\n   732→      return pendingChatId;\n   733→    }\n   734→\n   735→    // If current chat is already blank (and no pending chat), don't create a new one\n   736→    if (currentChatId && !pendingChatId && messages.length === 0) {\n   737→      console.log('[Provider] Current chat is already blank, not creating new chat');\n   738→      return currentChatId;\n   739→    }\n   740→\n   741→    console.log('[Provider] Creating new chat...');\n   742→    const repository = repositoryRef.current;\n   743→    const chatId = await repository.createChat();\n   744→\n   745→    // Set as pending - don't switch currentChatId until user sends a message\n   746→    setPendingChatId(chatId);\n   747→    setMessages([]); // Clear messages for the new blank chat\n   748→\n   749→    // Set threadId to new chatId to ensure clean conversation state\n   750→    if (clientRef.current) {\n   751→      clientRef.current.setThreadId(chatId);\n   752→      console.log('[Provider] Set threadId to new chatId:', chatId);\n   753→    }\n   754→\n   755→    console.log('[Provider] Created pending chat:', chatId, '(will activate on first message)');\n   756→    return chatId;\n   757→  }, [currentChatId, pendingChatId, messages]);\n   758→\n   759→  const loadChat = useCallback(async (chatId: string): Promise<void> => {\n   760→    // Set as pending chat - don't activate until user sends a message\n   761→    // This prevents race condition if AI is still responding to current chat\n   762→    setPendingChatId(chatId);\n   763→\n   764→    // Load messages from storage for display\n   765→    await loadMessagesFromStorage(chatId);\n   766→\n   767→    // Set threadId to chatId to ensure server recognizes this as a different conversation\n   768→    // This clears conversation state on the client and signals the server to clear history\n   769→    if (clientRef.current) {\n   770→      clientRef.current.setThreadId(chatId);\n   771→      console.log('[Provider] Set threadId to chatId:', chatId);\n   772→    }\n   773→\n   774→    console.log('[Provider] Loaded pending chat:', chatId, '(will activate on first message)');\n   775→  }, [loadMessagesFromStorage]);\n   776→\n   777→  const deleteChat = useCallback(async (chatId: string): Promise<void> => {\n   778→    const repository = repositoryRef.current;\n   779→    await repository.deleteChat(chatId);\n   780→\n   781→    // Clear current chat if it's the one being deleted\n   782→    if (currentChatId === chatId) {\n   783→      setCurrentChatId(null);\n   784→      setMessages([]);\n   785→    }\n   786→\n   787→    // Clear pend