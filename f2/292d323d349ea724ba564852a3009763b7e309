          "text": "     1→// Import and re-export AG-UI core types\n     2→import type {\n     3→  Tool,\n     4→  Message,\n     5→  Context,\n     6→  RunAgentInput,\n     7→  State,\n     8→  // Lifecycle events\n     9→  RunStartedEvent,\n    10→  RunFinishedEvent,\n    11→  RunErrorEvent,\n    12→  StepStartedEvent,\n    13→  StepFinishedEvent,\n    14→  // Text message events\n    15→  TextMessageStartEvent,\n    16→  TextMessageContentEvent,\n    17→  TextMessageEndEvent,\n    18→  TextMessageChunkEvent,\n    19→  // Tool call events\n    20→  ToolCallStartEvent,\n    21→  ToolCallArgsEvent,\n    22→  ToolCallEndEvent,\n    23→  ToolCallChunkEvent,\n    24→  ToolCallResultEvent,\n    25→  // State events\n    26→  StateSnapshotEvent,\n    27→  StateDeltaEvent,\n    28→  MessagesSnapshotEvent,\n    29→  // Special events\n    30→  RawEvent,\n    31→  CustomEvent,\n    32→  // Activity events\n    33→  ActivitySnapshotEvent,\n    34→  ActivityDeltaEvent,\n    35→} from '@ag-ui/core';\n    36→\n    37→/**\n    38→ * Error codes sent from server to client.\n    39→ * Used to identify specific error types for proper handling and messaging.\n    40→ */\n    41→export enum ErrorCode {\n    42→  /** Error when AI API is experiencing high load (HTTP 529) */\n    43→  API_OVERLOADED = 'API_OVERLOADED',\n    44→  /** Error when rate limit is exceeded (HTTP 429) */\n    45→  RATE_LIMITED = 'RATE_LIMITED',\n    46→  /** Generic error for unknown or unexpected errors */\n    47→  UNKNOWN_ERROR = 'UNKNOWN_ERROR',\n    48→}\n    49→\n    50→export type {\n    51→  Tool,\n    52→  Message,\n    53→  Context,\n    54→  RunAgentInput,\n    55→  State,\n    56→  RunStartedEvent,\n    57→  RunFinishedEvent,\n    58→  RunErrorEvent,\n    59→  StepStartedEvent,\n    60→  StepFinishedEvent,\n    61→  TextMessageStartEvent,\n    62→  TextMessageContentEvent,\n    63→  TextMessageEndEvent,\n    64→  TextMessageChunkEvent,\n    65→  ToolCallStartEvent,\n    66→  ToolCallArgsEvent,\n    67→  ToolCallEndEvent,\n    68→  ToolCallChunkEvent,\n    69→  ToolCallResultEvent,\n    70→  StateSnapshotEvent,\n    71→  StateDeltaEvent,\n    72→  MessagesSnapshotEvent,\n    73→  RawEvent,\n    74→  CustomEvent,\n    75→  ActivitySnapshotEvent,\n    76→  ActivityDeltaEvent,\n    77→};\n    78→\n    79→/**\n    80→ * Extended tool definition with use-ai specific features.\n    81→ * Extends AG-UI Tool type with confirmationRequired flag.\n    82→ */\n    83→export interface ToolDefinition {\n    84→  /** The unique name of the tool */\n    85→  name: string;\n    86→  /** Human-readable description of what the tool does */\n    87→  description: string;\n    88→  /** JSON Schema describing the tool's input parameters */\n    89→  parameters: {\n    90→    type: 'object';\n    91→    properties: Record<string, unknown>;\n    92→    required?: string[];\n    93→  };\n    94→  /** Whether the tool requires explicit user confirmation before execution */\n    95→  confirmationRequired?: boolean;\n    96→}\n    97→\n    98→/**\n    99→ * Base interface for all messages sent from client to server over WebSocket.\n   100→ * Uses AG-UI RunAgentInput format for agent execution.\n   101→ */\n   102→export interface ClientMessage {\n   103→  /** The type of message being sent */\n   104→  type: 'run_agent' | 'tool_result' | 'abort_run';\n   105→  /** The message payload */\n   106→  data: unknown;\n   107→}\n   108→\n   109→/**\n   110→ * Message sent from client to server to run the agent.\n   111→ * Includes tools, messages, and state using AG-UI RunAgentInput format.\n   112→ */\n   113→export interface RunAgentMessage {\n   114→  type: 'run_agent';\n   115→  data: RunAgentInput;\n   116→}\n   117→\n   118→/**\n   119→ * Message sent from client to server with the result of a tool execution.\n   120→ * This maps to AG-UI ToolCallResultEvent.\n   121→ */\n   122→export interface ToolResultMessage {\n   123→  type: 'tool_result';\n   124→  data: {\n   125→    /** Message ID for the tool result */\n   126→    messageId: string;\n   127→    /** The unique ID of the tool call being responded to */\n   128→    toolCallId: string;\n   129→    /** The result content (stringified) */\n   130→    content: string;\n   131→    /** Role is always 'tool' for tool results */\n   132→    role: 'tool';\n   133→  };\n   134→}\n   135→\n   136→/**\n   137→ * Message sent from client to server to abort a running agent execution.\n   138→ */\n   139→export interface AbortRunMessage {\n   140→  type: 'abort_run';\n   141→  data: {\n   142→    /** Run ID to abort */\n   143→    runId: string;\n   144→  };\n   145→}\n   146→\n   147→/**\n   148→ * AG-UI event type - all events from server to client.\n   149→ * Server emits AG-UI standard events.\n   150→ */\n   151→export type AGUIEvent =\n   152→  | RunStartedEvent\n   153→  | RunFinishedEvent\n   154→  | RunErrorEvent\n   155→  | StepStartedEvent\n   156→  | StepFinishedEvent\n   157→  | TextMessageStartEvent\n   158→  | TextMessageContentEvent\n   159→  | TextMessageEndEvent\n   160→  | TextMessageChunkEvent\n   161→  | ToolCallStartEvent\n   162→  | ToolCallArgsEvent\n   163→  | ToolCallEndEvent\n   164→  | ToolCallChunkEvent\n   165→  | ToolCallResultEvent\n   166→  | StateSnapshotEvent\n   167→  | StateDeltaEvent\n   168→  | MessagesSnapshotEvent\n   169→  | ActivitySnapshotEvent\n   170→  | ActivityDeltaEvent\n   171→  | RawEvent\n   172→  | CustomEvent;\n   173→\n   174→// Export EventType enum separately to avoid conflicts\n   175→export { EventType } from '@ag-ui/core';\n   176→\n   177→// ============================================================================\n   178→// use-ai Extensions\n   179→// ============================================================================\n   180→// The following types are use-ai-specific extensions and are NOT part of the\n   181→// AG-UI protocol. They provide additional functionality (like headless workflows)\n   182→// while keeping the core AG-UI protocol pure and compliant.\n   183→\n   184→/**\n   185→ * HTTP headers configuration for a single MCP endpoint.\n   186→ * Can be used for authentication, custom headers, or any HTTP header needs.\n   187→ */\n   188→export interface McpHeadersConfig {\n   189→  /** HTTP headers to send to the MCP endpoint */\n   190→  headers: Record<string, string>;\n   191→}\n   192→\n   193→/**\n   194→ * Information about an available agent on the server.\n   195→ */\n   196→export interface AgentInfo {\n   197→  /** The unique identifier/key for this agent */\n   198→  id: string;\n   199→  /** Human-readable name of the agent */\n   200→  name: string;\n   201→}\n   202→\n   203→/**\n   204→ * Extended forwardedProps type for use-ai protocol.\n   205→ * Uses AG-UI's forwardedProps extension point for use-ai specific features.\n   206→ */\n   207→export interface UseAIForwardedProps {\n   208→  /** MCP headers configuration for MCP endpoint authentication */\n   209→  mcpHeaders?: McpHeadersMap;\n   210→  /** Agent ID to use for this request (falls back to server default if not specified) */\n   211→  agent?: string;\n   212→}\n   213→\n   214→/**\n   215→ * Mapping of MCP endpoint patterns to HTTP headers configurations.\n   216→ * Patterns can be:\n   217→ * - Constant strings: `'https://api.example.com'` - Exact match\n   218→ * - Glob patterns: `'https://*.meetsmore.com'` - Wildcard matching using picomatch\n   219→ *\n   220→ * @example\n   221→ * ```typescript\n   222→ * {\n   223→ *   // Exact match\n   224→ *   'https://api.example.com': {\n   225→ *     headers: { 'Authorization': 'Bearer token123' }\n   226→ *   },\n   227→ *   // Wildcard subdomain\n   228→ *   'https://*.meetsmore.com': {\n   229→ *     headers: { 'X-API-Key': 'key456' }\n   230→ *   },\n   231→ *   // Multiple wildcards\n   232→ *   '*://*.example.com': {\n   233→ *     headers: { 'X-Custom': 'value' }\n   234→ *   }\n   235→ * }\n   236→ * ```\n   237→ */\n   238→export type McpHeadersMap = Record<string, McpHeadersConfig>;\n   239→\n   240→/**\n   241→ * Status of a workflow execution.\n   242→ */\n   243→export type WorkflowStatus = 'idle' | 'running' | 'completed' | 'error';\n   244→\n   245→/**\n   246→ * Extended message type for use-ai.\n   247→ * Includes AG-UI protocol messages ('run_agent', 'tool_result', 'abort_run')\n   248→ * plus use-ai-specific extensions ('run_workflow').\n   249→ *\n   250→ * Note: This extends beyond AG-UI protocol to support headless workflow triggers.\n   251→ * For AG-UI compliance, use ClientMessage instead.\n   252→ */\n   253→export interface UseAIClientMessage {\n   254→  type: 'run_agent' | 'tool_result' | 'abort_run' | 'run_workflow';\n   255→  data: unknown;\n   256→}\n   257→\n   258→/**\n   259→ * Message sent from client to server to run a workflow (headless execution).\n   260→ *\n   261→ * This is a use-ai-specific extension, NOT part of AG-UI protocol.\n   262→ * Used for triggering workflows without chat UI (e.g., button click, file upload).\n   263→ *\n   264→ * Workflows differ from agents:\n   265→ * - No conversation history (stateless)\n   266→ * - No chat UI involvement\n   267→ * - Can use external platforms (Dify, Flowise, etc.)\n   268→ * - Still supports tool calls to frontend\n   269→ *\n   270→ * @example\n   271→ * ```typescript\n   272→ * socket.emit('message', {\n   273→ *   type: 'run_workflow',\n   274→ *   data: {\n   275→ *     runner: 'dify',\n   276→ *     workflowId: 'pdf-processor',\n   277→ *     inputs: { file: pdfData },\n   278→ *     tools: [insertTextTool],\n   279→ *     runId: uuidv4(),\n   280→ *     threadId: uuidv4(),\n   281→ *   }\n   282→ * });\n   283→ * ```\n   284→ */\n   285→export interface RunWorkflowMessage {\n   286→  type: 'run_workflow';\n   287→  data: {\n   288→    /** The runner to use (e.g., 'dify', 'flowise') */\n   289→    runner: string;\n   290→    /** The workflow identifier (depends on which platform you are using) */\n   291→    workflowId: string;