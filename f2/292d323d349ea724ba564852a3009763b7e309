          "text": "     1→/**\n     2→ * Display mode for chat messages.\n     3→ * Determines the visual styling of the message bubble.\n     4→ */\n     5→export type MessageDisplayMode = 'default' | 'error';\n     6→\n     7→/**\n     8→ * Message format for persisted chat history.\n     9→ * Compatible with AI SDK's UIMessage format for future integration.\n    10→ */\n    11→export interface PersistedMessage {\n    12→  id: string;\n    13→  role: 'user' | 'assistant' | 'tool';\n    14→  content: string;\n    15→  createdAt: Date;\n    16→  displayMode?: MessageDisplayMode;\n    17→}\n    18→\n    19→/**\n    20→ * Represents a stored chat conversation.\n    21→ */\n    22→export interface Chat {\n    23→  id: string;\n    24→  title?: string;\n    25→  messages: PersistedMessage[];\n    26→  createdAt: Date;\n    27→  updatedAt: Date;\n    28→}\n    29→\n    30→/**\n    31→ * Options for creating a new chat.\n    32→ */\n    33→export interface CreateChatOptions {\n    34→  title?: string;\n    35→}\n    36→\n    37→/**\n    38→ * Options for listing chats.\n    39→ */\n    40→export interface ListChatsOptions {\n    41→  limit?: number;\n    42→  offset?: number;\n    43→}\n    44→\n    45→/**\n    46→ * Abstract repository interface for chat persistence.\n    47→ * Implementations can store chats locally (localStorage, IndexedDB)\n    48→ * or remotely (REST API, GraphQL, etc.)\n    49→ */\n    50→export interface ChatRepository {\n    51→  /**\n    52→   * Creates a new chat and returns its ID.\n    53→   * @param options Optional configuration for the new chat\n    54→   * @returns Promise resolving to the new chat ID\n    55→   */\n    56→  createChat(options?: CreateChatOptions): Promise<string>;\n    57→\n    58→  /**\n    59→   * Loads a chat by ID.\n    60→   * @param id Chat ID to load\n    61→   * @returns Promise resolving to the chat, or null if not found\n    62→   */\n    63→  loadChat(id: string): Promise<Chat | null>;\n    64→\n    65→  /**\n    66→   * Saves or updates a chat.\n    67→   * @param chat Chat to save\n    68→   * @returns Promise resolving when save is complete\n    69→   */\n    70→  saveChat(chat: Chat): Promise<void>;\n    71→\n    72→  /**\n    73→   * Deletes a chat by ID.\n    74→   * @param id Chat ID to delete\n    75→   * @returns Promise resolving when deletion is complete\n    76→   */\n    77→  deleteChat(id: string): Promise<void>;\n    78→\n    79→  /**\n    80→   * Lists all available chats (metadata only, without full message history).\n    81→   * @param options Optional pagination and filtering options\n    82→   * @returns Promise resolving to array of chat metadata\n    83→   */\n    84→  listChats(options?: ListChatsOptions): Promise<Array<Omit<Chat, 'messages'>>>;\n    85→\n    86→  /**\n    87→   * Deletes all stored chats.\n    88→   * @returns Promise resolving when all chats are deleted\n    89→   */\n    90→  deleteAll(): Promise<void>;\n    91→}\n    92→\n    93→/**\n    94→ * Generates a unique chat ID.\n    95→ */\n    96→export function generateChatId(): string {\n    97→  return `chat_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;\n    98→}\n    99→\n   100→/**\n   101→ * Generates a unique message ID.\n   102→ */\n   103→export function generateMessageId(): string {\n   104→  return `msg_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;\n   105→}\n   106→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
