bes to agent changes (when server sends available agents).\n   532→   *\n   533→   * @param handler - Callback function receiving agents list and default agent\n   534→   * @returns Cleanup function to unsubscribe\n   535→   */\n   536→  onAgentsChange(handler: (agents: AgentInfo[], defaultAgent: string | null) => void): () => void {\n   537→    this.agentsChangeHandlers.add(handler);\n   538→    // Immediately call with current values if available\n   539→    if (this._availableAgents.length > 0) {\n   540→      handler(this._availableAgents, this._defaultAgent);\n   541→    }\n   542→    return () => {\n   543→      this.agentsChangeHandlers.delete(handler);\n   544→    };\n   545→  }\n   546→\n   547→  /**\n   548→   * Sets the thread ID for this session.\n   549→   * When the thread ID changes, conversation state is cleared to prevent history bleeding.\n   550→   * Use this when switching between different chat conversations.\n   551→   *\n   552→   * @param threadId - The thread/chat ID to use (typically the chatId)\n   553→   */\n   554→  setThreadId(threadId: string) {\n   555→    if (this._threadId !== threadId) {\n   556→      console.log('[Client] ThreadId changed, clearing conversation state', {\n   557→        oldThreadId: this._threadId,\n   558→        newThreadId: threadId,\n   559→      });\n   560→\n   561→      // Clear conversation state when switching threads\n   562→      this._messages = [];\n   563→      this._currentMessageContent = '';\n   564→      this._currentMessageId = null;\n   565→      this.currentToolCalls.clear();\n   566→      this._currentAssistantMessage = null;\n   567→      this._currentAssistantToolCalls = [];\n   568→    }\n   569→    this._threadId = threadId;\n   570→  }\n   571→\n   572→  /**\n   573→   * Loads messages into the conversation history (for resuming from storage).\n   574→   * @param messages - Array of messages to load\n   575→   */\n   576→  loadMessages(messages: Message[]) {\n   577→    this._messages = 