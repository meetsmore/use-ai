          "text": "     1→import React, { useState, useRef, useEffect } from 'react';\n     2→import type { Chat } from '../providers/chatRepository/types';\n     3→import type { AgentInfo } from '../types';\n     4→import { MarkdownContent } from './MarkdownContent';\n     5→\n     6→/**\n     7→ * Display mode for chat messages.\n     8→ */\n     9→type MessageDisplayMode = 'default' | 'error';\n    10→\n    11→/**\n    12→ * Represents a single message in the AI conversation.\n    13→ */\n    14→interface Message {\n    15→  /** Unique identifier for the message */\n    16→  id: string;\n    17→  /** The role of the message sender */\n    18→  role: 'user' | 'assistant';\n    19→  /** The message content/text */\n    20→  content: string;\n    21→  /** When the message was created */\n    22→  timestamp: Date;\n    23→  /** Display mode for styling the message bubble */\n    24→  displayMode?: MessageDisplayMode;\n    25→}\n    26→\n    27→interface UseAIChatPanelProps {\n    28→  isOpen: boolean;\n    29→  onClose: () => void;\n    30→  onSendMessage: (message: string) => void;\n    31→  messages: Message[];\n    32→  loading: boolean;\n    33→  connected: boolean;\n    34→  currentChatId?: string | null;\n    35→  onNewChat?: () => Promise<string | void>;\n    36→  onLoadChat?: (chatId: string) => Promise<void>;\n    37→  onDeleteChat?: (chatId: string) => Promise<void>;\n    38→  onListChats?: () => Promise<Array<Omit<Chat, 'messages'>>>;\n    39→  suggestions?: string[];\n    40→  availableAgents?: AgentInfo[];\n    41→  defaultAgent?: string | null;\n    42→  selectedAgent?: string | null;\n    43→  onAgentChange?: (agentId: string | null) => void;\n    44→}\n    45→\n    46→export function UseAIChatPanel({\n    47→  isOpen,\n    48→  onClose,\n    49→  onSendMessage,\n    50→  messages,\n    51→  loading,\n    52→  connected,\n    53→  currentChatId,\n    54→  onNewChat,\n    55→  onLoadChat,\n    56→  onDeleteChat,\n    57→  onListChats,\n    58→  suggestions,\n    59→  availableAgents,\n    60→  defaultAgent,\n    61→  selectedAgent,\n    62→  onAgentChange,\n    63→}: UseAIChatPanelProps) {\n    64→  const [input, setInput] = useState('');\n    65→  const [showChatHistory, setShowChatHistory] = useState(false);\n    66→  const [chatHistory, setChatHistory] = useState<Array<Omit<Chat, 'messages'>>>([]);\n    67→  const messagesEndRef = useRef<HTMLDivElement>(null);\n    68→  const [displayedSuggestions, setDisplayedSuggestions] = useState<string[]>([]);\n    69→\n    70→  useEffect(() => {\n    71→    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });\n    72→  }, [messages]);\n    73→\n    74→  // Randomly select up to 4 suggestions when chat opens or when messages become empty\n    75→  useEffect(() => {\n    76→    if (!suggestions || suggestions.length === 0) {\n    77→      setDisplayedSuggestions([]);\n    78→      return;\n    79→    }\n    80→\n    81→    // Shuffle array and take up to 4 items\n    82→    const shuffled = [...suggestions].sort(() => Math.random() - 0.5);\n    83→    setDisplayedSuggestions(shuffled.slice(0, 4));\n    84→  }, [isOpen, messages.length, suggestions]);\n    85→\n    86→  const handleSend = () => {\n    87→    if (!input.trim() || !connected || loading) return;\n    88→    onSendMessage(input);\n    89→    setInput('');\n    90→  };\n    91→\n    92→  const handleKeyPress = (e: React.KeyboardEvent) => {\n    93→    if (e.key === 'Enter' && !e.shiftKey) {\n    94→      e.preventDefault();\n    95→      handleSend();\n    96→    }\n    97→  };\n    98→\n    99→  const handleNewChat = async () => {\n   100→    if (onNewChat) {\n   101→      await onNewChat();\n   102→    }\n   103→  };\n   104→\n   105→  const handleDeleteChat = async () => {\n   106→    if (onDeleteChat && currentChatId && confirm('Delete this chat from history?')) {\n   107→      await onDeleteChat(currentChatId);\n   108→      if (onNewChat) {\n   109→        await onNewChat();\n   110→      }\n   111→    }\n   112→  };\n   113→\n   114→  const handleShowHistory = async () => {\n   115→    if (onListChats) {\n   116→      const chats = await onListChats();\n   117→      setChatHistory(chats);\n   118→      setShowChatHistory(true);\n   119→    }\n   120→  };\n   121→\n   122→  const handleLoadChat = async (chatId: string) => {\n   123→    if (onLoadChat) {\n   124→      await onLoadChat(chatId);\n   125→      setShowChatHistory(false);\n   126→    }\n   127→  };\n   128→\n   129→  if (!isOpen) return null;\n   130→\n   131→  return (\n   132→    <>\n   133→      <div\n   134→        style={{\n   135→          position: 'fixed',\n   136→          top: 0,\n   137→          left: 0,\n   138→          right: 0,\n   139→          bottom: 0,\n   140→          background: 'rgba(0, 0, 0, 0.3)',\n   141→          zIndex: 999,\n   142→          animation: 'fadeIn 0.2s',\n   143→        }}\n   144→        onClick={onClose}\n   145→      />\n   146→      <div\n   147→        style={{\n   148→          position: 'fixed',\n   149→          bottom: '24px',\n   150→          right: '24px',\n   151→          width: '380px',\n   152→          height: '600px',\n   153→          maxHeight: 'calc(100vh - 48px)',\n   154→          background: 'white',\n   155→          borderRadius: '16px',\n   156→          boxShadow: '0 8px 32px rgba(0, 0, 0, 0.12)',\n   157→          display: 'flex',\n   158→          flexDirection: 'column',\n   159→          zIndex: 1001,\n   160→          animation: 'slideIn 0.3s ease-out',\n   161→          fontFamily: '-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif',\n   162→        }}\n   163→      >\n   164→        {/* Header */}\n   165→        <div\n   166→          style={{\n   167→            padding: '12px 16px',\n   168→            borderBottom: '1px solid #e5e7eb',\n   169→            background: 'white',\n   170→            borderRadius: '16px 16px 0 0',\n   171→            display: 'flex',\n   172→            alignItems: 'cen