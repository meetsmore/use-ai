tate - Optional updated state to send back to the AI\n   363→   */\n   364→  sendToolResponse(toolCallId: string, result: unknown, state?: unknown) {\n   365→    // Update session state if provided\n   366→    if (state !== undefined) {\n   367→      this._state = state;\n   368→    }\n   369→\n   370→    const toolResultMessage: ToolResultMessage = {\n   371→      type: 'tool_result',\n   372→      data: {\n   373→        messageId: uuidv4(),\n   374→        toolCallId,\n   375→        content: JSON.stringify(result),\n   376→        role: 'tool',\n   377→      },\n   378→    };\n   379→\n   380→    // Track tool result in conversation history\n   381→    const toolResultMsg: ToolResultMessageData = {\n   382→      id: toolResultMessage.data.messageId,\n   383→      role: 'tool',\n   384→      content: toolResultMessage.data.content,\n   385→      toolCallId,\n   386→    };\n   387→    this._messages.push(toolResultMsg);\n   388→\n   389→    this.send(toolResultMessage);\n   390→  }\n   391→\n   392→  /**\n   393→   * Retrieves accumulated tool call data for a specific tool call ID.\n   394→   * Used to get the complete tool name and arguments after they've been streamed\n   395→   * across multiple TOOL_CALL_ARGS events.\n   396→   *\n   397→   * @param toolCallId - The ID of the tool call\n   398→   * @returns Object with tool name and accumulated arguments, or undefined if not found\n   399→   */\n   400→  getToolCallData(toolCallId: string): { name: string; args: string } | undefined {\n   401→    return this.currentToolCalls.get(toolCallId);\n   402→  }\n   403→\n   404→  /**\n   405→   * Registers an AG-UI event handler for receiving server events.\n   406→   *\n   407→   * @param id - Unique identifier for this handler\n   408→   * @param handler - Callback function to handle incoming AG-UI events\n   409→   * @returns Cleanup function to unregister the handler\n   410→   */\n   411→  onEvent(id: string, handler: AGUIEventHandler) {\n   412→    this.eventHan