olArguments) => {\n   375→      const toolCallId = this.emitToolCallEvents(toolDef.name, args, events);\n   376→\n   377→      const result = await new Promise<string>((resolve) => {\n   378→        session.pendingToolCalls.set(toolCallId, resolve);\n   379→      });\n   380→\n   381→      logger.toolResult(toolDef.name, result);\n   382→      return JSON.parse(result);\n   383→    };\n   384→  }\n   385→\n   386→  private sanitizeToolsForAPI(\n   387→    tools: ToolDefinition[],\n   388→    session: ClientSession,\n   389→    events: EventEmitter\n   390→  ): Record<string, unknown> {\n   391→    const toolsObject: Record<string, unknown> = {};\n   392→\n   393→    for (const toolDef of tools) {\n   394→      // Ensure parameters has a type field (required by Anthropic API)\n   395→      // AI SDK v6 expects 'inputSchema', not 'parameters'\n   396→      const rawParams = toolDef.parameters;\n   397→      const inputSchema = rawParams && typeof rawParams === 'object'\n   398→        ? { ...rawParams, type: ((rawParams as Record<string, unknown>).type || 'object') as 'object' }\n   399→        : { type: 'object' as const, properties: {} };\n   400→\n   401→      toolsObject[toolDef.name] = {\n   402→        description: toolDef.description,\n   403→        inputSchema: jsonSchema(inputSchema as JSONSchema7),\n   404→        execute: this.isRemoteTool(toolDef)\n   405→          ? this.createMcpToolExecutor(toolDef, session, events)\n   406→          : this.createClientToolExecutor(toolDef, session, events),\n   407→      };\n   408→    }\n   409→\n   410→    return toolsObject;\n   411→  }\n   412→\n   413→  /**\n   414→   * Zod schemas for AI SDK ModelMessage format.\n   415→   * These schemas define the exact structure expected by the AI SDK,\n   416→   * automatically stripping any provider-specific fields (like 'id', 'tool_use_id').\n   417→   * Using .strip() to silently remove unknown fields rather than throwing errors.\n   418→   */\n   419→  private static readonly toolResultContentSchema = z.object({\n   420→    type: z.literal('tool-result'),\n   421→    toolCallId: z.string(),\n   422→    toolName: z.string(),\n   423→    output: z.unknown(),\n   424→    isError: z.boolean().optional(),\n   425→  }).strip();\n   426→\n   427→  private static readonly toolCallContentSchema = z.object({\n   428→    type: z.literal('tool-call'),\n   429→    toolCallId: z.string(),\n   430→    toolName: z.string(),\n   431→    input: z.unknown(),\n   432→  }).strip();\n   433→\n   434→  private static readonly textContentSchema = z.object({\n   435→    type: z.literal('text'),\n   436→    text: z.string(),\n   437→  }).strip();\n   438→\n   439→  private static readonly contentPartSchema = z.union([\n   440→    AISDKAgent.textContentSchema,\n   441→    AISDKAgent.toolCallContentSchema,\n   442→    AISDKAgent.toolResultContentSchema,\n   443→  ]);\n   444→\n   445→  private static readonly messageSchema = z.object({\n   446→    role: z.enum(['user', 'assistant', 'tool', 'system']),\n   447→    content: z.union([\n   448→      z.string(),\n   449→      z.array(AISDKAgent.contentPartSchema),\n   450→    ]),\n   451→  }).strip();\n   452→\n   453→  private static readonly messagesArraySchema = z.array(AISDKAgent.messageSchema);\n   454→\n   455→  /**\n   456→   * Sanitizes messages from AI SDK responses by removing provider-specific fields.\n   457→   * This prevents validation errors when messages are re-sent to the API in subsequent requests.\n   458→   *\n   459→   * Issue: AI SDK responses may include provider-specific fields (e.g., Anthropic's `id`, `tool_use_id`)\n   460→   * that are not valid when sent back to the API. These fields must be stripped.\n   461→   *\n   462→   * Uses Zod schema parsing with .strict() to automatically strip any extra fields.\n   463→   */\n   464→  private sanitizeMessages(messages: ModelMessage[]): ModelMessage[] {\n   465→    try {\n   466→      // Zod parse will automatically strip fields not in the sch