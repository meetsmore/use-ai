age.removeItem(key);\n   114→      await this.removeFromIndex(id);\n   115→    } catch (error) {\n   116→      console.error(`Failed to delete chat ${id}:`, error);\n   117→      throw new Error(`Failed to delete chat: ${error instanceof Error ? error.message : 'Unknown error'}`);\n   118→    }\n   119→  }\n   120→\n   121→  async listChats(\n   122→    options?: ListChatsOptions\n   123→  ): Promise<Array<Omit<Chat, 'messages'>>> {\n   124→    try {\n   125→      const ids = await this.getIndex();\n   126→      const chats: Array<Omit<Chat, 'messages'>> = [];\n   127→\n   128→      for (const id of ids) {\n   129→        const chat = await this.loadChat(id);\n   130→        if (chat) {\n   131→          const { messages, ...metadata } = chat;\n   132→          chats.push(metadata);\n   133→        }\n   134→      }\n   135→\n   136→      // Sort by updatedAt descending (most recent first)\n   137→      chats.sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime());\n   138→\n   139→      // Apply pagination\n   140→      const { limit, offset = 0 } = options ?? {};\n   141→      const start = offset;\n   142→      const end = limit ? offset + limit : undefined;\n   143→\n   144→      return chats.slice(start, end);\n   145→    } catch (error) {\n   146→      console.error('Failed to list chats:', error);\n   147→      return [];\n   148→    }\n   149→  }\n   150→\n   151→  async deleteAll(): Promise<void> {\n   152→    try {\n   153→      const ids = await this.getIndex();\n   154→\n   155→      for (const id of ids) {\n   156→        const key = this.getChatKey(id);\n   157→        this.storage.removeItem(key);\n   158→      }\n   159→\n   160→      this.storage.removeItem(STORAGE_INDEX_KEY);\n   161→    } catch (error) {\n   162→      console.error('Failed to clear all chats:', error);\n   163→      throw new Error(`Failed to clear all chats: ${error instanceof Error ? error.message : 'Unknown error'}`);\n   164→    }\n   165→  }\n   166→\n   167→  private getChatKey(id: string): string {\n   168→    return `${STORAGE_KEY_PREFIX}${id}`;\n   169→  }\n   170→\n   171→  private async getIndex(): Promise<string[]> {\n   172→    try {\n   173→      const data = this.storage.getItem(STORAGE_INDEX_KEY);\n   174→      return data ? JSON.parse(data) : [];\n   175→    } catch (error) {\n   176→      console.error('Failed to load chat index:', error);\n   177→      return [];\n   178→    }\n   179→  }\n   180→\n   181→  private async addToIndex(id: string): Promise<void> {\n   182→    const index = await this.getIndex();\n   183→    if (!index.includes(id)) {\n   184→      index.push(id);\n   185→      this.storage.setItem(STORAGE_INDEX_KEY, JSON.stringify(index));\n   186→    }\n   187→  }\n   188→\n   189→  private async removeFromIndex(id: string): Promise<void> {\n   190→    const index = await this.getIndex();\n   191→    const filtered = index.filter((chatId) => chatId !== id);\n   192→    this.storage.setItem(STORAGE_INDEX_KEY, JSON.stringify(filtered));\n   193→  }\n   194→\n   195→  private async enforceMaxChatsLimit(): Promise<void> {\n   196→    const chats = await this.listChats();\n   197→\n   198→    if (chats.length >= this.maxChats) {\n   199→      // Sort by updatedAt ascending to find oldest\n   200→      const sortedChats = [...chats].sort(\n   201→        (a, b) => a.updatedAt.getTime() - b.updatedAt.getTime()\n   202→      );\n   203→\n   204→      // Delete the oldest chat(s) to make room\n   205→      const numToDelete = chats.length - this.maxChats + 1;\n   206→      for (let i = 0; i < numToDelete; i++) {\n   207→        await this.deleteChat(sortedChats[i].id);\n   208→      }\n   209→    }\n   210→  }\n   211→}\n   212→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer 