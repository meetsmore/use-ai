rentTarget.style.background = 'transparent';\n   341→                  e.currentTarget.style.color = '#6b7280';\n   342→                }}\n   343→                title=\"Delete Chat\"\n   344→              >\n   345→                <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n   346→                  <path d=\"M2 4H14M6.5 7V11M9.5 7V11M3 4L4 13C4 13.5304 4.21071 14.0391 4.58579 14.4142C4.96086 14.7893 5.46957 15 6 15H10C10.5304 15 11.0391 14.7893 11.4142 14.4142C11.7893 14.0391 12 13.5304 12 13L13 4M5.5 4V2.5C5.5 2.23478 5.60536 1.98043 5.79289 1.79289C5.98043 1.60536 6.23478 1.5 6.5 1.5H9.5C9.76522 1.5 10.0196 1.60536 10.2071 1.79289C10.3946 1.98043 10.5 2.23478 10.5 2.5V4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/>\n   347→                </svg>\n   348→              </button>\n   349→            )}\n   350→\n   351→            {/* Close button */}\n   352→            <button\n   353→              data-testid=\"chat-close-button\"\n   354→              className=\"chat-close-button\"\n   355→              onClick={onClose}\n   356→              style={{\n   357→                background: 'transparent',\n   358→                border: 'none',\n   359→                borderRadius: '6px',\n   360→                padding: '6px 8px',\n   361→                cursor: 'pointer',\n   362→                color: '#6b7280',\n   363→                fontSize: '20px',\n   364→                display: 'flex',\n   365→                alignItems: 'center',\n   366→                justifyContent: 'center',\n   367→                transition: 'all 0.2s',\n   368→                lineHeight: 1,\n   369→              }}\n   370→              onMouseEnter={(e: React.MouseEvent<HTMLButtonElement>) => {\n   371→                e.currentTarget.style.background = '#f3f4f6';\n   372→                e.currentTarget.style.color = '#1f2937';\n   373→              }}\n   374→              onMouseLeave={(e: React.Mouse