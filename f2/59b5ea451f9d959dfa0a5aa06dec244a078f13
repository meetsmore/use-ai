          "text": "     1→import React, { createContext, useContext, useState, useEffect, ReactNode, useCallback, useRef } from 'react';\n     2→import type { UseAIConfig, AGUIEvent, ToolCallEndEvent, RunErrorEvent } from '../types';\n     3→import { EventType, ErrorCode } from '../types';\n     4→import { UseAIFloatingButton } from '../components/UseAIFloatingButton';\n     5→import { UseAIChatPanel, type Message } from '../components/UseAIChatPanel';\n     6→import { UseAIClient } from '../client';\n     7→import { convertToolsToDefinitions, executeDefinedTool, type ToolsDefinition } from '../defineTool';\n     8→import type { ChatRepository, Chat } from './chatRepository/types';\n     9→import { LocalStorageChatRepository } from './chatRepository/LocalStorageChatRepository';\n    10→import { generateMessageId } from './chatRepository/types';\n    11→\n    12→/**\n    13→ * Mapping of error codes to user-friendly error messages.\n    14→ * Used for displaying errors in the chat UI.\n    15→ * Can be customized for internationalization (i18n).\n    16→ */\n    17→export type ErrorMapping = {\n    18→  [K in ErrorCode]: string;\n    19→};\n    20→\n    21→// Constants\n    22→const CHAT_TITLE_MAX_LENGTH = 50;\n    23→\n    24→// Helper functions\n    25→/**\n    26→ * Generates a chat title from a message, truncating if necessary.\n    27→ */\n    28→const generateChatTitle = (message: string): string => {\n    29→  return message.length > CHAT_TITLE_MAX_LENGTH\n    30→    ? message.substring(0, CHAT_TITLE_MAX_LENGTH) + '...'\n    31→    : message;\n    32→};\n    33→\n    34→/**\n    35→ * Transforms storage messages to UI message format.\n    36→ */\n    37→const transformMessagesToUI = (storageMessages: Array<{ id: string; role: string; content: string; createdAt: Date; displayMode?: 'default' | 'error' }>): Message[] => {\n    38→  return storageMessages.map((msg) => ({\n    39→    id: msg.id,\n    40→    role: msg.role as 'user' | 'assistant',\n    41→    content: msg.content,\n    42→    timestamp: msg.createdAt,\n    43→    displayMode: msg.displayMode,\n    44→  }));\n    45→};\n    46→\n    47→/**\n    48→ * Context value provided by UseAIProvider.\n    49→ * Contains connection state and methods for managing tools and prompts.\n    50→ */\n    51→export interface UseAIContextValue {\n    52→  /** The WebSocket URL of the UseAI server */\n    53→  serverUrl: string;\n    54→  /** Whether the client is connected to the server */\n    55→  connected: boolean;\n    56→  /** Registers tools for a specific component */\n    57→  registerTools: (\n    58→    id: string,\n    59→    tools: ToolsDefinition,\n    60→    waitForRender?: () => Promise<void>\n    61→  ) => void;\n    62→  /** Unregisters tools for a specific component */\n    63→  unregisterTools: (id: string) => void;\n    64→  /** Updates the UI context prompt for a specific component */\n    65→  updatePrompt: (id: string, prompt?: string, suggestions?: string[]) => void;\n    66→  /** The underlying WebSocket client instance */\n    67→  client: UseAIClient | null;\n    68→  /** The current chat ID */\n    69→  currentChatId: string | null;\n    70→  /** Creates a new chat and switches to it */\n    71→  createNewChat: () => Promise<string>;\n    72→  /** Loads an existing chat by ID */\n    73→  loadChat: (chatId: string) => Promise<void>;\n    74→  /** Deletes a chat by ID */\n    75→  deleteChat: (chatId: string) => Promise<void>;\n    76→  /** Lists all available chats */\n    77→  listChats: () => Promise<Array<Omit<Chat, 'messages'>>>;\n    78→  /** Clears the current chat messages */\n    79→  clearCurrentChat: () => Promise<void>;\n    80→}\n    81→\n    82→/**\n    83→ * React context for UseAI provider state.\n    84→ * @internal This is exported only for testing purposes and should not be used directly.\n    85→ * Use the {@link useAIContext} hook instead.\n    86→ */\n    87→export const __UseAIContext = createContext<UseAIContextValue | null>(null);\n    88→\n    89→/**\n    90→ * Props for custom floating button component.\n    91→ * Used to customize the appearance and behavior of the AI chat trigger button.\n    92→ */\n    93→export interface FloatingButtonProps {\n    94→  /** Callback when the button is clicked */\n    95→  onClick: () => void;\n    96→  /** Whether the client is connected to the server */\n    97→  connected: boolean;\n    98→  /** Whether there are unread messages */\n    99→  hasUnread?: boolean;\n   100→}\n   101→\n   102→/**\n   103→ * Props for custom chat panel component.\n   104→ * Used to customize the appearance and behavior of the AI chat interface.\n   105→ */\n   106→export interface ChatPanelProps {\n   107→  /** Whether the chat panel is open */\n   108→  isOpen: boolean;\n   109→  /** Callback when the panel should close */\n   110→  onClose: () => void;\n   111→  /** Callback when a message is sent */\n   112→  onSendMessage: (message: string) => void;\n   113→  /** Array of messages in the conversation */\n   114→  messages: Message[];\n   115→  /** Whether the AI is currently processing */\n   116→  loading: boolean;\n   117→  /** Whether the client is connected to the server */\n   118→  connected: boolean;\n   119→  /** Optional array of suggestion strings to display when chat is empty */\n   120→  suggestions?: string[];\n   121→}\n   122→\n   123→export interface UseAIProviderProps extends UseAIConfig {\n   124→  children: ReactNode;\n   125→  systemPrompt?: string;\n   126→  CustomButton?: React.ComponentType<FloatingButtonProps> | null;\n   127→  CustomChat?: React.ComponentType<ChatPanelProps> | null;\n   128→  /**\n   129→   * Custom chat repository for message persistence.\n   130→   * Defaults to LocalStorageChatRepository if not provided.\n   131→   */\n   132→  chatRepository?: ChatRepository;\n   133→  /**\n   134→   * Custom error messages for different error codes.\n   135→   * Maps error codes (from server) to user-friendly messages.\n   136→   * Useful for internationalization (i18n).\n   137→   * Partial allows overriding only specific messages.\n   138→   *\n   139→   * @example\n   140→   * ```typescript\n   141→   * errorMessages={{\n   142→   *   API_OVERLOADED: \"Le service IA est actuellement surchargé.\",\n   143→   *   RATE_LIMITED: \"Trop de requêtes.\",\n   144→   *   UNKNOWN_ERROR: \"Une erreur s'est produite.\"\n   145→   * }}\n   146→   * ```\n   147→   */\n   148→  errorMessages?: Partial<ErrorMapping>;\n   149→  /**\n   150→   * Callback to provide HTTP headers for MCP endpoints.\n   151→   * Called each time AI is invoked by use-ai.\n   152→   * Returns a mapping of MCP endpoint patterns to header configurations.\n   153→   *\n   154→   * Patterns can be:\n   155→   * - Constant strings: `https://api.example.com` - Exact match\n   156→   * - Glob patterns: `https://*.meetsmore.com` - Wildcard matching using picomatch\n   157→   *\n   158→   * @example\n   159→   * ```typescript\n   160→   * mcpHeadersProvider={() => ({\n   161→   *   // Exact match\n   162→   *   'https://api.example.com': {\n   163→   *     headers: { 'Authorization': `Bearer ${userToken}` }\n   164→   *   },\n   165→   *   // Wildcard subdomain\n   166→   *   'https://*.meetsmore.com': {\n   167→   *     headers: { 'X-API-Key': apiKey }\n   168→   *   },\n   169→   *   // Multiple wildcards\n   170→   *   '*://*.example.com': {\n   171→   *     headers: { 'X-Custom': 'value' }\n   172→   *   }\n   173→   * })}\n   174→   * ```\n   175→   */\n   176→  mcpHeadersProvider?: () => import('@meetsmore/use-ai-core').McpHeadersMap | Promise<import('@meetsmore/use-ai-core').McpHeadersMap>;\n   177→}\n   178→\n   179→/**\n   180→ * Custom hook for managing chat storage operations.\n   181→ * Encapsulates all chat repository interactions for better separation of concerns.\n   182→ */\n   183→function useChatStorage(repository: ChatRepository) {\n   184→  const saveUserMessage = useCallback(async (\n   185→    chatId: string,\n   186→    message: string\n   187→  ): Promise<boolean> => {\n   188→    try {\n   189→      const chat = await repository.loadChat(chatId);\n   190→\n   191→      if (!chat) {\n   192→        console.error('[ChatStorage] Chat not found:', chatId);\n   193→        return false;\n   194→      }\n   195→\n   196→      chat.messages.push({\n   197→        id: generateMessageId(),\n   198→        role: 'user',\n   199→        content: message,\n   200→        createdAt: new Date(),\n   201→      });\n   202→\n   203→      // Auto-generate title using extracted helper\n   204→      if (!chat.title) {\n   205→        chat.title = generateChatTitle(message);\n   206→      }\n   207→\n   208→      await repository.saveChat(chat);\n   209→      console.log('[ChatStorage] Saved user message to storage');\n   210→      return true;\n   211→    } catch (error) {\n   212→      console.error('[ChatStorage] Failed to save user message:', error);\n   213→      return false;\n   214→    }\n   215→  }, [repository]);\n   216→\n   217→  const saveAIResponse = useCallback(async (\n   218→    chatId: string,\n   219→    content: string,\n   220→    displayMode?: 'default' | 'error'\n   221→  ): Promise<boolean> => {\n   222→    try {\n   223→      const chat = await repository.loadChat(chatId);\n   224→\n   225→      if (!chat) {\n   226→        console.error('[ChatStorage] Chat not found:', chatId);\n   227→        return false;\n   228→      }\n   229→\n   230→      chat.messages.push({\n   231→        id: generateMessageId(),\n   232→        role: 'assistant',\n   233→        content,\n   234→        createdAt: new Date(),\n   235→        displayMode,\n   236→      });\n   237→\n   238→      // Auto-generate title from first user message if not set\n   239→      if (!chat.title) {\n   240→        const firstUserMessage = chat.messages.find(msg => msg.role === 'user');\n   241→        if (firstUserMessage) {\n   242→          chat.title = generateChatTitle(firstUserMessage.content);\n   243→        }\n   244→      }\n   245→\n   246→      await repository.saveChat(chat);\n   247→      console.log('[ChatStorage] Saved AI response to storage for chatId:', chatId);\n   248→      return true;\n   249→    } catch (error) {\n   250→      console.error('[ChatStorage] Failed to save AI response:', error);\n   251→      return false;\n   252→    }\n   253→  }, [repository]);\n   254→\n   255→  const loadChatMessages = useCallback(async (chatId: string): Promise<Message[]> => {\n   256→    try {\n   257→      const chat = await repository.loadChat(chatId);\n   258→\n   259→      if (chat) {\n   260→        const loadedMessages = transformMessagesToUI(chat.messages);\n   261→        console.log('[ChatStorage] Loaded', loadedMessages.length, 'messages from storage for chat:', chatId);\n   262→        return loadedMessages;\n   263→      } else {\n   264→        console.log('[ChatStorage] Chat not found in storage:', chatId);\n   265→        return [];\n   266→      }\n   267→    } catch (error) {\n   268→      console.error('[ChatStorage] Failed to load chat messages:', error);\n   269→      return [];\n   270→    }\n   271→  }, [repository]);\n   272→\n   273→  return {\n   274→    saveUserMessage,\n   275→    saveAIResponse,\n   276→    loadChatMessages,\n   277→  };\n   278→}\n   279→\n   280→/**\n   281→ * Provider component that manages AI client connection and tool registration.\n   282→ * Must wrap all components that use the useAI hook.\n   283→ *\n   284→ * Features:\n   285→ * - Establishes and maintains WebSocket connection to UseAI server\n   286→ * - Aggregates tools from all child useAI hooks\n   287→ * - Handles tool execution requests from the AI\n   288→ * - Provides floating button and chat panel UI\n   289→ *\n   290→ * @param props - Provider configuration and children\n   291→ *\n   292→ * @example\n   293→ * ```typescript\n   294→ * import { UseAIProvider } from '@meetsmore/use-ai-client';\n   295→ *\n   296→ * function App() {\n   297→ *   return (\n   298→ *     <UseAIProvider\n   299→ *       serverUrl=\"wss://your-server.com\"\n   300→ *       systemPrompt=\"You are a helpful assistant for managing todos\"\n   301→ *     >\n   302→ *       <YourApp />\n   303→ *     </UseAIProvider>\n   304→ *   );\n   305→ * }\n   306→ * ```\n   307→ */\n   308→export function UseAIProvider({\n   309→  serverUrl,\n   310→  children,\n   311→  systemPrompt,\n   312→  CustomButton,\n   313→  CustomChat,\n   314→  chatRepository,\n   315→  mcpHeadersProvider,\n   316→  errorMessages: customErrorMessages,\n   317→}: UseAIProviderProps) {\n   318→  const [connected, setConnected] = useState(false);\n   319→  const [isChatOpen, setIsChatOpen] = useState(false);\n   320→  const [messages, setMessages] = useState<Message[]>([]);\n   321→  const [loading, setLoading] = useState(false);\n   322→\n   323→  /**\n   324→   * Current active chat where AI responses are saved.\n   325→   * This is the \"source of truth\" for where new AI messages get persisted.\n   326→   */\n   327→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   328→\n   329→  /**\n   330→   * Chat loaded for viewing but not yet active for AI responses.\n   331→   * Becomes currentChatId when user sends their first message.\n   332→   * This prevents race conditions when AI is still responding to the previous chat.\n   333→   */\n   334→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   335→\n   336→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   337→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   338→  const promptsRef = useRef<Map<string, string>>(new Map());\n   339→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   340→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   341→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   342→\n   343→  /**\n   344→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   345→   * Event handlers are created once during mount and don't see updated state values.\n   346→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   347→   */\n   348→  const currentChatIdSnapshot = useRef<string | null>(null);\n   349→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   350→\n   351→  const clientRef = useRef<UseAIClient | null>(null);\n   352→  const repositoryRef = useRef<ChatRepository>(\n   353→    chatRepository || new LocalStorageChatRepository()\n   354→  );\n   355→\n   356→  // Initialize chat storage hook\n   357→  const chatStorage = useChatStorage(repositoryRef.current);\n   358→\n   359→  // Helper function to load messages from storage for display\n   360→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   361→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   362→    setMessages(loadedMessages);\n   363→  }, [chatStorage]);\n   364→\n   365→  const registerTools = useCallback((\n   366→    id: string,\n   367→    tools: ToolsDefinition,\n   368→    waitForRender?: () => Promise<void>\n   369→  ) => {\n   370→    const existingTools = toolRegistryRef.current.get(id);\n   371→\n   372→    // Always update the ref to capture latest closures\n   373→    toolRegistryRef.current.set(id, tools);\n   374→\n   375→    // Only increment version if tool names changed (added/removed tools)\n   376→    if (existingTools) {\n   377→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   378→      const newKeys = Object.keys(tools).sort().join(',');\n   379→      if (existingKeys !== newKeys) {\n   380→        setToolRegistryVersion(v => v + 1);\n   381→      }\n   382→    } else {\n   383→      // First registration\n   384→      setToolRegistryVersion(v => v + 1);\n   385→    }\n   386→\n   387→    Object.keys(tools).forEach(toolName => {\n   388→      toolOwnershipRef.current.set(toolName, id);\n   389→    });\n   390→\n   391→    if (waitForRender) {\n   392→      renderWaitersRef.current.set(id, waitForRender);\n   393→    }\n   394→  }, []);\n   395→\n   396→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   397→    if (prompt) {\n   398→      promptsRef.current.set(id, prompt);\n   399→    } else {\n   400→      promptsRef.current.delete(id);\n   401→    }\n   402→\n   403→    if (suggestions && suggestions.length > 0) {\n   404→      suggestionsRef.current.set(id, suggestions);\n   405→    } else {\n   406→      suggestionsRef.current.delete(id);\n   407→    }\n   408→  }, []);\n   409→\n   410→  const unregisterTools = useCallback((id: string) => {\n   411→    const tools = toolRegistryRef.current.get(id);\n   412→    if (tools) {\n   413→      Object.keys(tools).forEach(toolName => {\n   414→        toolOwnershipRef.current.delete(toolName);\n   415→      });\n   416→    }\n   417→\n   418→    toolRegistryRef.current.delete(id);\n   419→    setToolRegistryVersion(v => v + 1);\n   420→    promptsRef.current.delete(id);\n   421→    suggestionsRef.current.delete(id);\n   422→    renderWaitersRef.current.delete(id);\n   423→  }, []);\n   424→\n   425→  const aggregatedTools = React.useMemo(() => {\n   426→    const tools: ToolsDefinition = {};\n   427→    toolRegistryRef.current.forEach((toolSet) => {\n   428→      Object.assign(tools, toolSet);\n   429→    });\n   430→    return tools;\n   431→  }, [toolRegistryVersion]);\n   432→\n   433→  const aggregatedSuggestions = React.useMemo(() => {\n   434→    const allSuggestions: string[] = [];\n   435→    suggestionsRef.current.forEach((suggestions) => {\n   436→      allSuggestions.push(...suggestions);\n   437→    });\n   438→    return allSuggestions;\n   439→  }, [toolRegistryVersion]);\n   440→\n   441→  const hasTools = toolRegistryRef.current.size > 0;\n   442→  const aggregatedToolsRef = useRef(aggregatedTools);\n   443→  aggregatedToolsRef.current = aggregatedTools;\n   444→\n   445→  // Keep snapshot refs in sync with latest chat IDs\n   446→  useEffect(() => {\n   447→    currentChatIdSnapshot.current = currentChatId;\n   448→  }, [currentChatId]);\n   449→\n   450→  useEffect(() => {\n   451→    pendingChatIdSnapshot.current = pendingChatId;\n   452→  }, [pendingChatId]);\n   453→\n   454→  /**\n   455→   * Handles saving AI response to storage and updating UI.\n   456→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   457→   */\n   458→  const handleAIResponse = useCallback(async (content: string, displayMode?: 'default' | 'error') => {\n   459→    const currentChatIdValue = currentChatIdSnapshot.current;\n   460→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   461→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   462→\n   463→    if (!currentChatIdValue) {\n   464→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   465→      return;\n   466→    }\n   467→\n   468→    // Save AI response to storage\n   469→    const saved = await chatStorage.saveAIResponse(currentChatIdValue, content, displayMode);\n   470→\n   471→    // Reload UI if save was successful and user is viewing this chat\n   472→    if (saved && displayedChatId === currentChatIdValue) {\n   473→      await loadMessagesFromStorage(currentChatIdValue);\n   474→    }\n   475→  }, [chatStorage, loadMessagesFromStorage]);\n   476→\n   477→  useEffect(() => {\n   478→    console.log('[UseAIProvider] Initializing client with serverUrl:', serverUrl);\n   479→    const client = new UseAIClient(serverUrl);\n   480→\n   481→    // Set MCP headers provider if provided\n   482→    if (mcpHeadersProvider) {\n   483→      client.setMcpHeadersProvider(mcpHeadersProvider);\n   484→    }\n   485→\n   486→    console.log('[UseAIProvider] Attempting to connect...');\n   487→    client.connect()\n   488→      .then(() => {\n   489→        console.log('[UseAIProvider] Connected successfully!');\n   490→        setConnected(true);\n   491→      })\n   492→      .catch((err) => {\n   493→        console.error('[UseAIProvider] Failed to connect client:', err);\n   494→        setConnected(false);\n   495→      });\n   496→\n   497→    const unsubscribe = client.onEvent('globalChat', async (event: AGUIEvent) => {\n   498→      if (event.type === EventType.TOOL_CALL_END) {\n   499→        const toolCallEnd = event as ToolCallEndEvent;\n   500→        const toolCallId = toolCallEnd.toolCallId;\n   501→\n   502→        // Get the accumulated tool call data\n   503→        const toolCallData = client['currentToolCalls'].get(toolCallId);\n   504→        if (!toolCallData) {\n   505→          console.error(`[Provider] Tool call ${toolCallId} not found`);\n   506→          return;\n   507→        }\n   508→\n   509→        const name = toolCallData.name;\n   510→        const input = JSON.parse(toolCallData.args);\n   511→\n   512→        // Check if this tool belongs to a useAI hook (not a workflow)\n   513→        // If the tool doesn't exist in our aggregated tools, it's a workflow tool\n   514→        // and will be handled by useAIWorkflow's event listener\n   515→        if (!aggregatedToolsRef.current[name]) {\n   516→          console.log(`[Provider] Tool \"${name}\" not found in useAI tools, skipping (likely a workflow tool)`);\n   517→          return;\n   518→        }\n   519→\n   520→        try {\n   521→          const ownerId = toolOwnershipRef.current.get(name);\n   522→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   523→\n   524→          let renderPromise: Promise<void> | undefined;\n   525→          if (ownerId) {\n   526→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   527→            if (waitForRender) {\n   528→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   529→         