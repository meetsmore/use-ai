cd \"$package_dir\"\n\n  if npm publish --access public; then\n    echo \"  ✓ $package_name published successfully\"\n    cd - > /dev/null\n    return 0\n  else\n    echo \"  ❌ Failed to publish $package_name\"\n    cd - > /dev/null\n    return 1\n  fi\n}\n\necho \"Publishing @use-ai/core first (dependency for other packages)...\"\nif ! publish_package \"packages/core\" \"@use-ai/core\"; then\n  echo \"\"\n  echo \"❌ Failed to publish @use-ai/core. Stopping.\"\n  exit 1\nfi\necho \"\"\n\necho \"Publishing remaining packages...\"\nfor i in 1 2 3; do\n  if ! publish_package \"${PACKAGES[$i]}\" \"${PACKAGE_NAMES[$i]}\"; then\n    echo \"\"\n    echo \"⚠️  Warning: Failed to publish ${PACKAGE_NAMES[$i]}\"\n  fi\ndone\n\necho \"\"\necho \"━━━━━━━━━━━━━━━━━━━━━━━━━━\"\necho \"✅ Publishing complete!\"\necho \"\"\necho \"Published version: $NEW_VERSION\"\necho \"\"\necho \"Next steps:\"\necho \"  • Verify packages on npm:\"\nfor pkg_name in \"${PACKAGE_NAMES[@]}\"; do\n  echo \"    https://www.npmjs.com/package/$pkg_name\"\ndone\necho \"  • Create a git tag: git tag v$NEW_VERSION && git push origin v$NEW_VERSION\"\necho \"  • Update CHANGELOG.md\"\n",
