ected: boolean;\n    88→  /** Whether there are unread messages */\n    89→  hasUnread?: boolean;\n    90→}\n    91→\n    92→/**\n    93→ * Props for custom chat panel component.\n    94→ * Used to customize the appearance and behavior of the AI chat interface.\n    95→ */\n    96→export interface ChatPanelProps {\n    97→  /** Whether the chat panel is open */\n    98→  isOpen: boolean;\n    99→  /** Callback when the panel should close */\n   100→  onClose: () => void;\n   101→  /** Callback when a message is sent */\n   102→  onSendMessage: (message: string) => void;\n   103→  /** Array of messages in the conversation */\n   104→  messages: Message[];\n   105→  /** Whether the AI is currently processing */\n   106→  loading: boolean;\n   107→  /** Whether the client is connected to the server */\n   108→  connected: boolean;\n   109→  /** Optional array of suggestion strings to display when chat is empty */\n   110→  suggestions?: string[];\n   111→}\n   112→\n   113→export interface UseAIProviderProps extends UseAIConfig {\n   114→  children: ReactNode;\n   115→  systemPrompt?: string;\n   116→  CustomButton?: React.ComponentType<FloatingButtonProps>;\n   117→  CustomChat?: React.ComponentType<ChatPanelProps>;\n   118→  /**\n   119→   * Custom chat repository for message persistence.\n   120→   * Defaults to LocalStorageChatRepository if not provided.\n   121→   */\n   122→  chatRepository?: ChatRepository;\n   123→}\n   124→\n   125→/**\n   126→ * Custom hook for managing chat storage operations.\n   127→ * Encapsulates all chat repository interactions for better separation of concerns.\n   128→ */\n   129→function useChatStorage(repository: ChatRepository) {\n   130→  const saveUserMessage = useCallback(async (\n   131→    chatId: string,\n   132→    message: string\n   133→  ): Promise<boolean> => {\n   134→    try {\n   135→      const chat = await repository.loadChat(chatId);\n   136→\n   137→      if (!chat) {\n   138→        console.error('[ChatStorage] Chat not found:', chatId);\n   139→        return false;\n   140→      }\n   141→\n   142→      chat.messages.push({\n   143→        id: generateMessageId(),\n   144→        role: 'user',\n   145→        content: message,\n   146→        createdAt: new Date(),\n   147→      });\n   148→\n   149→      // Auto-generate title using extracted helper\n   150→      if (!chat.title) {\n   151→        chat.title = generateChatTitle(message);\n   152→      }\n   153→\n   154→      await repository.saveChat(chat);\n   155→      console.log('[ChatStorage] Saved user message to storage');\n   156→      return true;\n   157→    } catch (error) {\n   158→      console.error('[ChatStorage] Failed to save user message:', error);\n   159→      return false;\n   160→    }\n   161→  }, [repository]);\n   162→\n   163→  const saveAIResponse = useCallback(async (\n   164→    chatId: string,\n   165→    content: string\n   166→  ): Promise<boolean> => {\n   167→    try {\n   168→      const chat = await repository.loadChat(chatId);\n   169→\n   170→      if (!chat) {\n   171→        console.error('[ChatStorage] Chat not found:', chatId);\n   172→        return false;\n   173→      }\n   174→\n   175→      chat.messages.push({\n   176→        id: generateMessageId(),\n   177→        role: 'assistant',\n   178→        content,\n   179→        createdAt: new Date(),\n   180→      });\n   181→\n   182→      // Auto-generate title from first user message if not set\n   183→      if (!chat.title) {\n   184→        const firstUserMessage = chat.messages.find(msg => msg.role === 'user');\n   185→        if (firstUserMessage) {\n   186→          chat.title = generateChatTitle(firstUserMessage.content);\n   187→        }\n   188→      }\n   189→\n   190→      await repository.saveChat(chat);\n   191→      console.log('[ChatStorage] Saved AI response to storage for chatId:', chatId);\n   192→      return true;\n   193→    } catch (error) {\n   194→      console.error('[ChatStorage] Failed to save AI