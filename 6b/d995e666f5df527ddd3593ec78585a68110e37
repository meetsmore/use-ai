ent ID */\n   183→  selectedAgent?: string | null;\n   184→  /** Callback when agent is changed */\n   185→  onAgentChange?: (agentId: string | null) => void;\n   186→}\n   187→\n   188→export interface UseAIProviderProps extends UseAIConfig {\n   189→  children: ReactNode;\n   190→  systemPrompt?: string;\n   191→  CustomButton?: React.ComponentType<FloatingButtonProps> | null;\n   192→  CustomChat?: React.ComponentType<ChatPanelProps> | null;\n   193→  /**\n   194→   * Custom chat repository for message persistence.\n   195→   * Defaults to LocalStorageChatRepository if not provided.\n   196→   */\n   197→  chatRepository?: ChatRepository;\n   198→  /**\n   199→   * Custom error messages for different error codes.\n   200→   * Maps error codes (from server) to user-friendly messages.\n   201→   * Useful for internationalization (i18n).\n   202→   * Partial allows overriding only specific messages.\n   203→   *\n   204→   * @example\n   205→   * ```typescript\n   206→   * errorMessages={{\n   207→   *   API_OVERLOADED: \"Le service IA est actuellement surchargé.\",\n   208→   *   RATE_LIMITED: \"Trop de requêtes.\",\n   209→   *   UNKNOWN_ERROR: \"Une erreur s'est produite.\"\n   210→   * }}\n   211→   * ```\n   212→   */\n   213→  errorMessages?: Partial<ErrorMapping>;\n   214→  /**\n   215→   * Callback to provide HTTP headers for MCP endpoints.\n   216→   * Called each time AI is invoked by use-ai.\n   217→   * Returns a mapping of MCP endpoint patterns to header configurations.\n   218→   *\n   219→   * Patterns can be:\n   220→   * - Constant strings: `https://api.example.com` - Exact match\n   221→   * - Glob patterns: `https://*.meetsmore.com` - Wildcard matching using picomatch\n   222→   *\n   223→   * @example\n   224→   * ```typescript\n   225→   * mcpHeadersProvider={() => ({\n   226→   *   // Exact match\n   227→   *   'https://api.example.com': {\n   228→   *     headers: { 'Authorization': `Bearer ${userToken}` }\n   229→   *   },\n   230→   *   // Wildcard subdomain\n   231→   *   'https://*.meetsmore.com': {\n   232→   *     headers: { 'X-API-Key': apiKey }\n   233→   *   },\n   234→   *   // Multiple wildcards\n   235→   *   '*://*.example.com': {\n   236→   *     headers: { 'X-Custom': 'value' }\n   237→   *   }\n   238→   * })}\n   239→   * ```\n   240→   */\n   241→  mcpHeadersProvider?: () => import('@meetsmore/use-ai-core').McpHeadersMap | Promise<import('@meetsmore/use-ai-core').McpHeadersMap>;\n   242→  /**\n   243→   * Configuration for file uploads.\n   244→   * File upload is enabled by default with EmbedFileUploadBackend, 10MB max size,\n   245→   * and accepts images and PDFs.\n   246→   *\n   247→   * Set to `false` to disable file uploads.\n   248→   *\n   249→   * @default { backend: EmbedFileUploadBackend, maxFileSize: 10MB, acceptedTypes: ['image/*', 'application/pdf'] }\n   250→   *\n   251→   * @example\n   252→   * ```typescript\n   253→   * // Custom config\n   254→   * fileUploadConfig={{\n   255→   *   backend: new EmbedFileUploadBackend(),\n   256→   *   maxFileSize: 5 * 1024 * 1024, // 5MB\n   257→   *   acceptedTypes: ['image/*'],\n   258→   * }}\n   259→   *\n   260→   * // Disable file uploads\n   261→   * fileUploadConfig={false}\n   262→   * ```\n   263→   */\n   264→  fileUploadConfig?: FileUploadConfig | false;\n   265→}\n   266→\n   267→/**\n   268→ * Default file upload configuration.\n   269→ * - Backend: EmbedFileUploadBackend (base64 data URLs)\n   270→ * - Max size: 10MB\n   271→ * - Accepted types: images and PDFs\n   272→ */\n   273→const DEFAULT_FILE_UPLOAD_CONFIG: FileUploadConfig = {\n   274→  backend: new EmbedFileUploadBackend(),\n   275→  maxFileSize: 10 * 1024 * 1024, // 10MB\n   276→  acceptedTypes: ['image/*', 'application/pdf'],\n   277→};\n   278→\n   279→/**\n   280→ * Extracts text content from persisted message content.\n   281→ */\n   282→function getTextFromContent(content: PersistedMessageContent): string {\n   283→  if (typeof content === 'string') {\n   284→    return content;\n   285→  }\n   286→  return content\n   287→    .filter((part): part is { type: 'text'; text: string } => part.type === 'text')\n   288→    .map(part => part.text)\n   289→    .join('\\n');\n   290→}\n   291→\n   292→/**\n   293→ * Custom hook for managing chat storage operations.\n   294→ * Encapsulates all chat repository interactions for better separation of concerns.\n   295→ */\n   296→function useChatStorage(repository: ChatRepository) {\n   297→  const saveUserMessage = useCallback(async (\n   298→    chatId: string,\n   299→    content: PersistedMessageContent\n   300→  ): Promise<boolean> => {\n   301→    try {\n   302→      const chat = await repository.loadChat(chatId);\n   303→\n   304→      if (!chat) {\n   305→        console.error('[ChatStorage] Chat not found:', chatId);\n   306→        return false;\n   307→      }\n   308→\n   309→      chat.messages.push({\n   310→        id: generateMessageId(),\n   311→        role: 'user',\n   312→        content,\n   313→        createdAt: new Date(),\n   314→      });\n   315→\n   316→      // Auto-generate title from text content\n   317→      if (!chat.title) {\n   318→        const text = getTextFromContent(content);\n   319→        if (text) {\n   320→          chat.title = generateChatTitle(text);\n   321→        }\n   322→      }\n   323→\n   324→      await repository.saveChat(chat);\n   325→      console.log('[ChatStorage] Saved user message to storage');\n   326→      return true;\n   327→    } catch (error) {\n   328→      console.error('[ChatStorage] Failed to save user message:', error);\n   329→      return false;\n   330→    }\n   331→  }, [repository]);\n   332→\n   333→  const saveAIResponse = useCallback(async (\n   334→    chatId: string,\n   335→    content: string,\n   336→    displayMode?: 'default' | 'error'\n   337→  ): Promise<boolean> => {\n   338→    try {\n   339→      const chat = await repository.loadChat(chatId);\n   340→\n   341→      if (!chat) {\n   342→        console.error('[ChatStorage] Chat not found:', chatId);\n   343→        return false;\n   344→      }\n   345→\n   346→      chat.messages.push({\n   347→        id: generateMessageId(),\n   348→        role: 'assistant',\n   349→        content,\n   350→        createdAt: new Date(),\n   351→        displayMode,\n   352→      });\n   353→\n   354→      // Auto-generate title from first user message if not set\n   355→      if (!chat.title) {\n   356→        const firstUserMessage = chat.messages.find(msg => msg.role === 'user');\n   357→        if (firstUserMessage) {\n   358→          const textContent = getTextFromContent(firstUserMessage.content);\n   359→          if (textContent) {\n   360→            chat.title = generateChatTitle(textContent);\n   361→          }\n   362→        }\n   363→      }\n   364→\n   365→      await repository.saveChat(chat);\n   366→      console.log('[ChatStorage] Saved AI response to storage for chatId:', chatId);\n   367→      return true;\n   368→    } catch (error) {\n   369→      console.error('[ChatStorage] Failed to save AI response:', error);\n   370→      return false;\n   371→    }\n   372→  }, [repository]);\n   373→\n   374→  const loadChatMessages = useCallback(async (chatId: string): Promise<Message[]> => {\n   375→    try {\n   376→      const chat = await repository.loadChat(chatId);\n   377→\n   378→      if (chat) {\n   379→        const loadedMessages = transformMessagesToUI(chat.messages);\n   380→        console.log('[ChatStorage] Loaded', loadedMessages.length, 'messages from storage for chat:', chatId);\n   381→        return loadedMessages;\n   382→      } else {\n   383→        console.log('[ChatStorage] Chat not found in storage:', chatId);\n   384→        return [];\n   385→      }\n   386→    } catch (error) {\n   387→      console.error('[ChatStorage] Failed to load chat messages:', error);\n   388→      return [];\n   389→    }\n   390→  }, [repository]);\n   391→\n   392→  return {\n   393→    saveUserMessage,\n   394→    saveAIResponse,\n   395→    loadChatMessages,\n   396→  };\n   397→}\n   398→\n   399→/**\n   400→ * Provider component that manages AI client connection and tool registration.\n   401→ * Must wrap all components that use the useAI hook.\n   402→ *\n   403→ * Features:\n   404→ * - Establishes and maintains WebSocket connection to UseAI server\n   405→ * - Aggregates tools from all child useAI hooks\n   406→ * - Handles tool execution requests from the AI\n   407→ * - Provides floating button and chat panel UI\n   408→ *\n   409→ * @param props - Provider configuration and children\n   410→ *\n   411→ * @example\n   412→ * ```typescript\n   413→ * import { UseAIProvider } from '@meetsmore/use-ai-client';\n   414→ *\n   415→ * function App() {\n   416→ *   return (\n   417→ *     <UseAIProvider\n   418→ *       serverUrl=\"wss://your-server.com\"\n   419→ *       systemPrompt=\"You are a helpful assistant for managing todos\"\n   420→ *     >\n   421→ *       <YourApp />\n   422→ *     </UseAIProvider>\n   423→ *   );\n   424→ * }\n   425→ * ```\n   426→ */\n   427→export function UseAIProvider({\n   428→  serverUrl,\n   429→  children,\n   430→  systemPrompt,\n   431→  CustomButton,\n   432→  CustomChat,\n   433→  chatRepository,\n   434→  mcpHeadersProvider,\n   435→  errorMessages: customErrorMessages,\n   436→  fileUploadConfig: fileUploadConfigProp,\n   437→}: UseAIProviderProps) {\n   438→  // Compute effective file upload config: use default if undefined, disable if false\n   439→  const fileUploadConfig = fileUploadConfigProp === false\n   440→    ? undefined\n   441→    : (fileUploadConfigProp ?? DEFAULT_FILE_UPLOAD_CONFIG);\n   442→\n   443→  const [connected, setConnected] = useState(false);\n   444→  const [isChatOpen, setIsChatOpen] = useState(false);\n   445→  const [messages, setMessages] = useState<Message[]>([]);\n   446→  const [loading, setLoading] = useState(false);\n   447→\n   448→  // Agent selection state\n   449→  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);\n   450→  const [defaultAgent, setDefaultAgent] = useState<string | null>(null);\n   451→  const [selectedAgent, setSelectedAgent] = useState<string | null>(null);\n   452→\n   453→  /**\n   454→   * Current active chat where AI responses are saved.\n   455→   * This is the \"source of truth\" for where new AI messages get persisted.\n   456→   */\n   457→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   458→\n   459→  /**\n   460→   * Chat loaded for viewing but not yet active for AI responses.\n   461→   * Becomes currentChatId when user sends their first message.\n   462→   * This prevents race conditions when AI is still responding to the previous chat.\n   463→   */\n   464→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   465→\n   466→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   467→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   468→  const promptsRef = useRef<Map<string, string>>(new Map());\n   469→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   470→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   471→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   472→\n   473→  /**\n   474→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   475→   * Event handlers are created once during mount and don't see updated state values.\n   476→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   477→   */\n   478→  const currentChatIdSnapshot = useRef<string | null>(null);\n   479→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   480→\n   481→  const clientRef = useRef<UseAIClient | null>(null);\n   482→  const repositoryRef = useRef<ChatRepository>(\n   483→    chatRepository || new LocalStorageChatRepository()\n   484→  );\n   485→\n   486→  // Initialize chat storage hook\n   487→  const chatStorage = useChatStorage(repositoryRef.current);\n   488→\n   489→  // Helper function to load messages from storage for display\n   490→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   491→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   492→    setMessages(loadedMessages);\n   493→  }, [chatStorage]);\n   494→\n   495→  const registerTools = useCallback((\n   496→    id: string,\n   497→    tools: ToolsDefinition,\n   498→    waitForRender?: () => Promise<void>\n   499→  ) => {\n   500→    const existingTools = toolRegistryRef.current.get(id);\n   501→\n   502→    // Always update the ref to capture latest closures\n   503→    toolRegistryRef.current.set(id, tools);\n   504→\n   505→    // Only increment version if tool names changed (added/removed tools)\n   506→    if (existingTools) {\n   507→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   508→      const newKeys = Object.keys(tools).sort().join(',');\n   509→      if (existingKeys !== newKeys) {\n   510→        setToolRegistryVersion(v => v + 1);\n   511→      }\n   512→    } else {\n   513→      // First registration\n   514→      setToolRegistryVersion(v => v + 1);\n   515→    }\n   516→\n   517→    Object.keys(tools).forEach(toolName => {\n   518→      toolOwnershipRef.current.set(toolName, id);\n   519→    });\n   520→\n   521→    if (waitForRender) {\n   522→      renderWaitersRef.current.set(id, waitForRender);\n   523→    }\n   524→  }, []);\n   525→\n   526→  // Helper to build state from all prompts\n   527→  const buildStateFromPrompts = useCallback(() => {\n   528→    const promptParts: string[] = [];\n   529→    if (systemPrompt) {\n   530→      promptParts.push(systemPrompt);\n   531→    }\n   532→    for (const [, prompt] of promptsRef.current.entries()) {\n   533→      if (prompt) {\n   534→        promptParts.push(prompt);\n   535→      }\n   536→    }\n   537→    return promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   538→  }, [systemPrompt]);\n   539→\n   540→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   541→    if (prompt) {\n   542→      promptsRef.current.set(id, prompt);\n   543→    } else {\n   544→      promptsRef.current.delete(id);\n   545→    }\n   546→\n   547→    if (suggestions && suggestions.length > 0) {\n   548→      suggestionsRef.current.set(id, suggestions);\n   549→    } else {\n   550→      suggestionsRef.current.delete(id);\n   551→    }\n   552→\n   553→    // Update client state immediately when prompts change\n   554→    if (clientRef.current) {\n   555→      clientRef.current.updateState(buildStateFromPrompts());\n   556→    }\n   557→  }, [buildStateFromPrompts]);\n   558→\n   559→  const unregisterTools = useCallback((id: string) => {\n   560→    const tools = toolRegistryRef.current.get(id);\n   561→    if (tools) {\n   562→      Object.keys(tools).forEach(toolName => {\n   563→        toolOwnershipRef.current.delete(toolName);\n   564→      });\n   565→    }\n   566→\n   567→    toolRegistryRef.current.delete(id);\n   568→    setToolRegistryVersion(v => v + 1);\n   569→    promptsRef.current.delete(id);\n   570→    suggestionsRef.current.delete(id);\n   571→    renderWaitersRef.current.delete(id);\n   572→  }, []);\n   573→\n   574→  const aggregatedTools = React.useMemo(() => {\n   575→    const tools: ToolsDefinition = {};\n   576→    toolRegistryRef.current.forEach((toolSet) => {\n   577→      Object.assign(tools, toolSet);\n   578→    });\n   579→    return tools;\n   580→  }, [toolRegistryVersion]);\n   581→\n   582→  const aggregatedSuggestions = React.useMemo(() => {\n   583→    const allSuggestions: string[] = [];\n   584→    suggestionsRef.current.forEach((suggestions) => {\n   585→      allSuggestions.push(...suggestions);\n   586→    });\n   587→    return allSuggestions;\n   588→  }, [toolRegistryVersion]);\n   589→\n   590→  const hasTools = toolRegistryRef.current.size > 0;\n   591→  const aggregatedToolsRef = useRef(aggregatedTools);\n   592→  aggregatedToolsRef.current = aggregatedTools;\n   593→\n   594→  // Keep snapshot refs in sync with latest chat IDs\n   595→  useEffect(() => {\n   596→    currentChatIdSnapshot.current = currentChatId;\n   597→  }, [currentChatId]);\n   598→\n   599→  useEffect(() => {\n   600→    pendingChatIdSnapshot.current = pendingChatId;\n   601→  }, [pendingChatId]);\n   602→\n   603→  /**\n   604→   * Handles saving AI response to storage and updating UI.\n   605→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   606→   */\n   607→  const handleAIResponse = useCallback(async (content: string, displayMode?: 'default' | 'error') => {\n   608→    const currentChatIdValue = currentChatIdSnapshot.current;\n   609→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   610→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   611→\n   612→    if (!currentChatIdValue) {\n   613→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   614→      return;\n   615→    }\n   616→\n   617→    // Save AI response to storage\n   618→    const saved = await chatStorage.saveAIResponse(currentChatIdValue, content, displayMode);\n   619→\n   620→    // Reload UI if save was successful and user is viewing this chat\n   621→    if (saved && displayedChatId === currentChatIdValue) {\n   622→      await loadMessagesFromStorage(currentChatIdValue);\n   623→    }\n   624→  }, [chatStorage, loadMessagesFromStorage]);\n   625→\n   626→  useEffect(() => {\n   627→    console.log('[UseAIProvider] Initializing client with serverUrl:', serverUrl);\n   628→    const client = new UseAIClient(serverUrl);\n   629→\n   630→    // Set MCP headers provider if provided\n   631→    if (mcpHeadersProvider) {\n   632→      client.setMcpH