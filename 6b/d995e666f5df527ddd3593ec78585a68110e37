          "text": "     1→import React, { useState, useRef, useEffect, useCallback } from 'react';\n     2→import type { Chat, PersistedMessageContent, PersistedContentPart } from '../providers/chatRepository/types';\n     3→import type { AgentInfo } from '../types';\n     4→import type { FileAttachment, FileUploadConfig } from '../fileUpload/types';\n     5→import { DEFAULT_MAX_FILE_SIZE } from '../fileUpload/types';\n     6→import { MarkdownContent } from './MarkdownContent';\n     7→import { FileChip, FilePlaceholder } from './FileChip';\n     8→import { v4 as uuidv4 } from 'uuid';\n     9→\n    10→/**\n    11→ * Display mode for chat messages.\n    12→ */\n    13→type MessageDisplayMode = 'default' | 'error';\n    14→\n    15→/**\n    16→ * Represents a single message in the AI conversation.\n    17→ */\n    18→interface Message {\n    19→  /** Unique identifier for the message */\n    20→  id: string;\n    21→  /** The role of the message sender */\n    22→  role: 'user' | 'assistant';\n    23→  /** The message content - string or multimodal content */\n    24→  content: PersistedMessageContent;\n    25→  /** When the message was created */\n    26→  timestamp: Date;\n    27→  /** Display mode for styling the message bubble */\n    28→  displayMode?: MessageDisplayMode;\n    29→}\n    30→\n    31→/**\n    32→ * Helper to extract text content from message content.\n    33→ */\n    34→function getTextContent(content: PersistedMessageContent): string {\n    35→  if (typeof content === 'string') {\n    36→    return content;\n    37→  }\n    38→  return content\n    39→    .filter((part): part is { type: 'text'; text: string } => part.type === 'text')\n    40→    .map(part => part.text)\n    41→    .join('\\n');\n    42→}\n    43→\n    44→/**\n    45→ * Helper to check if content has file attachments.\n    46→ */\n    47→function hasFileContent(content: PersistedMessageContent): content is PersistedContentPart[] {\n    48→  return Array.isArray(content) && content.some(part => part.type === 'file');\n    49→}\n    50→\n    51→/**\n    52→ * Generates a preview for image files.\n    53→ */\n    54→async function generateImagePreview(file: File): Promise<string | undefined> {\n    55→  if (!file.type.startsWith('image/')) {\n    56→    return undefined;\n    57→  }\n    58→\n    59→  return new Promise((resolve) => {\n    60→    const reader = new FileReader();\n    61→    reader.onload = () => {\n    62→      if (typeof reader.result === 'string') {\n    63→        resolve(reader.result);\n    64→      } else {\n    65→        resolve(undefined);\n    66→      }\n    67→    };\n    68→    reader.onerror = () => resolve(undefined);\n    69→    reader.readAsDataURL(file);\n    70→  });\n    71→}\n    72→\n    73→/**\n    74→ * Checks if a MIME type matches accepted types.\n    75→ */\n    76→function isTypeAccepted(mimeType: string, acceptedTypes?: string[]): boolean {\n    77→  if (!acceptedTypes || acceptedTypes.length === 0) {\n    78→    return true;\n    79→  }\n    80→\n    81→  return acceptedTypes.some(pattern => {\n    82→    if (pattern.endsWith('/*')) {\n    83→      // Wildcard pattern like 'image/*'\n    84→      const prefix = pattern.slice(0, -1);\n    85→      return mimeType.startsWith(prefix);\n    86→    }\n    87→    return mimeType === pattern;\n    88→  });\n    89→}\n    90→\n    91→interface UseAIChatPanelProps {\n    92→  isOpen: boolean;\n    93→  onClose: () => void;\n    94→  /** Callback when a message is sent, with optional file attachments */\n    95→  onSendMessage: (message: string, attachments?: FileAttachment[]) => void;\n    96→  messages: Message[];\n    97→  loading: boolean;\n    98→  connected: boolean;\n    99→  currentChatId?: string | null;\n   100→  onNewChat?: () => Promise<string | void>;\n   101→  onLoadChat?: (chatId: string) => Promise<void>;\n   102→  onDeleteChat?: (chatId: string) => Promise<void>;\n   103→  onListChats?: () => Promise<Array<Omit<Chat, 'messages'>>>;\n   104→  suggestions?: string[];\n   105→  availableAgents?: AgentInfo[];\n   106→  defaultAgent?: string | null;\n   107→  selectedAgent?: string | null;\n   108→  onAgentChange?: (agentId: string | null) => void;\n   109→  /** Configuration for file uploads */\n   110→  fileUploadConfig?: FileUploadConfig;\n   111→}\n   112→\n   113→export function UseAIChatPanel({\n   114→  isOpen,\n   115→  onClose,\n   116→  onSendMessage,\n   117→  messages,\n   118→  loading,\n   119→  connected,\n   120→  currentChatId,\n   121→  onNewChat,\n   122→  onLoadChat,\n   123→  onDeleteChat,\n   124→  onListChats,\n   125→  suggestions,\n   126→  availableAgents,\n   127→  defaultAgent,\n   128→  selectedAgent,\n   129→  onAgentChange,\n   130→  fileUploadConfig,\n   131→}: UseAIChatPanelProps) {\n   132→  const [input, setInput] = useState('');\n   133→  const [showChatHistory, setShowChatHistory] = useState(false);\n   134→  const [showAgentDropdown, setShowAgentDropdown] = useState(false);\n   135→  const [chatHistory, setChatHistory] = useState<Array<Omit<Chat, 'messages'>>>([]);\n   136→  const messagesEndRef = useRef<HTMLDivElement>(null);\n   137→  const [displayedSuggestions, setDisplayedSuggestions] = useState<string[]>([]);\n   138→\n   139→  // File upload state\n   140→  const [attachments, setAttachments] = useState<FileAttachment[]>([]);\n   141→  const [isDragging, setIsDragging] = useState(false);\n   142→  const [fileError, setFileError] = useState<string | null>(null);\n   143→  const fileInputRef = useRef<HTMLInputElement>(null);\n   144→\n   145→  // File upload config defaults\n   146→  const maxFileSize = fileUploadConfig?.maxFileSize ?? DEFAULT_MAX_FILE_SIZE;\n   147→  const acceptedTypes = fileUploadConfig?.acceptedTypes;\n   148→  const fileUploadEnabled = fileUploadConfig !== undefined;\n   149→\n   150→  // Clear file error after 3 seconds\n   151→  useEffect(() => {\n   152→    if (fileError) {\n   153→      const timer = setTimeout(() => setFileError(null), 3000);\n   154→      return () => clearTimeout(timer);\n   155→    }\n   156→  }, [fileError]);\n   157→\n   158→  // Clear attachments when chat changes\n   159→  useEffect(() => {\n   160→    setAttachments([]);\n   161→    setFileError(null);\n   162→  }, [currentChatId]);\n   163→\n   164→  /**\n   165→   * Validates and adds files to attachments.\n   166→   */\n   167→  const handleFiles = useCallback(async (files: FileList | File[]) => {\n   168→    const fileArray = Array.from(files);\n   169→\n   170→    for (const file of fileArray) {\n   171→      // Check file size\n   172→      if (file.size > maxFileSize) {\n   173→        setFileError(`File \"${file.name}\" exceeds ${Math.round(maxFileSize / (1024 * 1024))}MB limit`);\n   174→        continue;\n   175→      }\n   176→\n   177→      // Check file type\n   178→      if (!isTypeAccepted(file.type, acceptedTypes)) {\n   179→        setFileError(`File type \"${file.type}\" is not accepted`);\n   180→        continue;\n   181→      }\n   182→\n   183→      // Generate preview for images\n   184→      const preview = await generateImagePreview(file);\n   185→\n   186→      // Add to attachments\n   187→      setAttachments(prev => [\n   188→        ...prev,\n   189→        {\n   190→          id: uuidv4(),\n   191→          file,\n   192→          preview,\n   193→        },\n   194→      ]);\n   195→    }\n   196→  }, [maxFileSize, acceptedTypes]);\n   197→\n   198→  /**\n   199→   * Removes a file attachment.\n   200→   */\n   201→  const removeAttachment = useCallback((id: string) => {\n   202→    setAttachments(prev => prev.filter(a => a.id !== id));\n   203→  }, []);\n   204→\n   205→  // Drag and drop handlers\n   206→  const handleDragOver = useCallback((e: React.DragEvent) => {\n   207→    e.preventDefault();\n   208→    e.stopPropagation();\n   209→    if (fileUploadEnabled && !loading) {\n   210→      setIsDragging(true);\n   211→    }\n   212→  }, [fileUploadEnabled, loading]);\n   213→\n   214→  const handleDragLeave = useCallback((e: React.DragEvent) => {\n   215→    e.preventDefault();\n   216→    e.stopPropagation();\n   217→    setIsDragging(false);\n   218→  }, []);\n   219→\n   220→  const handleDrop = useCallback((e: React.DragEvent) => {\n   221→    e.preventDefault();\n   222→    e.stopPropagation();\n   223→    setIsDragging(false);\n   224→\n   225→    if (!fileUploadEnabled || loading) return;\n   226→\n   227→    const files = e.dataTransfer.files;\n   228→    if (files.length > 0) {\n   229→      handleFiles(files);\n   230→    }\n   231→  }, [fileUploadEnabled, loading, handleFiles]);\n   232→\n   233→  /**\n   234→   * Opens the file picker dialog.\n   235→   */\n   236→  const openFilePicker = useCallback(() => {\n   237→    fileInputRef.current?.click();\n   238→  }, []);\n   239→\n   240→  /**\n   241→   * Handles file input change.\n   242→   */\n   243→  const handleFileInputChange = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {\n   244→    const files = e.target.files;\n   245→    if (files && files.length > 0) {\n   246→      handleFiles(files);\n   247→    }\n   248→    // Reset input so the same file can be selected again\n   249→    e.target.value = '';\n   250→  }, [handleFiles]);\n   251→\n   252→  useEffect(() => {\n   253→    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });\n   254→  }, [messages]);\n   255→\n   256→  // Randomly select up to 4 suggestions when chat opens or when messages become empty\n   257→  useEffect(() => {\n   258→    if (!suggestions || suggestions.length === 0) {\n   259→      setDisplayedSuggestions([]);\n   260→      return;\n   261→    }\n   262→\n   263→    // Shuffle array and take up to 4 items\n   264→    const shuffled = [...suggestions].sort(() => Math.random() - 0.5);\n   265→    setDisplayedSuggestions(shuffled.slice(0, 4));\n   266→  }, [isOpen, messages.length, suggestions]);\n   267→\n   268→  const handleSend = () => {\n   269→    // Allow sending if there's text or attachments\n   270→    const hasContent = input.trim() || attachments.length > 0;\n   271→    if (!hasContent || !connected || loading) return;\n   272→\n   273→    onSendMessage(input, attachments.length > 0 ? attachments : undefined);\n   274→    setInput('');\n   275→    setAttachments([]);\n   276→  };\n   277→\n   278→  const handleKeyPress = (e: React.KeyboardEvent) => {\n   279→    if (e.key === 'Enter' && !e.shiftKey) {\n   280→      e.preventDefault();\n   281→      handleSend();\n   282→    }\n   283→  };\n   284→\n   285→  const handleNewChat = async () => {\n   286→    if (onNewChat) {\n   287→      await onNewChat();\n   288→    }\n   289→  };\n   290→\n   291→  const handleDeleteChat = async () => {\n   292→    if (onDeleteChat && currentChatId && confirm('Delete this chat from history?')) {\n   293→      await onDeleteChat(currentChatId);\n   294→      if (onNewChat) {\n   295→        await onNewChat();\n   296→      }\n   297→    }\n   298→  };\n   299→\n   300→  const handleShowHistory = async () => {\n   301→    if (onListChats) {\n   302→      const chats = await onListChats();\n   303→      setChatHistory(chats);\n   304→      setShowChatHistory(true);\n   305→    }\n   306→  };\n   307→\n   308→  const handleLoadChat = async (chatId: string) => {\n   309→    if (onLoadChat) {\n   310→      await onLoadChat(chatId);\n   311→      setShowChatHistory(false);\n   312→    }\n   313→  };\n   314→\n   315→  if (!isOpen) return null;\n   316→\n   317→  return (\n   318→    <>\n   319→      <div\n   320→        style={{\n   321→          position: 'fixed',\n   322→          top: 0,\n   323→          left: 0,\n   324→          right: 0,\n   325→          bottom: 0,\n   326→          background: 'rgba(0, 0, 0, 0.3)',\n   327→          zIndex: 999,\n   328→          animation: 'fadeIn 0.2s',\n   329→        }}\n   330→        onClick={onClose}\n   331→      />\n   332→      <div\n   333→        style={{\n   334→          position: 'fixed',\n   335→          bottom: '24px',\n   336→          right: '24px',\n   337→          width: '380px',\n   338→          height: '600px',\n   339→          maxHeight: 'calc(100vh - 48px)',\n   340→          background: 'white',\n   341→          borderRadius: '16px',\n   342→          boxShadow: '0 8px 32px rgba(0, 0, 0, 0.12)',\n   343→          display: 'flex',\n   344→          flexDirection: 'column',\n   345→          zIndex: 1001,\n   346→          animation: 'slideIn 0.3s ease-out',\n   347→          fontFamily: '-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif',\n   348→        }}\n   349→      >\n   350→        {/* Header */}\n   351→        <div\n   352→          style={{\n   353→            padding: '12px 16px',\n   354→            borderBottom: '1px solid #e5e7eb',\n   355→            background: 'white',\n   356→            borderRadius: '16px 16px 0 0',\n   357→            display: 'flex',\n   358→            alignItems: 'center',\n   359→            justifyContent: 'space-between',\n   360→            gap: '12px',\n   361→          }}\n   362→        >\n   363→          {/* Left side: Chat dropdown */}\n   364→          <div style={{ flex: 1, minWidth: 0, position: 'relative' }}>\n   365→            {onListChats ? (\n   366→              <button\n   367→                data-testid=\"chat-history-dropdown-button\"\n   368→                onClick={async () => {\n   369→                  const chats = await onListChats();\n   370→                  setChatHistory(chats);\n   371→                  setShowChatHistory(!showChatHistory);\n   372→                }}\n   373→                style={{\n   374→                  background: 'transparent',\n   375→                  border: 'none',\n   376→                  padding: '6px 8px',\n   377→                  cursor: 'pointer',\n   378→                  display: 'flex',\n   379→                  alignItems: 'center',\n   380→                  gap: '8px',\n   381→                  fontSize: '14px',\n   382→                  fontWeight: '600',\n   383→                  color: '#1f2937',\n   384→                  borderRadius: '6px',\n   385→                  transition: 'background 0.2s',\n   386→                  width: '100%',\n   387→                  textAlign: 'left',\n   388→                  overflow: 'hidden',\n   389→                }}\n   390→                onMouseEnter={(e: React.MouseEvent<HTMLButtonElement>) => {\n   391→                  e.currentTarget.style.background = '#f3f4f6';\n   392→                }}\n   393→                onMouseLeave={(e: React.MouseEvent<HTMLButtonElement>) => {\n   394→                  e.currentTarget.style.background = 'transparent';\n   395→                }}\n   396→              >\n   397→                <span style={{\n   398→                  overflow: 'hidden',\n   399→                  textOverflow: 'ellipsis',\n   400→                  whiteSpace: 'nowrap',\n   401→                  flex: 1,\n   402→                  minWidth: 0,\n   403→                }}>\n   404→                  {/* Get current chat title */}\n   405→                  {(() => {\n   406→                    if (messages.length > 0) {\n   407→                      const firstUserMsg = messages.find(m => m.role === 'user');\n   408→                      if (firstUserMsg) {\n   409→                        const textContent = getTextContent(firstUserMsg.content);\n   410→                        const maxLength = 30;\n   411→                        return textContent.length > maxLength\n   412→                          ? textContent.substring(0, maxLength) + '...'\n   413→                          : textContent || 'New Chat';\n   414→                      }\n   415→                    }\n   416→                    return 'New Chat';\n   417→                  })()}\n   418→                </span>\n   419→                <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" style={{ flexShrink: 0 }}>\n   420→                  <path d=\"M3 4.5L6 7.5L9 4.5\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/>\n   421→                </svg>\n   422→              </button>\n   423→            ) : (\n   424→              <div style={{ fontSize: '14px', fontWeight: '600', color: '#1f2937', padding: '6px 8px' }}>\n   425→                AI Assistant\n   426→              </div>\n   427→            )}\n   428→          </div>\n   429→\n   430→          {/* Right side: Actions */}\n   431→          <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>\n   432→            {/* Connection status */}\n   433→            <div\n   434→              style={{\n   435→                width: '8px',\n   436→                height: '8px',\n   437→                borderRadius: '50%',\n   438→                background: connected ? '#10b981' : '#6b7280',\n   439→              }}\n   440→              title={connected ? 'Online' : 'Offline'}\n   441→            />\n   442→\n   443→            {/* Model selector */}\n   444→            {availableAgents && availableAgents.length > 1 && onAgentChange && (\n   445→              <div style={{ position: 'relative' }}>\n   446→                <button\n   447→                  data-testid=\"agent-selector\"\n   448→                  onClick={() => setShowAgentDropdown(!showAgentDropdown)}\n   449→                  style={{\n   450→                    background: 'transparent',\n   451→                    border: 'none',\n   452→                    padding: '6px 8px',\n   453→                    cursor: 'pointer',\n   454→                    display: 'flex',\n   455→                    alignItems: 'center',\n   456→                    gap: '4px',\n   457→                    fontSize: '13px',\n   458→                    fontWeight: '500',\n   459→                    color: '#6b7280',\n   460→                    borderRadius: '6px',\n   461→                    transition: 'all 0.2s',\n   462→                  }}\n   463→                  onMouseEnter={(e: React.MouseEvent<HTMLButtonElement>) => {\n   464→                    e.currentTarget.style.background = '#f3f4f6';\n   465→                    e.currentTarget.style.color = '#1f2937';\n   466→                  }}\n   467→                  onMouseLeave={(e: React.MouseEvent<HTMLButtonElement>) => {\n   468→                    e.currentTarget.style.background = 'transparent';\n   469→                    e.currentTarget.style.color = '#6b7280';\n   470→                  }}\n   471→                  title=\"Select AI model\"\n   472→                >\n   473→                  <span style={{\n   474→                    overflow: 'hidden',\n   475→                    textOverflow: 'ellipsis',\n   476→                    whiteSpace: 'nowrap',\n   477→                    maxWidth: '80px',\n   478→                  }}>\n   479→                    {availableAgents.find(a => a.id === (selectedAgent ?? defaultAgent))?.name || 'AI'}\n   480→                  </span>\n   481→                  <svg width=\"10\" height=\"10\" viewBox=\"0 0 12 12\" fill=\"none\" style={{ flexShrink: 0 }}>\n   482→                    <path d=\"M3 4.5L6 7.5L9 4.5\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/>\n   483→                  </svg>\n   484→                </button>\n   485→\n   486→                {/* Agent Selector Dropdown */}\n   487→                {showAgentDropdown && (\n   488→                  <div\n   489→                    style={{\n   490→                      position: 'absolute',\n   491→                      top: '100%',\n   492→                      left: '50%',\n   493→                      transform: 'translateX(-50%)',\n   494→                      marginTop: '4px',\n   495→                      minWidth: '140px',\n   496→                      background: 'white',\n   497→                      borderRadius: '8px',\n   498→                      boxShadow: '0 4px 16px rgba(0, 0, 0, 0.15)',\n   499→                      zIndex: 1003,\n   500→                      overflow: 'hidden',\n   501→                      padding: '4px',\n   502→                    }}\n   503→                  >\n   504→                    {availableAgents.map((agent) => {\n   505→                      const isSelected = agent.id === (selectedAgent ?? defaultAgent);\n   506→                      return (\n   507→                        <div\n   508→                          key={agent.id}\n   509→                          data-testid=\"agent-option\"\n   510→                          onClick={() => {\n   511→                            onAgentChange(agent.id === defaultAgent ? null : agent.id);\n   512→                            setShowAgentDropdown(false);\n   513→                          }}\n   514→                          style={{\n   515→                            padding: '8px 12px',\n   516→                            background: isSelected ? '#f0f0ff' : 'transparent',\n   517→                            borderRadius: '6px',\n   518→                            cursor: 'pointer',\n   519→                            fontSize: '13px',\n   520→                            fontWeight: isSelected ? '600' : '500',\n   521→                            color: isSelected ? '#667eea' : '#1f2937',\n   522→                            transition: 'background 0.15s',\n   523→                            display: 'flex',\n   524→                            alignItems: 'center',\n   525→                            justifyContent: 'space-between',\n   526→                          }}\n   527→                          onMouseEnter={(e: React.MouseEvent<HTMLDivElement>) => {\n   528→                            if (!isSelected) {\n   529→                              e.currentTarget.style.background = '#f9fafb';\n   530→                            }\n   531→                          }}\n   532→                          onMouseLeave={(e: React.MouseEvent<HTMLDivElement>) => {\n   533→               