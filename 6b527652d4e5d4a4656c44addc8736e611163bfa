            "content": "import type { ToolDefinition } from './types';\n\nexport interface ToolFunction {\n  (...args: unknown[]): unknown | Promise<unknown>;\n}\n\nexport interface ToolConfig {\n  description: string;\n  parameters?: {\n    [key: string]: {\n      type: 'string' | 'number' | 'boolean' | 'object' | 'array';\n      description?: string;\n      required?: boolean;\n    };\n  };\n}\n\nexport type ToolRegistry = Record<string, {\n  fn: ToolFunction;\n  config: ToolConfig;\n}>;\n\nexport function createToolDefinition(\n  name: string,\n  config: ToolConfig\n): ToolDefinition {\n  const properties: Record<string, unknown> = {};\n  const required: string[] = [];\n\n  if (config.parameters) {\n    for (const [paramName, paramConfig] of Object.entries(config.parameters)) {\n      properties[paramName] = {\n        type: paramConfig.type,\n        description: paramConfig.description,\n      };\n\n      if (paramConfig.required) {\n        required.push(paramName);\n      }\n    }\n  }\n\n  return {\n    name,\n    description: config.description,\n    input_schema: {\n      type: 'object',\n      properties,\n      required: required.length > 0 ? required : undefined,\n    },\n  };\n}\n\nexport function createToolRegistry(\n  tools: Record<string, { fn: ToolFunction; config: ToolConfig }>\n): { registry: ToolRegistry; definitions: ToolDefinition[] } {\n  const registry: ToolRegistry = tools;\n  const definitions: ToolDefinition[] = [];\n\n  for (const [name, tool] of Object.entries(tools)) {\n    definitions.push(createToolDefinition(name, tool.config));\n  }\n\n  return { registry, definitions };\n}\n\nexport async function executeToolCall(\n  registry: ToolRegistry,\n  toolName: string,\n  input: Record<string, unknown>\n): Promise<unknown> {\n  const tool = registry[toolName];\n\n  if (!tool) {\n    throw new Error(`Tool \"${toolName}\" not found`);\n  }\n\n  try {\n    const result = await tool.fn(input);\n    return result;\n  } catch (error) {\n    console.error(`Error executing tool \"${toolName}\":`, error);\n    throw error;\n  }\n}\n",
