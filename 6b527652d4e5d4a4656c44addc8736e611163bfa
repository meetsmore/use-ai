verUrl, options.tools]);\n\n  const handleServerMessage = useCallback(async (message: ServerMessage) => {\n    switch (message.type) {\n      case 'tool_call': {\n        const toolCall = message as ToolCallMessage;\n        const { toolCallId, name, input } = toolCall.data;\n\n        try {\n          const result = await executeToolCall(toolRegistryRef.current, name, input);\n          clientRef.current?.sendToolResponse(toolCallId, result);\n        } catch (err) {\n          const error = err instanceof Error ? err : new Error('Tool execution failed');\n          console.error('Tool execution error:', error);\n          clientRef.current?.sendToolResponse(toolCallId, {\n            error: error.message,\n          });\n        }\n        break;\n      }\n\n      case 'response': {\n        const responseMsg = message as ResponseMessage;\n        setResponse(responseMsg.data.content);\n        setLoading(false);\n        break;\n      }\n\n      case 'error': {\n        const errorMsg = message as ErrorMessage;\n        const error = new Error(errorMsg.data.message);\n        setError(error);\n        setLoading(false);\n        options.onError?.(error);\n        break;\n      }\n    }\n  }, [options.onError]);\n\n  const generate = useCallback(async (prompt: string) => {\n    if (!clientRef.current?.isConnected()) {\n      const error = new Error('Not connected to server');\n      setError(error);\n      options.onError?.(error);\n      return;\n    }\n\n    setLoading(true);\n    setError(null);\n    setResponse(null);\n\n    try {\n      clientRef.current.sendPrompt(prompt);\n    } catch (err) {\n      const error = err instanceof Error ? err : new Error('Unknown error');\n      setError(error);\n      setLoading(false);\n      options.onError?.(error);\n    }\n  }, [options.onError]);\n\n  return {\n    response,\n    loading,\n    error,\n    generate,\n    connected,\n  };\n}\n",
