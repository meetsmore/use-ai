352→        type: EventType.RUN_ERROR,\n   353→        message: error instanceof Error ? error.message : 'Unknown error',\n   354→        timestamp: Date.now(),\n   355→      });\n   356→    }\n   357→  }\n   358→\n   359→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Record<string, any> {\n   360→    const toolsObject: Record<string, any> = {};\n   361→\n   362→    for (const toolDef of tools) {\n   363→      toolsObject[toolDef.name] = {\n   364→        description: toolDef.description,\n   365→        parameters: jsonSchema(toolDef.parameters),\n   366→        // No execute function - we handle tool calls manually\n   367→      };\n   368→    }\n   369→\n   370→    return toolsObject;\n   371→  }\n   372→\n   373→  private buildSystemPrompt(session: ClientSession, state: unknown): string | undefined {\n   374→    const parts: string[] = [];\n   375→\n   376→    // Add state context if available\n   377→    if (state) {\n   378→      parts.push('You are interacting with a web application. Here is the current state:');\n   379→      parts.push('');\n   380→      parts.push(JSON.stringify(state, null, 2));\n   381→      parts.push('');\n   382→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   383→    }\n   384→\n   385→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   386→    if (confirmationTools.length > 0) {\n   387→      if (parts.length > 0) {\n   388→        parts.push('');\n   389→      }\n   390→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   391→      parts.push('');\n   392→      confirmationTools.forEach(tool => {\n   393→        parts.push(`- ${tool.name}`);\n   394→      });\n   395→      parts.push('');\n   396→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   397→      parts.push('1. First, explain to the user exactly what changes will be made');\n   398→      parts.push('2. T