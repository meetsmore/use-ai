es to AI SDK CoreMessage format\n   259→    const coreMessages: CoreMessage[] = messages.map(msg => {\n   260→      // Helper to convert content to string if it's an array (AG-UI format)\n   261→      const getStringContent = (content: string | any[] | Record<string, any> | undefined): string => {\n   262→        if (!content) return '';\n   263→        if (typeof content === 'string') return content;\n   264→        // If it's an array, extract text from text blocks\n   265→        if (Array.isArray(content)) {\n   266→          return content\n   267→            .filter((block: any) => block.type === 'text')\n   268→            .map((block: any) => block.text)\n   269→            .join('');\n   270→        }\n   271→        // If it's an object (Record), convert to JSON string\n   272→        if (typeof content === 'object') {\n   273→          return JSON.stringify(content);\n   274→        }\n   275→        return '';\n   276→      };\n   277→\n   278→      if (msg.role === 'user') {\n   279→        return {\n   280→          role: 'user' as const,\n   281→          content: getStringContent(msg.content),\n   282→        };\n   283→      } else if (msg.role === 'assistant') {\n   284→        return {\n   285→          role: 'assistant' as const,\n   286→          content: getStringContent(msg.content),\n   287→        };\n   288→      } else if (msg.role === 'tool') {\n   289→        // Tool messages in AI SDK format\n   290→        return {\n   291→          role: 'tool' as const,\n   292→          content: [\n   293→            {\n   294→              type: 'tool-result' as const,\n   295→              toolCallId: (msg as any).tool_call_id || uuidv4(),\n   296→              toolName: (msg as any).tool_name || 'unknown',\n   297→              result: getStringContent(msg.content),\n   298→            },\n   299→          ],\n   300→        } as CoreToolMessage;\n   301→      }\n   302→      // Default fallback\n   303→      return {\n   304→        role: 'user'