ed: true,\n   167→              metadata: {\n   168→                sessionId: session.clientId,\n   169→                threadId: session.threadId,\n   170→                runId,\n   171→                ipAddress: session.ipAddress,\n   172→                toolCount: tools.length,\n   173→              },\n   174→            }\n   175→          : undefined,\n   176→      });\n   177→\n   178→      logger.apiRequest({\n   179→        tools: tools.map((t) => t.name),\n   180→        messageCount: messages.length,\n   181→        messages: messages.map((msg: any) => ({\n   182→          role: msg.role,\n   183→          preview:\n   184→            typeof msg.content === 'string'\n   185→              ? msg.content.substring(0, 80) + (msg.content.length > 80 ? '...' : '')\n   186→              : `${msg.content.length} content blocks`,\n   187→        })),\n   188→        systemPrompt,\n   189→      });\n   190→\n   191→      // Check for empty response (no text, no tool calls) - this is a bug\n   192→      if (!result.text && (!result.toolCalls || result.toolCalls.length === 0)) {\n   193→        events.emit<RunErrorEvent>({\n   194→          type: EventType.RUN_ERROR,\n   195→          message:\n   196→            'AI returned an empty response. This may be due to an ambiguous request. Please try being more specific.',\n   197→          timestamp: Date.now(),\n   198→        });\n   199→        return {\n   200→          success: false,\n   201→          error: 'Empty response from AI',\n   202→          conversationHistory: messages,\n   203→        };\n   204→      }\n   205→\n   206→      await this.processResponse(session, result, runId, events);\n   207→\n   208→      return {\n   209→        success: true,\n   210→        conversationHistory: session.conversationHistory,\n   211→      };\n   212→    } catch (error) {\n   213→      logger.error('Error calling AI SDK model', {\n   214→        error: error instanceof Error ? error.message : 'Unknown error',\n   215→        clientId: session.clientId,\n   216→      });\n   217→\n   218→      events.emit<RunErrorEvent>({\n   219→        type: EventType.RUN_ERROR,\n   220→        message: error instanceof Error ? error.message : 'Unknown error',\n   221→        timestamp: Date.now(),\n   222→      });\n   223→\n   224→      return {\n   225→        success: false,\n   226→        error: error instanceof Error ? error.message : 'Unknown error',\n   227→        conversationHistory: messages,\n   228→      };\n   229→    }\n   230→  }\n   231→\n   232→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Record<string, any> {\n   233→    const toolsObject: Record<string, any> = {};\n   234→\n   235→    for (const toolDef of tools) {\n   236→      toolsObject[toolDef.name] = {\n   237→        description: toolDef.description,\n   238→        parameters: jsonSchema(toolDef.parameters),\n   239→      };\n   240→    }\n   241→\n   242→    return toolsObject;\n   243→  }\n   244→\n   245→  private async processResponse(\n   246→    session: any,\n   247→    result: Awaited<ReturnType<typeof generateText>>,\n   248→    runId: string,\n   249→    events: EventEmitter\n   250→  ) {\n   251→    // Build assistant message content\n   252→    const assistantContent: any[] = [];\n   253→\n   254→    // Add text if present\n   255→    if (result.text) {\n   256→      assistantContent.push({ type: 'text', text: result.text });\n   257→    }\n   258→\n   259→    // Add tool calls if present\n   260→    if (result.toolCalls && result.toolCalls.length > 0) {\n   261→      for (const toolCall of result.toolCalls) {\n   262→        assistantContent.push({\n   263→          type: 'tool-call',\n   264→          toolCallId: toolCall.toolCallId,\n   265→          toolName: toolCall.toolName,\n   266→          args: toolCall.args,\n   267→        });\n   268→      }\n   269→    }\n   270→\n   271→    // Add assistant message to conversation history\n   272→    session.conversationHistory.push({\n   273→      role: 'assistant',\n   274→      content: assistantContent,\n   275→    } as any);\n   276→\n   277→    // Emit text message events\n   278→    if (result.text) {\n   279→      const messageId = uuidv4();\n   280→\n   281→      // Emit TEXT_MESSAGE_START\n   282→      events.emit<TextMessageStartEvent>({\n   283→        type: EventType.TEXT_MESSAGE_START,\n   284→        messageId,\n   285→        role: 'assistant',\n   286→        timestamp: Date.now(),\n   287→      });\n   288→\n   289→      // Emit TEXT_MESSAGE_CONTENT\n   290→      events.emit<TextMessageContentEvent>({\n   291→        type: EventType.TEXT_MESSAGE_CONTENT,\n   292→        messageId,\n   293→        delta: result.text,\n   294→        timestamp: Date.now(),\n   295→      });\n   296→\n   297→      // Emit TEXT_MESSAGE_END\n   298→      events.emit<TextMessageEndEvent>({\n   299→        type: EventType.TEXT_MESSAGE_END,\n   300→        messageId,\n   301→        timestamp: Date.now(),\n   302→      });\n   303→\n   304→      logger.aiResponse([result.text]);\n   305→    }\n   306→\n   307→    // Handle tool calls\n   308→    if (result.toolCalls && result.toolCalls.length > 0) {\n   309→      logger.toolCalls(result.toolCalls.map((t) => ({ name: t.toolName, input: t.args })));\n   310→      await this.handleMultipleToolUses(session, result.toolCalls, runId, events);\n   311→    } else {\n   312→      // No tool calls, run is finished\n   313→      events.emit<RunFinishedEvent>({\n   314→        type: EventType.RUN_FINISHED,\n   315→        threadId: session.threadId,\n   316→        runId,\n   317→        result: result.text,\n   318→        timestamp: Date.now(),\n   319→      });\n   320→    }\n   321→  }\n   322→\n   323→  private async handleMultipleToolUses(\n   324→    session: any,\n   325→    toolCalls: Array<{ toolCallId: string; toolName: string; args: any }>,\n   326→    runId: string,\n   327→    events: EventEmitter\n   328→  ) {\n   329→    const toolResults: ToolResultPart[] = [];\n   330→\n   331→    for (const toolCall of toolCalls) {\n   332→      const toolCallId = toolCall.toolCallId;\n   333→      const parentMessageId = uuidv4();\n   334→\n   335→      // Emit TOOL_CALL_START\n   336→      events.emit<ToolCallStartEvent>({\n   337→        type: EventType.TOOL_CALL_START,\n   338→        toolCallId,\n   339→        toolCallName: toolCall.toolName,\n   340→        parentMessageId,\n   341→        timestamp: Date.now(),\n   342→      });\n   343→\n   344→      // Emit TOOL_CALL_ARGS (stream the arguments)\n   345→      const argsStr = JSON.stringify(toolCall.args);\n   346→      events.emit<ToolCallArgsEvent>({\n   347→        type: EventType.TOOL_CALL_ARGS,\n   348→        toolCallId,\n   349→        delta: argsStr,\n   350→        timestamp: Date.now(),\n   351→      });\n   352→\n   353→      // Emit TOOL_CALL_END\n   354→      events.emit<ToolCallEndEvent>({\n   355→        type: EventType.TOOL_CALL_END,\n   356→        toolCallId,\n   357→        timestamp: Date.now(),\n   358→      });\n   359→\n   360→      // Wait for tool result from client\n   361→      const toolResponsePromise = new Promise<string>((resolve) => {\n   362→        session.pendingToolCalls.set(toolCallId, resolve);\n   363→      });\n   364→\n   365→      const content = await toolResponsePromise;\n   366→\n   367→      logger.toolResult(toolCall.toolName, content);\n   368→\n   369→      toolResults.push({\n   370→        type: 'tool-result',\n   371→        toolCallId,\n   372→        toolName: toolCall.toolName,\n   373→        result: content,\n   374→      });\n   375→    }\n   376→\n   377→    // Add tool results to conversation as a tool message\n   378→    session.conversationHistory.push({\n   379→      role: 'tool',\n   380→      content: toolResults,\n   381→    } as any);\n   382→\n   383→    // Build system prompt for follow-up\n   384→    const systemPrompt = this.buildSystemPrompt(session.tools, session.state);\n   385→\n   386→    // Call A