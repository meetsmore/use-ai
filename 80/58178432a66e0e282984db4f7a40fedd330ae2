          "input": {
            "content": "import { v4 as uuidv4 } from 'uuid';\nimport type { Runner, RunnerInput, EventEmitter, RunnerResult } from './types';\nimport type { ToolDefinition } from '../types';\nimport { EventType } from '../types';\nimport type {\n  TextMessageStartEvent,\n  TextMessageContentEvent,\n  TextMessageEndEvent,\n  ToolCallStartEvent,\n  ToolCallArgsEvent,\n  ToolCallEndEvent,\n  RunStartedEvent,\n  RunFinishedEvent,\n  RunErrorEvent,\n  StateSnapshotEvent,\n  MessagesSnapshotEvent,\n} from '../types';\nimport { logger } from '../logger';\n\n/**\n * Configuration for DifyRunner.\n */\nexport interface DifyRunnerConfig {\n  /**\n   * Dify API base URL (e.g., 'https://api.dify.ai/v1' or 'http://localhost/v1').\n   */\n  apiUrl: string;\n\n  /**\n   * Dify API key for authentication.\n   */\n  apiKey: string;\n\n  /**\n   * Runner name for identification (defaults to 'dify').\n   * Use this to differentiate multiple Dify runners.\n   */\n  name?: string;\n\n  /**\n   * Default user identifier for Dify API requests (can be overridden per request).\n   */\n  defaultUser?: string;\n}\n\n/**\n * Dify workflow execution response (blocking mode).\n */\ninterface DifyWorkflowResponse {\n  workflow_run_id: string;\n  task_id: string;\n  data: {\n    id: string;\n    workflow_id: string;\n    status: 'running' | 'succeeded' | 'failed' | 'stopped';\n    outputs: Record<string, any>;\n    error?: string;\n    elapsed_time: number;\n    total_tokens: number;\n    created_at: number;\n  };\n}\n\n/**\n * Dify streaming event types.\n */\ntype DifyStreamEvent =\n  | { event: 'workflow_started'; task_id: string; workflow_run_id: string; data: { id: string; workflow_id: string; sequence_number: number; created_at: number } }\n  | { event: 'node_started'; task_id: string; workflow_run_id: string; data: { id: string; node_id: string; node_type: string; title: string; index: number; predecessor_node_id?: string; inputs: Record<string, any>; created_at: number } }\n  | { event: 'node_finished'; task_id: string; workflow_run_id: string; data: { id: string; node_id: string; node_type: string; title: string; index: number; predecessor_node_id?: string; inputs: Record<string, any>; outputs: Record<string, any>; status: string; error?: string; elapsed_time: number; execution_metadata?: Record<string, any>; created_at: number } }\n  | { event: 'workflow_finished'; task_id: string; workflow_run_id: string; data: { id: string; workflow_id: string; status: 'succeeded' | 'failed' | 'stopped'; outputs: Record<string, any>; error?: string; elapsed_time: number; total_tokens: number; created_at: number } }\n  | { event: 'text_chunk'; task_id: string; workflow_run_id: string; data: { text: string } }\n  | { event: 'error'; task_id: string; workflow_run_id: string; status: number; code: string; message: string };\n\n/**\n * Runner implementation for Dify.AI workflow platform.\n *\n * This runner integrates with Dify workflows, enabling:\n * - Triggering external Dify workflows with inputs\n * - Processing workflow outputs and emitting AG-UI events\n * - Calling frontend tools mid-workflow (via custom Dify HTTP nodes)\n * - Both streaming and blocking execution modes\n *\n * Used primarily for headless workflows (via useAIWorkflow).\n *\n * @example\n * ```typescript\n * const difyRunner = new DifyRunner({\n *   apiUrl: 'https://api.dify.ai/v1',\n *   apiKey: process.env.DIFY_API_KEY!,\n *   defaultUser: 'use-ai-user',\n * });\n *\n * const server = new UseAIServer({\n *   runners: {\n *     dify: difyRunner,\n *   },\n *   runner: 'claude',\n * });\n * ```\n */\nexport class DifyRunner implements Runner {\n  private apiUrl: string;\n  private apiKey: string;\n  private name: string;\n  private defaultUser: string;\n\n  constructor(config: DifyRunnerConfig) {\n    this.apiUrl = config.apiUrl.replace(/\\/$/, ''); // Remove trailing slash\n    this.apiKey = config.apiKey;\n    this.name = config.name || 'dify';\n    this.defaultUser = config.defaultUser || 'use-ai-user';\n  }\n\n  getName(): string {\n    return this.name;\n  }\n\n  async run(input: RunnerInput, events: EventEmitter): Promise<RunnerResult> {\n    const { session, runId, messages, tools, state, originalInput } = input;\n\n    // Extract workflowId from originalInput (passed via useAIWorkflow)\n    const workflowId = (originalInput as any).workflowId;\n    if (!workflowId) {\n      const error = 'workflowId is required for DifyRunner';\n      events.emit<RunErrorEvent>({\n        type: EventType.RUN_ERROR,\n        message: error,\n        timestamp: Date.now(),\n      });\n      return {\n        success: false,\n        error,\n        conversationHistory: messages,\n      };\n    }\n\n    // Extract workflow inputs from originalInput\n    const workflowInputs = (originalInput as any).inputs || {};\n\n    // Emit RUN_STARTED event\n    events.emit<RunStartedEvent>({\n      type: EventType.RUN_STARTED,\n      threadId: session.threadId,\n      runId,\n      input: originalInput,\n      timestamp: Date.now(),\n    });\n\n    // Emit MESSAGES_SNAPSHOT event\n    events.emit<MessagesSnapshotEvent>({\n      type: EventType.MESSAGES_SNAPSHOT,\n      messages: session.messages,\n      timestamp: Date.now(),\n    });\n\n    // Emit STATE_SNAPSHOT event\n    events.emit<StateSnapshotEvent>({\n      type: EventType.STATE_SNAPSHOT,\n      snapshot: state,\n      timestamp: Date.now(),\n    });\n\n    try {\n      logger.info('Executing Dify workflow', {\n        clientId: session.clientId,\n        workflowId,\n        inputCount: Object.keys(workflowInputs).length,\n        toolCount: tools.length,\n      });\n\n      // Use blocking mode for simplicity (streaming can be added later)\n      const response = await this.executeWorkflow(workflowId, workflowInputs, session.clientId);\n\n      if (response.data.status === 'failed') {\n        const error = response.data.error || 'Workflow execution failed';\n        events.emit<RunErrorEvent>({\n          type: EventType.RUN_ERROR,\n          message: error,\n          timestamp: Date.now(),\n        });\n        return {\n          success: false,\n          error,\n          conversationHistory: messages,\n        };\n      }\n\n      // Process workflow outputs\n      const outputs = response.data.outputs;\n\n      // Check if workflow wants to call frontend tools\n      if (outputs.tool_calls && Array.isArray(outputs.tool_calls)) {\n        await this.handleToolCalls(session, outputs.tool_calls, runId, events, workflowId, workflowInputs);\n      }\n\n      // Emit text message if there's output text\n      const outputText = outputs.text || outputs.output || JSON.stringify(outputs);\n      if (outputText) {\n        const messageId = uuidv4();\n\n        events.emit<TextMessageStartEvent>({\n          type: EventType.TEXT_MESSAGE_START,\n          messageId,\n          role: 'assistant',\n          timestamp: Date.now(),\n        });\n\n        events.emit<TextMessageContentEvent>({\n          type: EventType.TEXT_MESSAGE_CONTENT,\n          messageId,\n          delta: outputText,\n          timestamp: Date.now(),\n        });\n\n        events.emit<TextMessageEndEvent>({\n          type: EventType.TEXT_MESSAGE_END,\n          messageId,\n          timestamp: Date.now(),\n        });\n\n        logger.info('Dify workflow completed', {\n          workflowId,\n          outputLength: outputText.length,\n        });\n      }\n\n      // Emit RUN_FINISHED\n      events.emit<RunFinishedEvent>({\n        type: EventType.RUN_FINISHED,\n        threadId: session.threadId,\n        runId,\n        result: outputText,\n        timestamp: Date.now(),\n      });\n\n      return {\n        success: true,\n        conversationHistory: messages,\n      };\n    } catch (error) {\n      logger.error('Error executing Dify workflow', {\n        error: error instanceof Error ? error.message : 'Unknown error',\n        clientId: session.clientId,\n        workflowId,\n      });\n\n      events.emit<RunErrorEvent>({\n        type: EventType.RUN_ERROR,\n        message: error instanceof Error ? error.message : 'Unknown error',\n        timestamp: Date.now(),\n      });\n\n      return {\n        success: false,\n        error: error instanceof Error ? error.message : 'Unknown error',\n        conversationHistory: messages,\n      };\n    }\n  }\n\n  /**\n   * Executes a Dify workflow in blocking mode.\n   */\n  private async executeWorkflow(\n    workflowId: string,\n    inputs: Record<string, any>,\n    user: string\n  ): Promise<DifyWorkflowResponse> {\n    const url = `${this.apiUrl}/workflows/${workflowId}/run`;\n    const response = await fetch(url, {\n      method: 'POST',\n      headers: {\n        'Authorization': `Bearer ${this.apiKey}`,\n        'Content-Type': 'application/json',\n      },\n      body: JSON.stringify({\n        inputs,\n        response_mode: 'blocking',\n        user: user || this.defaultUser,\n      }),\n    });\n\n    if (!response.ok) {\n      const errorText = await response.text();\n      throw new Error(`Dify API error (${response.status}): ${errorText}`);\n    }\n\n    return response.json();\n  }\n\n  /**\n   * Handles tool calls requested by the Dify workflow.\n   * Dify workflows can request tool calls via a special output format.\n   */\n  private async handleToolCalls(\n    session: any,\n    toolCalls: Array<{ toolName: string; args: any }>,\n    runId: string,\n    events: EventEmitter,\n    workflowId: string,\n    workflowInputs: Record<string, any>\n  ) {\n    const toolResults: Array<{ toolName: string; result: any }> = [];\n\n    for (const toolCall of toolCalls) {\n      const toolCallId = uuidv4();\n      const parentMessageId = uuidv4();\n\n      // Emit TOOL_CALL_START\n      events.emit<ToolCallStartEvent>({\n        type: EventType.TOOL_CALL_START,\n        toolCallId,\n        toolCallName: toolCall.toolName,\n        parentMessageId,\n        timestamp: Date.now(),\n      });\n\n      // Emit TOOL_CALL