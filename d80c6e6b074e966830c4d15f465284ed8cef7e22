            "content": "/**\n * Utility for matching URLs against patterns with wildcard support.\n *\n * Supported patterns:\n * - Exact match: `https://api.example.com`\n * - Wildcard subdomain: `https://*.example.com` (matches api.example.com, staging.example.com)\n * - Wildcard protocol: `*://api.example.com` (matches http:// and https://)\n * - Multiple wildcards: `*://*.example.com/*` (flexible matching)\n *\n * @example\n * ```typescript\n * matchesPattern('https://api.meetsmore.com', 'https://*.meetsmore.com') // true\n * matchesPattern('https://staging.meetsmore.com', 'https://*.meetsmore.com') // true\n * matchesPattern('https://api.example.com', 'https://*.meetsmore.com') // false\n * ```\n */\n\n/**\n * Converts a pattern string into a RegExp for matching.\n * Handles wildcards (*) and escapes special regex characters.\n */\nfunction patternToRegex(pattern: string): RegExp {\n  // Escape special regex characters except *\n  const escaped = pattern\n    .replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&')\n    // Convert * to regex pattern (match any characters except /)\n    .replace(/\\*/g, '[^/]*');\n\n  // Anchor to start and end of string\n  return new RegExp(`^${escaped}$`);\n}\n\n/**\n * Checks if a URL matches a pattern.\n *\n * @param url - The URL to test (e.g., 'https://api.example.com')\n * @param pattern - The pattern with optional wildcards (e.g., 'https://*.example.com')\n * @returns true if the URL matches the pattern\n */\nexport function matchesPattern(url: string, pattern: string): boolean {\n  // Exact match first (fast path)\n  if (url === pattern) {\n    return true;\n  }\n\n  // No wildcard, no match\n  if (!pattern.includes('*')) {\n    return false;\n  }\n\n  // Convert pattern to regex and test\n  const regex = patternToRegex(pattern);\n  return regex.test(url);\n}\n\n/**\n * Finds the first matching pattern from a map of patterns.\n * Exact matches take precedence over wildcard matches.\n *\n * @param url - The URL to match\n * @param patterns - Array of pattern strings\n * @returns The matching pattern, or undefined if no match\n */\nexport function findMatchingPattern(url: string, patterns: string[]): string | undefined {\n  // Check for exact match first\n  if (patterns.includes(url)) {\n    return url;\n  }\n\n  // Check wildcard patterns\n  for (const pattern of patterns) {\n    if (matchesPattern(url, pattern)) {\n      return pattern;\n    }\n  }\n\n  return undefined;\n}\n",
