/\n   252→export function UseAIProvider({\n   253→  serverUrl,\n   254→  children,\n   255→  systemPrompt,\n   256→  CustomButton,\n   257→  CustomChat,\n   258→  chatRepository,\n   259→}: UseAIProviderProps) {\n   260→  const [connected, setConnected] = useState(false);\n   261→  const [isChatOpen, setIsChatOpen] = useState(false);\n   262→  const [messages, setMessages] = useState<Message[]>([]);\n   263→  const [loading, setLoading] = useState(false);\n   264→\n   265→  /**\n   266→   * Current active chat where AI responses are saved.\n   267→   * This is the \"source of truth\" for where new AI messages get persisted.\n   268→   */\n   269→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   270→\n   271→  /**\n   272→   * Chat loaded for viewing but not yet active for AI responses.\n   273→   * Becomes currentChatId when user sends their first message.\n   274→   * This prevents race conditions when AI is still responding to the previous chat.\n   275→   */\n   276→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   277→\n   278→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   279→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   280→  const promptsRef = useRef<Map<string, string>>(new Map());\n   281→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   282→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   283→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   284→\n   285→  /**\n   286→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   287→   * Event handlers are created once during mount and don't see updated state values.\n   288→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   289→   */\n   290→  const currentChatIdSnapshot = useRef<string | null>(null);\n   291→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   292→\n   293→  const clientRef = useRef<UseAIClient | null>(null);\n   294→  const repositoryRef = useRef<ChatRepository>(\n   295→    chatRepository || new LocalStorageChatRepository()\n   296→  );\n   297→\n   298→  // Initialize chat storage hook\n   299→  const chatStorage = useChatStorage(repositoryRef.current);\n   300→\n   301→  // Helper function to load messages from storage for display\n   302→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   303→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   304→    setMessages(loadedMessages);\n   305→  }, [chatStorage]);\n   306→\n   307→  const registerTools = useCallback((\n   308→    id: string,\n   309→    tools: ToolsDefinition,\n   310→    waitForRender?: () => Promise<void>\n   311→  ) => {\n   312→    const existingTools = toolRegistryRef.current.get(id);\n   313→\n   314→    // Always update the ref to capture latest closures\n   315→    toolRegistryRef.current.set(id, tools);\n   316→\n   317→    // Only increment version if tool names changed (added/removed tools)\n   318→    if (existingTools) {\n   319→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   320→      const newKeys = Object.keys(tools).sort().join(',');\n   321→      if (existingKeys !== newKeys) {\n   322→        setToolRegistryVersion(v => v + 1);\n   323→      }\n   324→    } else {\n   325→      // First registration\n   326→      setToolRegistryVersion(v => v + 1);\n   327→    }\n   328→\n   329→    Object.keys(tools).forEach(toolName => {\n   330→      toolOwnershipRef.current.set(toolName, id);\n   331→    });\n   332→\n   333→    if (waitForRender) {\n   334→      renderWaitersRef.current.set(id, waitForRender);\n   335→    }\n   336→  }, []);\n   337→\n   338→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   339→    if (prompt) {\n   340→      promptsRef.current.set(id, prompt);\n   341→   