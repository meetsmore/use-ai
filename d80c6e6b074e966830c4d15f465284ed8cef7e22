            "old_string": "/**\n * Utility for matching URLs against patterns.\n * Uses picomatch for glob patterns and native RegExp for regex patterns.\n *\n * Supported pattern types:\n * 1. **Constant strings** - Exact match\n *    - `https://api.example.com`\n *\n * 2. **Glob patterns** (using picomatch) - Wildcard matching\n *    - `https://*.example.com` - Matches api.example.com, staging.example.com\n *    - `*://api.example.com` - Matches any protocol\n *    - `https://**.example.com` - Matches any subdomain depth\n *\n * 3. **Regular expressions** - Full regex power\n *    - `/^https:\\/\\/.*\\.example\\.com$/` - Regex string format\n *    - `/api-(dev|staging)\\.example\\.com/` - With capture groups\n *\n * @example\n * ```typescript\n * // Constant string\n * matchesPattern('https://api.example.com', 'https://api.example.com') // true\n *\n * // Glob patterns\n * matchesPattern('https://api.meetsmore.com', 'https://*.meetsmore.com') // true\n * matchesPattern('https://staging.meetsmore.com', 'https://*.meetsmore.com') // true\n *\n * // Regex patterns\n * matchesPattern('https://api-staging.example.com', '/api-(dev|staging)\\\\.example\\\\.com/') // true\n * matchesPattern('https://api.example.com', '/^https:\\\\/\\\\/.*\\\\.example\\\\.com$/') // true\n * ```\n */\n\nimport picomatch from 'picomatch';\n\n/**\n * Checks if a string is a regex pattern.\n * Regex patterns must be in the format: /pattern/ or /pattern/flags\n */\nfunction isRegexPattern(pattern: string): boolean {\n  return pattern.startsWith('/') && pattern.lastIndexOf('/') > 0;\n}\n\n/**\n * Converts a regex string (e.g., \"/pattern/gi\") to a RegExp object.\n */\nfunction parseRegexPattern(pattern: string): RegExp {\n  const lastSlash = pattern.lastIndexOf('/');\n  const regexBody = pattern.slice(1, lastSlash);\n  const flags = pattern.slice(lastSlash + 1);\n  return new RegExp(regexBody, flags);\n}\n\n/**\n * Checks if a URL matches a pattern.\n * Supports three pattern types:\n * 1. Constant strings (exact match)\n * 2. Glob patterns with wildcards (using picomatch)\n * 3. Regular expressions (format: /pattern/flags)\n *\n * @param url - The URL to test (e.g., 'https://api.example.com')\n * @param pattern - The pattern (string, glob, or regex)\n * @returns true if the URL matches the pattern\n */\nexport function matchesPattern(url: string, pattern: string): boolean {\n  // 1. Exact match (fast path)\n  if (url === pattern) {\n    return true;\n  }\n\n  // 2. Regex pattern\n  if (isRegexPattern(pattern)) {\n    try {\n      const regex = parseRegexPattern(pattern);\n      return regex.test(url);\n    } catch (error) {\n      console.error(`[PatternMatcher] Invalid regex pattern: ${pattern}`, error);\n      return false;\n    }\n  }\n\n  // 3. Glob pattern (if contains wildcards)\n  if (pattern.includes('*')) {\n    const isMatch = picomatch(pattern);\n    return isMatch(url);\n  }\n\n  // No wildcard and not exact match = no match\n  return false;\n}\n\n/**\n * Finds the first matching pattern from an array of patterns.\n * Checks patterns in order:\n * 1. Exact matches first (highest priority)\n * 2. Then other patterns (glob/regex) in array order\n *\n * @param url - The URL to match\n * @param patterns - Array of pattern strings (constants, globs, or regexes)\n * @returns The matching pattern, or undefined if no match\n */\nexport function findMatchingPattern(url: string, patterns: string[]): string | undefined {\n  // Check for exact match first (highest priority)\n  if (patterns.includes(url)) {\n    return url;\n  }\n\n  // Check other patterns in order\n  for (const pattern of patterns) {\n    if (matchesPattern(url, pattern)) {\n      return pattern;\n    }\n  }\n\n  return undefined;\n}"
