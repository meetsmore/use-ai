ocol (https://docs.ag-ui.com/), so will be compatible with other AG-UI compliant servers.\n    71→ *\n    72→ * Handles:\n    73→ * - Connection management and automatic reconnection\n    74→ * - Sending RunAgentInput messages to server\n    75→ * - Parsing AG-UI event streams from server\n    76→ * - Tool execution coordination\n    77→ *\n    78→ * You probably don't need to use this directly, instead use {@link UseAIProvider}.\n    79→ */\n    80→export class UseAIClient {\n    81→  private socket: Socket | null = null;\n    82→  private eventHandlers: Map<string, AGUIEventHandler> = new Map();\n    83→  private reconnectAttempts = 0;\n    84→  private maxReconnectAttempts = 5;\n    85→  private reconnectDelay = 1000;\n    86→\n    87→  // Session state\n    88→  private _threadId: string | null = null;\n    89→  private _tools: ToolDefinition[] = [];\n    90→  private _messages: Message[] = [];\n    91→  private _state: unknown = null;\n    92→\n    93→  // MCP headers provider\n    94→  private mcpHeadersProvider?: () => McpHeadersMap | Promise<McpHeadersMap>;\n    95→\n    96→  // Agent selection\n    97→  private _availableAgents: AgentInfo[] = [];\n    98→  private _defaultAgent: string | null = null;\n    99→  private _selectedAgent: string | null = null;\n   100→  private agentsChangeHandlers: Set<(agents: AgentInfo[], defaultAgent: string | null) => void> = new Set();\n   101→\n   102→  // Text message assembly\n   103→  private _currentMessageId: string | null = null;\n   104→  private _currentMessageContent: string = '';\n   105→\n   106→  // Assistant message assembly (for tracking full conversation history)\n   107→  private _currentAssistantMessage: { id: string; role: 'assistant'; content: string } | null = null;\n   108→  private _currentAssistantToolCalls: Array<{ id: string; type: 'function'; function: { name: string; arguments: string } }> = [];\n   109→\n   110→  // Tool call assembly\n   111→  private currentToolCalls: Map<string, {\n   112→    name: string;\n   113→    args: string;\n   114→  }> = new Map();\n   115→\n   116→  /**\n   117→   * Creates a new UseAI client instance.\n   118→   *\n   119→   * @param serverUrl - The WebSocket URL of the UseAI server\n   120→   */\n   121→  constructor(private serverUrl: string) {}\n   122→\n   123→  /**\n   124→   * Establishes a Socket.IO connection to the server.\n   125→   * Automatically sets up reconnection logic on disconnect.\n   126→   *\n   127→   * @returns Promise that resolves when connected\n   128→   * @throws Error if connection fails\n   129→   */\n   130→  connect(): Promise<void> {\n   131→    return new Promise((resolve, reject) => {\n   132→      try {\n   133→        this.socket = io(this.serverUrl, {\n   134→          transports: ['polling', 'websocket'],\n   135→          reconnection: true,\n   136→          reconnectionAttempts: this.maxReconnectAttempts,\n   137→          reconnectionDelay: this.reconnectDelay,\n   138→        });\n   139→\n   140→        this.socket.on('connect', () => {\n   141→          console.log('Connected to UseAI server');\n   142→          console.log('Transport:', this.socket?.io?.engine?.transport?.name);\n   143→          this.reconnectAttempts = 0;\n   144→\n   145→          // Listen for transport upgrades (only if engine is available)\n   146→          const engine = this.socket?.io?.engine;\n   147→          if (engine) {\n   148→            engine.on('upgrade', (transport: { name: string }) => {\n   149→              console.log('🚀 Upgraded to transport:', transport.name);\n   150→            });\n   151→\n   152→            engine.on('upgradeError', (err: { message: string }) => {\n   153→              console.warn('⚠️  Upgrade error:', err.message);\n   154→            });\n   155→          }\n   156→\n   157→          resolve();\n   158→        });\n   159→\n   160→        this.socket.on('event', (aguiEvent: AGUIEvent) => {\n   161→          try {\n   162→            console.log('[Client] Received event:', aguiEvent.type);\n   163→            this.handleEvent(aguiEvent);\n   164→          } catch (error) {\n   165→            console.error('Error handling event:', error);\n   166→          }\n   167→        });\n   168→\n   169→        // Listen for available agents from server\n   170→        this.socket.on('agents', (data: { agents: AgentInfo[]; defaultAgent: string }) => {\n   171→          console.log('[Client] Received available agents:', data);\n   172→          this._availableAgents = data.agents;\n   173→          this._defaultAgent = data.defaultAgent;\n   174→          // Notify listeners\n   175→          this.agentsChangeHandlers.forEach(handler => handler(data.agents, data.defaultAgent));\n   176→        });\n   177→\n   178→        this.socket.on('connect_error', (error) => {\n   179→          console.error('Socket.IO connection error:', error);\n   180→          reject(error);\n   181→        });\n   182→\n   183→        this.socket.on('disconnect', (reason) => {\n   184→          console.log('Disconnected from UseAI server:', reason);\n   185→        });\n   186→      } catch (error) {\n   187→        reject(error);\n   188→      }\n   189→    });\n   190→  }\n   191→\n   192→\n   193→  private handleEvent(event: AGUIEvent) {\n   194→    // Track assistant message lifecycle for conversation history\n   195→    if (event.type === EventType.RUN_STARTED) {\n   196→      // Start of a new assistant response - initialize message\n   197→      this._currentAssistantMessage = {\n   198→        id: uuidv4(),\n   199→        role: 'assistant' as const,\n   200→        content: '',\n   201→      };\n   202→      this._currentAssistantToolCalls = [];\n   203→    }\n   204→\n   205→    // Handle text message streaming\n   206→    if (event.type === EventType.TEXT_MESSAGE_START) {\n   207→      const e = event as TextMessageStartEvent;\n   208→      this._currentMessageId = e.messageId;\n   209→      this._currentMessageContent = '';\n   210→    } else if (event.type === EventType.TEXT_MESSAGE_CONTENT) {\n   211→      const e = event as TextMessageContentEvent;\n   212→      this._currentMessageContent += e.delta;\n   213→    } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   214→      // Message complete - store content in assistant message\n   215→      if (this._currentAssistantMessage) {\n   216→        this._currentAssistantMessage.content = this._currentMessageContent;\n   217→      }\n   218→      this._currentMessageId = null;\n   219→    }\n   220→\n   221→    // Handle tool call streaming\n   222→    else if (event.type === EventType.TOOL_CALL_START) {\n   223→      const e = event as ToolCallStartEvent;\n   224→      this.currentToolCalls.set(e.toolCallId, {\n   225→        name: e.toolCallName,\n   226→        args: '',\n   227→      });\n   228→    } else if (event.type === EventType.TOOL_CALL_ARGS) {\n   229→      const e = event as ToolCallArgsEvent;\n   230→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   231→      if (toolCall) {\n   232→        toolCall.args += e.delta;\n   233→      }\n   234→    } else if (event.type === EventType.TOOL_CALL_END) {\n   235→      // Tool call args complete - add to assistant message\n   236→      const e = event as ToolCallEndEvent;\n   237→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   238→      if (toolCall) {\n   239→        this._currentAssistantToolCalls.push({\n   240→          id: e.toolCallId,\n   241→          type: 'function',\n   242→          function: {\n   243→            name: toolCall.name,\n   244→            arguments: toolCall.args,\n   245→          },\n   246→        });\n   247→      }\n   248→    }\n   249→\n   250→    // Handle run completion - finalize assistant message\n   251→    else if (event.type === EventType.RUN_FINISHED) {\n   252→      // Add completed assistant message to conversation history\n   253→      if (this._currentAssistantMessage) {\n   254→        const assistantMessage: AssistantMessageWithTools = {\n   255→          id: this._currentAssistantMessage.id!,\n   256→          role: 'assistant',\n   257→          content: this._currentAssistantMessage.content || '',\n   258→        };\n   259→\n   260→        // Add tool calls if any\n   261→        if (this._currentAssistantToolCalls.length > 0) {\n   262→          assistantMessage.toolCalls = this._currentAssistantToolCalls;\n   263→        }\n   264→\n   265→        this._messages.push(assistantMessage);\n   266→\n   267→        // Reset for next message\n   268→        this._currentAssistantMessage = null;\n   269→        this._currentAssistantToolCalls = [];\n   270→      }\n   271→    }\n   272→\n   273→    // Notify all registered handlers\n   274→    this.eventHandlers.forEach((handler) => handler(event));\n   275→  }\n   276→\n   277→  /**\n   278→   * Registers available tools and optional state with the server.\n   279→   * This updates the session state for future agent runs.\n   280→   *\n   281→   * @param tools - Array of tool definitions to register\n   282→   * @param state - Optional state object to provide to the AI.\n   283→   */\n   284→  registerTools(tools: ToolDefinition[], state?: unknown) {\n   285→    this._tools = tools;\n   286→    this._state = state;\n   287→  }\n   288→\n   289→  /**\n   290→   * Updates the state without re-registering tools.\n   291→   * Call this before sendPrompt to ensure the AI sees the latest UI state.\n   292→   *\n   293→   * @param state - The current state object to provide to the AI\n   294→   */\n   295→  updateState(state: unknown) {\n   296→    this._state = state;\n   297→  }\n   298→\n   299→  /**\n   300→   * Sets the MCP headers provider.\n   301→   * The provider will be called each time a message is sent to get fresh headers.\n   302→   *\n   303→   * @param provider - Function that returns MCP headers configuration\n   304→   */\n   305→  setMcpHeadersProvider(provider: () => McpHeadersMap | Promise<McpHeadersMap>) {\n   306→    this.mcpHeadersProvider = provider;\n   307→  }\n   308→\n   309→  /**\n   310→   * Sends a user prompt to the AI.\n   311→   *\n   312→   * @param prompt - The user's prompt/question (text part)\n   313→   * @param multimodalContent - Optional multimodal content (text, images, files)\n   314→   */\n   315→  async sendPrompt(prompt: string, multimodalContent?: MultimodalContent[]) {\n   316→    // Build message content - use multimodal if provided, otherwise just the text\n   317→    // AG-UI Message type expects content to be string | ContentPart[]\n   318→    // For multimodal content, we pass the array; for text-only, we pass the string\n   319→    type MessageContent = string | Array<{ type: string; [key: string]: unknown }>;\n   320→    let messageContent: MessageContent = prompt;\n   321→\n   322→    if (multimodalContent && multimodalContent.length > 0) {\n   323→      // Convert our MultimodalContent to AG-UI ContentPart format\n   324→      messageContent = multimodalContent.map(part => {\n   325→        if (part.type === 'text') {\n   326→          return { type: 'text', text: part.text };\n   327→        } else if (part.type === 'image') {\n   328→          return { type: 'image', url: part.url };\n   329→        } else {\n   330→          return {\n   331→            type: 'file',\n   332→            url: part.url,\n   333→            mimeType: part.mimeType,\n   334→          };\n   335→        }\n   336→      });\n   337→    }\n   338→\n   339→    // Add user message to conversation\n   340→    const userMessage: Message = {\n   341→      id: uuidv4(),\n   342→      role: 'user',\n   343→      content: messageContent as string, // Type cast needed for Message type compatibility\n   344→    };\n   345→    this._messages.push(userMessage);\n   346→\n   347→    // Get MCP headers if provider is set\n   348→    let mcpHeaders: McpHeadersMap | undefined;\n   349→    if (this.mcpHeadersProvider) {\n   350→      try {\n   351→        mcpHeaders = await this.mcpHeadersProvider();\n   352→      } catch (error) {\n   353→        console.error('[UseAIClient] Failed to get MCP headers:', error);\n   354→        // Continue without headers rather than blocking the request\n   355→      }\n   356→    }\n   357→\n   358→    // Create RunAgentInput\n   359→    const runInput: RunAgentInput = {\n   360→      threadId: this.threadId, // Use getter to ensure non-null\n   361→      runId: uuidv4(),\n   362→      messages: this._messages,\n   363→      tools: this._tools.map(t => ({\n   364→        name: t.name,\n   365→        description: t.description,\n   366→        parameters: t.parameters,\n   367→      })),\n   368→      state: this._state,\n   369→      context: [],\n   370→      forwardedProps: {\n   371→        ...(mcpHeaders ? { mcpHeaders } : {}),\n   372→        ...(this._selectedAgent ? { agent: this._selectedAgent } : {}),\n   373→      },\n   374→    };\n   375→\n   376→    this.send({\n   377→      type: 'run_agent',\n   378→      data: runInput,\n   379→    });\n   380→  }\n   381→\n   382→  /**\n   383→   * Sends the result of a tool execution back to the server.\n   384→   *\n   385→   * @param toolCallId - The ID of the tool call being responded to\n   386→   * @param result - The result returned by the tool execution\n   387→   * @param state - Optional updated state to send back to the AI\n   388→   */\n   389→  sendToolResponse(toolCallId: string, result: unknown, state?: unknown) {\n   390→    // Update session state if provided\n   391→    if (state !== undefined) {\n   392→      this._state = state;\n   393→    }\n   394→\n   395→    const toolResultMessage: ToolResultMessage = {\n   396→      type: 'tool_result',\n   397→      data: {\n   398→        messageId: uuidv4(),\n   399→        toolCallId,\n   400→        content: JSON.stringify(result),\n   401→        role: 'tool',\n   402→      },\n   403→    };\n   404→\n   405→    // Track tool result in conversation history\n   406→    const toolResultMsg: ToolResultMessageData = {\n   407→      id: toolResultMessage.data.messageId,\n   408→      role: 'tool',\n   409→      content: toolResultMessage.data.content,\n   410→      toolCallId,\n   411→    };\n   412→    this._messages.push(toolResultMsg);\n   413→\n   414→    this.send(toolResultMessage);\n   415→  }\n   416→\n   417→  /**\n   418→   * Retrieves accumulated tool call data for a specific tool call ID.\n   419→   * Used to get the complete tool name and arguments after they've been streamed\n   420→   * across multiple TOOL_CALL_ARGS events.\n   421→   *\n   422→   * @param toolCallId - The ID of the tool call\n   423→   * @returns Object with tool name and accumulated arguments, or undefined if not found\n   424→   */\n   425→  getToolCallData(toolCallId: string): { name: string; args: string } | undefined {\n   426→    return this.currentToolCalls.get(toolCallId);\n   427→  }\n   428→\n   429→  /**\n   430→   * Registers an AG-UI event handler for receiving server events.\n   431→   *\n   432→   * @param id - Unique identifier for this handler\n   433→   * @param handler - Callback function to handle incoming AG-UI events\n   434→   * @returns Cleanup function to unregister the handler\n   435→   */\n   436→  onEvent(id: string, handler: AGUIEventHandler) {\n   437→    this.eventHandlers.set(id, handler);\n   438→    return () => {\n   439→      this.eventHandlers.delete(id);\n   440→    };\n   441→  }\n   442→\n   443→  /**\n   444→   * Helper method to listen for text message content.\n   445→   * Aggregates TEXT_MESSAGE_CONTENT events and calls handler with complete messages.\n   446→   *\n   447→   * @param handler - Callback function to handle complete text messages\n   448→   * @returns Cleanup function\n   449→   */\n   450→  onTextMessage(handler: MessageHandler): () => void {\n   451→    return this.onEvent('text-message-handler', (event) => {\n   452→      if (event.type === EventType.TEXT_MESSAGE_END && this._currentMessageContent) {\n   453→        handler(this._currentMessageContent);\n   454→      }\n   455→    });\n   456→  }\n   457→\n   458→  /**\n   459→   * Helper method to listen for tool call requests.\n   460→   * Aggregates TOOL_CALL_* events and calls handler with complete tool calls.\n   461→   *\n   462→   * @param handler - Callback function to handle tool calls\n   463→   * @returns Cleanup function\n   464→   */\n   465→  onToolCall(handler: ToolCallHandler): () => void {\n   466→    return this.onEvent('tool-call-handler', (event) => {\n   467→      if (event.type === EventType.TOOL_CALL_END) {\n   468→        const e = event as ToolCallEndEvent;\n   469→        const toolCall = this.currentToolCalls.get(e.toolCallId);\n   470→        if (toolCall) {\n   471→          try {\n   472→            const args = JSON.parse(toolCall.args);\n   473→            handler(e.toolCallId, toolCall.name, args);\n   474→            this.currentToolCalls.delete(e.toolCallId);\n   475→          } catch (error) {\n   476→            console.error('Error parsing tool call args:', error);\n   477→          }\n   478→        }\n   479→      }\n   480→    });\n   481→  }\n   482→\n   483→  /**\n   484→   * Gets the current accumulated message content (useful during streaming).\n   485→   */\n   486→  get currentMessageContent(): string {\n   487→    return this._currentMessageContent;\n   488→  }\n   489→\n   490→  /**\n   491→   * Gets the current thread ID for this session.\n   492→   * Generates a new one if not set.\n   493→   */\n   494→  get threadId(): string {\n   495→    if (!this._threadId) {\n   496→      this._threadId = uuidv4();\n   497→    }\n   498→    return this._threadId;\n   499→  }\n   500→\n   501→  /**\n   502→   * Gets the current conversation messages.\n   503→   */\n   504→  get messages(): Message[] {\n   505→    return this._messages;\n   506→  }\n   507→\n   508→  /**\n   509→   * Gets the current state.\n   510→   */\n   511→  get state(): unknown {\n   512→    return this._state;\n   513→  }\n   514→\n   515→  /**\n   516→   * Gets the list of available agents from the server.\n   517→   */\n   518→  get availableAgents(): AgentInfo[] {\n   519→    return this._availableAgents;\n   520→  }\n   521→\n   522→  /**\n   523→   * Gets the default agent ID from the server.\n   524→   */\n   525→  get defaultAgent(): string | null {\n   526→    return this._defaultAgent;\n   527→  }\n   528→\n   529→  /**\n   530→   * Gets the currently selected agent ID.\n   531→   * Returns null if using server default.\n   532→   */\n   533→  get selectedAgent(): string | null {\n   534→    return this._selectedAgent;\n   535→  }\n   536→\n   537→  /**\n   538→   * Gets the effective agent ID (selected or default).\n   539→   */\n   540→  get currentAgent(): string | null {\n   541→    return this._selectedAgent ?? this._defaultAgent;\n   542→  }\n   543→\n   544→  /**\n   545→   * Sets the agent to use for requests.\n   546→   * Pass null to use the server default.\n   547→   *\n   548→   * @param agentId - The agent ID to use, or null for server default\n   549→   */\n   550→  setAgent(agentId: string | null) {\n   551→    this._selectedAgent = agentId;\n   552→    console.log('[Client] Agent set to:', agentId ?? 'server default');\n   553→  }\n   554→\n   555→  /**\n   556→   * Subscribes to agent changes (when server sends available agents).\n   557→   *\n   558→   * @param handler - Callback function receiving agents list and default agent\n   559→   * @returns Cleanup function to unsubscribe\n   560→   */\n   561→  onAgentsChange(handler: (agents: AgentInfo[], defaultAgent: string | null) => void): () => void {\n   562→    this.agentsChangeHandlers.add(handler);\n   563→    // Immediately call with current values if available\n   564→    if (this._availableAgents.length > 0) {\n   565→      handler(this._availableAgents, this._defaultAgent);\n   566→    }\n   567→    return () => {\n   568→      this.agentsChangeHandlers.delete(handler);\n   569→    };\n   570→  }\n   571→\n   572→  /**\n   573→   * Sets the thread ID for this session.\n   574→   * When the thread ID changes, conversation state is cleared to prevent history bleeding.\n   575→   * Use this when switching between different chat conversations.\n   576→   *\n   577→   * @param threadId - The thread/chat ID to use (typically the chatId)\n   578→   */\n   579→  setThreadId(threadId: string) {\n   580→    if (this._threadId !== threadId) {\n   581→      console.log('[Client] ThreadId changed, clearing conversation state', {\n   582→        oldThreadId: this._threadId,\n   583→        newThreadId: threadId,\n   584→      });\n   585→\n   586→      // Clear conversation state when switching threads\n   587→      this._messages = [];\n   588→      this._currentMessageContent = '';\n   589→      this._currentMessageId = null;\n   590→      this.currentToolCalls.clear();\n   591→      this._currentAssistantMessage = null;\n   592→      this._currentAssistantToolCalls = [];\n   593→    }\n   594→    this._threadId = threadId;\n   595→  }\n   596→\n   597→  /**\n   598→   * Loads messages into the conversation history (for resuming from storage).\n   599→   * @param messages - Array of messages to load\n   600→   */\n   601→  loadMessages(messages: Message[]) {\n   602→    this._messages = messages;\n   603→  }\n   604→\n   605→  /**\n   606→   * Clears the conversation history and resets the thread.\n   607→   */\n   608→  clearConversation() {\n   609→    this._messages = [];\n   610→    this._threadId = null;\n   611→    this._currentMessageContent = '';\n   612→    this._currentMessageId = null;\n   613→    this.currentToolCalls.clear();\n   614→    this._currentAssistantMessage = null;\n   615→    this._currentAssistantToolCalls = [];\n   616→  }\n   617→\n   618→  send(message: UseAIClientMessage) {\n   619→    if (this.socket && this.socket.connected) {\n   620→      this.socket.emit('message', message);\n   621→    } else {\n   622→      console.error('Socket.IO is not connected');\n   623→    }\n   624→  }\n   625→\n   626→  /**\n   627→   * Closes the Socket.IO connection to the server.\n   628→   */\n   629→  disconnect() {\n   630→    if (this.socket) {\n   631→      this.socket.disconnect();\n   632→      this.socket = null;\n   633→    }\n   634→  }\n   635→\n   636→  /**\n   637→   * Checks if the client is currently connected to the server.\n   638→   *\n   639→   * @returns true if connected, false otherwise\n   640→   */\n   641→  isConnected(): boolean {\n   642→    return this.socket !== null && this.socket.connected;\n   643→  }\n   644→}\n   645→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
