: NodeJS.Timeout;\n    54→  private clientIdCounter = 0;\n    55→\n    56→  /**\n    57→   * Creates a new UseAI server instance.\n    58→   *\n    59→   * @param config - Server configuration options\n    60→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    61→   */\n    62→  constructor(config: UseAIServerConfig = {}) {\n    63→    this.config = {\n    64→      port: config.port ?? 8080,\n    65→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    66→      model: config.model ?? 'claude-sonnet-4-20250514',\n    67→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    68→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    69→    };\n    70→\n    71→    if (!this.config.anthropicApiKey) {\n    72→      throw new Error('Anthropic API key is required');\n    73→    }\n    74→\n    75→    this.anthropic = new Anthropic({\n    76→      apiKey: this.config.anthropicApiKey,\n    77→    });\n    78→\n    79→    this.rateLimiter = new RateLimiter({\n    80→      maxRequests: this.config.rateLimitMaxRequests,\n    81→      windowMs: this.config.rateLimitWindowMs,\n    82→    });\n    83→\n    84→    this.cleanupInterval = setInterval(() => {\n    85→      this.rateLimiter.cleanup();\n    86→    }, this.config.rateLimitWindowMs);\n    87→\n    88→    // Create HTTP server for health checks\n    89→    this.httpServer = createServer((req, res) => {\n    90→      if (req.url === '/health') {\n    91→        res.writeHead(200, { 'Content-Type': 'application/json' });\n    92→        res.end(JSON.stringify({ status: 'ok' }));\n    93→      } else {\n    94→        res.writeHead(404);\n    95→        res.end();\n    96→      }\n    97→    });\n    98→\n    99→    // Attach WebSocket server to HTTP server\n   100→    this.wss = new WebSocketServer({ server: this.httpServer });\n   101→    this.httpServer.listen(this.config.port);\n   102→    this.setupWebSocketServer();\n  