→ *\n   101→ * // Example 2: Invisible provider component (no UI state)\n   102→ * function AIToolsProvider({ children }) {\n   103→ *   useAI({\n   104→ *     tools: {\n   105→ *       sendEmail: defineTool(\n   106→ *         'Send an email',\n   107→ *         z.object({ to: z.string(), subject: z.string() }),\n   108→ *         async (input) => {\n   109→ *           await sendEmail(input);\n   110→ *           return { success: true };\n   111→ *         }\n   112→ *       )\n   113→ *     },\n   114→ *     invisible: true  // Skip render wait since this has no visual state\n   115→ *   });\n   116→ *\n   117→ *   return <>{children}</>;\n   118→ * }\n   119→ * ```\n   120→ */\n   121→export function useAI(options: UseAIOptions = {}): UseAIResult {\n   122→  const { connected, registerTools, unregisterTools, updatePrompt, client } = useAIContext();\n   123→  const [response, setResponse] = useState<string | null>(null);\n   124→  const [loading, setLoading] = useState(false);\n   125→  const [error, setError] = useState<Error | null>(null);\n   126→\n   127→  const hookId = useRef(`useAI-${Math.random().toString(36).substr(2, 9)}`);\n   128→  const toolsRef = useRef<ToolsDefinition>({});\n   129→  const componentRef = useRef<HTMLDivElement>(null);\n   130→  const renderResolvers = useRef<Array<() => void>>([]);\n   131→\n   132→  useEffect(() => {\n   133→    if (componentRef.current) {\n   134→      componentRef.current.setAttribute('data-useai-context', 'true');\n   135→    }\n   136→  }, []);\n   137→\n   138→  useEffect(() => {\n   139→    const count = renderResolvers.current.length;\n   140→    if (count > 0) {\n   141→      console.log(`[${hookId.current}] Render complete, resolving ${count} promises`);\n   142→      renderResolvers.current.forEach(resolve => resolve());\n   143→      renderResolvers.current = [];\n   144→    }\n   145→  });\n   146→\n   147→  const waitForRender = useCallback(() => {\n   148→    return new Promise<void>(resolve => {\n   149→      console.log(`[${hookId.current}] Adding render promise`);\n   150→      renderResolvers.current.push(resolve);\n   151→    });\n   152→  }, []);\n   153→\n   154→  useEffect(() => {\n   155→    updatePrompt(hookId.current, options.prompt, options.suggestions);\n   156→  }, [options.prompt, options.suggestions, updatePrompt]);\n   157→\n   158→  useEffect(() => {\n   159→    if (options.tools) {\n   160→      const componentId = options.id || componentRef.current?.id;\n   161→      const toolsToRegister = componentId\n   162→        ? namespaceTools(options.tools, componentId)\n   163→        : options.tools;\n   164→\n   165→      // Only pass waitForRender if component is not invisible\n   166→      const renderWaiter = options.invisible ? undefined : waitForRender;\n   167→      registerTools(hookId.current, toolsToRegister, renderWaiter);\n   168→      toolsRef.current = toolsToRegister;\n   169→    }\n   170→\n   171→    return () => {\n   172→      if (options.tools) {\n   173→        unregisterTools(hookId.current);\n   174→      }\n   175→    };\n   176→  }, [options.tools, options.id, options.invisible, registerTools, unregisterTools, waitForRender]);\n   177→\n   178→  useEffect(() => {\n   179→    if (!client) return;\n   180→\n   181→    const unsubscribe = client.onEvent(hookId.current, (event: AGUIEvent) => {\n   182→      handleAGUIEvent(event);\n   183→    });\n   184→\n   185→    return () => {\n   186→      unsubscribe();\n   187→    };\n   188→  }, [client]);\n   189→\n   190→  const handleAGUIEvent = useCallback(async (event: AGUIEvent) => {\n   191→    switch (event.type) {\n   192→      case EventType.TEXT_MESSAGE_END: {\n   193→        const content = client?.currentMessageContent;\n   194→        if (content) {\n   195→          setResponse(content);\n   196→          setLoading(false);\n   197→        }\n   198→        break;\n   199→      }\n   200→\n   201→      case EventType.RUN_ERROR: {\n   202→        const errorEvent = event