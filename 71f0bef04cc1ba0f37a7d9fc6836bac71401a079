            "content": "import { defineTool } from '@use-ai/client';\nimport { z } from 'zod';\n\nexport interface Calculation {\n  expression: string;\n  result: number;\n  timestamp: number;\n}\n\nlet currentResult: number | null = null;\nlet history: Calculation[] = [];\nconst listeners: Set<(data: { result: number | null; history: Calculation[] }) => void> = new Set();\n\nexport function subscribeCalculator(callback: (data: { result: number | null; history: Calculation[] }) => void) {\n  listeners.add(callback);\n  callback({ result: currentResult, history: [...history] });\n\n  return () => {\n    listeners.delete(callback);\n  };\n}\n\nfunction notifyListeners() {\n  listeners.forEach((callback) => callback({ result: currentResult, history: [...history] }));\n}\n\nfunction evaluateExpression(expression: string): number {\n  const cleaned = expression.replace(/\\s+/g, '');\n\n  const validChars = /^[0-9+\\-*/().]+$/;\n  if (!validChars.test(cleaned)) {\n    throw new Error('Invalid characters in expression');\n  }\n\n  const parenBalance = (cleaned.match(/\\(/g) || []).length - (cleaned.match(/\\)/g) || []).length;\n  if (parenBalance !== 0) {\n    throw new Error('Unbalanced parentheses');\n  }\n\n  const result = Function('\"use strict\"; return (' + cleaned + ')')();\n\n  if (typeof result !== 'number' || !isFinite(result)) {\n    throw new Error('Invalid calculation result');\n  }\n\n  return result;\n}\n\nexport const calculatorTools = {\n  calculate: defineTool(\n    'Perform a mathematical calculation and display the result in the calculator',\n    z.object({\n      expression: z.string().describe('The mathematical expression to evaluate (e.g., \"2 + 2\", \"10 * 5 - 3\", \"(8 + 2) / 2\")'),\n    }),\n    (input) => {\n      try {\n        const result = evaluateExpression(input.expression);\n        currentResult = result;\n\n        history = [...history, {\n          expression: input.expression,\n          result,\n          timestamp: Date.now(),\n        }];\n\n        if (history.length > 10) {\n          history = history.slice(-10);\n        }\n\n        notifyListeners();\n\n        return {\n          success: true,\n          expression: input.expression,\n          result,\n          message: `${input.expression} = ${result}`,\n        };\n      } catch (error) {\n        return {\n          success: false,\n          error: error instanceof Error ? error.message : 'Unknown error',\n          message: `Failed to calculate: ${input.expression}`,\n        };\n      }\n    }\n  ),\n\n  getCalculatorState: defineTool(\n    'Get the current calculator state including the last result and calculation history',\n    z.object({}),\n    () => {\n      return {\n        currentResult,\n        history: history.map((calc) => ({\n          expression: calc.expression,\n          result: calc.result,\n        })),\n        count: history.length,\n      };\n    }\n  ),\n\n  clearCalculator: defineTool(\n    'Clear the calculator display and history',\n    z.object({}),\n    () => {\n      currentResult = null;\n      history = [];\n      notifyListeners();\n\n      return {\n        success: true,\n        message: 'Calculator cleared',\n      };\n    }\n  ),\n};\n",
