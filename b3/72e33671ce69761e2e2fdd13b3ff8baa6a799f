seAI server instance.\n    56→   *\n    57→   * @param config - Server configuration options\n    58→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    59→   */\n    60→  constructor(config: UseAIServerConfig = {}) {\n    61→    this.config = {\n    62→      port: config.port ?? 8080,\n    63→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    64→      model: config.model ?? 'claude-sonnet-4-20250514',\n    65→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    66→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    67→    };\n    68→\n    69→    if (!this.config.anthropicApiKey) {\n    70→      throw new Error('Anthropic API key is required');\n    71→    }\n    72→\n    73→    this.anthropic = new Anthropic({\n    74→      apiKey: this.config.anthropicApiKey,\n    75→    });\n    76→\n    77→    this.rateLimiter = new RateLimiter({\n    78→      maxRequests: this.config.rateLimitMaxRequests,\n    79→      windowMs: this.config.rateLimitWindowMs,\n    80→    });\n    81→\n    82→    this.cleanupInterval = setInterval(() => {\n    83→      this.rateLimiter.cleanup();\n    84→    }, this.config.rateLimitWindowMs);\n    85→\n    86→    this.wss = new WebSocketServer({ port: this.config.port });\n    87→    this.setupWebSocketServer();\n    88→\n    89→    if (this.rateLimiter.isEnabled()) {\n    90→      logger.info('Rate limiting enabled', {\n    91→        maxRequests: this.config.rateLimitMaxRequests,\n    92→        windowMs: this.config.rateLimitWindowMs,\n    93→      });\n    94→    }\n    95→  }\n    96→\n    97→  private setupWebSocketServer() {\n    98→    this.wss.on('connection', (ws: WebSocket) => {\n    99→      const clientId = `client-${++this.clientIdCounter}`;\n   100→      logger.info('Client connected', { clientId });\n   101→\n   102→      const session: ClientSession = {\n   103→        clientId,\n   104→        ws,\n   105→        tools: [],\n   106→        conversationHistory: [],\n   107→        pendingToolCalls: new Map(),\n   108→      };\n   109→\n   110→      this.clients.set(ws, session);\n   111→\n   112→      ws.on('message', async (data: Buffer) => {\n   113→        try {\n   114→          const message: ClientMessage = JSON.parse(data.toString());\n   115→          await this.handleClientMessage(ws, message);\n   116→        } catch (error) {\n   117→          logger.error('Error handling message', {\n   118→            error: error instanceof Error ? error.message : 'Unknown error',\n   119→            clientId,\n   120→          });\n   121→          this.sendError(ws, error instanceof Error ? error.message : 'Unknown error');\n   122→        }\n   123→      });\n   124→\n   125→      ws.on('close', () => {\n   126→        logger.info('Client disconnected', { clientId });\n   127→        this.rateLimiter.removeClient(clientId);\n   128→        this.clients.delete(ws);\n   129→      });\n   130→    });\n   131→\n   132→    logger.info('UseAI server listening', { port: this.config.port });\n   133→  }\n   134→\n   135→  private async handleClientMessage(ws: WebSocket, message: ClientMessage) {\n   136→    const session = this.clients.get(ws);\n   137→    if (!session) return;\n   138→\n   139→    switch (message.type) {\n   140→      case 'register_tools':\n   141→        this.handleRegisterTools(session, message as RegisterToolsMessage);\n   142→        break;\n   143→      case 'prompt':\n   144→        await this.handlePrompt(session, message as PromptMessage);\n   145→        break;\n   146→      case 'tool_response':\n   147→        this.handleToolResponse(session, message as ToolResponseMessage);\n   148→        break;\n   149→    }\n   150→  }\n   151→\n   152→  private handleRegisterTools(session: ClientSession, message: RegisterToolsMessage) {\n   153→    session.tools = message.data.tools;\n   154→    session.context = message.data.context;\n   155→    logger.info('Tools registered', {\n   156→      clientId: session.clientId,\n   157→      toolCount: session.tools.length,\n   158→      tools: session.tools.map(t => t.name),\n   159→      contextLength: session.context?.length,\n   160→    });\n   161→  }\n   162→\n   163→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Anthropic.Tool[] {\n   164→    return tools.map(tool => ({\n   165→      name: tool.name,\n   166→      description: tool.description,\n   167→      input_schema: tool.input_schema,\n   168→    }));\n   169→  }\n   170→\n   171→  private buildSystemPrompt(session: ClientSession, includeContext = true): string | undefined {\n   172→    const parts: string[] = [];\n   173→\n   174→    if (includeContext && session.context) {\n   175→      parts.push('You are interacting with a web application. Here is the current state of the UI:');\n   176→      parts.push('');\n   177→      parts.push(session.context);\n   178→      parts.push('');\n   179→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   180→    }\n   181→\n   182→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   183→    if (confirmationTools.length > 0) {\n   184→      if (parts.length > 0) {\n   185→        parts.push('');\n   186→      }\n   187→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   188→      parts.push('');\n   189→      confirmationTools.forEach(tool => {\n   190→        parts.push(`- ${tool.name}`);\n   191→      });\n   192→      parts.push('');\n   193→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   194→      parts.push('1. First, explain to the user exactly what changes will be made (which specific items will be affected)');\n   195→      parts.push('2. Then, explicitly ask: \"Do you want me to proceed?\" or similar confirmation question');\n   196→      parts.push('3. STOP and WAIT for the user to respond with explicit confirmation (like \"yes\", \"ok\", \"proceed\")');\n   197→      parts.push('4. ONLY after receiving confirmation in the IMMEDIATE user message, call the tool');\n   198→      parts.push('');\n   199→      parts.push('NEVER ASSUME CONFIRMATION:');\n   200→      parts.push('- Do NOT call these tools without receiving explicit confirmation in the user\\'s most recent message');\n   201→      parts.push('- Previous confirmations in the conversation history do NOT count as confirmation for new operations');\n   202→      parts.push('- Each deletion or destructive operation requires its own separate confirmation');\n   203→      parts.push('- If the user\\'s message does not contain explicit confirmation, ask for it again');\n   204→    }\n   205→\n   206→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   207→  }\n   208→\n   209→  private prepareMessagesWithCaching(messages: Anthropic.MessageParam[]): any[] {\n   210→    if (messages.length < 2) return messages; // Only cache if we have history\n   211→\n   212→    // Add ONE cache breakpoint at the end of the second-to-last message\n   213→    // This caches all conversation history except the most recent user message\n   214→    const messagesWithCache = JSON.parse(JSON.stringify(messages)); // Deep clone\n   215→    const cacheIndex = messagesWithCache.length - 2;\n   216→\n   217→    const messageToCache = messagesWithCache[cacheIndex];\n   218→\n   219→    // Add cache_control to the last content block of this message\n   220→    if (typeof messageToCache.content === 'string') {\n   221→      messageToCache.content = [\n   222→        {\n   223→          type: 'text',\n   224→          text: messageToCache.content,\n   225→          cache_control: { type: 'ephemeral' }\n   226→        }\n   227→      ];\n   228→    } else if (Array.isArray(messageToCache.content) && messageToCache.content.length > 0) {\n   229→      const lastContent = messageToCache.content[messageToCache.content.length - 1];\n   230→      lastContent.cache_control = { type: 'ephemeral' };\n   231→    }\n   232→\n   233→    return messagesWithCache;\n   234→  }\n   235→\n   236→  private async handlePrompt(session: ClientSession, message: PromptMessage) {\n   237→    const { prompt } = message.data;\n   238→\n   239→    const rateLimitCheck = this.rateLimiter.checkLimit(session.clientId);\n   240→    if (!rateLimitCheck.allowed) {\n   241→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   242→      this.sendError(\n   243→        session.ws,\n   244→        `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`\n   245→      );\n   246→      return;\n   247→    }\n   248→\n   249→    session.conversationHistory.push({\n   250→      role: 'user',\n   251→      content: prompt,\n   252→    });\n   253→\n   254→    try {\n   255→      const systemPrompt = this.buildSystemPrompt(session);\n   256→      const messagesWithCache = this.prepareMessagesWithCaching(session.conversationHistory);\n   257→\n   258→      const response = await this.anthropic.messages.create({\n   259→        model: this.config.model,\n   260→        max_tokens: 4096,\n   261→        messages: messagesWithCache,\n   262→        tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   263→        system: systemPrompt,\n   264→      });\n   265→\n   266→      logger.apiRequest({\n   267→        tools: session.tools.map(t => t.name),\n   268→        messageCount: messagesWithCache.length,\n   269→        messages: messagesWithCache.map((msg: any) => ({\n   270→          role: msg.role,\n   271→          preview: typeof msg.content === 'string'\n   272→            ? msg.content.substring(0, 80) + (msg.content.length > 80 ? '...' : '')\n   273→            : `${msg.content.length} content blocks`,\n   274→        })),\n   275→        systemPrompt,\n   276→      });\n   277→\n   278→      await this.processResponse(session, response);\n   279→    } catch (error) {\n   280→      logger.error('Error calling Anthropic API', {\n   281→        error: error instanceof Error ? error.message : 'Unknown error',\n   282→        clientId: session.clientId,\n   283→      });\n   284→      this.sendError(session.ws, error instanceof Error ? error.message : 'Unknown error');\n   285→    }\n   286→  }\n   287→\n   288→  private async processResponse(session: ClientSession, response: Anthropic.Message) {\n   289→    session.conversationHistory.push({\n   290→      role: 'assistant',\n   291→      content: response.content,\n   292→    });\n   293→\n   294→    const toolUseBlocks: Anthropic.ToolUseBlock[] = [];\n   295→    const textBlocks: string[] = [];\n   296→\n   297→    for (const block of response.content) {\n   298→      if (block.type === 'text') {\n   299→        textBlocks.push(block.text);\n   300→        this.sendMessage(session.ws, {\n   301→          type: 'response',\n   302→          data: {\n   303→            content: block.text,\n   304→            conversationId: response.id,\n   305→          },\n   306→        });\n   307→      } else if (block.type === 'tool_use') {\n   308→        toolUseBlocks.push(block);\n   309→      }\n   310→    }\n   311→\n   312→    if (textBlocks.length > 0) {\n   313→      logger.aiResponse(textBlocks);\n   314→    }\n   315→\n   316→    if (toolUseBlocks.length > 0) {\n   317→      logger.toolCalls(toolUseBlocks.map(t => ({ name: t.name, input: t.input })));\n   318→      await this.handleMultipleToolUses(session, toolUseBlocks);\n   319→    }\n   320→  }\n   321→\n   322→  private async handleMultipleToolUses(\n   323→    session: ClientSession,\n   324→    toolUseBlocks: Anthropic.ToolUseBlock[]\n   325→  ) {\n   326→    const toolResults: Anthropic.ToolResultBlockParam[] = [];\n   327→\n   328→    for (const toolUse of toolUseBlocks) {\n   329→      const toolCallId = toolUse.id;\n   330→\n   331→      const toolResponsePromise = new Promise<{ result: unknown; context?: string }>((resolve) => {\n   332→        session.pendingToolCalls.set(toolCallId, resolve);\n   333→      });\n   334→\n   335→      this.sendMessage(session.ws, {\n   336→        type: 'tool_call',\n   337→        data: {\n   338→          toolCallId,\n   339→          name: toolUse.name,\n   340→          input: toolUse.input,\n   341→        },\n   342→      });\n   343→\n   344→      const { result, context } = await toolResponsePromise;\n   345→\n   346→      logger.toolResult(toolUse.name, result);\n   347→\n   348→      if (context) {\n   349→        session.context = context;\n   350→      }\n   351→\n   352→      const toolResultContent = context\n   353→        ? JSON.stringify(result) + '\\n\\nUpdated UI state:\\n' + context\n   354→        : JSON.stringify(result);\n   355→\n   356→      toolResults.push({\n   357→        type: 'tool_result',\n   358→        tool_use_id: toolCallId,\n   359→        content: toolResultContent,\n   360→      });\n   361→    }\n   362→\n   363→    session.conversationHistory.push({\n   364→      role: 'user',\n   365→      content: toolResults,\n   366→    });\n   367→\n   368→    // Don't include context in system prompt - it's already in tool_result content\n   369→    const systemPrompt = this.buildSystemPrompt(session, false);\n   370→    const messagesWithCache = this.prepareMessagesWithCaching(session.conversationHistory);\n   371→\n   372→    const followUpResponse = await this.anthropic.messages.create({\n   373→      model: this.config.model,\n   374→      max_tokens: 4096,\n   375→      messages: messagesWithCache,\n   376→      tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   377→      system: systemPrompt,\n   378→    });\n   379→\n   380→    await this.processResponse(session, followUpResponse);\n   381→  }\n   382→\n   383→  private handleToolResponse(session: ClientSession, message: ToolResponseMessage) {\n   384→    const { toolCallId, result, context } = message.data