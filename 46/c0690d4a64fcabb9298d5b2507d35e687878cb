→  /** Triggers a workflow execution */\n    50→  trigger: (options: TriggerWorkflowOptions) => Promise<void>;\n    51→  /** Current status of the workflow */\n    52→  status: WorkflowStatus;\n    53→  /** Accumulated text output from the workflow */\n    54→  text: string | null;\n    55→  /** Error if workflow failed */\n    56→  error: Error | null;\n    57→  /** Whether the client is connected to the server */\n    58→  connected: boolean;\n    59→}\n    60→\n    61→/**\n    62→ * React hook for triggering headless workflows.\n    63→ *\n    64→ * Workflows are different from chat-based agents:\n    65→ * - No conversation history (stateless)\n    66→ * - No chat UI involvement\n    67→ * - Can use external platforms (Dify, Flowise, etc.)\n    68→ * - Still supports tool calls to frontend\n    69→ *\n    70→ * Use this for button-triggered operations like:\n    71→ * - File upload processing\n    72→ * - Data transformations\n    73→ * - Multi-step background tasks\n    74→ * - External workflow integrations\n    75→ *\n    76→ * @param runner - The runner to use (e.g., 'dify', 'flowise', 'claude')\n    77→ * @param workflowId - The workflow identifier\n    78→ *\n    79→ * @example\n    80→ * ```typescript\n    81→ * import { useAIWorkflow, defineTool } from '@use-ai/client';\n    82→ * import { z } from 'zod';\n    83→ *\n    84→ * function PDFUploadButton() {\n    85→ *   const { trigger, status, text } = useAIWorkflow('dify', 'pdf-processor');\n    86→ *\n    87→ *   const insertText = defineTool(\n    88→ *     'Insert text into the document',\n    89→ *     z.object({ text: z.string() }),\n    90→ *     (input) => {\n    91→ *       document.body.appendChild(document.createTextNode(input.text));\n    92→ *       return { success: true };\n    93→ *     }\n    94→ *   );\n    95→ *\n    96→ *   const handleUpload = async (file: File) => {\n    97→ *     const pdfData = await file.arrayBuffer();\n    98→ *\n    99→ *     await trigger({\n   100→ *       inputs: { file: pdfData },\n   101→ *       tools: { insertText },\n   102→ *       onProgress: (progress) => console.log('Progress:', progress),\n   103→ *       onComplete: (result) => console.log('Completed:', result),\n   104→ *       onError: (error) => console.error('Error:', error),\n   105→ *     });\n   106→ *   };\n   107→ *\n   108→ *   return (\n   109→ *     <div>\n   110→ *       <input type=\"file\" onChange={(e) => handleUpload(e.target.files[0])} />\n   111→ *       {status === 'running' && <p>Processing...</p>}\n   112→ *       {status === 'completed' && <p>Done! {text}</p>}\n   113→ *     </div>\n   114→ *   );\n   115→ * }\n   116→ * ```\n   117→ */\n   118→export function useAIWorkflow(runner: string, workflowId: string): UseAIWorkflowResult {\n   119→  const { connected, client } = useAIContext();\n   120→  const [status, setStatus] = useState<WorkflowStatus>('idle');\n   121→  const [text, setText] = useState<string | null>(null);\n   122→  const [error, setError] = useState<Error | null>(null);\n   123→\n   124→  const currentWorkflowRef = useRef<{\n   125→    runId: string;\n   126→    threadId: string;\n   127→    tools: ToolsDefinition;\n   128→    onProgress?: (progress: WorkflowProgress) => void;\n   129→    onComplete?: (result: any) => void;\n   130→    onError?: (error: Error) => void;\n   131→    accumulatedText: string;\n   132→    toolCalls: Array<{\n   133→      toolName: string;\n   134→      args: Record<string, unknown>;\n   135→      result?: unknown;\n   136→    }>;\n   137→  } | null>(null);\n   138→\n   139→  const eventListenerIdRef = useRef<string>(`useAIWorkflow-${Math.random().toString(36).substr(2, 9)}`);\n   140→\n   141→  const handleWorkflowEvent = useCallback(async (event: AGUIEvent) => {\n   142→    const currentWorkflow = currentWorkflowRef.current;\n   143→    if (!currentWorkflow) return;\n   144→\n   145→    // Only process events for the current workflow\n   146→    if (event.type === EventType.RUN_STARTED) {\n 