ion.conversationHistory);\n   386→\n   387→    const followUpResponse = await this.anthropic.messages.create({\n   388→      model: this.config.model,\n   389→      max_tokens: 4096,\n   390→      messages: messagesWithCache,\n   391→      tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   392→      system: systemPrompt,\n   393→    });\n   394→\n   395→    await this.processResponse(session, followUpResponse);\n   396→  }\n   397→\n   398→  private handleToolResponse(session: ClientSession, message: ToolResponseMessage) {\n   399→    const { toolCallId, result, context } = message.data;\n   400→    const resolver = session.pendingToolCalls.get(toolCallId);\n   401→\n   402→    if (resolver) {\n   403→      resolver({ result, context });\n   404→      session.pendingToolCalls.delete(toolCallId);\n   405→    }\n   406→  }\n   407→\n   408→  private sendMessage(ws: WebSocket, message: ServerMessage) {\n   409→    if (ws.readyState === WebSocket.OPEN) {\n   410→      ws.send(JSON.stringify(message));\n   411→    }\n   412→  }\n   413→\n   414→  private sendError(ws: WebSocket, message: string) {\n   415→    this.sendMessage(ws, {\n   416→      type: 'error',\n   417→      data: { message },\n   418→    });\n   419→  }\n   420→\n   421→  /**\n   422→   * Closes the server and cleans up resources.\n   423→   * Stops accepting new connections and terminates all existing connections.\n   424→   */\n   425→  public close() {\n   426→    clearInterval(this.cleanupInterval);\n   427→    this.wss.close();\n   428→    this.httpServer.close();\n   429→  }\n   430→}\n   431→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
