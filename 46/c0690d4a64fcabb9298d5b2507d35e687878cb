            "content": "import { describe, expect, test, beforeAll, afterEach, afterAll, mock } from 'bun:test';\nimport WebSocket from 'ws';\nimport type {\n  ClientMessage,\n  ServerMessage,\n  ToolCallMessage,\n  ResponseMessage,\n  ErrorMessage,\n  ToolDefinition,\n} from './types';\nimport type Anthropic from '@anthropic-ai/sdk';\n\n// Create mock for Anthropic messages.create\nconst mockMessagesCreate = mock(() => Promise.resolve({\n  id: 'msg_default',\n  type: 'message',\n  role: 'assistant',\n  content: [{ type: 'text', text: 'Default response' }],\n  model: 'claude-sonnet-4-20250514',\n  stop_reason: 'end_turn',\n  stop_sequence: null,\n  usage: { input_tokens: 100, output_tokens: 50 },\n}));\n\n// Mock Anthropic SDK\nmock.module('@anthropic-ai/sdk', () => {\n  return {\n    default: class MockAnthropic {\n      apiKey: string;\n      messages: { create: typeof mockMessagesCreate };\n\n      constructor(config: any) {\n        this.apiKey = config.apiKey;\n        this.messages = {\n          create: mockMessagesCreate,\n        };\n      }\n    },\n  };\n});\n\n// Now import server after mocking\nimport { UseAIServer } from './server';\n\n// Test helpers\nfunction waitForConnection(ws: WebSocket): Promise<void> {\n  return new Promise((resolve, reject) => {\n    if (ws.readyState === WebSocket.OPEN) {\n      resolve();\n      return;\n    }\n    ws.once('open', () => resolve());\n    ws.once('error', reject);\n  });\n}\n\nfunction waitForMessage(ws: WebSocket, timeout = 5000): Promise<ServerMessage> {\n  return new Promise((resolve, reject) => {\n    const timeoutId = setTimeout(() => {\n      reject(new Error('Message timeout'));\n    }, timeout);\n\n    ws.once('message', (data: Buffer) => {\n      clearTimeout(timeoutId);\n      resolve(JSON.parse(data.toString()));\n    });\n  });\n}\n\nfunction sendMessage(ws: WebSocket, message: ClientMessage): void {\n  ws.send(JSON.stringify(message));\n}\n\nasync function createTestClient(port: number): Promise<WebSocket> {\n  const ws = new WebSocket(`ws://localhost:${port}`);\n  await waitForConnection(ws);\n  return ws;\n}\n\n// Mock response helpers\nfunction createMockAnthropicMessage(\n  id: string,\n  content: Anthropic.ContentBlock[]\n): Anthropic.Message {\n  return {\n    id,\n    type: 'message',\n    role: 'assistant',\n    content,\n    model: 'claude-sonnet-4-20250514',\n    stop_reason: 'end_turn',\n    stop_sequence: null,\n    usage: {\n      input_tokens: 100,\n      output_tokens: 50,\n    },\n  };\n}\n\nfunction createTextResponse(id: string, text: string): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'text',\n      text,\n    },\n  ]);\n}\n\nfunction createToolUseResponse(\n  id: string,\n  toolCallId: string,\n  toolName: string,\n  input: Record<string, unknown>\n): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'tool_use',\n      id: toolCallId,\n      name: toolName,\n      input,\n    },\n  ]);\n}\n\nfunction createTextAfterToolResponse(id: string, text: string): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'text',\n      text,\n    },\n  ]);\n}\n\n// Track all servers for cleanup\nconst allServers: UseAIServer[] = [];\nconst allWebSockets: WebSocket[] = [];\n\nafterAll(() => {\n  // Force cleanup of any remaining servers\n  allServers.forEach(server => {\n    try {\n      server.close();\n    } catch (e) {\n      // Ignore errors during cleanup\n    }\n  });\n\n  // Force close any remaining websockets\n  allWebSockets.forEach(ws => {\n    try {\n      if (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING) {\n        ws.close();\n      }\n    } catch (e) {\n      // Ignore errors during cleanup\n    }\n  });\n});\n\ndescribe('UseAIServer - Connection Management', () => {\n  let server: UseAIServer;\n  const testPort = 8081;\n\n  beforeAll(() => {\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('client can connect to the server', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n    expect(ws.readyState).toBe(WebSocket.OPEN);\n    ws.close();\n  });\n\n  test('server tracks multiple simultaneous client connections', async () => {\n    const ws1 = await createTestClient(testPort);\n    const ws2 = await createTestClient(testPort);\n    const ws3 = await createTestClient(testPort);\n    allWebSockets.push(ws1, ws2, ws3);\n\n    expect(ws1.readyState).toBe(WebSocket.OPEN);\n    expect(ws2.readyState).toBe(WebSocket.OPEN);\n    expect(ws3.readyState).toBe(WebSocket.OPEN);\n\n    ws1.close();\n    ws2.close();\n    ws3.close();\n  });\n\n  test('client disconnection cleans up session', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const closePromise = new Promise<void>((resolve) => {\n      ws.on('close', () => resolve());\n    });\n\n    ws.close();\n    await closePromise;\n\n    // If we can connect again with no issues, cleanup worked\n    const ws2 = await createTestClient(testPort);\n    allWebSockets.push(ws2);\n    expect(ws2.readyState).toBe(WebSocket.OPEN);\n    ws2.close();\n  });\n});\n\ndescribe('UseAIServer - Tool Registration', () => {\n  let server: UseAIServer;\n  const testPort = 8082;\n\n  beforeAll(() => {\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('client can register tools with server', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const tools: ToolDefinition[] = [\n      {\n        name: 'add_todo',\n        description: 'Add a new todo',\n        input_schema: {\n          type: 'object',\n          properties: {\n            text: { type: 'string' },\n          },\n          required: ['text'],\n        },\n      },\n    ];\n\n    sendMessage(ws, {\n      type: 'register_tools',\n      data: { tools },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 50));\n\n    ws.close();\n  });\n\n  test('client can register tools with UI context', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const tools: ToolDefinition[] = [\n      {\n        name: 'add_todo',\n        description: 'Add a new todo',\n        input_schema: {\n          type: 'object',\n          properties: {\n            text: { type: 'string' },\n          },\n          required: ['text'],\n        },\n      },\n    ];\n\n    const context = 'Current todos: Buy milk, Walk dog';\n\n    sendMessage(ws, {\n      type: 'register_tools',\n      data: { tools, context },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 50));\n\n    ws.close();\n  });\n});\n\ndescribe('UseAIServer - Prompt Processing (Basic)', () => {\n  let server: UseAIServer;\n  const testPort = 8083;\n\n  beforeAll(() => {\n    mockMessagesCreate.mockClear();\n    mockMessagesCreate.mockImplementation(() =>\n      Promise.resolve(createTextResponse('msg_123', 'Hello! How can I help you?'))\n    );\n\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('client can send prompt and receive text response', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Hello' },\n    });\n\n    const response = await waitForMessage(ws) as ResponseMessage;\n    expect(response.type).toBe('response');\n    expect(response.data.content).toBe('Hello! How can I help you?');\n    expect(response.data.conversationId).toBe('msg_123');\n\n    ws.close();\n  });\n\n  test('server forwards prompt to Anthropic API with correct model', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    mockMessagesCreate.mockClear();\n\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Test prompt' },\n    });\n\n    await waitForMessage(ws);\n\n    expect(mockMessagesCreate).toHaveBeenCalled();\n    const callArgs = mockMessagesCreate.mock.calls[0][0];\n    expect(callArgs.model).toBe('claude-sonnet-4-20250514');\n    expect(callArgs.messages).toEqual([\n      {\n        role: 'user',\n        content: 'Test prompt',\n      },\n    ]);\n\n    ws.close();\n  });\n});\n\ndescribe('UseAIServer - Tool Execution Flow', () => {\n  let server: UseAIServer;\n  const testPort = 8084;\n\n  beforeAll(() => {\n    mockMessagesCreate.mockClear();\n\n    let callCount = 0;\n    mockMessagesCreate.mockImplementation(() => {\n      callCount++;\n      if (callCount === 1) {\n        return Promise.resolve(\n          createToolUseResponse('msg_456', 'toolu_789', 'add_todo', { text: 'Buy milk' })\n        );\n      } else {\n        return Promise.resolve(createTextAfterToolResponse('msg_457', 'Added the todo!'));\n      }\n    });\n\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('prompt triggers tool_use - server sends tool_call to client', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const tools: ToolDefinition[] = [\n      {\n        name: 'add_todo',\n        description: 'Add a new todo',\n        input_schema: {\n          type: 'object',\n          properties: {\n            text: { type: 'string' },\n          },\n          required: ['text'],\n        },\n      },\n    ];\n\n    sendMessage(ws, {\n      type: 'register_tools',\n      data: { tools },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 50));\n\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Add a todo to buy milk' },\n    });\n\n    const toolCallMessage = await waitForMessage(ws) as ToolCallMessage;\n    expect(toolCallMessage.type).toBe('tool_call');\n    expect(toolCallMessage.data.toolCallId).toBe('toolu_789');\n    expect(toolCallMessage.data.name).toBe('add_todo');\n    expect(toolCallMessage.data.input).toEqual({ text: 'Buy milk' });\n\n    // Send tool response to complete the flow\n    sendMessage(ws, {\n      type: 'tool_response',\n      data: {\n        toolCallId: 'toolu_789',\n        result: { success: true },\n      },\n    });\n\n    await waitForMessage(ws);\n\n    ws.close();\n  }, 10000);\n});\n\ndescribe('UseAIServer - Error Handling', () => {\n  let server: UseAIServer;\n  const testPort = 8089;\n\n  beforeAll(() => {\n    mockMessagesCreate.mockClear();\n    mockMessagesCreate.mockImplementation(() => Promise.resolve(createTextResponse('msg_err1', 'Response')));\n\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('invalid JSON message returns error to client', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    ws.send('invalid json{{{');\n\n    const errorMessage = await waitForMessage(ws) as ErrorMessage;\n    expect(errorMessage.type).toBe('error');\n\n    ws.close();\n  });\n\n  test('missing API key throws error on server construction', () => {\n    expect(() => {\n      new UseAIServer({\n        port: 9999,\n        anthropicApiKey: '',\n      });\n    }).toThrow('Anthropic API key is required');\n  });\n});\n\ndescribe('UseAIServer - Server Lifecycle', () => {\n  test('server starts on configured port', async () => {\n    const testPort = 8090;\n    const server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n    expect(ws.readyState).toBe(WebSocket.OPEN);\n\n    ws.close();\n    server.close();\n  });\n\n  test('multiple server instances can run on different ports', async () => {\n    const server1 = new UseAIServer({\n      port: 8092,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server1);\n\n    const server2 = new UseAIServer({\n      port: 8093,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server2);\n\n    const ws1 = await createTestClient(8092);\n    const ws2 = await createTestClient(8093);\n    allWebSockets.push(ws1, ws2);\n\n    expect(ws1.readyState).toBe(WebSocket.OPEN);\n    expect(ws2.readyState).toBe(WebSocket.OPEN);\n\n    ws1.close();\n    ws2.close();\n    server1.close();\n    server2.close();\n  });\n});\n",
