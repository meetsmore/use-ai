lCalls: currentWorkflow.toolCalls,\n   198→          });\n   199→\n   200→          // Send result back to server\n   201→          client.sendToolResponse(toolCallId, result);\n   202→        } catch (err) {\n   203→          console.error('[useAIWorkflow] Tool execution error:', err);\n   204→          client.sendToolResponse(toolCallId, {\n   205→            error: err instanceof Error ? err.message : 'Unknown error',\n   206→          });\n   207→        }\n   208→        break;\n   209→      }\n   210→\n   211→      case EventType.RUN_FINISHED: {\n   212→        setStatus('completed');\n   213→\n   214→        const result = {\n   215→          text: currentWorkflow.accumulatedText,\n   216→          toolCalls: currentWorkflow.toolCalls,\n   217→        };\n   218→\n   219→        currentWorkflow.onProgress?.({\n   220→          status: 'completed',\n   221→          text: currentWorkflow.accumulatedText,\n   222→          toolCalls: currentWorkflow.toolCalls,\n   223→        });\n   224→\n   225→        currentWorkflow.onComplete?.(result);\n   226→\n   227→        // Clear workflow ref\n   228→        currentWorkflowRef.current = null;\n   229→        break;\n   230→      }\n   231→\n   232→      case EventType.RUN_ERROR: {\n   233→        const errorEvent = event as RunErrorEvent;\n   234→        const err = new Error(errorEvent.message);\n   235→        setError(err);\n   236→        setStatus('error');\n   237→\n   238→        currentWorkflow.onProgress?.({\n   239→          status: 'error',\n   240→          error: errorEvent.message,\n   241→          text: currentWorkflow.accumulatedText,\n   242→          toolCalls: currentWorkflow.toolCalls,\n   243→        });\n   244→\n   245→        currentWorkflow.onError?.(err);\n   246→\n   247→        // Clear workflow ref\n   248→        currentWorkflowRef.current = null;\n   249→        break;\n   250→      }\n   251→    }\n   252→  }, [client]);\n   253→\n   254→  // Register event listener once\n   255→  useCallback(() => {\n   256→    if (!client) return;\n   257→\n   258→    const unsubscribe = client.onEvent(eventListenerIdRef.current, handleWorkflowEvent);\n   259→\n   260→    return () => {\n   261→      unsubscribe();\n   262→    };\n   263→  }, [client, handleWorkflowEvent]);\n   264→\n   265→  const trigger = useCallback(async (options: TriggerWorkflowOptions) => {\n   266→    if (!client?.isConnected()) {\n   267→      const err = new Error('Not connected to server');\n   268→      setError(err);\n   269→      options.onError?.(err);\n   270→      return;\n   271→    }\n   272→\n   273→    // Prevent concurrent workflows\n   274→    if (currentWorkflowRef.current !== null) {\n   275→      const err = new Error('A workflow is already running. Wait for it to complete before triggering a new one.');\n   276→      setError(err);\n   277→      setStatus('error');\n   278→      options.onError?.(err);\n   279→      return;\n   280→    }\n   281→\n   282→    // Reset state\n   283→    setStatus('running');\n   284→    setError(null);\n   285→    setText(null);\n   286→\n   287→    const runId = uuidv4();\n   288→    const threadId = uuidv4();\n   289→\n   290→    // Store workflow context\n   291→    currentWorkflowRef.current = {\n   292→      runId,\n   293→      threadId,\n   294→      tools: options.tools || {},\n   295→      onProgress: options.onProgress,\n   296→      onComplete: options.onComplete,\n   297→      onError: options.onError,\n   298→      accumulatedText: '',\n   299→      toolCalls: [],\n   300→    };\n   301→\n   302→    // Register event listener\n   303→    const unsubscribe = client.onEvent(eventListenerIdRef.current, handleWorkflowEvent);\n   304→\n   305→    // Convert tools to ToolDefinition format\n   306→    const toolDefinitions = options.tools ? convertToolsToDefinitions(options.tools) : [];\n   307→\n   308→    // Send run_workflow message\n   309→    const message: RunWorkflowMessage = {\n   310→      type: 'run_workflow',\n   311→