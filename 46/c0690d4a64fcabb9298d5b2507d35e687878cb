st messageToCache = messagesWithCache[cacheIndex];\n   233→\n   234→    // Add cache_control to the last content block of this message\n   235→    if (typeof messageToCache.content === 'string') {\n   236→      messageToCache.content = [\n   237→        {\n   238→          type: 'text',\n   239→          text: messageToCache.content,\n   240→          cache_control: { type: 'ephemeral' }\n   241→        }\n   242→      ];\n   243→    } else if (Array.isArray(messageToCache.content) && messageToCache.content.length > 0) {\n   244→      const lastContent = messageToCache.content[messageToCache.content.length - 1];\n   245→      lastContent.cache_control = { type: 'ephemeral' };\n   246→    }\n   247→\n   248→    return messagesWithCache;\n   249→  }\n   250→\n   251→  private async handlePrompt(session: ClientSession, message: PromptMessage) {\n   252→    const { prompt } = message.data;\n   253→\n   254→    const rateLimitCheck = this.rateLimiter.checkLimit(session.clientId);\n   255→    if (!rateLimitCheck.allowed) {\n   256→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   257→      this.sendError(\n   258→        session.ws,\n   259→        `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`\n   260→      );\n   261→      return;\n   262→    }\n   263→\n   264→    session.conversationHistory.push({\n   265→      role: 'user',\n   266→      content: prompt,\n   267→    });\n   268→\n   269→    try {\n   270→      const systemPrompt = this.buildSystemPrompt(session);\n   271→      const messagesWithCache = this.prepareMessagesWithCaching(session.conversationHistory);\n   272→\n   273→      const response = await this.anthropic.messages.create({\n   274→        model: this.config.model,\n   275→        max_tokens: 4096,\n   276→        messages: messagesWithCache,\n   277→        tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   278→        system: systemPrompt,\n   