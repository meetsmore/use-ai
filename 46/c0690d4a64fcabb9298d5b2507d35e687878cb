            "new_string": "describe('Server Lifecycle', () => {\n  test('server starts on configured port', async () => {\n    const testPort = 8084;\n    const server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n    expect(ws.readyState).toBe(WebSocket.OPEN);\n\n    ws.close();\n    server.close();\n  });\n});\n\ndescribe('Rate Limiting', () => {\n  test('if a client hits the rate limit, they will be blocked from queries', async () => {\n    const testPort = 8085;\n    const server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n      rateLimitConfig: {\n        maxRequests: 2,\n        windowMs: 1000,\n      },\n    });\n    allServers.push(server);\n\n    mockMessagesCreate.mockClear();\n    mockMessagesCreate.mockImplementation((_params?: any): Promise<Anthropic.Message> => {\n      return Promise.resolve(createTextResponse('msg_rate1', 'Response'));\n    });\n\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    // Send first prompt (should succeed)\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'First prompt' },\n    });\n\n    const response1 = await waitForMessage(ws);\n    expect(response1.type).toBe('response');\n\n    // Send second prompt (should succeed)\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Second prompt' },\n    });\n\n    const response2 = await waitForMessage(ws);\n    expect(response2.type).toBe('response');\n\n    // Send third prompt (should be rate limited)\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Third prompt' },\n    });\n\n    const response3 = await waitForMessage(ws) as ErrorMessage;\n    expect(response3.type).toBe('error');\n    expect(response3.data.message).toContain('Rate limit exceeded');\n\n    ws.close();\n    server.close();\n  });\n\n  test('clients rate limits do not affect other clients', async () => {\n    const testPort = 8086;\n    const server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n      rateLimitConfig: {\n        maxRequests: 2,\n        windowMs: 1000,\n      },\n    });\n    allServers.push(server);\n\n    mockMessagesCreate.mockClear();\n    mockMessagesCreate.mockImplementation((_params?: any): Promise<Anthropic.Message> => {\n      return Promise.resolve(createTextResponse('msg_rate2', 'Response'));\n    });\n\n    // Connect two clients\n    const ws1 = await createTestClient(testPort);\n    const ws2 = await createTestClient(testPort);\n    allWebSockets.push(ws1, ws2);\n\n    // Client 1: Send requests until rate limited\n    sendMessage(ws1, {\n      type: 'prompt',\n      data: { prompt: 'Client 1 - First' },\n    });\n    await waitForMessage(ws1);\n\n    sendMessage(ws1, {\n      type: 'prompt',\n      data: { prompt: 'Client 1 - Second' },\n    });\n    await waitForMessage(ws1);\n\n    sendMessage(ws1, {\n      type: 'prompt',\n      data: { prompt: 'Client 1 - Third' },\n    });\n    const ws1Response = await waitForMessage(ws1) as ErrorMessage;\n    expect(ws1Response.type).toBe('error');\n    expect(ws1Response.data.message).toContain('Rate limit exceeded');\n\n    // Client 2: Should still be able to send requests\n    sendMessage(ws2, {\n      type: 'prompt',\n      data: { prompt: 'Client 2 - First' },\n    });\n    const ws2Response = await waitForMessage(ws2) as ResponseMessage;\n    expect(ws2Response.type).toBe('response');\n\n    ws1.close();\n    ws2.close();\n    server.close();\n  });\n});",
