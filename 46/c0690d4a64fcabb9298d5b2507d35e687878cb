e: 'prompt',\n      data: { prompt: 'First message' },\n    });\n\n    await waitForMessage(ws);\n\n    sendMessage(ws, {\n      type: 'prompt',\n      data: { prompt: 'Second message' },\n    });\n\n    await waitForMessage(ws);\n\n    // Check that second call includes history from first\n    expect(mockCreate).toHaveBeenCalledTimes(2);\n    const secondCallArgs = mockCreate.mock.calls[1][0];\n    expect(secondCallArgs.messages).toHaveLength(4); // user1, assistant1, user2, assistant2 (wait, assistant2 hasn't been added yet)\n    // Actually it should be: user1, assistant1, user2\n    expect(secondCallArgs.messages).toHaveLength(3);\n    expect(secondCallArgs.messages[0].content).toBe('First message');\n    expect(secondCallArgs.messages[2].content).toBe('Second message');\n\n    ws.close();\n  });\n\n  test('each client session has independent conversation history', async () => {\n    const ws1 = await createTestClient(testPort);\n    const ws2 = await createTestClient(testPort);\n\n    sendMessage(ws1, {\n      type: 'prompt',\n      data: { prompt: 'Client 1 message' },\n    });\n\n    await waitForMessage(ws1);\n\n    sendMessage(ws2, {\n      type: 'prompt',\n      data: { prompt: 'Client 2 message' },\n    });\n\n    await waitForMessage(ws2);\n\n    // Client 1 makes another request\n    sendMessage(ws1, {\n      type: 'prompt',\n      data: { prompt: 'Client 1 second message' },\n    });\n\n    await waitForMessage(ws1);\n\n    // Check the third call (client 1's second message) only has client 1's history\n    const thirdCallArgs = mockCreate.mock.calls[2][0];\n    expect(thirdCallArgs.messages.some((m: any) => m.content === 'Client 2 message')).toBe(false);\n    expect(thirdCallArgs.messages.some((m: any) => m.content === 'Client 1 message')).toBe(true);\n\n    ws1.close();\n    ws2.close();\n  });\n});\n\ndescribe('UseAIServer - Rate Limiting Integration', () => {\n  let server: UseAIServer;\n  const testPort = 8088;\n  let mockCreate: ReturnType<typeof