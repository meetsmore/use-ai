          "type": "user",
          "text": "     1→import type { ToolDefinition, ToolRegistration, ServerMessage } from './types';\n     2→\n     3→/**\n     4→ * WebSocket client for communicating with the UseAI server.\n     5→ * Handles connection management, message routing, and automatic reconnection.\n     6→ * \n     7→ * You probably don't need to use this directly, instead use {@link UseAIProvider}.\n     8→ */\n     9→export class UseAIClient {\n    10→  private ws: WebSocket | null = null;\n    11→  private messageHandlers: Map<string, (message: ServerMessage) => void> = new Map();\n    12→  private reconnectAttempts = 0;\n    13→  private maxReconnectAttempts = 5;\n    14→  private reconnectDelay = 1000;\n    15→\n    16→  /**\n    17→   * Creates a new UseAI client instance.\n    18→   *\n    19→   * @param serverUrl - The WebSocket URL of the UseAI server\n    20→   */\n    21→  constructor(private serverUrl: string) {}\n    22→\n    23→  /**\n    24→   * Establishes a WebSocket connection to the server.\n    25→   * Automatically sets up reconnection logic on disconnect.\n    26→   *\n    27→   * @returns Promise that resolves when connected\n    28→   * @throws Error if connection fails\n    29→   */\n    30→  connect(): Promise<void> {\n    31→    return new Promise((resolve, reject) => {\n    32→      try {\n    33→        this.ws = new WebSocket(this.serverUrl);\n    34→\n    35→        this.ws.onopen = () => {\n    36→          console.log('Connected to UseAI server');\n    37→          this.reconnectAttempts = 0;\n    38→          resolve();\n    39→        };\n    40→\n    41→        this.ws.onmessage = (event) => {\n    42→          try {\n    43→            const message: ServerMessage = JSON.parse(event.data);\n    44→            this.messageHandlers.forEach((handler) => handler(message));\n    45→          } catch (error) {\n    46→            console.error('Error parsing message:', error);\n    47→          }\n    48→        };\n    49→\n    50→        this.ws.onerror = (error) => {\n    51→          console.error('WebSocket error:', error);\n    52→          reject(error);\n    53→        };\n    54→\n    55→        this.ws.onclose = () => {\n    56→          console.log('Disconnected from UseAI server');\n    57→          this.attemptReconnect();\n    58→        };\n    59→      } catch (error) {\n    60→        reject(error);\n    61→      }\n    62→    });\n    63→  }\n    64→\n    65→  private attemptReconnect() {\n    66→    if (this.reconnectAttempts < this.maxReconnectAttempts) {\n    67→      this.reconnectAttempts++;\n    68→      console.log(`Attempting to reconnect (${this.reconnectAttempts}/${this.maxReconnectAttempts})...`);\n    69→\n    70→      setTimeout(() => {\n    71→        this.connect().catch((error) => {\n    72→          console.error('Reconnection failed:', error);\n    73→        });\n    74→      }, this.reconnectDelay * this.reconnectAttempts);\n    75→    }\n    76→  }\n    77→\n    78→  /**\n    79→   * Registers available tools with the server.\n    80→   *\n    81→   * @param tools - Array of tool definitions to register\n    82→   * @param prompt - Optional prompt to send to the AI for this component (or set of tools) (e.g. UI state)\n    83→   */\n    84→  registerTools(tools: ToolDefinition[], prompt?: string) {\n    85→    const data: ToolRegistration = { tools };\n    86→    if (prompt) {\n    87→      data.context = prompt;\n    88→    }\n    89→    this.send({\n    90→      type: 'register_tools',\n    91→      data,\n    92→    });\n    93→  }\n    94→\n    95→  /**\n    96→   * Sends a user prompt to the AI.\n    97→   *\n    98→   * @param prompt - The user's prompt/question\n    99→   * @param conversationId - Optional ID to continue an existing conversation\n   100→   */\n   101→  sendPrompt(prompt: string, conversationId?: string) {\n   102→    this.send({\n   103→      type: 'prompt',\n   104→      data: { prompt, conversationId },\n   105→    });\n   106→  }\n   107→\n   108→  /**\n   109→   * Sends the result of a tool execution back to the server.\n   110→   *\n   111→   * @param toolCallId - The ID of the tool call being responded to\n   112→   * @param result - The result returned by the tool execution\n   113→   * @param prompt - Optional updated prompt to send back to the AI (e.g. updated UI state)\n   114→   */\n   115→  sendToolResponse(toolCallId: string, result: unknown, prompt?: string) {\n   116→    const data: { toolCallId: string; result: unknown; context?: string } = { toolCallId, result };\n   117→    if (prompt) {\n   118→      data.context = prompt;\n   119→    }\n   120→    this.send({\n   121→      type: 'tool_response',\n   122→      data,\n   123→    });\n   124→  }\n   125→\n   126→  /**\n   127→   * Registers a message handler for receiving server messages.\n   128→   *\n   129→   * @param id - Unique identifier for this handler\n   130→   * @param handler - Callback function to handle incoming messages\n   131→   * @returns Cleanup function to unregister the handler\n   132→   */\n   133→  onMessage(id: string, handler: (message: ServerMessage) => void) {\n   134→    this.messageHandlers.set(id, handler);\n   135→    return () => {\n   136→      this.messageHandlers.delete(id);\n   137→    };\n   138→  }\n   139→\n   140→  private send(message: unknown) {\n   141→    if (this.ws && this.ws.readyState === WebSocket.OPEN) {\n   142→      this.ws.send(JSON.stringify(message));\n   143→    } else {\n   144→      console.error('WebSocket is not connected');\n   145→    }\n   146→  }\n   147→\n   148→  /**\n   149→   * Closes the WebSocket connection to the server.\n   150→   */\n   151→  disconnect() {\n   152→    if (this.ws) {\n   153→      this.ws.close();\n   154→      this.ws = null;\n   155→    }\n   156→  }\n   157→\n   158→  /**\n   159→   * Checks if the client is currently connected to the server.\n   160→   *\n   161→   * @returns true if connected, false otherwise\n   162→   */\n   163→  isConnected(): boo