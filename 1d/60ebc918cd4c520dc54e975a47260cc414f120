   * @param config - Server configuration options\n    57→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    58→   */\n    59→  constructor(config: UseAIServerConfig = {}) {\n    60→    this.config = {\n    61→      port: config.port ?? 8080,\n    62→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    63→      model: config.model ?? 'claude-sonnet-4-20250514',\n    64→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    65→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    66→    };\n    67→\n    68→    if (!this.config.anthropicApiKey) {\n    69→      throw new Error('Anthropic API key is required');\n    70→    }\n    71→\n    72→    this.anthropic = new Anthropic({\n    73→      apiKey: this.config.anthropicApiKey,\n    74→    });\n    75→\n    76→    this.rateLimiter = new RateLimiter({\n    77→      maxRequests: this.config.rateLimitMaxRequests,\n    78→      windowMs: this.config.rateLimitWindowMs,\n    79→    });\n    80→\n    81→    this.cleanupInterval = setInterval(() => {\n    82→      this.rateLimiter.cleanup();\n    83→    }, this.config.rateLimitWindowMs);\n    84→\n    85→    this.wss = new WebSocketServer({ port: this.config.port });\n    86→    this.setupWebSocketServer();\n    87→\n    88→    if (this.rateLimiter.isEnabled()) {\n    89→      console.log(`Rate limiting enabled: ${this.config.rateLimitMaxRequests} requests per ${this.config.rateLimitWindowMs}ms`);\n    90→    }\n    91→  }\n    92→\n    93→  private setupWebSocketServer() {\n    94→    this.wss.on('connection', (ws: WebSocket) => {\n    95→      const clientId = `client-${++this.clientIdCounter}`;\n    96→      console.log(`Client connected: ${clientId}`);\n    97→\n    98→      const session: ClientSession = {\n    99→        clientId,\n   100→        ws,\n   101→        tools: [],\n   102→        conversationHistory: [],\n   103→        pendingToolCalls: new Map(),\n   104→      };\n   105→\n   106→      this.clients.set(ws, session);\n   107→\n   108→      ws.on('message', async (data: Buffer) => {\n   109→        try {\n   110→          const message: ClientMessage = JSON.parse(data.toString());\n   111→          await this.handleClientMessage(ws, message);\n   112→        } catch (error) {\n   113→          console.error('Error handling message:', error);\n   114→          this.sendError(ws, error instanceof Error ? error.message : 'Unknown error');\n   115→        }\n   116→      });\n   117→\n   118→      ws.on('close', () => {\n   119→        console.log(`Client disconnected: ${clientId}`);\n   120→        this.rateLimiter.removeClient(clientId);\n   121→        this.clients.delete(ws);\n   122→      });\n   123→    });\n   124→\n   125→    console.log(`UseAI server listening on port ${this.config.port}`);\n   126→  }\n   127→\n   128→  private async handleClientMessage(ws: WebSocket, message: ClientMessage) {\n   129→    const session = this.clients.get(ws);\n   130→    if (!session) return;\n   131→\n   132→    switch (message.type) {\n   133→      case 'register_tools':\n   134→        this.handleRegisterTools(session, message as RegisterToolsMessage);\n   135→        break;\n   136→      case 'prompt':\n   137→        await this.handlePrompt(session, message as PromptMessage);\n   138→        break;\n   139→      case 'tool_response':\n   140→        this.handleToolResponse(session, message as ToolResponseMessage);\n   141→        break;\n   142→    }\n   143→  }\n   144→\n   145→  private handleRegisterTools(session: ClientSession, message: RegisterToolsMessage) {\n   146→    session.tools = message.data.tools;\n   147→    session.context = message.data.context;\n   148→    console.log(`Registered ${session.tools.length} tools for client`);\n   149→    if (session.context) {\n   150→      console.log(`Received UI context (${session.context.length} chars)`);\n   151→    }\n   152→  }\n   153→\n   154→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Anthropic.Tool[] {\n   155→    return tools.map(tool => ({\n   156→      name: tool.name,\n   157→      description: tool.description,\n   158→      input_schema: tool.input_schema,\n   159→    }));\n   160→  }\n   161→\n   162→  private buildSystemPrompt(session: ClientSession): string | undefined {\n   163→    const parts: string[] = [];\n   164→\n   165→    if (session.context) {\n   166→      parts.push('You are interacting with a web application. Here is the current state of the UI:');\n   167→      parts.push('');\n   168→      parts.push(session.context);\n   169→      parts.push('');\n   170→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   171→    }\n   172→\n   173→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   174→    if (confirmationTools.length > 0) {\n   175→      if (parts.length > 0) {\n   176→        parts.push('');\n   177→      }\n   178→      parts.push('IMPORTANT: The following tools require user confirmation before execution:');\n   179→      parts.push('');\n   180→      confirmationTools.forEach(tool => {\n   181→        parts.push(`- ${tool.name}`);\n   182→      });\n   183→      parts.push('');\n   184→      parts.push('Before calling any of these tools, you MUST:');\n   185→      parts.push('1. Explain to the user exactly what changes will be made');\n   186→      parts.push('2. Ask the user to confirm they want to proceed');\n   187→      parts.push('3. Only call the tool after receiving explicit confirmation from the user');\n   188→      parts.push('');\n   189→      parts.push('Never call these tools without first getting user confirmation in the same conversation turn.');\n   190→    }\n   191→\n   192→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   193→  }\n   194→\n   195→  private async handlePrompt(session: ClientSession, message: PromptMessage) {\n   196→    const { prompt } = message.data;\n   197→\n   198→    const rateLimitCheck = this.rateLimiter.checkLimit(session.clientId);\n   199→    if (!rateLimitCheck.allowed) {\n   200→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   201→      this.sendError(\n   202→        session.ws,\n   203→        `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`\n   204→      );\n   205→      return;\n   206→    }\n   207→\n   208→    session.conversationHistory.push({\n   209→      role: 'user',\n   210→      content: prompt,\n   211→    });\n   212→\n   213→    try {\n   214→      const systemPrompt = this.buildSystemPrompt(session);\n   215→\n   216→      const response = await this.anthropic.messages.create({\n   217→        model: this.config.model,\n   218→        max_tokens: 4096,\n   219→        messages: session.conversationHistory,\n   220→        tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   221→        system: systemPrompt,\n   222→      });\n   223→\n   224→      console.log('PROMPT' + systemPrompt)\n   225→      console.log('CONVERSATION' + JSON.stringify(session.conversationHistory))\n   226→      console.log('TOOLS' + JSON.stringify(this.sanitizeToolsForAPI(session.tools)))\n   227→\n   228→      await this.processResponse(session, response);\n   229→    } catch (error) {\n   230→      console.error('Error calling Anthropic API:', error);\n   231→      this.sendError(session.ws, error instanceof Error ? error.message : 'Unknown error');\n   232→    }\n   233→  }\n   234→\n   235→  private async processResponse(session: ClientSession, response: Anthropic.Message) {\n   236→    session.conversationHistory.push({\n   237→      role: 'assistant',\n   238→      content: response.content,\n   239→    });\n   240→\n   241→    const toolUseBlocks: Anthropic.ToolUseBlock[] = [];\n   242→\n   243→    for (const block of response.content) {\n   244→      if (block.type === 'text') {\n   245→        this.sendMessage(session.ws, {\n   246→          type: 'response',\n   247→          data: {\n   248→            content: block.text,\n   249→            conversationId: response.id,\n   250→          },\n   251→        });\n   252→      } else if (block.type === 'tool_use') {\n   253→        toolUseBlocks.push(block);\n   254→      }\n   255→    }\n   256→\n   257→    if (toolUseBlocks.length > 0) {\n   258→      await this.handleMultipleToolUses(session, toolUseBlocks);\n   259→    }\n   260→  }\n   261→\n   262→  private async handleMultipleToolUses(\n   263→    session: ClientSession,\n   264→    toolUseBlocks: Anthropic.ToolUseBlock[]\n   265→  ) {\n   266→    const toolResults: Anthropic.ToolResultBlockParam[] = [];\n   267→\n   268→    for (const toolUse of toolUseBlocks) {\n   269→      const toolCallId = toolUse.id;\n   270→\n   271→      const toolResponsePromise = new Promise<{ result: unknown; context?: string }>((resolve) => {\n   272→        session.pendingToolCalls.set(toolCallId, resolve);\n   273→      });\n   274→\n   275→      this.sendMessage(session.ws, {\n   276→        type: 'tool_call',\n   277→        data: {\n   278→          toolCallId,\n   279→          name: toolUse.name,\n   280→          input: toolUse.input,\n   281→        },\n   282→      });\n   283→\n   284→      const { result, context } = await toolResponsePromise;\n   285→\n   286→      if (context) {\n   287→        session.context = context;\n   288→      }\n   289→\n   290→      const toolResultContent = context\n   291→        ? JSON.stringify(result) + '\\n\\nUpdated UI state:\\n' + context\n   292→        : JSON.stringify(result);\n   293→\n   294→      toolResults.push({\n   295→        type: 'tool_result',\n   296→        tool_use_id: toolCallId,\n   297→        content: toolResultContent,\n   298→      });\n   299→    }\n   300→\n   301→    session.conversationHistory.push({\n   302→      role: 'user',\n   303→      content: toolResults,\n   304→    });\n   305→\n   306→    const systemPrompt = this.buildSystemPrompt(session);\n   307→\n   308→    const followUpResponse = await this.anthropic.messages.create({\n   309→      model: this.config.model,\n   310→      max_tokens: 4096,\n   311→      messages: session.conversationHistory,\n   312→      tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   313→      system: systemPrompt,\n   314→    });\n   315→\n   316→    await this.processResponse(session, followUpResponse);\n   317→  }\n   318→\n   319→  private handleToolResponse(session: ClientSession, message: ToolResponseMessage) {\n   320→    const { toolCallId, result, context } = message.data;\n   321→    const resolver = session.pendingToolCalls.get(toolCallId);\n   322→\n   323→    if (resolver) {\n   324→      resolver({ result, context });\n   325→      session.pendingToolCalls.delete(toolCallId);\n   326→    }\n   327→  }\n   328→\n   329→  private sendMessage(ws: WebSocket, message: ServerMessage) {\n   330→    if (ws.readyState === WebSocket.OPEN) {\n   331→      ws.send(JSON.stringify(message));\n   332→    }\n   333→  }\n   334→\n   335→  private sendError(ws: WebSocket, message: string) {\n   336→    this.sendMessage(ws, {\n   337→      type: 'error',\n   338→      data: { message },\n   339→    });\n   340→  }\n   341→\n   342→  /**\n   343→   * Closes the server and cleans up resources.\n   344→   * Stops accepting new connections and terminates all existing connections.\n   345→   */\n   346→  public close() {\n   347→    clearInterval(this.cleanupInterval);\n   348→    this.wss.close();\n   349→  }\n   350→}\n   351→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
