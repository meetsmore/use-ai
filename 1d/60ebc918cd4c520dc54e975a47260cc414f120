ocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   298→      });\n   299→\n   300→      // Initial count should be 0\n   301→      expect(getByTestId('counter').textContent).toBe('0');\n   302→\n   303→      // Invoke the tool to increment counter\n   304→      await act(async () => {\n   305→        const ws = MockWebSocket.getMostRecent();\n   306→        ws?.simulateToolCall('call-increment-1', 'incrementCounter', {});\n   307→      });\n   308→\n   309→      // Verify the component state was updated\n   310→      await waitFor(() => {\n   311→        expect(getByTestId('counter').textContent).toBe('1');\n   312→      });\n   313→\n   314→      // Verify tool_result message contains updated state\n   315→      await waitFor(() => {\n   316→        const ws = MockWebSocket.getMostRecent();\n   317→        const toolResultMessage = ws?.sentMessages.find(\n   318→          (msg) => msg.type === 'tool_result'\n   319→        );\n   320→        expect(toolResultMessage).toBeDefined();\n   321→        expect(toolResultMessage.data.toolCallId).toBe('call-increment-1');\n   322→\n   323→        const resultData = JSON.parse(toolResultMessage.data.content);\n   324→        expect(resultData.success).toBe(true);\n   325→        expect(resultData.newCount).toBe(1);\n   326→      });\n   327→    });\n   328→  });\n   329→\n   330→  describe('Components will be automatically identified by their \"id\" attribute if present', () => {\n   331→    it('should namespace tools with the component ref id attribute', async () => {\n   332→      const TestComponent = ({ id, listName }: { id: string; listName: string }) => {\n   333→        const [lastTodo, setLastTodo] = React.useState<string>('');\n   334→\n   335→        const tools = React.useMemo(() => ({\n   336→          addTodo: defineTool(\n   337→            'Add a todo',\n   338→            z.object({ text: z.string() }),\n   339→            (input) => {\n   340→              setLastTodo(input.text);\n   341→              return { success: true, list: listName, text: input.text };\n   342→            }\n   343→          )\n   344→        }), [listName]);\n   345→        const { ref } = useAI({ tools });\n   346→\n   347→        return <div ref={ref} id={id} data-testid={`list-${id}`}>{lastTodo}</div>;\n   348→      };\n   349→\n   350→      const { getByTestId } = render(\n   351→        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n   352→          <TestComponent id=\"todo-list\" listName=\"todo-list\" />\n   353→          <TestComponent id=\"shopping-list\" listName=\"shopping-list\" />\n   354→          <TestComponent id=\"work-tasks\" listName=\"work-tasks\" />\n   355→        </UseAIProvider>\n   356→      );\n   357→\n   358→      await waitFor(() => {\n   359→        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   360→      });\n   361→\n   362→      // Test namespaced tool calls - call todo-list component\n   363→      await act(async () => {\n   364→        const ws = MockWebSocket.getMostRecent();\n   365→        ws?.simulateToolCall('call-1', 'todo-list_addTodo', { text: 'Task 1' });\n   366→      });\n   367→\n   368→      // Verify only the todo-list component state was updated\n   369→      await waitFor(() => {\n   370→        expect(getByTestId('list-todo-list').textContent).toBe('Task 1');\n   371→        expect(getByTestId('list-shopping-list').textContent).toBe('');\n   372→        expect(getByTestId('list-work-tasks').textContent).toBe('');\n   373→      });\n   374→\n   375→      // Verify the tool result contains the correct list identifier\n   376→      await waitFor(() => {\n   377→        const ws = MockWebSocket.getMostRecent();\n   378→        const toolResult = ws?.sentMessages.find(msg => msg.type === 'tool_result');\n   379→        const resultData = JSON.parse(toolResult.data.content);\n   380→        expect(resultData.list).toBe('todo-list');\n   381→        expect(resultData.text).toBe('Task 1');\n   382→      });\n   383→    });\n   384→  });\n   385→\n   386→  describe('An explicit id can be provided to useAI', () => {\n   387→    it('should namespace tools with the explicit id option', async () => {\n   388→      const TestComponent = ({ id, panelName }: { id: string; panelName: string }) => {\n   389→        const [lastTask, setLastTask] = React.useState<string>('');\n   390→\n   391→        const tools = React.useMemo(() => ({\n   392→          addTodo: defineTool(\n   393→            'Add a todo',\n   394→            z.object({ text: z.string() }),\n   395→            (input) => {\n   396→              setLastTask(input.text);\n   397→              return { success: true, panel: panelName, text: input.text };\n   398→            }\n   399→          )\n   400→        }), [panelName]);\n   401→        useAI({ tools, id });\n   402→        return <div data-testid={`panel-${id}`}>{lastTask}</div>;\n   403→      };\n   404→\n   405→      const { getByTestId } = render(\n   406→        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n   407→          <TestComponent id=\"user-panel\" panelName=\"user\" />\n   408→          <TestComponent id=\"admin-panel\" panelName=\"admin\" />\n   409→          <TestComponent id=\"guest-panel\" panelName=\"guest\" />\n   410→        </UseAIProvider>\n   411→      );\n   412→\n   413→      await waitFor(() => {\n   414→        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   415→      });\n   416→\n   417→      // Test that namespaced tool can be called\n   418→      await act(async () => {\n   419→        const ws = MockWebSocket.getMostRecent();\n   420→        ws?.simulateToolCall('call-1', 'user-panel_addTodo', { text: 'Task' });\n   421→      });\n   422→\n   423→      // Verify only the user panel state was updated\n   424→      await waitFor(() => {\n   425→        expect(getByTestId('panel-user-panel').textContent).toBe('Task');\n   426→        expect(getByTestId('panel-admin-panel').textContent).toBe(''