          "text": "     1→import { describe, it, expect, beforeEach, afterEach, mock } from 'bun:test';\n     2→import { renderHook, waitFor, render, act } from '@testing-library/react';\n     3→import React, { useMemo } from 'react';\n     4→import { z } from 'zod';\n     5→import { UseAIProvider } from '../src/providers/useAIProvider';\n     6→import { useAI } from '../src/useAI';\n     7→import { defineTool } from '../src/defineTool';\n     8→import { UseAIFloatingButton } from '../src/components/UseAIFloatingButton';\n     9→import type { AGUIEvent } from '../src/types';\n    10→import { EventType } from '../src/types';\n    11→\n    12→// Mock WebSocket\n    13→class MockWebSocket {\n    14→  static instances: MockWebSocket[] = [];\n    15→\n    16→  onopen: ((event: Event) => void) | null = null;\n    17→  onclose: ((event: CloseEvent) => void) | null = null;\n    18→  onmessage: ((event: MessageEvent) => void) | null = null;\n    19→  onerror: ((event: Event) => void) | null = null;\n    20→\n    21→  readyState: number = WebSocket.CONNECTING;\n    22→  sentMessages: any[] = [];\n    23→\n    24→  constructor(public url: string) {\n    25→    MockWebSocket.instances.push(this);\n    26→    // Simulate async connection\n    27→    setTimeout(() => {\n    28→      this.readyState = WebSocket.OPEN;\n    29→      this.onopen?.(new Event('open'));\n    30→    }, 0);\n    31→  }\n    32→\n    33→  send(data: string) {\n    34→    this.sentMessages.push(JSON.parse(data));\n    35→  }\n    36→\n    37→  close() {\n    38→    this.readyState = WebSocket.CLOSED;\n    39→    this.onclose?.(new CloseEvent('close'));\n    40→  }\n    41→\n    42→  simulateEvent(event: AGUIEvent) {\n    43→    this.onmessage?.(new MessageEvent('message', { data: JSON.stringify(event) }));\n    44→  }\n    45→\n    46→  simulateToolCall(toolCallId: string, toolName: string, input: Record<string, unknown>) {\n    47→    // Simulate AG-UI tool call event sequence\n    48→    this.simulateEvent({\n    49→      type: EventType.TOOL_CALL_START,\n    50→      toolCallId,\n    51→      toolCallName: toolName,\n    52→      parentMessageId: 'msg-test',\n    53→      timestamp: Date.now(),\n    54→    });\n    55→    this.simulateEvent({\n    56→      type: EventType.TOOL_CALL_ARGS,\n    57→      toolCallId,\n    58→      delta: JSON.stringify(input),\n    59→      timestamp: Date.now(),\n    60→    });\n    61→    this.simulateEvent({\n    62→      type: EventType.TOOL_CALL_END,\n    63→      toolCallId,\n    64→      timestamp: Date.now(),\n    65→    });\n    66→  }\n    67→\n    68→  simulateError() {\n    69→    this.onerror?.(new Event('error'));\n    70→  }\n    71→\n    72→  static reset() {\n    73→    MockWebSocket.instances = [];\n    74→  }\n    75→\n    76→  static getMostRecent(): MockWebSocket | undefined {\n    77→    return MockWebSocket.instances[MockWebSocket.instances.length - 1];\n    78→  }\n    79→}\n    80→\n    81→// Store original WebSocket\n    82→const OriginalWebSocket = global.WebSocket;\n    83→\n    84→// Helper to create stable tools that don't cause re-renders\n    85→function useStableTools<T extends Record<string, any>>(tools: T): T {\n    86→  return useMemo(() => tools, []);\n    87→}\n    88→\n    89→describe('useAI Integration Tests', () => {\n    90→  beforeEach(() => {\n    91→    global.WebSocket = MockWebSocket as any;\n    92→    MockWebSocket.reset();\n    93→  });\n    94→\n    95→  afterEach(() => {\n    96→    global.WebSocket = OriginalWebSocket;\n    97→    MockWebSocket.reset();\n    98→  });\n    99→\n   100→  const wrapper = ({ children }: { children: React.ReactNode }) => (\n   101→    <UseAIProvider serverUrl=\"ws://localhost:8080\">{children}</UseAIProvider>\n   102→  );\n   103→\n   104→  describe('A component can define tools for an AI to invoke', () => {\n   105→    it('should allow tools to be defined and registered in the provider', async () => {\n   106→      let todoList: string[] = [];\n   107→\n   108→      const addTodo = defineTool(\n   109→        'Add a new todo item',\n   110→        z.object({ text: z.string() }),\n   111→        (input) => {\n   112→          todoList.push(input.text);\n   113→          return { success: true, id: '123', text: input.text, totalTodos: todoList.length };\n   114→        }\n   115→      );\n   116→\n   117→      const TestComponent = () => {\n   118→        const tools = useStableTools({ addTodo });\n   119→        useAI({ tools });\n   120→        return null;\n   121→      };\n   122→\n   123→      render(\n   124→        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n   125→          <TestComponent />\n   126→        </UseAIProvider>\n   127→      );\n   128→\n   129→      await waitFor(() => {\n   130→        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   131→      });\n   132→\n   133→      // Invoke the tool and verify it actually modifies state\n   134→      await act(async () => {\n   135→        const ws = MockWebSocket.getMostRecent();\n   136→        ws?.simulateToolCall('call-1', 'addTodo', { text: 'Buy groceries' });\n   137→      });\n   138→\n   139→      // Wait for tool result to be sent\n   140→      await waitFor(() => {\n   141→        const ws = MockWebSocket.getMostRecent();\n   142→        const toolResult = ws?.sentMessages.find(msg => msg.type === 'tool_result');\n   143→        expect(toolResult).toBeDefined();\n   144→      });\n   145→\n   146→      // Verify the state was actually updated\n   147→      expect(todoList).toEqual(['Buy groceries']);\n   148→\n   149→      // Verify the tool result contains the correct data\n   150→      const ws = MockWebSocket.getMostRecent();\n   151→      const toolResult = ws?.sentMessages.find(msg => msg.type === 'tool_result');\n   152→      const resultData = JSON.parse(toolResult.data.content);\n   153→      expect(resultData.success).toBe(true);\n   154→      expect(resultData.text).toBe('Buy groceries');\n   155→      expect(resultData.totalTodos).toBe(1);\n   156→    });\n   157→\n   158→    it('should allow the AI to invoke registered tools', async () => {\n   159→      const TestComponent = () => {\n   160→        const [lastTodo, setLastTodo] = React.useState<string>('');\n   161→\n   162→        const tools = React.useMemo(() => ({\n   163→          addTodo: defineTool(\n   164→            'Add a todo',\n   165→            z.object({ text: z.string() }),\n   166→            (input) => {\n   167→              setLastTodo(input.text);\n   168→              return { success: true, text: input.text };\n   169→            }\n   170→          )\n   171→        }), []);\n   172→\n   173→        useAI({ tools });\n   174→        return <div data-testid=\"last-todo\">{lastTodo}</div>;\n   175→      };\n   176→\n   177→      const { getByTestId } = render(\n   178→        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n   179→          <TestComponent />\n   180→        </UseAIProvider>\n   181→      );\n   182→\n   183→      await waitFor(() => {\n   184→        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   185→      });\n   186→\n   187→      await act(async () => {\n   188→        const ws = MockWebSocket.getMostRecent();\n   189→        ws?.simulateToolCall('call-123', 'addTodo', { text: 'Buy groceries' });\n   190→      });\n   191→\n   192→      // Verify the component state was updated\n   193→      await waitFor(() => {\n   194→        expect(getByTestId('last-todo').textContent).toBe('Buy groceries');\n   195→      });\n   196→\n   197→      // Verify the tool result was sent back to the server\n   198→      await waitFor(() => {\n   199→        const ws = MockWebSocket.getMostRecent();\n   200→        const toolResult = ws?.sentMessages.find(msg => msg.type === 'tool_result');\n   201→        expect(toolResult).toBeDefined();\n   202→        expect(toolResult.data.toolCallId).toBe('call-123');\n   203→\n   204→        const resultData = JSON.parse(toolResult.data.content);\n   205→        expect(resultData.success).toBe(true);\n   206→        expect(resultData.text).toBe('Buy groceries');\n   207→      });\n   208→    });\n   209→  });\n   210→\n   211→  describe('A component can put its state in \"prompt\" to provide current state to the AI', () => {\n   212→    it('should allow prompt to be provided (state is sent with RunAgentInput)', async () => {\n   213→      const TestComponent = () => {\n   214→        const [todos, setTodos] = React.useState<string[]>(['Buy milk', 'Walk dog']);\n   215→\n   216→        const toolsWithState = React.useMemo(() => ({\n   217→          addTodo: defineTool(\n   218→            'Add a todo',\n   219→            z.object({ text: z.string() }),\n   220→            (input) => {\n   221→              setTodos(prev => [...prev, input.text]);\n   222→              return { success: true, added: input.text };\n   223→            }\n   224→          )\n   225→        }), []);\n   226→\n   227→        const currentState = `Current todos: ${todos.join(', ')}`;\n   228→        useAI({ tools: toolsWithState, prompt: currentState });\n   229→        return <div data-testid=\"todo-count\">{todos.length}</div>;\n   230→      };\n   231→\n   232→      const { getByTestId } = render(\n   233→        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n   234→          <TestComponent />\n   235→        </UseAIProvider>\n   236→      );\n   237→\n   238→      await waitFor(() => {\n   239→        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n   240→      });\n   241→\n   242→      // Initial state should be 2 todos\n   243→      expect(getByTestId('todo-count').textContent).toBe('2');\n   244→\n   245→      // Invoke the tool\n   246→      await act(async () => {\n   247→        const ws = MockWebSocket.getMostRecent();\n   248→        ws?.simulateToolCall('call-1', 'addTodo', { text: 'Take out trash' });\n   249→      });\n   250→\n   251→      // Wait for too