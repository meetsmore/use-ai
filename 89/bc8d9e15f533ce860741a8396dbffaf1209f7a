 of the AI chat interface.\n    90→ */\n    91→export interface ChatPanelProps {\n    92→  /** Whether the chat panel is open */\n    93→  isOpen: boolean;\n    94→  /** Callback when the panel should close */\n    95→  onClose: () => void;\n    96→  /** Callback when a message is sent */\n    97→  onSendMessage: (message: string) => void;\n    98→  /** Array of messages in the conversation */\n    99→  messages: Message[];\n   100→  /** Whether the AI is currently processing */\n   101→  loading: boolean;\n   102→  /** Whether the client is connected to the server */\n   103→  connected: boolean;\n   104→  /** Optional array of suggestion strings to display when chat is empty */\n   105→  suggestions?: string[];\n   106→}\n   107→\n   108→export interface UseAIProviderProps extends UseAIConfig {\n   109→  children: ReactNode;\n   110→  systemPrompt?: string;\n   111→  CustomButton?: React.ComponentType<FloatingButtonProps>;\n   112→  CustomChat?: React.ComponentType<ChatPanelProps>;\n   113→  /**\n   114→   * Custom chat repository for message persistence.\n   115→   * Defaults to LocalStorageChatRepository if not provided.\n   116→   */\n   117→  chatRepository?: ChatRepository;\n   118→}\n   119→\n   120→/**\n   121→ * Custom hook for managing chat storage operations.\n   122→ * Encapsulates all chat repository interactions for better separation of concerns.\n   123→ */\n   124→function useChatStorage(repository: ChatRepository) {\n   125→  const saveUserMessage = useCallback(async (\n   126→    chatId: string,\n   127→    message: string\n   128→  ): Promise<boolean> => {\n   129→    try {\n   130→      const chat = await repository.loadChat(chatId);\n   131→\n   132→      if (!chat) {\n   133→        console.error('[ChatStorage] Chat not found:', chatId);\n   134→        return false;\n   135→      }\n   136→\n   137→      chat.messages.push({\n   138→        id: generateMessageId(),\n   139→        role: 'user',\n   140→        content: message,\n   141→        createdAt: new Date(),\n   142→      });\n   143→\n   144→      // Auto-generate title using extracted helper\n   145→      if (!chat.title) {\n   146→        chat.title = generateChatTitle(message);\n   147→      }\n   148→\n   149→      await repository.saveChat(chat);\n   150→      console.log('[ChatStorage] Saved user message to storage');\n   151→      return true;\n   152→    } catch (error) {\n   153→      console.error('[ChatStorage] Failed to save user message:', error);\n   154→      return false;\n   155→    }\n   156→  }, [repository]);\n   157→\n   158→  const saveAIResponse = useCallback(async (\n   159→    chatId: string,\n   160→    content: string\n   161→  ): Promise<boolean> => {\n   162→    try {\n   163→      const chat = await repository.loadChat(chatId);\n   164→\n   165→      if (!chat) {\n   166→        console.error('[ChatStorage] Chat not found:', chatId);\n   167→        return false;\n   168→      }\n   169→\n   170→      chat.messages.push({\n   171→        id: generateMessageId(),\n   172→        role: 'assistant',\n   173→        content,\n   174→        createdAt: new Date(),\n   175→      });\n   176→\n   177→      // Auto-generate title from first user message if not set\n   178→      if (!chat.title) {\n   179→        const firstUserMessage = chat.messages.find(msg => msg.role === 'user');\n   180→        if (firstUserMessage) {\n   181→          chat.title = generateChatTitle(firstUserMessage.content);\n   182→        }\n   183→      }\n   184→\n   185→      await repository.saveChat(chat);\n   186→      console.log('[ChatStorage] Saved AI response to storage for chatId:', chatId);\n   187→      return true;\n   188→    } catch (error) {\n   189→      console.error('[ChatStorage] Failed to save AI response:', error);\n   190→      return false;\n   191→    }\n   192→  }, [repository]);\n   193→\n   194→  const loadChatMessages = useCallback(async (chatId: string): Promise<Message[]> => {\n   195→    try {\n   196→      const chat = await repository.loadChat(chatId);\n   197→\n   198→      if (chat) {\n   199→        const loadedMessages = transformMessagesToUI(chat.messages);\n   200→        console.log('[ChatStorage] Loaded', loadedMessages.length, 'messages from storage for chat:', chatId);\n   201→        return loadedMessages;\n   202→      } else {\n   203→        console.log('[ChatStorage] Chat not found in storage:', chatId);\n   204→        return [];\n   205→      }\n   206→    } catch (error) {\n   207→      console.error('[ChatStorage] Failed to load chat messages:', error);\n   208→      return [];\n   209→    }\n   210→  }, [repository]);\n   211→\n   212→  return {\n   213→    saveUserMessage,\n   214→    saveAIResponse,\n   215→    loadChatMessages,\n   216→  };\n   217→}\n   218→\n   219→/**\n   220→ * Provider component that manages AI client connection and tool registration.\n   221→ * Must wrap all components that use the useAI hook.\n   222→ *\n   223→ * Features:\n   224→ * - Establishes and maintains WebSocket connection to UseAI server\n   225→ * - Aggregates tools from all child useAI hooks\n   226→ * - Handles tool execution requests from the AI\n   227→ * - Provides floating button and chat panel UI\n   228→ *\n   229→ * @param props - Provider configuration and children\n   230→ *\n   231→ * @example\n   232→ * ```typescript\n   233→ * import { UseAIProvider } from '@use-ai/client';\n   234→ *\n   235→ * function App() {\n   236→ *   return (\n   237→ *     <UseAIProvider\n   238→ *       serverUrl=\"ws://localhost:8080\"\n   239→ *       systemPrompt=\"You are a helpful assistant for managing todos\"\n   240→ *     >\n   241→ *       <YourApp />\n   242→ *     </UseAIProvider>\n   243→ *   );\n   244→ * }\n   245→ * ```\n   246→ */\n   247→export function UseAIProvider({\n   248→  serverUrl,\n   249→  children,\n   250→  systemPrompt,\n   251→  CustomButton,\n   252→  CustomChat,\n   253→  chatRepository,\n   254→}: UseAIProviderProps) {\n   255→  const [connected, setConnected] = useState(false);\n   256→  const [isChatOpen, setIsChatOpen] = useState(false);\n   257→  const [messages, setMessages] = useState<Message[]>([]);\n   258→  const [loading, setLoading] = useState(false);\n   259→\n   260→  /**\n   261→   * Current active chat where AI responses are saved.\n   262→   * This is the \"source of truth\" for where new AI messages get persisted.\n   263→   */\n   264→  const [currentChatId, setCurrentChatId] = useState<string | null>(null);\n   265→\n   266→  /**\n   267→   * Chat loaded for viewing but not yet active for AI responses.\n   268→   * Becomes currentChatId when user sends their first message.\n   269→   * This prevents race conditions when AI is still responding to the previous chat.\n   270→   */\n   271→  const [pendingChatId, setPendingChatId] = useState<string | null>(null);\n   272→\n   273→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n   274→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n   275→  const promptsRef = useRef<Map<string, string>>(new Map());\n   276→  const suggestionsRef = useRef<Map<string, string[]>>(new Map());\n   277→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n   278→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n   279→\n   280→  /**\n   281→   * Snapshot refs to capture latest chat IDs in event handler closures.\n   282→   * Event handlers are created once during mount and don't see updated state values.\n   283→   * These refs are kept in sync with state via useEffect to provide access to current values.\n   284→   */\n   285→  const currentChatIdSnapshot = useRef<string | null>(null);\n   286→  const pendingChatIdSnapshot = useRef<string | null>(null);\n   287→\n   288→  const clientRef = useRef<UseAIClient | null>(null);\n   289→  const repositoryRef = useRef<ChatRepository>(\n   290→    chatRepository || new LocalStorageChatRepository()\n   291→  );\n   292→\n   293→  // Initialize chat storage hook\n   294→  const chatStorage = useChatStorage(repositoryRef.current);\n   295→\n   296→  // Helper function to load messages from storage for display\n   297→  const loadMessagesFromStorage = useCallback(async (chatId: string) => {\n   298→    const loadedMessages = await chatStorage.loadChatMessages(chatId);\n   299→    setMessages(loadedMessages);\n   300→  }, [chatStorage]);\n   301→\n   302→  const registerTools = useCallback((\n   303→    id: string,\n   304→    tools: ToolsDefinition,\n   305→    waitForRender?: () => Promise<void>\n   306→  ) => {\n   307→    const existingTools = toolRegistryRef.current.get(id);\n   308→\n   309→    // Always update the ref to capture latest closures\n   310→    toolRegistryRef.current.set(id, tools);\n   311→\n   312→    // Only increment version if tool names changed (added/removed tools)\n   313→    if (existingTools) {\n   314→      const existingKeys = Object.keys(existingTools).sort().join(',');\n   315→      const newKeys = Object.keys(tools).sort().join(',');\n   316→      if (existingKeys !== newKeys) {\n   317→        setToolRegistryVersion(v => v + 1);\n   318→      }\n   319→    } else {\n   320→      // First registration\n   321→      setToolRegistryVersion(v => v + 1);\n   322→    }\n   323→\n   324→    Object.keys(tools).forEach(toolName => {\n   325→      toolOwnershipRef.current.set(toolName, id);\n   326→    });\n   327→\n   328→    if (waitForRender) {\n   329→      renderWaitersRef.current.set(id, waitForRender);\n   330→    }\n   331→  }, []);\n   332→\n   333→  const updatePrompt = useCallback((id: string, prompt?: string, suggestions?: string[]) => {\n   334→    if (prompt) {\n   335→      promptsRef.current.set(id, prompt);\n   336→    } else {\n   337→      promptsRef.current.delete(id);\n   338→    }\n   339→\n   340→    if (suggestions && suggestions.length > 0) {\n   341→      suggestionsRef.current.set(id, suggestions);\n   342→    } else {\n   343→      suggestionsRef.current.delete(id);\n   344→    }\n   345→  }, []);\n   346→\n   347→  const unregisterTools = useCallback((id: string) => {\n   348→    const tools = toolRegistryRef.current.get(id);\n   349→    if (tools) {\n   350→      Object.keys(tools).forEach(toolName => {\n   351→        toolOwnershipRef.current.delete(toolName);\n   352→      });\n   353→    }\n   354→\n   355→    toolRegistryRef.current.delete(id);\n   356→    setToolRegistryVersion(v => v + 1);\n   357→    promptsRef.current.delete(id);\n   358→    suggestionsRef.current.delete(id);\n   359→    renderWaitersRef.current.delete(id);\n   360→  }, []);\n   361→\n   362→  const aggregatedTools = React.useMemo(() => {\n   363→    const tools: ToolsDefinition = {};\n   364→    toolRegistryRef.current.forEach((toolSet) => {\n   365→      Object.assign(tools, toolSet);\n   366→    });\n   367→    return tools;\n   368→  }, [toolRegistryVersion]);\n   369→\n   370→  const aggregatedSuggestions = React.useMemo(() => {\n   371→    const allSuggestions: string[] = [];\n   372→    suggestionsRef.current.forEach((suggestions) => {\n   373→      allSuggestions.push(...suggestions);\n   374→    });\n   375→    return allSuggestions;\n   376→  }, [toolRegistryVersion]);\n   377→\n   378→  const hasTools = toolRegistryRef.current.size > 0;\n   379→  const aggregatedToolsRef = useRef(aggregatedTools);\n   380→  aggregatedToolsRef.current = aggregatedTools;\n   381→\n   382→  // Keep snapshot refs in sync with latest chat IDs\n   383→  useEffect(() => {\n   384→    currentChatIdSnapshot.current = currentChatId;\n   385→  }, [currentChatId]);\n   386→\n   387→  useEffect(() => {\n   388→    pendingChatIdSnapshot.current = pendingChatId;\n   389→  }, [pendingChatId]);\n   390→\n   391→  /**\n   392→   * Handles saving AI response to storage and updating UI.\n   393→   * Extracted from TEXT_MESSAGE_END event handler for better error handling and readability.\n   394→   */\n   395→  const handleAIResponse = useCallback(async (content: string) => {\n   396→    const currentChatIdValue = currentChatIdSnapshot.current;\n   397→    const pendingChatIdValue = pendingChatIdSnapshot.current;\n   398→    const displayedChatId = pendingChatIdValue || currentChatIdValue;\n   399→\n   400→    if (!currentChatIdValue) {\n   401→      console.warn('[Provider] No current chat ID, cannot save AI response');\n   402→      return;\n   403→    }\n   404→\n   405→    // Save AI response to storage\n   406→    const saved = await chatStorage.saveAIResponse(currentChatIdValue, content);\n   407→\n   408→    // Reload UI if save was successful and user is viewing this chat\n   409→    if (saved && displayedChatId === currentChatIdValue) {\n   410→      await loadMessagesFromStorage(currentChatIdValue);\n   411→    }\n   412→  }, [chatStorage, loadMessagesFromStorage]);\n   413→\n   414→  useEffect(() => {\n   415→    const client = new UseAIClient(serverUrl);\n   416→\n   417→    client.connect()\n   418→      .then(() => {\n   419→        setConnected(true);\n   420→      })\n   421→      .catch((err) => {\n   422→        console.error('Failed to connect client:', err);\n   423→        setConnected(false);\n   424→      });\n   425→\n   426→    const unsubscribe = client.onEvent('globalChat', async (event: AGUIEvent) => {\n   427→      if (event.type === EventType.TOOL_CALL_END) {\n   428→        const toolCallEnd = event as ToolCallEndEvent;\n   429→        const toolCallId = toolCallEnd.toolCallId;\n   430→\n   431→        // Get the accumulated tool call data\n   432→        const toolCallData = client['currentToolCalls'].get(toolCallId);\n   433→        if (!toolCallData) {\n   434→          console.error(`[Provider] Tool call ${toolCallId} not found`);\n   435→          return;\n   436→        }\n   437→\n   438→        const name = toolCallData.name;\n   439→        const input = JSON.parse(toolCallData.args);\n   440→\n   441→        try {\n   442→          const ownerId = toolOwnershipRef.current.get(name);\n   443→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   444→\n   445→          let renderPromise: Promise<void> | undefined;\n   446→          if (ownerId) {\n   447→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   448→            if (waitForRender) {\n   449→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   450→              renderPromise = waitForRender();\n   451→            }\n   452→          }\n   453→\n   454→          console.log('[useAI] Executing tool...');\n   455→          const result = await executeDefinedTool(aggregatedToolsRef.current, name, input);\n   456→\n   457→          // Check if result indicates an error - if so, skip render wait\n   458→          // Error results typically don't trigger state changes/re-renders\n   459→          const isErrorResult = result && typeof result === 'object' &&\n   460→            ('error' in result || (result as any).success === false);\n   461→\n   462→          if (renderPromise && !isErrorResult) {\n   463→            console.log('[useAI] Tool executed successfully, waiting for render...');\n   464→            await renderPromise;\n   465→            console.log('[useAI] Render complete');\n   466→          } else if (isErrorResult) {\n   467→            console.log('[useAI] Tool returned error, skipping render wait');\n   468→          } else {\n   469→            console.log('[useAI] No render to wait for');\n   470→          }\n   471→\n   472→          // Build updated state\n   473→          let updatedState: unknown = null;\n   474→          if (ownerId) {\n   475→            const prompt = promptsRef.current.get(ownerId);\n   476→            if (prompt) {\n   477→              updatedState = { context: prompt };\n   478→              console.log(`[useAI] Updated state from ${ownerId}`);\n   479→            }\n   480→          }\n   481→\n   482→          client.sendToolResponse(toolCallId, result, updatedState);\n   483→        } catch (err) {\n   484→          console.error('Tool execution error:', err);\n   485→          client.sendToolResponse(toolCallId, {\n   486→            error: err instanceof Error ? err.message : 'Unknown error',\n   487→          });\n   488→        }\n   489→      } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   490→        const content = client.currentMessageContent;\n   491→        if (content) {\n   492→          console.log('[Provider] Received text message:', content.substring(0, 100));\n   493→          handleAIResponse(content); // Fire-and-forget is intentional here\n   494→          setLoading(false);\n   495→        }\n   496→      } else if (event.type === EventType.RUN_ERROR) {\n   497→        const errorEvent = event as RunErrorEvent;\n   498→        console.error('[Provider] Run error:', errorEvent.message);\n   499→        setLoading(false);\n   500→      }\n   501→    });\n   502→\n   503→    clientRef.current = client;\n   504→\n   505→    return () => {\n   506→      unsubscribe();\n   507→      client.disconnect();\n   508→      setConnected(false);\n   509→    };\n   510→  }, [serverUrl]);\n   511→\n   512→  const lastRegisteredToolsRef = useRef<string>('');\n   513→\n   514→  useEffect(() => {\n   515→    const client = clientRef.current;\n   516→    if (!client || !client.isConnected() || !hasTools) return;\n   517→\n   518→    const toolKeys = Object.keys(aggregatedTools).sort().join(',');\n   519→    if (toolKeys === lastRegisteredToolsRef.current) {\n   520→      console.log('[Provider] Skipping re-registration, tools unchanged');\n   521→      return;\n   522→    }\n   523→\n   524→    lastRegisteredToolsRef.current = toolKeys;\n   525→    console.log('[Provider] Registering tools:', toolKeys);\n   526→\n   527→    (async () => {\n   528→      try {\n   529→        const toolDefinitions = convertToolsToDefinitions(aggregatedTools);\n   530→        console.log(`[Provider] Converted ${toolDefinitions.length} tool definitions`);\n   531→\n   532→        const promptParts: string[] = [];\n   533→\n   534→        if (systemPrompt) {\n   535→          promptParts.push(systemPrompt);\n   536→        }\n   537→\n   538→        for (const [id, prompt] of promptsRef.current.entries()) {\n   539→          if (prompt) {\n   540→            promptParts.push(prompt);\n   541→          }\n   542→        }\n   543→\n   544→        // Build state object from prompts\n   545→        const state = promptParts.length > 0 ? { context: promptParts.join('\\n\\n---\\n\\n') } : null;\n   546→        console.log(`[Provider] Registering ${toolDefinitions.length} tools with state`);\n   547→        client.registerTools(toolDefinitions, state);\n   548→      } catch (err) {\n   549→        console.error('Failed to register tools:', err);\n   550→      }\n   551→    })();\n   552→  }, [hasTools, aggregatedTools, systemPrompt, connected]);\n   553→\n   554→  // Chat management functions\n   555→  const createNewChat = useCallback(async (): Promise<string> => {\n   556→    console.log('[Provider] createNewChat called - currentChatId:', currentChatId, 'pendingChatId:', pendingChatId, 'messages.length:', messages.length);\n   557→\n   558→    // If we already have a pending blank chat, don't create another one\n   559→    if (pendingChatId && messages.length === 0) {\n   560→      console.log('[Provider] Pending chat is already blank, not creating new chat');\n   561→      return pendingChatId;\n   562→    }\n   563→\n   564→    // If current chat is already blank (and no pending chat), don't create a new one\n   565→    if (currentChatId && !pendingChatId && messages.length === 0) {\n   566→      console.log('[Provider] Current chat is already blank, not creating new chat');\n   567→      return currentChatId;\n   568→    }\n   569→\n   570→    console.log('[Provider] Creating new chat...');\n   571→    const repository = repositoryRef.current;\n   572→    const chatId = await