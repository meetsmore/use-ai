h tool definitions\n    55→ * - Emits AG-UI events (TEXT_MESSAGE_*, TOOL_CALL_*, etc.)\n    56→ * - Routes tool execution requests back to clients\n    57→ * - Maintains conversation history and state per session\n    58→ * - Handles rate limiting\n    59→ *\n    60→ * @example\n    61→ * ```typescript\n    62→ * import { UseAIServer } from '@use-ai/server';\n    63→ *\n    64→ * const server = new UseAIServer({\n    65→ *   port: 8080,\n    66→ *   anthropicApiKey: process.env.ANTHROPIC_API_KEY,\n    67→ *   model: 'claude-sonnet-4-20250514'\n    68→ * });\n    69→ * ```\n    70→ */\n    71→export class UseAIServer {\n    72→  private io: SocketIOServer;\n    73→  private httpServer: ReturnType<typeof createServer>;\n    74→  private anthropic: ReturnType<typeof createAnthropic>;\n    75→  private clients: Map<string, ClientSession> = new Map();\n    76→  private config: Required<UseAIServerConfig>;\n    77→  private rateLimiter: RateLimiter;\n    78→  private cleanupInterval: NodeJS.Timeout;\n    79→  private clientIdCounter = 0;\n    80→  private langfuse: LangfuseConfig;\n    81→\n    82→  /**\n    83→   * Creates a new UseAI server instance.\n    84→   *\n    85→   * @param config - Server configuration options\n    86→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    87→   */\n    88→  constructor(config: UseAIServerConfig = {}) {\n    89→    this.config = {\n    90→      port: config.port ?? 8080,\n    91→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    92→      model: config.model ?? 'claude-sonnet-4-20250514',\n    93→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    94→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    95→    };\n    96→\n    97→    if (!this.config.anthropicApiKey) {\n    98→      throw new Error('Anthropic API key is required');\n    99→    }\n   100→\n   101→    this.anthropic = createAnthropic({\n   102→      apiKey: this.config.anthropicApiKey,\n   103→    });\n   104→\n   105→    // Initialize Langfuse observability (optional)\n   106→    this.langfuse = initializeLangfuse();\n   107→\n   108→    this.rateLimiter = new RateLimiter({\n   109→      maxRequests: this.config.rateLimitMaxRequests,\n   110→      windowMs: this.config.rateLimitWindowMs,\n   111→    });\n   112→\n   113→    this.cleanupInterval = setInterval(() => {\n   114→      this.rateLimiter.cleanup();\n   115→    }, this.config.rateLimitWindowMs);\n   116→\n   117→    // Create HTTP server for health checks\n   118→    this.httpServer = createServer((req, res) => {\n   119→      if (req.url === '/health') {\n   120→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   121→        res.end(JSON.stringify({ status: 'ok' }));\n   122→      } else {\n   123→        res.writeHead(404);\n   124→        res.end();\n   125→      }\n   126→    });\n   127→\n   128→    // Attach Socket.IO server to HTTP server\n   129→    this.io = new SocketIOServer(this.httpServer, {\n   130→      cors: {\n   131→        origin: '*',\n   132→        methods: ['GET', 'POST']\n   133→      }\n   134→    });\n   135→    this.httpServer.listen(this.config.port);\n   136→    this.setupSocketIOServer();\n   137→\n   138→    if (this.rateLimiter.isEnabled()) {\n   139→      logger.info('Rate limiting enabled', {\n   140→        maxRequests: this.config.rateLimitMaxRequests,\n   141→        windowMs: this.config.rateLimitWindowMs,\n   142→      });\n   143→    }\n   144→  }\n   145→\n   146→  private setupSocketIOServer() {\n   147→    this.io.on('connection', (socket: Socket) => {\n   148→      const clientId = `client-${++this.clientIdCounter}`;\n   149→      const threadId = uuidv4();\n   150→      const ipAddress = socket.handshake.address || socket.id;\n   151→      logger.info('Client connected', { clientId, threadId, ipAddress });\n   152→\n   153→      const session: ClientSession = {\n   154→        clientId,\n   155→        ipAddress,\n   156→        socket,\n   157→        threadId,\n   158→        tools: [],\n   159→        state: null,\n   160→        messages: [],\n   161→        conversationHistory: [],\n   162→        pendingToolCalls: new Map(),\n   163→      };\n   164→\n   165→      this.clients.set(socket.id, session);\n   166→\n   167→      socket.on('message', async (message: ClientMessage) => {\n   168→        try {\n   169→          await this.handleClientMessage(socket, message);\n   170→        } catch (error) {\n   171→          logger.error('Error handling message', {\n   172→            error: error instanceof Error ? error.message : 'Unknown error',\n   173→            clientId,\n   174→          });\n   175→          this.sendEvent(socket, {\n   176→            type: EventType.RUN_ERROR,\n   177→            message: error instanceof Error ? error.message : 'Unknown error',\n   178→            timestamp: Date.now(),\n   179→          });\n   180→        }\n   181→      });\n   182→\n   183→      socket.on('disconnect', () => {\n   184→        logger.info('Client disconnected', { clientId, ipAddress });\n   185→        // Note: Rate limiting persists by IP address across connections\n   186→        this.clients.delete(socket.id);\n   187→      });\n   188→    });\n   189→\n   190→    logger.info('UseAI server listening', { port: this.config.port });\n   191→  }\n   192→\n   193→  private async handleClientMessage(socket: Socket, message: ClientMessage) {\n   194→    const session = this.clients.get(socket.id);\n   195→    if (!session) return;\n   196→\n   197→    switch (message.type) {\n   198→      case 'run_agent':\n   199→        await this.handleRunAgent(session, message as RunAgentMessage);\n   200→        break;\n   201→      case 'tool_result':\n   202→        this.handleToolResult(session, message as ToolResultMessage);\n   203→        break;\n   204→      case 'abort_run':\n   205→        this.handleAbortRun(session, message as AbortRunMessage);\n   206→        break;\n   207→    }\n   208→  }\n   209→\n   210→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   211→    const { threadId, runId, messages, tools, state, context } = message.data;\n   212→\n   213→    // Rate limiting by IP address\n   214→    const rateLimitCheck = this.rateLimiter.checkLimit(session.ipAddress);\n   215→    if (!rateLimitCheck.allowed) {\n   216→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   217→      this.sendEvent(session.socket, {\n   218→        type: EventType.RUN_ERROR,\n   219→        message: `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`,\n   220→        timestamp: Date.now(),\n   221→      });\n   222→      return;\n   223→    }\n   224→\n   225→    // Update session\n   226→    session.threadId = threadId;\n   227→    session.currentRunId = runId;\n   228→    session.tools = tools.map(t => ({\n   229→      ...t,\n   230→      parameters: t.parameters || { type: 'object', properties: {}, required: [] },\n   231→    })) as ToolDefinition[];\n   232→    session.state = state;\n   233→    session.messages = messages;\n   234→\n   235→    // Emit RUN_STARTED event\n   236→    this.sendEvent<RunStartedEvent>(session.socket, {\n   237→      type: EventType.RUN_STARTED,\n   238→      threadId,\n   239→      runId,\n   240→      input: message.data,\n   241→      timestamp: Date.now(),\n   242→    });\n   243→\n   244→    // Emit MESSAGES_SNAPSHOT event\n   245→    this.sendEvent<MessagesSnapshotEvent>(session.socket, {\n   246→      type: EventType.MESSAGES_SNAPSHOT,\n   247→      messages,\n   248→      timestamp: Date.now(),\n   249→    });\n   250→\n   251→    // Emit STATE_SNAPSHOT event\n   252→    this.sendEvent<StateSnapshotEvent>(session.socket, {\n   253→      type: EventType.STATE_SNAPSHOT,\n   254→      snapshot: state,\n   255→      timestamp: Date.now(),\n   256→    });\n   257→\n   258→    // Helper to convert content to string if it's an array (AG-UI format)\n   259→    const getStringContent = (content: string | any[] | Record<string, any> | undefined): string => {\n   260→      if (!content) return '';\n   261→      if (typeof content === 'string') return content;\n   262→      // If it's an array, extract text from text blocks\n   263→      if (Array.isArray(content)) {\n   264→        return content\n   265→          .filter((block: any) => block.type === 'text')\n   266→          .map((block: any) => block.text)\n   267→          .join('');\n   268→      }\n   269→      // If it's an object (Record), convert to JSON string\n   270→      if (typeof content === 'object') {\n   271→        return JSON.stringify(content);\n   272→      }\n   273→      return '';\n   274→    };\n   275→\n   276→    // Convert AG-UI messages to AI SDK CoreMessage format\n   277→    const incomingMessages: CoreMessage[] = messages.map(msg => {\n   278→      if (msg.role === 'user') {\n   279→        return {\n   280→          role: 'user' as const,\n   281→          content: getStringContent(msg.content),\n   282→        };\n   283→      } else if (msg.role === 'assistant') {\n   284→        return {\n   285→          role: 'assistant' as const,\n   286→          content: getStringContent(msg.content),\n   287→        };\n   288→      } else if (msg.role === 'tool') {\n   289→        // Tool messages in AI SDK format\n   290→        return {\n   291→          role: 'tool' as const,\n   292→          content: [\n   293→            {\n   294→              type: 'tool-result' as const,\n   295→              toolCallId: (msg as any).tool_call_id || uuidv4(),\n   296→              toolName: (msg as any).tool_name || 'unknown',\n   297→              result: getStringContent(msg.content),\n   298→            },\n   299→          ],\n   300→        } as CoreToolMessage;\n   301→      }\n   302→      // Default fallback\n   303→      return {\n   304→        role: 'user' as const,\n   305→        content: getStringContent(msg.content),\n   306→      };\n   307→    });\n   308→\n   309→    // Conversation history management:\n   310→    // - The client sends ALL messages it knows about (user + assistant messages from past turns)\n   311→    // - The server maintains the authoritative history including tool results\n   312→    // - We only append NEW user messages to avoid duplicates\n   313→    if (session.conversationHistory.length === 0) {\n   314→      // First run: initialize conversation history with incoming messages\n   315→      session.conversationHistory = incomingMessages;\n   316→    } else {\n   317→      // Subsequent runs: only append NEW user messages that aren't already in the history\n   318→      // Count how many user messages we already have\n   319→      const existingUserMessageCount = session.conversationHistory.filter(msg => msg.role === 'user').length;\n   320→      const incomingUserMessages = incomingMessages.filter(msg => msg.role === 'user');\n   321→\n   322→      // Only append user messages beyond what we already have\n   323→      const newUserMessages = incomingUserMessages.slice(existingUserMessageCount);\n   324→\n   325→      // Append only new user messages to preserve the full conversation context\n   326→      session.conversationHistory.push(...newUserMessages);\n   327→    }\n   328→\n   329→    try {\n   330→      const systemPrompt = this.buildSystemPrompt(session, state);\n   331→\n   332→      logger.info('Sending to Claude API', {\n   333→        clientId: session.clientId,\n   334→        messageCount: session.conversationHistory.length,\n   335→        toolCount: session.tools.length,\n   336→      });\n   337→\n   338→      const result = await generateText({\n   339→        model: this.anthropic(this.config.model),\n   340→        messages: session.conversationHistory,\n   341→        system: systemPrompt,\n   342→        tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   343→        maxSteps: 1, // Prevent automatic multi-step execution; we handle it manually\n   344→        maxTokens: 4096,\n   345→        experimental_telemetry: {\n   346→          isEnabled: this.langfuse.enabled,\n   347→          metadata: {\n   348→            sessionId: session.clientId,\n   349→            threadId: session.threadId,\n   350→            runId,\n   351→            ipAddress: session.ipAddress,\n   352→            toolCount: session.tools.length,\n   353→          },\n   354→        },\n   355→      });\n   356→\n   357→      logger.apiRequest({\n   358→        tools: session.tools.map(t => t.name),\n   359→        messageCount: session.conversationHistory.length,\n   360→        messages: session.conversationHistory.map((msg: any) => ({\n   361→          role: msg.role,\n   362→          preview: typeof msg.content === 'string'\n   363→            ? msg.content.substring(0, 80) + (msg.content.length > 80 ? '...' : '')\n   364→            : `${msg.content.length} content blocks`,\n   365→        })),\n   366→        systemPrompt,\n   367→      });\n   368→\n   369→      // Check for empty response (no text, no tool calls) - this is a bug\n   370→      if (!result.text && (!result.toolCalls || result.toolCalls.length === 0)) {\n   371→        // Send error to client\n   372→        this.sendEvent<RunErrorEvent>(session.socket, {\n   373→          type: EventType.RUN_ERROR,\n   374→          message: 'Claude returned an empty response. This may be due to an ambiguous request. Please try being more specific.',\n   375→          timestamp: Date.now(),\n   376→        });\n   377→        return;\n   378→      }\n   379→\n   380→      await this.processResponse(session, result, runId);\n   381→    } catch (error) {\n   382→      logger.error('Error calling Anthropic API', {\n   383→        error: error instanceof Error ? error.message : 'Unknown error',\n   384→        clientId: session.clientId,\n   385→      });\n   386→      this.sendEvent<RunErrorEvent>(session.socket, {\n   387→        type: EventType.RUN_ERROR,\n   388→        message: error instanceof Error ? error.message : 'Unknown error',\n   389→        timestamp: Date.now(),\n   390→      });\n   391→    }\n   392→  }\n   393→\n   394→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Record<string, any> {\n   395→    const toolsObject: Record<string, any> = {};\n   396→\n   397→    for (const toolDef of tools) {\n   398→      toolsObject[toolDef.name] = {\n   399→        description: toolDef.description,\n   400→        parameters: jsonSchema(toolDef.parameters),\n   401→        // No execute function - we handle tool calls manually\n   402→      };\n   403→    }\n   404→\n   405→    return toolsObject;\n   406→  }\n   407→\n   408→  private buildSystemPrompt(session: ClientSession, state: unknown): string | undefined {\n   409→    const parts: string[] = [];\n   410→\n   411→    // Add state context if available\n   412→    if (state) {\n   413→      parts.push('You are interacting with a web application. Here is the current state:');\n   414→      parts.push('');\n   415→      parts.push(JSON.stringify(state, null, 2));\n   416→      parts.push('');\n   417→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   418→    }\n   419→\n   420→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   421→    if (confirmationTools.length > 0) {\n   422→      if (parts.length > 0) {\n   423→        parts.push('');\n   424→      }\n   425→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   426→      parts.push('');\n   427→      confirmationTools.forEach(tool => {\n   428→        parts.push(`- ${tool.name}`);\n   429→      });\n   430→      parts.push('');\n   431→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   432→      parts.push('1. First, explain to the user exactly what changes will be made');\n   433→      parts.push('2. Then, explicitly ask: \"Do you want me to proceed?\" or similar confirmation question');\n   434→      parts.push('3. STOP and WAIT for the user to respond with explicit confirmation');\n   435→      parts.push('4. ONLY after receiving confirmation, call the tool');\n   436→      parts.push('');\n   437→      parts.push('NEVER ASSUME CONFIRMATION:');\n   438→      parts.push('- Do NOT call these tools without receiving explicit confirmation');\n   439→      parts.push('- Each destructive operation requires its own separate confirmation');\n   440→    }\n   441→\n   442→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   443→  }\n   444→\n   445→  private async processResponse(session: ClientSession, result: Awaited<ReturnType<typeof generateText>>, runId: string) {\n   446→    // Build assistant message content\n   447→    const assistantContent: any[] = [];\n   448→\n   449→    // Add text if present\n   450→    if (result.text) {\n   451→      assistantContent.push({ type: 'text', text: result.text });\n   452→    }\n   453→\n   454→    // Add tool calls if present\n   455→    if (result.toolCalls && result.toolCalls.length > 0) {\n   456→      for (const toolCall of result.toolCalls) {\n   457→        assistantContent.push({\n   458→          type: 'tool-call',\n   459→          toolCallId: toolCall.toolCallId,\n   460→          toolName: toolCall.toolName,\n   461→          args: toolCall.args,\n   462→        });\n   463→      }\n   464→    }\n   465→\n   466→    // Add assistant message to conversation history\n   467→    session.conversationHistory.push({\n   468→      role: 'assistant',\n   469→      content: assistantContent,\n   470→    } as any);\n   471→\n   472→    // Emit text message events\n   473→    if (result.text) {\n   474→      const messageId = uuidv4();\n   475→\n   476→      // Emit TEXT_MESSAGE_START\n   477→      this.sendEvent<TextMessageStartEvent>(session.socket, {\n   478→        type: EventType.TEXT_MESSAGE_START,\n   479→        messageId,\n   480→        role: 'assistant',\n   481→        timestamp: Date.now(),\n   482→      });\n   483→\n   484→      // Emit TEXT_MESSAGE_CONTENT\n   485→      this.sendEvent<TextMessageContentEvent>(session.socket, {\n   486→        type: EventType.TEXT_MESSAGE_CONTENT,\n   487→        messageId,\n   488→        delta: result.text,\n   489→        timestamp: Date.now(),\n   490→      });\n   491→\n   492→      // Emit TEXT_MESSAGE_END\n   493→      this.sendEvent<TextMessageEndEvent>(session.socket, {\n   494→        type: EventType.TEXT_MESSAGE_END,\n   495→        messageId,\n   496→        timestamp: Date.now(),\n   497→      });\n   498→\n   499→      logger.aiResponse([result.text]);\n   500→    }\n   501→\n   502→    // Handle tool calls\n   503→    if (result.toolCalls && result.toolCalls.length > 0) {\n   504→      logger.toolCalls(result.toolCalls.map(t => ({ name: t.toolName, input: t.args })));\n   505→      await this.handleMultipleToolUses(session, result.toolCalls, runId);\n   506→    } else {\n   507→      // No tool calls, run is finished\n   508→      this.sendEvent<RunFinishedEvent>(session.socket, {\n   509→        type: EventType.RUN_FINISHED,\n   510→        threadId: session.threadId,\n   511→        runId,\n   512→        result: result.text,\n   513→        timestamp: Date.now(),\n   514→      });\n   515→    }\n   516→  }\n   517→\n   518→  private async handleMultipleToolUses(\n   519→    session: ClientSession,\n   520→    toolCalls: Array<{ toolCallId: string; toolName: string; args: any }>,\n   521→    runId: string\n   522→  ) {\n   523→    const toolResults: ToolResultPart[] = [];\n   524→\n   525→    for (const toolCall of toolCalls) {\n   526→      const toolCallId = toolCall.toolCallId;\n   527→      const parentMessageId = uuidv4();\n   528→\n   529→      // Emit TOOL_CALL_START\n   530→      this.sendEvent<ToolCallStartEvent>(session.socket, {\n   531→        type: EventType.TOOL_CALL_START,\n   532→        toolCallId,\n   533→        toolCallName: toolCall.toolName,\n   534→        parentMessageId,\n   535→        timestamp: Date.now(),\n   536→      });\n   537→\n   538→      // Emit TOOL_CALL_ARGS (stream the arguments)\n   539→      const argsStr = JSON.stringify(toolCall.args);\n   540→      this.sendEvent<ToolCallArgsEvent>(session.socket, {\n   541→        type: EventType.TOOL_CALL_ARGS,\n   542→        toolCallId,\n   543→        delta: argsStr,\n   544→        timestamp: Date.now(),\n   545→      });\n   546→\n   547→      // Emit TOOL_CALL_END\n   548→      this.sendEvent<ToolCallEndEvent>(session.socket, {\n   549→        type: EventType.TOOL_CALL_END,\n   550→        toolCallId,\n   551→        timestamp: Date.now(),\n   552→      });\n   553→\n   554→      // Wait for tool result from client\n   555→      const toolResponsePromise = new Promise<string>((resolve) => {\n   556→        session.pendingToolCalls.set(toolCallId, resolve);\n   557→      });\n   558→\n   559→      const content = await toolResponsePromise;\n   560→\n   561→      logger.toolResult(toolCall.toolName, content);\n   562→\n   563→      toolResults.push({\n   564→        type: 'tool-result',\n   565→        toolCallId,\n   566→        toolName: toolCall.toolName,\n   567→        result: content,\n   568→      });\n   569→    }\n   570→\n   571→    // Add tool results to conversation as a tool message\n   572→    session.conversationHistory.push({\n   573→      role: 'tool',\n   574→      content: toolResults,\n   575→    } as CoreToolMessage);\n   576→\n   577→    // Call Claude again with tool results\n   578→    const systemPrompt = this.buildSystemPrompt(session, session.state);\n   579→\n   580→    const followUpResult = await generateText({\n   581→      model: this.anthropic(this.config.model),\n   582→      messages: session.conversationHistory,\n   583→      system: systemPrompt,\n   584→      tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   585→      maxSteps: 1,\n   586→      maxTokens: 4096,\n   587→      experimental_telemetry: {\n   588→        isEnabled: this.langfuse.enabled,\n   589→        metadata: {\n   590→          sessionId: session.clientId,\n   591→          threadId: session.threadId,\n   592→          runId,\n   593→          toolCount: session.tools.length,\n   594→          isFollowUp: true, // Mark as follow-up after tool execution\n   595→        },\n   596→      },\n   597→    });\n   598→\n   599→    await this.processResponse(session, followUpResult, runId);\n   600→  }\n   601→\n   602→  private handleToolResult(session: ClientSession, message: ToolResultMessage) {\n   603→    const { toolCallId, content } = message.data;\n   604→    const resolver = session.pendingToolCalls.get(toolCallId);\n   605→\n   606→    if (resolver) {\n   607→      resolver(content);\n   608→      session.pendingToolCalls.delete(toolCallId);\n   609→    }\n   610→  }\n   611→\n   612→  private handleAbortRun(session: ClientSession, message: AbortRunMessage) {\n   613→    const { runId } = message.data;\n   614→    // Clear pending tool calls for this run\n   615→    session.pendingToolCalls.clear();\n   616→    session.currentRunId = undefined;\n   617→\n   618→    logger.info('Run aborted', { clientId: session.clientId, runId });\n   619→  }\n   620→\n   621→  private sendEvent<T = unknown>(socket: Socket, event: T) {\n   622→    if (socket.connected) {\n   623→      socket.emit('event', event);\n   624→    }\n   625→  }\n   626→\n   627→  /**\n   628→   * Flushes pending telemetry data to Langfuse.\n   629→   * Useful for tests to ensure data is sent before querying.\n   630→   */\n   631→  public async flushTelemetry(): Promise<void> {\n   632→    if (this.langfuse.flush) {\n   633→      await this.langfuse.flush();\n   634→    }\n   635→  }\n   636→\n   637→  /**\n   638→   * Closes the server and cleans up resources.\n   639→   * Stops accepting new connections and