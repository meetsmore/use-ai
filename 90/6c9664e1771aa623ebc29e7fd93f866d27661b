3→  }\n   394→\n   395→  private async processResponse(session: ClientSession, result: Awaited<ReturnType<typeof generateText>>, runId: string) {\n   396→    // Build assistant message content\n   397→    const assistantContent: any[] = [];\n   398→\n   399→    // Add text if present\n   400→    if (result.text) {\n   401→      assistantContent.push({ type: 'text', text: result.text });\n   402→    }\n   403→\n   404→    // Add tool calls if present\n   405→    if (result.toolCalls && result.toolCalls.length > 0) {\n   406→      for (const toolCall of result.toolCalls) {\n   407→        assistantContent.push({\n   408→          type: 'tool-call',\n   409→          toolCallId: toolCall.toolCallId,\n   410→          toolName: toolCall.toolName,\n   411→          args: toolCall.args,\n   412→        });\n   413→      }\n   414→    }\n   415→\n   416→    // Add assistant message to conversation history\n   417→    session.conversationHistory.push({\n   418→      role: 'assistant',\n   419→      content: assistantContent,\n   420→    } as any);\n   421→\n   422→    // Emit text message events\n   423→    if (result.text) {\n   424→      const messageId = uuidv4();\n   425→\n   426→      // Emit TEXT_MESSAGE_START\n   427→      this.sendEvent<TextMessageStartEvent>(session.socket, {\n   428→        type: EventType.TEXT_MESSAGE_START,\n   429→        messageId,\n   430→        role: 'assistant',\n   431→        timestamp: Date.now(),\n   432→      });\n   433→\n   434→      // Emit TEXT_MESSAGE_CONTENT\n   435→      this.sendEvent<TextMessageContentEvent>(session.socket, {\n   436→        type: EventType.TEXT_MESSAGE_CONTENT,\n   437→        messageId,\n   438→        delta: result.text,\n   439→        timestamp: Date.now(),\n   440→      });\n   441→\n   442→      // Emit TEXT_MESSAGE_END\n   443→      this.sendEvent<TextMessageEndEvent>(session.socket, {\n   444→        type: EventType.TEXT_MESSAGE_END,\n   445→        messageId,\n   446→        timestamp: Date.now(),\n