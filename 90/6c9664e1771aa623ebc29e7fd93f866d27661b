ession, state);\n   308→\n   309→      const result = await generateText({\n   310→        model: this.anthropic(this.config.model),\n   311→        messages: coreMessages,\n   312→        system: systemPrompt,\n   313→        tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   314→        maxSteps: 1, // Prevent automatic multi-step execution; we handle it manually\n   315→        maxTokens: 4096,\n   316→      });\n   317→\n   318→      logger.apiRequest({\n   319→        tools: session.tools.map(t => t.name),\n   320→        messageCount: coreMessages.length,\n   321→        messages: coreMessages.map((msg: any) => ({\n   322→          role: msg.role,\n   323→          preview: typeof msg.content === 'string'\n   324→            ? msg.content.substring(0, 80) + (msg.content.length > 80 ? '...' : '')\n   325→            : `${msg.content.length} content blocks`,\n   326→        })),\n   327→        systemPrompt,\n   328→      });\n   329→\n   330→      await this.processResponse(session, result, runId);\n   331→    } catch (error) {\n   332→      logger.error('Error calling Anthropic API', {\n   333→        error: error instanceof Error ? error.message : 'Unknown error',\n   334→        clientId: session.clientId,\n   335→      });\n   336→      this.sendEvent<RunErrorEvent>(session.socket, {\n   337→        type: EventType.RUN_ERROR,\n   338→        message: error instanceof Error ? error.message : 'Unknown error',\n   339→        timestamp: Date.now(),\n   340→      });\n   341→    }\n   342→  }\n   343→\n   344→  private sanitizeToolsForAPI(tools: ToolDefinition[]): Record<string, any> {\n   345→    const toolsObject: Record<string, any> = {};\n   346→\n   347→    for (const toolDef of tools) {\n   348→      toolsObject[toolDef.name] = {\n   349→        description: toolDef.description,\n   350→        parameters: jsonSchema(toolDef.parameters),\n   351→        // No execute function - we handle tool calls manually\n   352→