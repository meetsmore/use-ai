  };\n   159→\n   160→      this.clients.set(socket.id, session);\n   161→\n   162→      socket.on('message', async (message: ClientMessage) => {\n   163→        try {\n   164→          await this.handleClientMessage(socket, message);\n   165→        } catch (error) {\n   166→          logger.error('Error handling message', {\n   167→            error: error instanceof Error ? error.message : 'Unknown error',\n   168→            clientId,\n   169→          });\n   170→          this.sendEvent(socket, {\n   171→            type: EventType.RUN_ERROR,\n   172→            message: error instanceof Error ? error.message : 'Unknown error',\n   173→            timestamp: Date.now(),\n   174→          });\n   175→        }\n   176→      });\n   177→\n   178→      socket.on('disconnect', () => {\n   179→        logger.info('Client disconnected', { clientId, ipAddress });\n   180→        // Note: Rate limiting persists by IP address across connections\n   181→        this.clients.delete(socket.id);\n   182→      });\n   183→    });\n   184→\n   185→    logger.info('UseAI server listening', { port: this.config.port });\n   186→  }\n   187→\n   188→  private async handleClientMessage(socket: Socket, message: ClientMessage) {\n   189→    const session = this.clients.get(socket.id);\n   190→    if (!session) return;\n   191→\n   192→    switch (message.type) {\n   193→      case 'run_agent':\n   194→        await this.handleRunAgent(session, message as RunAgentMessage);\n   195→        break;\n   196→      case 'tool_result':\n   197→        this.handleToolResult(session, message as ToolResultMessage);\n   198→        break;\n   199→      case 'abort_run':\n   200→        this.handleAbortRun(session, message as AbortRunMessage);\n   201→        break;\n   202→    }\n   203→  }\n   204→\n   205→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   206→    const { threadId, runId, messages, tools, state, context } = message.data;\n   207→\n   208→  