  // Only trace if Langfuse is enabled\n    if (langfuseConfig.enabled) {\n      await startActiveObservation(\n        'agent-run',\n        async (trace) => {\n          trace.update({\n            input: { prompt: data.prompt, tools: Object.keys(data.tools) },\n            sessionId,\n            userId,\n            metadata: {\n              socketId: socket.id,\n              toolCount: Object.keys(data.tools).length,\n            },\n          });\n\n          try {\n            await this.executeAgentRun(socket, data, trace);\n            trace.update({ output: { success: true } });\n          } catch (error) {\n            trace.update({ \n              level: 'ERROR',\n              output: { error: error.message } \n            });\n            throw error;\n          }\n        }\n      );\n    } else {\n      // No tracing, just execute\n      await this.executeAgentRun(socket, data, null);\n    }\n  }\n\n  private async executeAgentRun(\n    socket: Socket,\n    data: RunAgentMessage['data'],\n    parentTrace?: any\n  ) {\n    // Track Claude API call\n    const generation = parentTrace?.startObservation(\n      'claude-api-call',\n      {\n        model: 'claude-sonnet-4-5-20250929',\n        input: this.buildMessages(data),\n      },\n      { asType: 'generation' }\n    );\n\n    const stream = await this.anthropic.messages.create({\n      model: 'claude-sonnet-4-5-20250929',\n      max_tokens: 8000,\n      messages: this.buildMessages(data),\n      tools: this.convertToolsToAnthropicFormat(data.tools),\n      stream: true,\n    });\n\n    let response = '';\n    let usage = { input_tokens: 0, output_tokens: 0 };\n\n    for await (const event of stream) {\n      if (event.type === 'content_block_delta' && event.delta.type === 'text_delta') {\n        response += event.delta.text;\n      }\n      if (event.type === 'message_delta' && event.usage) {\n        usage.input_tokens += event.usage.input_tokens || 0;\n        usage.output_tokens += event.usage.output_tokens || 0;\n      }\n      // Handle tool_use events...\n    }\n\n    // Update generation span with results\n    generation?.update({\n      output: { response },\n      usage: {\n        input: usage.input_tokens,\n        output: usage.output_tokens,\n        total: usage.input_tokens + usage.output_tokens,\n      },\n    }).end();\n  }\n\n  private async executeToolCall(toolCall: ToolUse, trace?: any): Promise<string> {\n    // Track individual tool calls\n    const toolSpan = trace?.startObservation(\n      `tool-${toolCall.name}`,\n      {\n        input: toolCall.input,\n        name: toolCall.name,\n      },\n      { asType: 'tool' }\n    );\n\n    try {\n      const result = await this.waitForToolResult(toolCall.id);\n      \n      toolSpan?.update({\n        output: { result },\n      }).end();\n      \n      return result;\n    } catch (error) {\n      toolSpan?.update({\n        level: 'ERROR',\n        output: { error: error.message },\n      }).end();\n      throw error;\n    }\n  }\n}\n```\n\n### 4. **Package Dependencies**\n\n```json\n// packages/server/package.json\n{\n  \"dependencies\": {\n    \"@anthropic-ai/sdk\": \"^0.33.1\",\n    \"socket.io\": \"^4.8.1\",\n    \"langfuse\": \"^4.0.0\",  // Add if enabled\n    \"@langfuse/otel\": \"^4.0.0\",  // Add if enabled\n    \"@opentelemetry/sdk-node\": \"^0.55.0\",  // Add if enabled\n    \"@langfuse/tracing\": \"^4.0.0\"  // Add if enabled\n  }\n}\n```\n\n### 5. **Optional Installation Script**\n\n```bash\n# Only install Langfuse if env vars are set\nif [ -n \"$LANGFUSE_PUBLIC_KEY\" ]; then\n  bun add langfuse @langfuse/otel @langfuse/tracing @opentelemetry/sdk-node\nfi\n```\n\n## Environment Variables\n\n```bash\n# Optional - only set if you want Langfuse tracing\nexport LANGFUSE_PUBLIC_KEY=pk-lf-...\nexport LANGFUSE_SECRET_KEY=sk-lf-...\nexport LANGFUSE_BASE_URL=https://cloud.langfuse.com  # Optional\n\n# Required\nexport ANTHROPIC_API_KEY=sk-ant-...\n```\n\n## Benefits\n\n1. **Observabil