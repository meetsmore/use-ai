g(), subject: z.string() }),\n   102→ *         async (input) => {\n   103→ *           await sendEmail(input);\n   104→ *           return { success: true };\n   105→ *         }\n   106→ *       )\n   107→ *     },\n   108→ *     invisible: true  // Skip render wait since this has no visual state\n   109→ *   });\n   110→ *\n   111→ *   return <>{children}</>;\n   112→ * }\n   113→ * ```\n   114→ */\n   115→export function useAI(options: UseAIOptions = {}): UseAIResult {\n   116→  const { connected, registerTools, unregisterTools, updatePrompt, client } = useAIContext();\n   117→  const [response, setResponse] = useState<string | null>(null);\n   118→  const [loading, setLoading] = useState(false);\n   119→  const [error, setError] = useState<Error | null>(null);\n   120→\n   121→  const hookId = useRef(`useAI-${Math.random().toString(36).substr(2, 9)}`);\n   122→  const toolsRef = useRef<ToolsDefinition>({});\n   123→  const componentRef = useRef<HTMLDivElement>(null);\n   124→  const renderResolvers = useRef<Array<() => void>>([]);\n   125→\n   126→  useEffect(() => {\n   127→    if (componentRef.current) {\n   128→      componentRef.current.setAttribute('data-useai-context', 'true');\n   129→    }\n   130→  }, []);\n   131→\n   132→  useEffect(() => {\n   133→    const count = renderResolvers.current.length;\n   134→    if (count > 0) {\n   135→      console.log(`[${hookId.current}] Render complete, resolving ${count} promises`);\n   136→      renderResolvers.current.forEach(resolve => resolve());\n   137→      renderResolvers.current = [];\n   138→    }\n   139→  });\n   140→\n   141→  const waitForRender = useCallback(() => {\n   142→    return new Promise<void>(resolve => {\n   143→      console.log(`[${hookId.current}] Adding render promise`);\n   144→      renderResolvers.current.push(resolve);\n   145→    });\n   146→  }, []);\n   147→\n   148→  useEffect(() => {\n   149→    updatePrompt(hookId.current, options.prompt);\n   150→  }, [options.prompt, updat