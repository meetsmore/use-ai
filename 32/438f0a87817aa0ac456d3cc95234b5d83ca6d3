            "content": "import { WebSocketServer, WebSocket } from 'ws';\nimport Anthropic from '@anthropic-ai/sdk';\nimport type {\n  UseAIServerConfig,\n  ToolDefinition,\n  ClientMessage,\n  RegisterToolsMessage,\n  PromptMessage,\n  ToolResponseMessage,\n  ServerMessage,\n} from './types';\n\ninterface ClientSession {\n  ws: WebSocket;\n  tools: ToolDefinition[];\n  conversationHistory: Anthropic.MessageParam[];\n  pendingToolCalls: Map<string, (result: unknown) => void>;\n}\n\nexport class UseAIServer {\n  private wss: WebSocketServer;\n  private anthropic: Anthropic;\n  private clients: Map<WebSocket, ClientSession> = new Map();\n  private config: Required<UseAIServerConfig>;\n\n  constructor(config: UseAIServerConfig = {}) {\n    this.config = {\n      port: config.port ?? 8080,\n      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n      model: config.model ?? 'claude-sonnet-4-20250514',\n    };\n\n    if (!this.config.anthropicApiKey) {\n      throw new Error('Anthropic API key is required');\n    }\n\n    this.anthropic = new Anthropic({\n      apiKey: this.config.anthropicApiKey,\n    });\n\n    this.wss = new WebSocketServer({ port: this.config.port });\n    this.setupWebSocketServer();\n  }\n\n  private setupWebSocketServer() {\n    this.wss.on('connection', (ws: WebSocket) => {\n      console.log('Client connected');\n\n      const session: ClientSession = {\n        ws,\n        tools: [],\n        conversationHistory: [],\n        pendingToolCalls: new Map(),\n      };\n\n      this.clients.set(ws, session);\n\n      ws.on('message', async (data: Buffer) => {\n        try {\n          const message: ClientMessage = JSON.parse(data.toString());\n          await this.handleClientMessage(ws, message);\n        } catch (error) {\n          console.error('Error handling message:', error);\n          this.sendError(ws, error instanceof Error ? error.message : 'Unknown error');\n        }\n      });\n\n      ws.on('close', () => {\n        console.log('Client disconnected');\n        this.clients.delete(ws);\n      });\n    });\n\n    console.log(`UseAI server listening on port ${this.config.port}`);\n  }\n\n  private async handleClientMessage(ws: WebSocket, message: ClientMessage) {\n    const session = this.clients.get(ws);\n    if (!session) return;\n\n    switch (message.type) {\n      case 'register_tools':\n        this.handleRegisterTools(session, message as RegisterToolsMessage);\n        break;\n      case 'prompt':\n        await this.handlePrompt(session, message as PromptMessage);\n        break;\n      case 'tool_response':\n        this.handleToolResponse(session, message as ToolResponseMessage);\n        break;\n    }\n  }\n\n  private handleRegisterTools(session: ClientSession, message: RegisterToolsMessage) {\n    session.tools = message.data.tools;\n    console.log(`Registered ${session.tools.length} tools for client`);\n  }\n\n  private async handlePrompt(session: ClientSession, message: PromptMessage) {\n    const { prompt } = message.data;\n\n    session.conversationHistory.push({\n      role: 'user',\n      content: prompt,\n    });\n\n    try {\n      const response = await this.anthropic.messages.create({\n        model: this.config.model,\n        max_tokens: 4096,\n        messages: session.conversationHistory,\n        tools: session.tools.length > 0 ? session.tools as Anthropic.Tool[] : undefined,\n      });\n\n      await this.processResponse(session, response);\n    } catch (error) {\n      console.error('Error calling Anthropic API:', error);\n      this.sendError(session.ws, error instanceof Error ? error.message : 'Unknown error');\n    }\n  }\n\n  private async processResponse(session: ClientSession, response: Anthropic.Message) {\n    session.conversationHistory.push({\n      role: 'assistant',\n      content: response.content,\n    });\n\n    for (const block of response.content) {\n      if (block.type === 'text') {\n        this.sendMessage(session.ws, {\n          type: 'response',\n          data: {\n            content: block.text,\n            conversationId: response.id,\n          },\n        });\n      } else if (block.type === 'tool_use') {\n        await this.handleToolUse(session, block, response.id);\n      }\n    }\n  }\n\n  private async handleToolUse(\n    session: ClientSession,\n    toolUse: Anthropic.ToolUseBlock,\n    conversationId: string\n  ) {\n    const toolCallId = toolUse.id;\n\n    const toolResponsePromise = new Promise<unknown>((resolve) => {\n      session.pendingToolCalls.set(toolCallId, resolve);\n    });\n\n    this.sendMessage(session.ws, {\n      type: 'tool_call',\n      data: {\n        toolCallId,\n        name: toolUse.name,\n        input: toolUse.input,\n      },\n    });\n\n    const result = await toolResponsePromise;\n\n    session.conversationHistory.push({\n      role: 'user',\n      content: [\n        {\n          type: 'tool_result',\n          tool_use_id: toolCallId,\n          content: JSON.stringify(result),\n        },\n      ],\n    });\n\n    const followUpResponse = await this.anthropic.messages.create({\n      model: this.config.model,\n      max_tokens: 4096,\n      messages: session.conversationHistory,\n      tools: session.tools.length > 0 ? session.tools as Anthropic.Tool[] : undefined,\n    });\n\n    await this.processResponse(session, followUpResponse);\n  }\n\n  private handleToolResponse(session: ClientSession, message: ToolResponseMessage) {\n    const { toolCallId, result } = message.data;\n    const resolver = session.pendingToolCalls.get(toolCallId);\n\n    if (resolver) {\n      resolver(result);\n      session.pendingToolCalls.delete(toolCallId);\n    }\n  }\n\n  private sendMessage(ws: WebSocket, message: ServerMessage) {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify(message));\n    }\n  }\n\n  private sendError(ws: WebSocket, message: string) {\n    this.sendMessage(ws, {\n      type: 'error',\n      data: { message },\n    });\n  }\n\n  public close() {\n    this.wss.close();\n  }\n}\n",
