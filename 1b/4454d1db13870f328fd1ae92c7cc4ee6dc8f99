PO_ROOT\"\n\nif [ \"$DRY_RUN\" = true ]; then\n  echo -e \"${YELLOW}[DRY RUN] Would execute:${NC}\"\n  echo \"$BUILD_CMD\"\nelse\n  echo -e \"${GREEN}Building image...${NC}\"\n  cd \"$REPO_ROOT\"\n  eval \"$BUILD_CMD\"\n  echo -e \"${GREEN}✓ Build complete${NC}\"\n  echo \"\"\nfi\n\nif [ \"$BUILD_ONLY\" = true ]; then\n  echo -e \"${GREEN}Build complete. Skipping tests.${NC}\"\n  exit 0\nfi\n\n# Test the image\nif [ \"$DRY_RUN\" = true ]; then\n  echo -e \"${YELLOW}[DRY RUN] Would run tests${NC}\"\n  exit 0\nfi\n\necho -e \"${GREEN}Testing the image...${NC}\"\necho \"\"\n\n# Check if image exists\nif ! docker image inspect \"$FULL_IMAGE_NAME\" > /dev/null 2>&1; then\n  echo -e \"${RED}Error: Image $FULL_IMAGE_NAME not found${NC}\"\n  exit 1\nfi\n\n# Test 1: Check image size\necho -e \"${GREEN}1. Checking image size...${NC}\"\nSIZE=$(docker image inspect \"$FULL_IMAGE_NAME\" --format='{{.Size}}' | awk '{print int($1/1024/1024)}')\necho \"   Image size: ${SIZE}MB\"\nif [ \"$SIZE\" -gt 500 ]; then\n  echo -e \"${YELLOW}   Warning: Image is larger than 500MB${NC}\"\nfi\necho \"\"\n\n# Test 2: Check that required files exist\necho -e \"${GREEN}2. Verifying image contents...${NC}\"\nREQUIRED_FILES=(\n  \"/app/apps/use-ai-server-app/dist/index.js\"\n  \"/app/packages/server/dist/index.js\"\n  \"/app/packages/core/dist/index.js\"\n  \"/app/packages/plugin-workflows/dist/index.js\"\n)\n\nfor file in \"${REQUIRED_FILES[@]}\"; do\n  if docker run --rm \"$FULL_IMAGE_NAME\" test -f \"$file\"; then\n    echo -e \"   ${GREEN}✓${NC} $file\"\n  else\n    echo -e \"   ${RED}✗${NC} $file (missing)\"\n    exit 1\n  fi\ndone\necho \"\"\n\n# Test 3: Check that it runs (without API key)\necho -e \"${GREEN}3. Testing startup (should fail without API key)...${NC}\"\nif docker run --rm \"$FULL_IMAGE_NAME\" timeout 5 bun run /app/apps/use-ai-server-app/dist/index.js 2>&1 | grep -q \"At least one AI provider API key is required\"; then\n  echo -e \"   ${GREEN}✓${NC} Exits with expected error message\"\nelse\n  echo -e \"   ${RED}✗${NC} Unexpected behavior\"\n  exit 1\nfi\necho \"\"\n\n# Test 4: Check that it runs with API key (if provided)\nif [ -n \"$ANTHROPIC_API_KEY\" ]; then\n  echo -e \"${GREEN}4. Testing with ANTHROPIC_API_KEY...${NC}\"\n\n  # Start container in background\n  CONTAINER_ID=$(docker run -d \\\n    --rm \\\n    -e ANTHROPIC_API_KEY=\"$ANTHROPIC_API_KEY\" \\\n    -p 8081:8081 \\\n    \"$FULL_IMAGE_NAME\")\n\n  echo \"   Started container: $CONTAINER_ID\"\n\n  # Wait for startup\n  echo \"   Waiting for server to start...\"\n  sleep 5\n\n  # Check if container is still running\n  if docker ps | grep -q \"$CONTAINER_ID\"; then\n    echo -e \"   ${GREEN}✓${NC} Container is running\"\n\n    # Check logs for successful startup\n    if docker logs \"$CONTAINER_ID\" 2>&1 | grep -q \"UseAI server is running\"; then\n      echo -e \"   ${GREEN}✓${NC} Server started successfully\"\n    else\n      echo -e \"   ${YELLOW}Warning: Server may not have started correctly${NC}\"\n      echo \"   Logs:\"\n      docker logs \"$CONTAINER_ID\" 2>&1 | head -20\n    fi\n  else\n    echo -e \"   ${RED}✗${NC} Container stopped unexpectedly\"\n    docker logs \"$CONTAINER_ID\" 2>&1\n    exit 1\n  fi\n\n  # Clean up\n  echo \"   Stopping container...\"\n  docker stop \"$CONTAINER_ID\" > /dev/null\n  echo -e \"   ${GREEN}✓${NC} Container stopped\"\nelse\n  echo -e \"${YELLOW}4. Skipping runtime test (ANTHROPIC_API_KEY not set)${NC}\"\n  echo \"   Set ANTHROPIC_API_KEY environment variable to test full startup\"\nfi\necho \"\"\n\necho -e \"${GREEN}========================================${NC}\"\necho -e \"${GREEN}All tests passed!${NC}\"\necho -e \"${GREEN}========================================${NC}\"\necho \"\"\necho \"To run the container:\"\necho \"  docker run -d -p 8081:8081 -e ANTHROPIC_API_KEY=your_key $FULL_IMAGE_NAME\"\necho \"\"\necho \"To tag and push to registry:\"\necho \"  docker tag $FULL_IMAGE_NAME your-registry/$IMAGE_NAME:$TAG\"\necho \"  docker push your-registry/$IMAGE_NAME:$TAG\"\n",
