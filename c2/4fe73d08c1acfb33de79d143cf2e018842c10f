          "text": "     1→import type { ToolDefinition } from '@use-ai/core';\n     2→import type { McpEndpointConfig } from '../types';\n     3→import { logger } from '../logger';\n     4→\n     5→/**\n     6→ * Schema format returned by MCP endpoints.\n     7→ * Based on Model Context Protocol specification.\n     8→ */\n     9→interface McpToolSchema {\n    10→  name: string;\n    11→  description: string;\n    12→  inputSchema: {\n    13→    type: 'object';\n    14→    properties: Record<string, unknown>;\n    15→    required?: string[];\n    16→    [key: string]: unknown;\n    17→  };\n    18→}\n    19→\n    20→interface McpSchemaResponse {\n    21→  tools: McpToolSchema[];\n    22→}\n    23→\n    24→/**\n    25→ * Server-only extension of ToolDefinition with remote execution metadata.\n    26→ * This type is used internally by the server and never exposed to the client.\n    27→ * The actual execute function is created in AISDKAgent where EventEmitter is available.\n    28→ */\n    29→export interface RemoteToolDefinition extends ToolDefinition {\n    30→  /** Remote execution metadata for MCP tools */\n    31→  _remote: {\n    32→    /** The provider that manages this tool */\n    33→    provider: RemoteMcpToolsProvider;\n    34→    /** The original tool name (before namespace prefix) */\n    35→    originalName: string;\n    36→  };\n    37→}\n    38→\n    39→/**\n    40→ * Manages fetching and executing tools from a single MCP endpoint.\n    41→ * Each instance handles one endpoint independently, allowing for separate failure handling.\n    42→ */\n    43→export class RemoteMcpToolsProvider {\n    44→  private tools: RemoteToolDefinition[] = [];\n    45→  private refreshTimer?: NodeJS.Timeout;\n    46→  private readonly url: string;\n    47→  private readonly config: McpEndpointConfig;\n    48→\n    49→  constructor(config: McpEndpointConfig) {\n    50→    this.config = config;\n    51→    this.url = config.url;\n    52→  }\n    53→\n    54→  /**\n    55→   * Initializes by fetching tools from the endpoint.\n    56→   * Should be called once during server startup.\n    57→   */\n    58→  async initialize(): Promise<void> {\n    59→    logger.info(`[MCP] Initializing endpoint: ${this.url}`);\n    60→\n    61→    try {\n    62→      await this.fetchAndRegister();\n    63→      logger.info(`[MCP] Successfully initialized endpoint: ${this.url}`);\n    64→    } catch (error) {\n    65→      const message = error instanceof Error ? error.message : String(error);\n    66→      logger.error(`[MCP] Failed to initialize endpoint ${this.url}: ${message}`);\n    67→      throw error;\n    68→    }\n    69→  }\n    70→\n    71→  /**\n    72→   * Fetches tools from the endpoint and registers them.\n    73→   * Sets up periodic refresh if configured.\n    74→   */\n    75→  private async fetchAndRegister(): Promise<void> {\n    76→    const schema = await this.fetchSchema();\n    77→    this.tools = this.convertToToolDefinitions(schema);\n    78→\n    79→    logger.info(`[MCP] Registered ${this.tools.length} tool(s) from ${this.url}`);\n    80→\n    81→    // Set up periodic refresh if configured\n    82→    if (this.config.refreshInterval && this.config.refreshInterval > 0 && !this.refreshTimer) {\n    83→      this.refreshTimer = setInterval(() => {\n    84→        logger.debug(`[MCP] Refreshing tools from ${this.url}`);\n    85→        this.fetchAndRegister().catch((err) => {\n    86→          logger.error(`[MCP] Failed to refresh tools from ${this.url}:`, err);\n    87→        });\n    88→      }, this.config.refreshInterval);\n    89→\n    90→      logger.debug(`[MCP] Set up refresh timer for ${this.url} (${this.config.refreshInterval}ms)`);\n    91→    }\n    92→  }\n    93→\n    94→  /**\n    95→   * Fetches the tool schema from the MCP endpoint using JSON-RPC.\n    96→   */\n    97→  private async fetchSchema(): Promise<McpSchemaResponse> {\n    98→    const url = `${this.url}/mcp`;\n    99→    const timeout = this.config.timeout || 30000;\n   100→\n   101→    logger.debug(`[MCP] Fetching schema from ${url}`);\n   102→\n   103→    const controller = new AbortController();\n   104→    const timeoutId = setTimeout(() => controller.abort(), timeout);\n   105→\n   106→    try {\n   107→      const response = await fetch(url, {\n   108→        method: 'POST',\n   109→        headers: {\n   110→          'Content-Type': 'application/json',\n   111→          'Accept': 'application/json, text/event-stream',\n   112→          ...this.config.headers,\n   113→        },\n   114→        body: JSON.stringify({\n   115→          jsonrpc: '2.0',\n   116→          method: 'tools/list',\n   117→          id: 1,\n   118→        }),\n   119→        signal: controller.signal,\n   120→      });\n   121→\n   122→      clearTimeout(timeoutId);\n   123→\n   124→      if (!response.ok) {\n   125→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   126→      }\n   127→\n   128→      const rpcResponse = (await response.json()) as any;\n   129→\n   130→      if (rpcResponse.error) {\n   131→        throw new Error(`MCP error: ${rpcResponse.error.message}`);\n   132→      }\n   133→\n   134→      const tools = rpcResponse.result?.tools || [];\n   135→\n   136→      return { tools };\n   137→    } catch (error) {\n   138→      clearTimeout(timeoutId);\n   139→\n   140→      if (error instanceof Error && error.name === 'AbortError') {\n   141→        throw new Error(`Request timeout after ${timeout}ms`);\n   142→      }\n   143→\n   144→      throw error;\n   145→    }\n   146→  }\n   147→\n   148→  /**\n   149→   * Converts MCP tool schemas to RemoteToolDefinition format.\n   150→   */\n   151→  private convertToToolDefinitions(schema: McpSchemaResponse): RemoteToolDefinition[] {\n   152→    return schema.tools.map((tool) => {\n   153→      // Apply namespace prefix if configured\n   154→      const name = this.config.namespace ? `${this.config.namespace}_${tool.name}` : tool.name;\n   155→\n   156→      // Create tool definition with remote metadata\n   157→      const toolDef: RemoteToolDefinition = {\n   158→        name,\n   159→        description: tool.description,\n   160→        parameters: {\n   161→          type: 'object',\n   162→          properties: tool.inputSchema.properties,\n   163→          required: tool.inputSchema.required,\n   164→        },\n   165→        // Mark with remote execution metadata\n   166→        _remote: {\n   167→          provider: this,\n   168→          originalName: tool.name,\n   169→        },\n   170→      };\n   171→\n   172→      return toolDef;\n   173→    });\n   174→  }\n   175→\n   176→  /**\n   177→   * Gets all tools from this endpoint.\n   178→   */\n   179→  getTools(): RemoteToolDefinition[] {\n   180→    return this.tools;\n   181→  }\n   182→\n   183→  /**\n   184→   * Executes a tool on the remote MCP endpoint using JSON-RPC.\n   185→   */\n   186→  async executeTool(toolName: string, args: any): Promise<any> {\n   187→    const url = `${this.url}/mcp`;\n   188→    const timeout = this.config.timeout || 30000;\n   189→\n   190→    logger.debug(`[MCP] Executing tool \"${toolName}\" at ${url}`);\n   191→\n   192→    const controller = new AbortController();\n   193→    const timeoutId = setTimeout(() => controller.abort(), timeout);\n   194→\n   195→    try {\n   196→      const response = await fetch(url, {\n   197→        method: 'POST',\n   198→        headers: {\n   199→          'Content-Type': 'application/json',\n   200→          'Accept': 'application/json, text/event-stream',\n   201→          ...this.config.headers,\n   202→        },\n   203→        body: JSON.stringify({\n   204→          jsonrpc: '2.0',\n   205→          method: 'tools/call',\n   206→          params: {\n   207→            name: toolName,\n   208→            arguments: args,\n   209→          },\n   210→          id: Date.now(),\n   211→        }),\n   212→        signal: controller.signal,\n   213→      });\n   214→\n   215→      clearTimeout(timeoutId);\n   216→\n   217→      if (!response.ok) {\n   218→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   219→      }\n   220→\n   221→      const rpcResponse = (await response.json()) as any;\n   222→\n   223→      if (rpcResponse.error) {\n   224→        throw new Error(`MCP error: ${rpcResponse.error.message}`);\n   225→      }\n   226→\n   227→      // Extract content from MCP response\n   228→      const content = rpcResponse.result?.content || [];\n   229→\n   230→      // Find text content\n   231→      const textContent = content.find((c: any) => c.type === 'text');\n   232→      if (textContent) {\n   233→        // Try to parse as JSON\n   234→        try {\n   235→          return JSON.parse(textContent.text);\n   236→        } catch {\n   237→          // If not JSON, return as result object\n   238→          return { result: textContent.text };\n   239→        }\n   240→      }\n   241→\n   242→      logger.debug(`[MCP] Tool \"${toolName}\" executed successfully`);\n   243→\n   244→      return {};\n   245→    } catch (error) {\n   246→      clearTimeout(timeoutId);\n   247→\n   248→      if (error instanceof Error && error.name === 'AbortError') {\n   249→        const errorMsg = `Tool execution timeout after ${timeout}ms`;\n   250→        logger.error(`[MCP] ${errorMsg}`);\n   251→        throw new Error(errorMsg);\n   252→      }\n   253→\n   254→      const errorMsg = error instanceof Error ? error.message : String(error);\n   255→      logger.error(`[MCP] Tool execution failed: ${errorMsg}`);\n   256→      throw error;\n   257→    }\n   258→  }\n   259→\n   260→  /**\n   261→   * Cleans up resources (timers).\n   262→   * Should be called when the server shuts down.\n   263→   */\n   264→  destroy(): void {\n   265→    if (this.refreshTimer) {\n   266→      logger.info(`[MCP] Cleaning up refresh timer for ${this.url}`);\n   267→      clearInterval(this.refreshTimer);\n   268→      this.refreshTimer = undefined;\n   269→    }\n   270→  }\n   271→\n   272→  /**\n   273→   * Gets the endpoint URL.\n   274→   */\n   275→  getUrl(): string {\n   276→    return this.url;\n   277→  }\n   278→}\n   279→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
