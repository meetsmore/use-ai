r(config: UseAIServerConfig) {\n    96→    this.config = {\n    97→      port: config.port ?? 8080,\n    98→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    99→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n   100→    };\n   101→\n   102→    // Set agents registry\n   103→    this.agents = config.agents;\n   104→\n   105→    // Get the default agent by name\n   106→    const defaultAgent = this.agents[config.defaultAgent];\n   107→    if (!defaultAgent) {\n   108→      throw new Error(\n   109→        `Agent \"${config.defaultAgent}\" not found in agents config. Available agents: ${Object.keys(this.agents).join(', ')}`\n   110→      );\n   111→    }\n   112→    this.agent = defaultAgent;\n   113→\n   114→    this.rateLimiter = new RateLimiter({\n   115→      maxRequests: this.config.rateLimitMaxRequests,\n   116→      windowMs: this.config.rateLimitWindowMs,\n   117→    });\n   118→\n   119→    this.cleanupInterval = setInterval(() => {\n   120→      this.rateLimiter.cleanup();\n   121→    }, this.config.rateLimitWindowMs);\n   122→\n   123→    // Create RemoteMcpToolsProvider instances (to reference remote tools)\n   124→    if (config.mcpEndpoints && config.mcpEndpoints.length > 0) {\n   125→      this.mcpEndpoints = config.mcpEndpoints.map(endpoint => new RemoteMcpToolsProvider(endpoint));\n   126→      logger.info('[MCP] Created remote MCP instances', {\n   127→        count: this.mcpEndpoints.length,\n   128→        endpoints: this.mcpEndpoints.map(e => e.getUrl()),\n   129→      });\n   130→    }\n   131→\n   132→    // Initialize plugins\n   133→    this.plugins = config.plugins ?? [];\n   134→    this.initializePlugins();\n   135→\n   136→    // Create HTTP server for health checks\n   137→    this.httpServer = createServer((req, res) => {\n   138→      if (req.url === '/health') {\n   139→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   140→        res.end(JSON.stringify({ status: 'ok' }));\n   141→      } else {\n   142→        res.writeHead(404);\n   143→        res.end();\n   144→      }\n   145→    });\n   146→\n   147→    // Attach Socket.IO server to HTTP server\n   148→    this.io = new SocketIOServer(this.httpServer, {\n   149→      cors: {\n   150→        origin: '*',\n   151→        methods: ['GET', 'POST']\n   152→      }\n   153→    });\n   154→    this.httpServer.listen(this.config.port);\n   155→    this.setupSocketIOServer();\n   156→\n   157→    if (this.rateLimiter.isEnabled()) {\n   158→      logger.info('Rate limiting enabled', {\n   159→        maxRequests: this.config.rateLimitMaxRequests,\n   160→        windowMs: this.config.rateLimitWindowMs,\n   161→      });\n   162→    }\n   163→  }\n   164→\n   165→  /**\n   166→   * Initializes the server by fetching MCP tools from all endpoints.\n   167→   * Must be called before the server starts accepting connections.\n   168→   */\n   169→  async initialize(): Promise<void> {\n   170→    // Initialize all MCP endpoints (fetch tools)\n   171→    if (this.mcpEndpoints.length > 0) {\n   172→      logger.info('[MCP] Initializing MCP endpoints', { count: this.mcpEndpoints.length });\n   173→\n   174→      const results = await Promise.allSettled(\n   175→        this.mcpEndpoints.map(endpoint => endpoint.initialize())\n   176→      );\n   177→\n   178→      // Log results\n   179→      const successful = results.filter(r => r.status === 'fulfilled').length;\n   180→      const failed = results.filter(r => r.status === 'rejected').length;\n   181→\n   182→      if (failed > 0) {\n   183→        logger.warn('[MCP] Some endpoints failed to initialize', { successful, failed });\n   184→      } else {\n   185→        logger.info('[MCP] All endpoints initialized successfully', { count: successful });\n   186→      }\n   187→    }\n   188→  }\n   189→\n   190→  /**\n   191→   * Initialize all plugins by calling their registerHandlers method.\n   192→   * This allows plugins to register custom message handlers.\n   193→   */\n   194→  private initializePlugins() {\n   195→    for (const plugin of this.plugins) {\n   196→      logger.info('Initializing plugin', { pluginName: plugin.getName() });\n   197→\n   198→      plugin.registerHandlers({\n   199→        registerMessageHandler: this.registerMessageHandler.bind(this),\n   200→      });\n   201→    }\n   202→  }\n   203→\n   204→  /**\n   205→   * Register a custom message handler for a specific message type.\n   206→   * Used by plugins to handle custom message types.\n   207→   *\n   208→   * @param type - The message type to handle (e.g., 'run_workflow')\n   209→   * @param handler - The handler function to call when this message type is received\n   210→   */\n   211→  public registerMessageHandler(type: string, handler: MessageHandler): void {\n   212→    if (this.messageHandlers.has(type)) {\n   213→      logger.warn('Overwriting existing message handler', { type });\n   214→    }\n   215→\n   216→    this.messageHandlers.set(type, handler);\n   217→    logger.debug('Registered message handler', { type });\n   218→  }\n   219→\n   220→  private setupSocketIOServer() {\n   221→    this.io.on('connection', (socket: Socket) => {\n   222→      const clientId = `client-${++this.clientIdCounter}`;\n   223→      const threadId = uuidv4();\n   224→      const ipAddress = socket.handshake.address || socket.id;\n   225→      logger.info('Client connected', { clientId, threadId, ipAddress });\n   226→\n   227→      const session: ClientSession = {\n   228→        clientId,\n   229→        ipAddress,\n   230→        socket,\n   231→        threadId,\n   232→        tools: [],\n   233→        state: null,\n   234→        messages: [],\n   235→        conversationHistory: [],\n   236→        pendingToolCalls: new Map(),\n   237→      };\n   238→\n   239→      this.clients.set(socket.id, session);\n   240→\n   241→      // Call plugin lifecycle hooks\n   242→      for (const plugin of this.plugins) {\n   243→        plugin.onClientConnect?.(session);\n   244→      }\n   245→\n   246→      socket.on('message', async (message: UseAIClientMessage) => {\n   247→        try {\n   248→          await this.handleClientMessage(socket, message);\n   249→        } catch (error) {\n   250→          logger.error('Error handling message', {\n   251→            error: error instanceof Error ? error.message : 'Unknown error',\n   252→            clientId,\n   253→          });\n   254→          this.sendEvent(socket, {\n   255→            type: EventType.RUN_ERROR,\n   256→            message: error instanceof Error ? error.message : 'Unknown error',\n   257→            timestamp: Date.now(),\n   258→          });\n   259→        }\n   260→      });\n   261→\n   262→      socket.on('disconnect', () => {\n   263→        logger.info('Client disconnected', { clientId, ipAddress });\n   264→\n   265→        // Call plugin lifecycle hooks\n   266→        for (const plugin of this.plugins) {\n   267→          plugin.onClientDisconnect?.(session);\n   268→        }\n   269→\n   270→        // Note: Rate limiting persists by IP address across connections\n   271→        this.clients.delete(socket.id);\n   272→      });\n   273→    });\n   274→\n   275→    logger.info('UseAI server listening', { port: this.config.port });\n   276→  }\n   277→\n   278→  private async handleClientMessage(socket: Socket, message: UseAIClientMessage) {\n   279→    const session = this.clients.get(socket.id);\n   280→    if (!session) return;\n   281→\n   282→    // Check if a plugin has registered a handler for this message type\n   283→    const pluginHandler = this.messageHandlers.get(message.type);\n   284→    if (pluginHandler) {\n   285→      await pluginHandler(session, message);\n   286→      return;\n   287→    }\n   288→\n   289→    // Core message handlers\n   290→    switch (message.type) {\n   291→      case 'run_agent':\n   292→        await this.handleRunAgent(session, message as RunAgentMessage);\n   293→        break;\n   294→      case 'tool_result':\n   295→        this.handleToolResult(session, message as ToolResultMessage);\n   296→        break;\n   297→      case 'abort_run':\n   298→        this.handleAbortRun(session, message as AbortRunMessage);\n   299→        break;\n   300→      default:\n   301→        logger.warn('Unknown message type', { type: message.type });\n   302→    }\n   303→  }\n   304→\n   305→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   306→    const { threadId, runId, messages, tools, state, context } = message.data;\n   307→\n   308→    // Rate limiting by IP address\n   309→    const rateLimitCheck = this.rateLimiter.checkLimit(session.ipAddress);\n   310→    if (!rateLimitCheck.allowed) {\n   311→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   312→      this.sendEvent(session.socket, {\n   313→        type: EventType.RUN_ERROR,\n   314→        message: `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`,\n   315→        timestamp: Date.now(),\n   316→      });\n   317→      return;\n   318→    }\n   319→\n   320→    // Update session\n   321→    session.threadId = threadId;\n   322→    session.currentRunId = runId;\n   323→\n   324→    // Merge client tools with MCP tools from all endpoints\n   325→    const clientTools = tools.map(t => ({\n   326→      ...t,\n   327→      parameters: t.parameters || { type: 'object', properties: {}, required: [] },\n   328→    })) as ToolDefinition[];\n   329→\n   330→    // Get tools from all MCP endpoints\n   331→    const mcpTools: RemoteToolDefinition[] = this.mcpEndpoints.flatMap(endpoint => endpoint.getTools());\n   332→\n   333→    // Merge: client tools + MCP tools\n   334→    session.tools = [...clientTools, ...mcpTools];\n   335→\n   336→    if (mcpTools.length > 0) {\n   337→      logger.debug('[MCP] Merged tools', {\n   338→        clientTools: clientTools.length,\n   339→        mcpTools: mcpTools.length,\n   340→        total: session.tools.length,\n   341→      });\n   342→    }\n   343→\n   344→    session.state = state;\n   345→    session.messages = messages;\n   346→\n   347→    // Helper to convert content to string if it's an array (AG-UI format)\n   348→    const getStringContent = (content: string | any[] | Record<string, any> | undefined): string => {\n   349→      if (!content) return '';\n   350→      if (typeof content === 'string') return content;\n   351→      // If it's an array, extract text from text blocks\n   352→      if (Array.isArray(content)) {\n   353→        return content\n   354→          .filter((block: any) => block.type === 'text')\n   355→          .map((block: any) => block.text)\n   356→          .join('');\n   357→      }\n   358→      // If it's an object (Record), convert to JSON string\n   359→      if (typeof content === 'object') {\n   360→        return JSON.stringify(content);\n   361→      }\n   362→      return '';\n   363→    };\n   364→\n   365→    // Convert AG-UI messages to AI SDK CoreMessage format\n   366→    const incomingMessages: CoreMessage[] = messages.map(msg => {\n   367→      if (msg.role === 'user') {\n   368→        return {\n   369→          role: 'user' as const,\n   370→          content: getStringContent(msg.content),\n   371→        };\n   372→      } else if (msg.role === 'assistant') {\n   373→        return {\n   374→          role: 'assistant' as const,\n   375→          content: getStringContent(msg.content),\n   376→        };\n   377→      } else if (msg.role === 'tool') {\n   378→        // Tool messages in AI SDK format\n   379→        return {\n   380→          role: 'tool' as const,\n   381→          content: [\n   382→            {\n   383→              type: 'tool-result' as const,\n   384→              toolCallId: (msg as any).tool_call_id || uuidv4(),\n   385→              toolName: (msg as any).tool_name || 'unknown',\n   386→              result: getStringContent(msg.content),\n   387→            },\n   388→          ],\n   389→        } as CoreToolMessage;\n   390→      }\n   391→      // Default fallback\n   392→      return {\n   393→        role: 'user' as const,\n   394→        content: getStringContent(msg.content),\n   395→      };\n   396→    });\n   397→\n   398→    // Conversation history management:\n   399→    // - The client sends ALL messages it knows about (user + assistant messages from past turns)\n   400→    // - The server maintains the authoritative history including tool results\n   401→    // - We only append NEW user messages to avoid duplicates\n   402→    if (session.conversationHistory.length === 0) {\n   403→      // First run: initialize conversation history with incoming messages\n   404→      session.conversationHistory = incomingMessages;\n   405→    } else {\n   406→      // Subsequent runs: only append NEW user messages that aren't already in the history\n   407→      // Count how many user messages we already have\n   408→      const existingUserMessageCount = session.conversationHistory.filter(msg => msg.role === 'user').length;\n   409→      const incomingUserMessages = incomingMessages.filter(msg => msg.role === 'user');\n   410→\n   411→      // Only append user messages beyond what we already have\n   412→      const newUserMessages = incomingUserMessages.slice(existingUserMessageCount);\n   413→\n   414→      // Append only new user messages to preserve the full conversation context\n   415→      session.conversationHistory.push(...newUserMessages);\n   416→    }\n   417→\n   418→    // Build system prompt\n   419→    const systemPrompt = this.buildSystemPrompt(session, state);\n   420→\n   421→    // Create event emitter that forwards all events to client\n   422→    const eventEmitter: EventEmitter = {\n   423→      emit: <T extends AGUIEvent>(event: T) => {\n   424→        this.sendEvent(session.socket, event);\n   425→      },\n   426→    };\n   427→\n   428→    // Delegate to agent\n   429→    await this.agent.run(\n   430→      {\n   431→        session,\n   432→        runId,\n   433→        messages: session.conversationHistory,\n   434→        tools: session.tools,\n   435→        state,\n   436→        systemPrompt,\n   437→        originalInput: message.data,\n   438→      },\n   439→      eventEmitter\n   440→    );\n   441→  }\n   442→\n   443→  private buildSystemPrompt(session: ClientSession, state: unknown): string | undefined {\n   444→    const parts: string[] = [];\n   445→\n   446→    // Add state context if available\n   447→    if (state) {\n   448→      parts.push('You are interacting with a web application. Here is the current state:');\n   449→      parts.push('');\n   450→      parts.push(JSON.stringify(state, null, 2));\n   451→      parts.push('');\n   452→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   453→    }\n   454→\n   455→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   456→    if (confirmationTools.length > 0) {\n   457→      if (parts.length > 0) {\n   458→        parts.push('');\n   459→      }\n   460→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   461→      parts.push('');\n   462→      confirmationTools.forEach(tool => {\n   463→        parts.push(`- ${tool.name}`);\n   464→      });\n   465→      parts.push('');\n   466→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   467→      parts.push('1. First, explain to the user exactly what changes will be made');\n   468→      parts.push('2. Then, explicitly ask: \"Do you want me to proceed?\" or similar confirmation question');\n   469→      parts.push('3. STOP and WAIT for the user to respond with explicit confirmation');\n   470→      parts.push('4. ONLY after receiving confirmation, call the tool');\n   471→      parts.push('');\n   472→      parts.push('NEVER ASSUME CONFIRMATION:');\n   473→      parts