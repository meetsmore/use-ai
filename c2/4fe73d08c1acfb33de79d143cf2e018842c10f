→  }\n    41→\n    42→  // Require at least one agent\n    43→  if (Object.keys(agents).length === 0) {\n    44→    console.error('Error: At least one AI provider API key is required');\n    45→    console.error('Please set one of the following:');\n    46→    console.error('  - ANTHROPIC_API_KEY (for Claude)');\n    47→    console.error('  - OPENAI_API_KEY (for GPT)');\n    48→    process.exit(1);\n    49→  }\n    50→\n    51→  // Default to Claude if available, otherwise use the first available agent\n    52→  const defaultAgent = agents.claude ? 'claude' : Object.keys(agents)[0];\n    53→\n    54→  if (logFormat === 'pretty') {\n    55→    console.log(`✓ Enabled agents: ${enabledAgents.join(', ')}`);\n    56→    console.log(`  Default agent: ${defaultAgent}`);\n    57→  } else {\n    58→    logger.info('Agents configured', { enabledAgents, defaultAgent });\n    59→  }\n    60→\n    61→  return { agents, defaultAgent };\n    62→}\n    63→\n    64→/**\n    65→ * Create workflow runners based on available configuration.\n    66→ * Returns a map of runner names to runner instances.\n    67→ */\n    68→function createWorkflowRunners(): Map<string, WorkflowRunner> {\n    69→  const runners = new Map<string, WorkflowRunner>();\n    70→  const enabledRunners: string[] = [];\n    71→\n    72→  // Check for Dify configuration\n    73→  const difyUrl = process.env.DIFY_API_URL;\n    74→  if (difyUrl) {\n    75→    // Build workflows mapping from environment variables\n    76→    // Convention: DIFY_<WORKFLOW_NAME>_KEY maps to workflow name\n    77→    const workflows: Record<string, string> = {};\n    78→\n    79→    // Example: DIFY_GREETING_WORKFLOW_KEY -> 'greeting-workflow'\n    80→    // Example: DIFY_PDF_PROCESSOR_KEY -> 'pdf-processor'\n    81→    Object.keys(process.env).forEach((key) => {\n    82→      if (key.startsWith('DIFY_') && key.endsWith('_KEY')) {\n    83→        const workflowName = key\n    84→          .slice(5, -4) // Remove 'DIFY_' prefix and '_KEY' suffix\n    85→          .toLowerCase()\n    86→          .replace(/_/g, '-'); // Convert underscores to hyphens\n    87→        workflows[workflowName] = process.env[key]!;\n    88→      }\n    89→    });\n    90→\n    91→    runners.set(\n    92→      'dify',\n    93→      new DifyWorkflowRunner({\n    94→        apiBaseUrl: difyUrl,\n    95→        workflows,\n    96→      })\n    97→    );\n    98→\n    99→    const workflowNames = Object.keys(workflows).join(', ');\n   100→    enabledRunners.push(\n   101→      `dify (${difyUrl}${workflowNames ? `, workflows: ${workflowNames}` : ''})`\n   102→    );\n   103→  }\n   104→\n   105→  if (logFormat === 'pretty' && enabledRunners.length > 0) {\n   106→    console.log(`✓ Enabled workflow runners: ${enabledRunners.join(', ')}`);\n   107→  } else if (enabledRunners.length > 0) {\n   108→    logger.info('Workflow runners configured', { enabledRunners });\n   109→  }\n   110→\n   111→  return runners;\n   112→}\n   113→\n   114→/**\n   115→ * Create MCP endpoint configurations from environment variables.\n   116→ * Returns an array of MCP endpoint configs.\n   117→ */\n   118→function createMcpEndpoints(): import('./types').McpEndpointConfig[] {\n   119→  const endpoints: import('./types').McpEndpointConfig[] = [];\n   120→\n   121→  // Check for MCP_ENDPOINT_URL (single endpoint for simple setups)\n   122→  const mcpUrl = process.env.MCP_ENDPOINT_URL;\n   123→  if (mcpUrl) {\n   124→    endpoints.push({\n   125→      url: mcpUrl,\n   126→      namespace: process.env.MCP_NAMESPACE || 'mcp',\n   127→      timeout: Number(process.env.MCP_TIMEOUT) || 30000,\n   128→    });\n   129→\n   130→    if (logFormat === 'pretty') {\n   131→      console.log(`✓ MCP endpoint configured: ${mcpUrl}`);\n   132→    } else {\n   133→      logger.info('MCP endpoint configured', { url: mcpUrl });\n   134→    }\n   135→  }\n   136→\n   137→  return endpoints;\n   138→}\n   139→\n   140→logger.info('Starting UseAI server', { logFormat });\n   14