          "text": "     1→import { WebSocketServer, WebSocket } from 'ws';\n     2→import Anthropic from '@anthropic-ai/sdk';\n     3→import { createServer } from 'http';\n     4→import { EventType } from '@use-ai/core';\n     5→import type {\n     6→  UseAIServerConfig,\n     7→  ToolDefinition,\n     8→  ClientMessage,\n     9→  RunAgentMessage,\n    10→  ToolResultMessage,\n    11→  AbortRunMessage,\n    12→  RunAgentInput,\n    13→  Message,\n    14→  Tool,\n    15→  TextMessageStartEvent,\n    16→  TextMessageContentEvent,\n    17→  TextMessageEndEvent,\n    18→  ToolCallStartEvent,\n    19→  ToolCallArgsEvent,\n    20→  ToolCallEndEvent,\n    21→  RunStartedEvent,\n    22→  RunFinishedEvent,\n    23→  RunErrorEvent,\n    24→  StateSnapshotEvent,\n    25→  MessagesSnapshotEvent,\n    26→} from './types';\n    27→import { RateLimiter } from './rateLimiter';\n    28→import { logger } from './logger';\n    29→import { v4 as uuidv4 } from 'uuid';\n    30→\n    31→interface ClientSession {\n    32→  clientId: string;\n    33→  ws: WebSocket;\n    34→  threadId: string;\n    35→  currentRunId?: string;\n    36→  tools: ToolDefinition[];\n    37→  state: unknown;\n    38→  messages: Message[];\n    39→  conversationHistory: Anthropic.MessageParam[];\n    40→  pendingToolCalls: Map<string, (content: string) => void>;\n    41→}\n    42→\n    43→/**\n    44→ * WebSocket server that coordinates between client applications and the Claude API.\n    45→ * Now emits AG-UI standard events for interoperability.\n    46→ *\n    47→ * Responsibilities:\n    48→ * - Manages WebSocket connections from clients\n    49→ * - Accepts RunAgentInput messages\n    50→ * - Forwards to Claude API with tool definitions\n    51→ * - Emits AG-UI events (TEXT_MESSAGE_*, TOOL_CALL_*, etc.)\n    52→ * - Routes tool execution requests back to clients\n    53→ * - Maintains conversation history and state per session\n    54→ * - Handles rate limiting\n    55→ *\n    56→ * @example\n    57→ * ```typescript\n    58→ * import { UseAIServer } from '@use-ai/server';\n    59→ *\n    60→ * const server = new UseAIServer({\n    61→ *   port: 8080,\n    62→ *   anthropicApiKey: process.env.ANTHROPIC_API_KEY,\n    63→ *   model: 'claude-sonnet-4-20250514'\n    64→ * });\n    65→ * ```\n    66→ */\n    67→export class UseAIServer {\n    68→  private wss: WebSocketServer;\n    69→  private httpServer: ReturnType<typeof createServer>;\n    70→  private anthropic: Anthropic;\n    71→  private clients: Map<WebSocket, ClientSession> = new Map();\n    72→  private config: Required<UseAIServerConfig>;\n    73→  private rateLimiter: RateLimiter;\n    74→  private cleanupInterval: NodeJS.Timeout;\n    75→  private clientIdCounter = 0;\n    76→\n    77→  /**\n    78→   * Creates a new UseAI server instance.\n    79→   *\n    80→   * @param config - Server configuration options\n    81→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    82→   */\n    83→  constructor(config: UseAIServerConfig = {}) {\n    84→    this.config = {\n    85→      port: config.port ?? 8080,\n    86→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    87→      model: config.model ?? 'claude-sonnet-4-20250514',\n    88→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    89→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    90→    };\n    91→\n    92→    if (!this.config.anthropicApiKey) {\n    93→      throw new Error('Anthropic API key is required');\n    94→    }\n    95→\n    96→    this.anthropic = new Anthropic({\n    97→      apiKey: this.config.anthropicApiKey,\n    98→    });\n    99→\n   100→    this.rateLimiter = new RateLimiter({\n   101→      maxRequests: this.config.rateLimitMaxRequests,\n   102→      windowMs: this.config.rateLimitWindowMs,\n   103→    });\n   104→\n   105→    this.cleanupInterval = setInterval(() => {\n   106→      this.rateLimiter.cleanup();\n   107→    }, this.config.rateLimitWindowMs);\n   108→\n   109→    // Create HTTP server for health checks\n   110→    this.httpServer = createServer((req, res) => {\n   111→      if (req.url === '/health') {\n   112→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   113→        res.end(JSON.stringify({ status: 'ok' }));\n   114→      } else {\n   115→        res.writeHead(404);\n   116→        res.end();\n   117→      }\n   118→    });\n   119→\n   120→    // Attach WebSocket server to HTTP server\n   121→    this.wss = new WebSocketServer({ server: this.httpServer });\n   122→    this.httpServer.listen(this.config.port);\n   123→    this.setupWebSocketServer();\n   124→\n   125→    if (this.rateLimiter.isEnabled()) {\n   126→      logger.info('Rate limiting enabled', {\n   127→        maxRequests: this.config.rateLimitMaxRequests,\n   128→        windowMs: this.config.rateLimitWindowMs,\n   129→      });\n   130→    }\n   131→  }\n   132→\n   133→  private setupWebSocketServer() {\n   134→    this.wss.on('connection', (ws: WebSocket) => {\n   135→      const clientId = `client-${++this.clientIdCounter}`;\n   136→      const threadId = uuidv4();\n   137→      logger.info('Client connected', { clientId, threadId });\n   138→\n   139→      const session: ClientSession = {\n   140→        clientId,\n   141→        ws,\n   142→        threadId,\n   143→        tools: [],\n   144→        state: null,\n   145→        messages: [],\n   146→        conversationHistory: [],\n   147→        pendingToolCalls: new Map(),\n   148→      };\n   149→\n   150→      this.clients.set(ws, session);\n   151→\n   152→      ws.on('message', async (data: Buffer) => {\n   153→        try {\n   154→          const message: ClientMessage = JSON.parse(data.toString());\n   155→          await this.handleClientMessage(ws, message);\n   156→        } catch (error) {\n   157→          logger.error('Error handling message', {\n   158→            error: error instanceof Error ? error.message : 'Un