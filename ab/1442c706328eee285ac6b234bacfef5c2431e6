\n    43→  serverUrl: string;\n    44→  /** Whether the client is connected to the server */\n    45→  connected: boolean;\n    46→  /** Registers tools for a specific component */\n    47→  registerTools: (\n    48→    id: string,\n    49→    tools: ToolsDefinition,\n    50→    waitForRender?: () => Promise<void>\n    51→  ) => void;\n    52→  /** Unregisters tools for a specific component */\n    53→  unregisterTools: (id: string) => void;\n    54→  /** Updates the UI context prompt for a specific component */\n    55→  updatePrompt: (id: string, prompt?: string) => void;\n    56→  /** The underlying WebSocket client instance */\n    57→  client: UseAIClient | null;\n    58→  /** The current chat ID */\n    59→  currentChatId: string | null;\n    60→  /** Creates a new chat and switches to it */\n    61→  createNewChat: () => Promise<string>;\n    62→  /** Loads an existing chat by ID */\n    63→  loadChat: (chatId: string) => Promise<void>;\n    64→  /** Deletes a chat by ID */\n    65→  deleteChat: (chatId: string) => Promise<void>;\n    66→  /** Lists all available chats */\n    67→  listChats: () => Promise<Array<Omit<Chat, 'messages'>>>;\n    68→  /** Clears the current chat messages */\n    69→  clearCurrentChat: () => Promise<void>;\n    70→}\n    71→\n    72→const UseAIContext = createContext<UseAIContextValue | null>(null);\n    73→\n    74→/**\n    75→ * Props for custom floating button component.\n    76→ * Used to customize the appearance and behavior of the AI chat trigger button.\n    77→ */\n    78→export interface FloatingButtonProps {\n    79→  /** Callback when the button is clicked */\n    80→  onClick: () => void;\n    81→  /** Whether the client is connected to the server */\n    82→  connected: boolean;\n    83→  /** Whether there are unread messages */\n    84→  hasUnread?: boolean;\n    85→}\n    86→\n    87→/**\n    88→ * Props for custom chat panel component.\n    89→ * Used to customize the appearance and behavior of the AI chat interface.\n    90→ */\n    91→export interface ChatPanelProps {\n    92→  /** Whether the chat panel is open */\n    93→  isOpen: boolean;\n    94→  /** Callback when the panel should close */\n    95→  onClose: () => void;\n    96→  /** Callback when a message is sent */\n    97→  onSendMessage: (message: string) => void;\n    98→  /** Array of messages in the conversation */\n    99→  messages: Message[];\n   100→  /** Whether the AI is currently processing */\n   101→  loading: boolean;\n   102→  /** Whether the client is connected to the server */\n   103→  connected: boolean;\n   104→}\n   105→\n   106→export interface UseAIProviderProps extends UseAIConfig {\n   107→  children: ReactNode;\n   108→  systemPrompt?: string;\n   109→  CustomButton?: React.ComponentType<FloatingButtonProps>;\n   110→  CustomChat?: React.ComponentType<ChatPanelProps>;\n   111→  /**\n   112→   * Custom chat repository for message persistence.\n   113→   * Defaults to LocalStorageChatRepository if not provided.\n   114→   */\n   115→  chatRepository?: ChatRepository;\n   116→}\n   117→\n   118→/**\n   119→ * Custom hook for managing chat storage operations.\n   120→ * Encapsulates all chat repository interactions for better separation of concerns.\n   121→ */\n   122→function useChatStorage(repository: ChatRepository) {\n   123→  const saveUserMessage = useCallback(async (\n   124→    chatId: string,\n   125→    message: string\n   126→  ): Promise<boolean> => {\n   127→    try {\n   128→      const chat = await repository.loadChat(chatId);\n   129→\n   130→      if (!chat) {\n   131→        console.error('[ChatStorage] Chat not found:', chatId);\n   132→        return false;\n   133→      }\n   134→\n   135→      chat.messages.push({\n   136→        id: generateMessageId(),\n   137→        role: 'user',\n   138→        content: message,\n   139→        createdAt: new Date(),\n   140→      });\n   141→\n   142→      // Auto-generate title using extracted helper\n   143→      if (!chat.title)