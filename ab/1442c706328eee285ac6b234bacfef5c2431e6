\n    48→  }, []);\n    49→\n    50→  useEffect(() => {\n    51→    const count = renderResolvers.current.length;\n    52→    if (count > 0) {\n    53→      console.log(`[${hookId.current}] Render complete, resolving ${count} promises`);\n    54→      renderResolvers.current.forEach(resolve => resolve());\n    55→      renderResolvers.current = [];\n    56→    }\n    57→  });\n    58→\n    59→  const waitForRender = useCallback(() => {\n    60→    return new Promise<void>(resolve => {\n    61→      console.log(`[${hookId.current}] Adding render promise`);\n    62→      renderResolvers.current.push(resolve);\n    63→    });\n    64→  }, []);\n    65→\n    66→  useEffect(() => {\n    67→    updatePrompt(hookId.current, options.prompt);\n    68→  }, [options.prompt, updatePrompt]);\n    69→\n    70→  useEffect(() => {\n    71→    if (options.tools) {\n    72→      const componentId = options.id || componentRef.current?.id;\n    73→      const toolsToRegister = componentId\n    74→        ? namespaceTools(options.tools, componentId)\n    75→        : options.tools;\n    76→\n    77→      registerTools(hookId.current, toolsToRegister, waitForRender);\n    78→      toolsRef.current = toolsToRegister;\n    79→    }\n    80→\n    81→    return () => {\n    82→      if (options.tools) {\n    83→        unregisterTools(hookId.current);\n    84→      }\n    85→    };\n    86→  }, [options.tools, options.id, registerTools, unregisterTools, waitForRender]);\n    87→\n    88→  useEffect(() => {\n    89→    if (!client) return;\n    90→\n    91→    const unsubscribe = client.onMessage(hookId.current, (message: ServerMessage) => {\n    92→      handleServerMessage(message);\n    93→    });\n    94→\n    95→    return () => {\n    96→      unsubscribe();\n    97→    };\n    98→  }, [client]);\n    99→\n   100→  const handleServerMessage = useCallback(async (message: ServerMessage) => {\n   101→    switch (message.type) {\n   102→      case 'response': {\n   103→        const responseMsg = message as ResponseMessage;\n   104→        setResponse(responseMsg.data.content);\n   105→        setLoading(false);\n   106→        break;\n   107→      }\n   108→\n   109→      case 'error': {\n   110→        const errorMsg = message as ErrorMessage;\n   111→        const error = new Error(errorMsg.data.message);\n   112→        setError(error);\n   113→        setLoading(false);\n   114→        options.onError?.(error);\n   115→        break;\n   116→      }\n   117→    }\n   118→  }, [options.onError]);\n   119→\n   120→  const generate = useCallback(async (prompt: string) => {\n   121→    if (!client?.isConnected()) {\n   122→      const error = new Error('Not connected to server');\n   123→      setError(error);\n   124→      options.onError?.(error);\n   125→      return;\n   126→    }\n   127→\n   128→    setLoading(true);\n   129→    setError(null);\n   130→    setResponse(null);\n   131→\n   132→    try {\n   133→      client.sendPrompt(prompt);\n   134→    } catch (err) {\n   135→      const error = err instanceof Error ? err : new Error('Unknown error');\n   136→      setError(error);\n   137→      setLoading(false);\n   138→      options.onError?.(error);\n   139→    }\n   140→  }, [client, options.onError]);\n   141→\n   142→  return {\n   143→    response,\n   144→    loading,\n   145→    error,\n   146→    generate,\n   147→    connected,\n   148→    ref: componentRef,\n   149→  };\n   150→}\n   151→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
