      data: { prompt, conversationId },\n   106→    });\n   107→  }\n   108→\n   109→  /**\n   110→   * Sends the result of a tool execution back to the server.\n   111→   *\n   112→   * @param toolCallId - The ID of the tool call being responded to\n   113→   * @param result - The result returned by the tool execution\n   114→   * @param prompt - Optional updated prompt to send back to the AI (e.g. updated UI state)\n   115→   */\n   116→  sendToolResponse(toolCallId: string, result: unknown, prompt?: string) {\n   117→    const data: { toolCallId: string; result: unknown; context?: string } = { toolCallId, result };\n   118→    if (prompt) {\n   119→      data.context = prompt;\n   120→    }\n   121→    this.send({\n   122→      type: 'tool_response',\n   123→      data,\n   124→    });\n   125→  }\n   126→\n   127→  /**\n   128→   * Registers a message handler for receiving server messages.\n   129→   *\n   130→   * @param id - Unique identifier for this handler\n   131→   * @param handler - Callback function to handle incoming messages\n   132→   * @returns Cleanup function to unregister the handler\n   133→   */\n   134→  onMessage(id: string, handler: (message: ServerMessage) => void) {\n   135→    this.messageHandlers.set(id, handler);\n   136→    return () => {\n   137→      this.messageHandlers.delete(id);\n   138→    };\n   139→  }\n   140→\n   141→  private send(message: unknown) {\n   142→    if (this.ws && this.ws.readyState === WebSocket.OPEN) {\n   143→      this.ws.send(JSON.stringify(message));\n   144→    } else {\n   145→      console.error('WebSocket is not connected');\n   146→    }\n   147→  }\n   148→\n   149→  /**\n   150→   * Closes the WebSocket connection to the server.\n   151→   */\n   152→  disconnect() {\n   153→    if (this.ws) {\n   154→      this.ws.close();\n   155→      this.ws = null;\n   156→    }\n   157→  }\n   158→\n   159→  /**\n   160→   * Checks if the client is currently connected to the server.\n   161→   *\n   162→   * 