escript\n    58→ * import { UseAIServer } from '@use-ai/server';\n    59→ *\n    60→ * const server = new UseAIServer({\n    61→ *   port: 8080,\n    62→ *   anthropicApiKey: process.env.ANTHROPIC_API_KEY,\n    63→ *   model: 'claude-sonnet-4-20250514'\n    64→ * });\n    65→ * ```\n    66→ */\n    67→export class UseAIServer {\n    68→  private wss: WebSocketServer;\n    69→  private httpServer: ReturnType<typeof createServer>;\n    70→  private anthropic: Anthropic;\n    71→  private clients: Map<WebSocket, ClientSession> = new Map();\n    72→  private config: Required<UseAIServerConfig>;\n    73→  private rateLimiter: RateLimiter;\n    74→  private cleanupInterval: NodeJS.Timeout;\n    75→  private clientIdCounter = 0;\n    76→\n    77→  /**\n    78→   * Creates a new UseAI server instance.\n    79→   *\n    80→   * @param config - Server configuration options\n    81→   * @throws Error if Anthropic API key is not provided via config or environment variable\n    82→   */\n    83→  constructor(config: UseAIServerConfig = {}) {\n    84→    this.config = {\n    85→      port: config.port ?? 8080,\n    86→      anthropicApiKey: config.anthropicApiKey ?? process.env.ANTHROPIC_API_KEY ?? '',\n    87→      model: config.model ?? 'claude-sonnet-4-20250514',\n    88→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n    89→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n    90→    };\n    91→\n    92→    if (!this.config.anthropicApiKey) {\n    93→      throw new Error('Anthropic API key is required');\n    94→    }\n    95→\n    96→    this.anthropic = new Anthropic({\n    97→      apiKey: this.config.anthropicApiKey,\n    98→    });\n    99→\n   100→    this.rateLimiter = new RateLimiter({\n   101→      maxRequests: this.config.rateLimitMaxRequests,\n   102→      windowMs: this.config.rateLimitWindowMs,\n   103→    });\n   104→\n   105→    this.cleanupInterval = setInterval(() => {\n   106→      this.rateLimiter.cleanup();\n   107→    }, this.config.rateLimitWindowMs);\n   108→\n   109→    // Create HTTP server for health checks\n   110→    this.httpServer = createServer((req, res) => {\n   111→      if (req.url === '/health') {\n   112→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   113→        res.end(JSON.stringify({ status: 'ok' }));\n   114→      } else {\n   115→        res.writeHead(404);\n   116→        res.end();\n   117→      }\n   118→    });\n   119→\n   120→    // Attach WebSocket server to HTTP server\n   121→    this.wss = new WebSocketServer({ server: this.httpServer });\n   122→    this.httpServer.listen(this.config.port);\n   123→    this.setupWebSocketServer();\n   124→\n   125→    if (this.rateLimiter.isEnabled()) {\n   126→      logger.info('Rate limiting enabled', {\n   127→        maxRequests: this.config.rateLimitMaxRequests,\n   128→        windowMs: this.config.rateLimitWindowMs,\n   129→      });\n   130→    }\n   131→  }\n   132→\n   133→  private setupWebSocketServer() {\n   134→    this.wss.on('connection', (ws: WebSocket) => {\n   135→      const clientId = `client-${++this.clientIdCounter}`;\n   136→      const threadId = uuidv4();\n   137→      logger.info('Client connected', { clientId, threadId });\n   138→\n   139→      const session: ClientSession = {\n   140→        clientId,\n   141→        ws,\n   142→        threadId,\n   143→        tools: [],\n   144→        state: null,\n   145→        messages: [],\n   146→        conversationHistory: [],\n   147→        pendingToolCalls: new Map(),\n   148→      };\n   149→\n   150→      this.clients.set(ws, session);\n   151→\n   152→      ws.on('message', async (data: Buffer) => {\n   153→        try {\n   154→          const message: ClientMessage = JSON.parse(data.toString());\n   155→          await this.handleClientMessage(ws, message);\n   156→        } catch (error) {\n   157→          logger.error('Error handling message', {\n   158→            error: error instanceof Error ? error.message : 'Unknown error',\n   159→            clientId,\n   160→          });\n   161→          this.sendEvent(ws, {\n   162→            type: EventType.RUN_ERROR,\n   163→            message: error instanceof Error ? error.message : 'Unknown error',\n   164→            timestamp: Date.now(),\n   165→          });\n   166→        }\n   167→      });\n   168→\n   169→      ws.on('close', () => {\n   170→        logger.info('Client disconnected', { clientId });\n   171→        this.rateLimiter.removeClient(clientId);\n   172→        this.clients.delete(ws);\n   173→      });\n   174→    });\n   175→\n   176→    logger.info('UseAI server listening', { port: this.config.port });\n   177→  }\n   178→\n   179→  private async handleClientMessage(ws: WebSocket, message: ClientMessage) {\n   180→    const session = this.clients.get(ws);\n   181→    if (!session) return;\n   182→\n   183→    switch (message.type) {\n   184→      case 'run_agent':\n   185→        await this.handleRunAgent(session, message as RunAgentMessage);\n   186→        break;\n   187→      case 'tool_result':\n   188→        this.handleToolResult(session, message as ToolResultMessage);\n   189→        break;\n   190→      case 'abort_run':\n   191→        this.handleAbortRun(session, message as AbortRunMessage);\n   192→        break;\n   193→    }\n   194→  }\n   195→\n   196→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   197→    const { threadId, runId, messages, tools, state, context } = message.data;\n   198→\n   199→    // Rate limiting\n   200→    const rateLimitCheck = this.rateLimiter.checkLimit(session.clientId);\n   201→    if (!rateLimitCheck.allowed) {\n   202→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   203→      this.sendEvent(session.ws, {\n   204→        type: EventType.RUN_ERROR,\n   205→        message: `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`,\n   206→        timestamp: Date.now(),\n   207→      });\n   208→      return;\n   209→    }\n   210→\n   211→    // Update session\n   212→    session.threadId = threadId;\n   213→    session.currentRunId = runId;\n   214→    session.tools = tools.map(t => ({\n   215→      ...t,\n   216→      parameters: t.parameters || { type: 'object', properties: {}, required: [] },\n   217→    })) as ToolDefinition[];\n   218→    session.state = state;\n   219→    session.messages = messages;\n   220→\n   221→    // Emit RUN_STARTED event\n   222→    this.sendEvent<RunStartedEvent>(session.ws, {\n   223→      type: EventType.RUN_STARTED,\n   224→      threadId,\n   225→      runId,\n   226→      input: message.data,\n   227→      timestamp: Date.now(),\n   228→    });\n   229→\n   230→    // Emit MESSAGES_SNAPSHOT event\n   231→    this.sendEvent<MessagesSnapshotEvent>(session.ws, {\n   232→      type: EventType.MESSAGES_SNAPSHOT,\n   233→      messages,\n   234→      timestamp: Date.now(),\n   235→    });\n   236→\n   237→    // Emit STATE_SNAPSHOT event\n   238→    this.sendEvent<StateSnapshotEvent>(session.ws, {\n   239→      type: EventType.STATE_SNAPSHOT,\n   240→      snapshot: state,\n   241→      timestamp: Date.now(),\n   242→    });\n   243→\n   244→    // Convert AG-UI messages to Anthropic format\n   245→    const anthropicMessages: Anthropic.MessageParam[] = messages.map(msg => {\n   246→      // Helper to convert content to string if it's an array (AG-UI format)\n   247→      const getStringContent = (content: string | any[] | Record<string, any> | undefined): string => {\n   248→        if (!content) return '';\n   249→        if (typeof content === 'string') return content;\n   250→        // If it's an array, extract text from text blocks\n   251→        if (Array.isArray(content)) {\n   252→          return content\n   253→            .filter((block: any) => block.type === 'text')\n   254→            .map((block: any) => block.text)\n   255→            .join('');\n   256→        }\n   257→        /