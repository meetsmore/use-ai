tent\n   394→    const assistantContent: any[] = [];\n   395→\n   396→    // Add text if present\n   397→    if (result.text) {\n   398→      assistantContent.push({ type: 'text', text: result.text });\n   399→    }\n   400→\n   401→    // Add tool calls if present\n   402→    if (result.toolCalls && result.toolCalls.length > 0) {\n   403→      for (const toolCall of result.toolCalls) {\n   404→        assistantContent.push({\n   405→          type: 'tool-call',\n   406→          toolCallId: toolCall.toolCallId,\n   407→          toolName: toolCall.toolName,\n   408→          args: toolCall.args,\n   409→        });\n   410→      }\n   411→    }\n   412→\n   413→    // Add assistant message to conversation history\n   414→    session.conversationHistory.push({\n   415→      role: 'assistant',\n   416→      content: assistantContent,\n   417→    } as any);\n   418→\n   419→    // Emit text message events\n   420→    if (result.text) {\n   421→      const messageId = uuidv4();\n   422→\n   423→      // Emit TEXT_MESSAGE_START\n   424→      this.sendEvent<TextMessageStartEvent>(session.socket, {\n   425→        type: EventType.TEXT_MESSAGE_START,\n   426→        messageId,\n   427→        role: 'assistant',\n   428→        timestamp: Date.now(),\n   429→      });\n   430→\n   431→      // Emit TEXT_MESSAGE_CONTENT\n   432→      this.sendEvent<TextMessageContentEvent>(session.socket, {\n   433→        type: EventType.TEXT_MESSAGE_CONTENT,\n   434→        messageId,\n   435→        delta: result.text,\n   436→        timestamp: Date.now(),\n   437→      });\n   438→\n   439→      // Emit TEXT_MESSAGE_END\n   440→      this.sendEvent<TextMessageEndEvent>(session.socket, {\n   441→        type: EventType.TEXT_MESSAGE_END,\n   442→        messageId,\n   443→        timestamp: Date.now(),\n   444→      });\n   445→\n   446→      logger.aiResponse([result.text]);\n   447→    }\n   448→\n   449→    // Handle tool calls\n   450→    if (result.toolCalls && result.toolCalls.length > 0) {\n   451→      logger.toolCalls(result.toolCalls.map(t => ({ name: t.toolName, input: t.args })));\n   452→      await this.handleMultipleToolUses(session, result.toolCalls, runId);\n   453→    } else {\n   454→      // No tool calls, run is finished\n   455→      this.sendEvent<RunFinishedEvent>(session.socket, {\n   456→        type: EventType.RUN_FINISHED,\n   457→        threadId: session.threadId,\n   458→        runId,\n   459→        result: result.text,\n   460→        timestamp: Date.now(),\n   461→      });\n   462→    }\n   463→  }\n   464→\n   465→  private async handleMultipleToolUses(\n   466→    session: ClientSession,\n   467→    toolCalls: Array<{ toolCallId: string; toolName: string; args: any }>,\n   468→    runId: string\n   469→  ) {\n   470→    const toolResults: ToolResultPart[] = [];\n   471→\n   472→    for (const toolCall of toolCalls) {\n   473→      const toolCallId = toolCall.toolCallId;\n   474→      const parentMessageId = uuidv4();\n   475→\n   476→      // Emit TOOL_CALL_START\n   477→      this.sendEvent<ToolCallStartEvent>(session.socket, {\n   478→        type: EventType.TOOL_CALL_START,\n   479→        toolCallId,\n   480→        toolCallName: toolCall.toolName,\n   481→        parentMessageId,\n   482→        timestamp: Date.now(),\n   483→      });\n   484→\n   485→      // Emit TOOL_CALL_ARGS (stream the arguments)\n   486→      const argsStr = JSON.stringify(toolCall.args);\n   487→      this.sendEvent<ToolCallArgsEvent>(session.socket, {\n   488→        type: EventType.TOOL_CALL_ARGS,\n   489→        toolCallId,\n   490→        delta: argsStr,\n   491→        timestamp: Date.now(),\n   492→      });\n   493→\n   494→      // Emit TOOL_CALL_END\n   495→      this.sendEvent<ToolCallEndEvent>(session.socket, {\n   496→        type: EventType.TOOL_CALL_END,\n   497→        toolCallId,\n   498→        timestamp: Date.now(),\n   499→      });\n   500→\n   501→      // Wait for tool result from client\n   502→      const toolResponsePromise = new Promise<string>((resolve) => {\n   503→        session.pendingToolCalls.set(toolCallId, resolve);\n   504→      });\n   505→\n   506→      const content = await toolResponsePromise;\n   507→\n   508→      logger.toolResult(toolCall.toolName, content);\n   509→\n   510→      toolResults.push({\n   511→        type: 'tool-result',\n   512→        toolCallId,\n   513→        toolName: toolCall.toolName,\n   514→        result: content,\n   515→      });\n   516→    }\n   517→\n   518→    // Add tool results to conversation as a tool message\n   519→    session.conversationHistory.push({\n   520→      role: 'tool',\n   521→      content: toolResults,\n   522→    } as CoreToolMessage);\n   523→\n   524→    // Call Claude again with tool results\n   525→    const systemPrompt = this.buildSystemPrompt(session, session.state);\n   526→\n   527→    const followUpResult = await generateText({\n   528→      model: this.anthropic(this.config.model),\n   529→      messages: session.conversationHistory,\n   530→      system: systemPrompt,\n   531→      tools: session.tools.length > 0 ? this.sanitizeToolsForAPI(session.tools) : undefined,\n   532→      maxSteps: 1,\n   533→      maxTokens: 4096,\n   534→    });\n   535→\n   536→    await this.processResponse(session, followUpResult, runId);\n   537→  }\n   538→\n   539→  private handleToolResult(session: ClientSession, message: ToolResultMessage) {\n   540→    const { toolCallId, content } = message.data;\n   541→    const resolver = session.pendingToolCalls.get(toolCallId);\n   542→\n   543→    if (resolver) {\n   544→      resolver(content);\n   545→      session.pendingToolCalls.delete(toolCallId);\n   546→    }\n   547→  }\n   548→\n   549→  private handleAbortRun(session: ClientSession, message: AbortRunMessage) {\n   550→    const { runId } = message.data;\n   551→    // Clear pending tool calls for this run\n   552→    session.pendingToolCalls.clear();\n   553→    session.currentRunId = undefined;\n   554→\n   555→    logger.info('Run aborted', { clientId: session.clientId, runId });\n   556→  }\n   557→\n   558→  private sendEvent<T = unknown>(socket: Socket, event: T) {\n   559→    if (socket.connected) {\n   560→      socket.emit('event', event);\n   561→    }\n   562→  }\n   563→\n   564→  /**\n   565→   * Closes the server and cleans up resources.\n   566→   * Stops accepting new connections and terminates all existing connections.\n   567→   */\n   568→  public close() {\n   569→    clearInterval(this.cleanupInterval);\n   570→    this.io.close();\n   571→    this.httpServer.close();\n   572→  }\n   573→}\n   574→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
