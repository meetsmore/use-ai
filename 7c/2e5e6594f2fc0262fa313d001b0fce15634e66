';\n    46→ * import { openai } from '@ai-sdk/openai';\n    47→ *\n    48→ * // Single agent (Claude)\n    49→ * const anthropic = createAnthropic({\n    50→ *   apiKey: process.env.ANTHROPIC_API_KEY,\n    51→ * });\n    52→ * const claudeAgent = new AISDKAgent({\n    53→ *   model: anthropic('claude-sonnet-4-20250514'),\n    54→ * });\n    55→ * const server = new UseAIServer({\n    56→ *   port: 8081,\n    57→ *   agents: { claude: claudeAgent },\n    58→ *   defaultAgent: 'claude', // Default agent name\n    59→ * });\n    60→ *\n    61→ * // Multiple agents (Claude + OpenAI)\n    62→ * const gptAgent = new AISDKAgent({\n    63→ *   model: openai('gpt-4-turbo'),\n    64→ * });\n    65→ * const multiServer = new UseAIServer({\n    66→ *   port: 8081,\n    67→ *   agents: {\n    68→ *     claude: claudeAgent,\n    69→ *     'gpt-4': gptAgent,\n    70→ *   },\n    71→ *   runner: 'claude', // Default for chat\n    72→ * });\n    73→ * ```\n    74→ */\n    75→export class UseAIServer {\n    76→  private io: SocketIOServer;\n    77→  private httpServer: ReturnType<typeof createServer>;\n    78→  private agent: Agent; // Default agent for chat (run_agent)\n    79→  private defaultAgentId: string; // ID of the default agent\n    80→  private agents: Record<string, Agent>; // Registry of all agents\n    81→  private clients: Map<string, ClientSession> = new Map();\n    82→  private config: Required<Omit<UseAIServerConfig, 'defaultAgent' | 'agents' | 'plugins' | 'mcpEndpoints'>>;\n    83→  private rateLimiter: RateLimiter;\n    84→  private cleanupInterval: NodeJS.Timeout;\n    85→  private clientIdCounter = 0;\n    86→  private plugins: UseAIServerPlugin[] = [];\n    87→  private messageHandlers: Map<string, MessageHandler> = new Map();\n    88→  private mcpEndpoints: RemoteMcpToolsProvider[] = [];\n    89→\n    90→  /**\n    91→   * Creates a new UseAI server instance.\n    92→   *\n    93→   * @param config - Server configuration options\n    94→   * @throws Error if the specified agent name does not exist in the agents map\n    95→   */\n    96→  constructor(config: UseAIServerConfig) {\n    97→    this.config = {\n    98→      port: config.port ?? 8081,\n    99→      rateLimitMaxRequests: config.rateLimitMaxRequests ?? 0,\n   100→      rateLimitWindowMs: config.rateLimitWindowMs ?? 60000,\n   101→    };\n   102→\n   103→    // Set agents registry\n   104→    this.agents = config.agents;\n   105→\n   106→    // Get the default agent by name\n   107→    const defaultAgent = this.agents[config.defaultAgent];\n   108→    if (!defaultAgent) {\n   109→      throw new Error(\n   110→        `Agent \"${config.defaultAgent}\" not found in agents config. Available agents: ${Object.keys(this.agents).join(', ')}`\n   111→      );\n   112→    }\n   113→    this.agent = defaultAgent;\n   114→    this.defaultAgentId = config.defaultAgent;\n   115→\n   116→    this.rateLimiter = new RateLimiter({\n   117→      maxRequests: this.config.rateLimitMaxRequests,\n   118→      windowMs: this.config.rateLimitWindowMs,\n   119→    });\n   120→\n   121→    this.cleanupInterval = setInterval(() => {\n   122→      this.rateLimiter.cleanup();\n   123→    }, this.config.rateLimitWindowMs);\n   124→\n   125→    // Create RemoteMcpToolsProvider instances (to reference remote tools)\n   126→    if (config.mcpEndpoints && config.mcpEndpoints.length > 0) {\n   127→      this.mcpEndpoints = config.mcpEndpoints.map(endpoint => new RemoteMcpToolsProvider(endpoint));\n   128→      logger.info('[MCP] Created remote MCP instances', {\n   129→        count: this.mcpEndpoints.length,\n   130→        endpoints: this.mcpEndpoints.map(e => e.getUrl()),\n   131→      });\n   132→    }\n   133→\n   134→    // Initialize plugins\n   135→    this.plugins = config.plugins ?? [];\n   136→    this.initializePlugins();\n   137→\n   138→    // Create HTTP server for health checks\n   139→    this.httpServer = createServer((req, res) => {\n   140→      if (req.url === '/health') {\n   141→        res.writeHead(200, { 'Content-Type': 'application/json' });\n   142→        res.end(JSON.stringify({ status: 'ok' }));\n   143→      } else {\n   144→        res.writeHead(404);\n   145→        res.end();\n   146→      }\n   147→    });\n   148→\n   149→    // Attach Socket.IO server to HTTP server\n   150→    this.io = new SocketIOServer(this.httpServer, {\n   151→      cors: {\n   152→        origin: '*',\n   153→        methods: ['GET', 'POST']\n   154→      },\n   155→      allowUpgrades: true,\n   156→      transports: ['polling', 'websocket']\n   157→    });\n   158→    this.httpServer.listen(this.config.port);\n   159→    this.setupSocketIOServer();\n   160→\n   161→    if (this.rateLimiter.isEnabled()) {\n   162→      logger.info('Rate limiting enabled', {\n   163→        maxRequests: this.config.rateLimitMaxRequests,\n   164→        windowMs: this.config.rateLimitWindowMs,\n   165→      });\n   166→    }\n   167→  }\n   168→\n   169→  /**\n   170→   * Initializes the server by fetching MCP tools from all endpoints.\n   171→   * Must be called before the server starts accepting connections.\n   172→   */\n   173→  async initialize(): Promise<void> {\n   174→    // Initialize all MCP endpoints (fetch tools)\n   175→    if (this.mcpEndpoints.length > 0) {\n   176→      logger.info('[MCP] Initializing MCP endpoints', { count: this.mcpEndpoints.length });\n   177→\n   178→      const results = await Promise.allSettled(\n   179→        this.mcpEndpoints.map(endpoint => endpoint.initialize())\n   180→      );\n   181→\n   182→      // Log results\n   183→      const successful = results.filter(r => r.status === 'fulfilled').length;\n   184→      const failed = results.filter(r => r.status === 'rejected').length;\n   185→\n   186→      if (failed > 0) {\n   187→        logger.warn('[MCP] Some endpoints failed to initialize', { successful, failed });\n   188→      } else {\n   189→        logger.info('[MCP] All endpoints initialized successfully', { count: successful });\n   190→      }\n   191→    }\n   192→  }\n   193→\n   194→  /**\n   195→   * Initialize all plugins by calling their registerHandlers method.\n   196→   * This allows plugins to register custom message handlers.\n   197→   */\n   198→  private initializePlugins() {\n   199→    for (const plugin of this.plugins) {\n   200→      logger.info('Initializing plugin', { pluginName: plugin.getName() });\n   201→\n   202→      plugin.registerHandlers({\n   203→        registerMessageHandler: this.registerMessageHandler.bind(this),\n   204→      });\n   205→    }\n   206→  }\n   207→\n   208→  /**\n   209→   * Register a custom message handler for a specific message type.\n   210→   * Used by plugins to handle custom message types.\n   211→   *\n   212→   * @param type - The message type to handle (e.g., 'run_workflow')\n   213→   * @param handler - The handler function to call when this message type is received\n   214→   */\n   215→  public registerMessageHandler(type: string, handler: MessageHandler): void {\n   216→    if (this.messageHandlers.has(type)) {\n   217→      logger.warn('Overwriting existing message handler', { type });\n   218→    }\n   219→\n   220→    this.messageHandlers.set(type, handler);\n   221→    logger.debug('Registered message handler', { type });\n   222→  }\n   223→\n   224→  private setupSocketIOServer() {\n   225→    this.io.on('connection', (socket: Socket) => {\n   226→      const clientId = `client-${++this.clientIdCounter}`;\n   227→      const threadId = uuidv4();\n   228→      const ipAddress = socket.handshake.address || socket.id;\n   229→      const transport = socket.conn.transport.name;\n   230→      logger.info('Client connected', { clientId, threadId, ipAddress, transport });\n   231→\n   232→      // Log transport upgrades\n   233→      socket.conn.on('upgrade', (transport) => {\n   234→        logger.info('Client upgraded transport', { clientId, transport: transport.name });\n   235→      });\n   236→\n   237→      const session: ClientSession = {\n   238→        clientId,\n   239→        ipAddress,\n   240→        socket,\n   241→        threadId,\n   242→        tools: [],\n   243→        state: null,\n   244→        conversationHistory: [],\n   245→        pendingToolCalls: new Map(),\n   246→      };\n   247→\n   248→      this.clients.set(socket.id, session);\n   249→\n   250→      // Send available agents to client\n   251→      const availableAgents = Object.entries(this.agents).map(([id, agent]) => ({\n   252→        id,\n   253→        name: agent.getName?.() || id,\n   254→      }));\n   255→      socket.emit('agents', {\n   256→        agents: availableAgents,\n   257→        defaultAgent: this.defaultAgentId,\n   258→      });\n   259→\n   260→      // Call plugin lifecycle hooks\n   261→      for (const plugin of this.plugins) {\n   262→        plugin.onClientConnect?.(session);\n   263→      }\n   264→\n   265→      socket.on('message', async (message: UseAIClientMessage) => {\n   266→        try {\n   267→          await this.handleClientMessage(socket, message);\n   268→        } catch (error) {\n   269→          logger.error('Error handling message', {\n   270→            error: error instanceof Error ? error.message : 'Unknown error',\n   271→            clientId,\n   272→          });\n   273→          this.sendEvent(socket, {\n   274→            type: EventType.RUN_ERROR,\n   275→            message: error instanceof Error ? error.message : 'Unknown error',\n   276→            timestamp: Date.now(),\n   277→          });\n   278→        }\n   279→      });\n   280→\n   281→      socket.on('disconnect', () => {\n   282→        logger.info('Client disconnected', { clientId, ipAddress });\n   283→\n   284→        // Call plugin lifecycle hooks\n   285→        for (const plugin of this.plugins) {\n   286→          plugin.onClientDisconnect?.(session);\n   287→        }\n   288→\n   289→        // Note: Rate limiting persists by IP address across connections\n   290→        this.clients.delete(socket.id);\n   291→      });\n   292→    });\n   293→\n   294→    logger.info('UseAI server listening', { port: this.config.port });\n   295→  }\n   296→\n   297→  private async handleClientMessage(socket: Socket, message: UseAIClientMessage) {\n   298→    const session = this.clients.get(socket.id);\n   299→    if (!session) return;\n   300→\n   301→    // Check if a plugin has registered a handler for this message type\n   302→    const pluginHandler = this.messageHandlers.get(message.type);\n   303→    if (pluginHandler) {\n   304→      await pluginHandler(session, message);\n   305→      return;\n   306→    }\n   307→\n   308→    // Core message handlers\n   309→    switch (message.type) {\n   310→      case 'run_agent':\n   311→        await this.handleRunAgent(session, message as RunAgentMessage);\n   312→        break;\n   313→      case 'tool_result':\n   314→        this.handleToolResult(session, message as ToolResultMessage);\n   315→        break;\n   316→      case 'abort_run':\n   317→        this.handleAbortRun(session, message as AbortRunMessage);\n   318→        break;\n   319→      default:\n   320→        logger.warn('Unknown message type', { type: message.type });\n   321→    }\n   322→  }\n   323→\n   324→  private async handleRunAgent(session: ClientSession, message: RunAgentMessage) {\n   325→    const { threadId, runId, messages, tools, state, context, forwardedProps } = message.data;\n   326→\n   327→    // Extract use-ai extensions from forwardedProps (AG-UI extension point)\n   328→    const mcpHeaders = forwardedProps?.mcpHeaders as import('@meetsmore/use-ai-core').McpHeadersMap | undefined;\n   329→    const requestedAgent = forwardedProps?.agent as string | undefined;\n   330→\n   331→    // Select agent: use requested agent if valid, otherwise fall back to default\n   332→    let selectedAgent = this.agent;\n   333→    if (requestedAgent) {\n   334→      const agent = this.agents[requestedAgent];\n   335→      if (agent) {\n   336→        selectedAgent = agent;\n   337→        logger.debug('Using requested agent', { agent: requestedAgent });\n   338→      } else {\n   339→        const availableAgents = Object.keys(this.agents);\n   340→        logger.warn('Requested agent not found', {\n   341→          requested: requestedAgent,\n   342→          available: availableAgents,\n   343→        });\n   344→        this.sendEvent(session.socket, {\n   345→          type: EventType.RUN_ERROR,\n   346→          message: `Agent \"${requestedAgent}\" not found. Available agents: ${availableAgents.join(', ')}`,\n   347→          timestamp: Date.now(),\n   348→        });\n   349→        return;\n   350→      }\n   351→    }\n   352→\n   353→    // Rate limiting by IP address\n   354→    const rateLimitCheck = this.rateLimiter.checkLimit(session.ipAddress);\n   355→    if (!rateLimitCheck.allowed) {\n   356→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   357→      this.sendEvent(session.socket, {\n   358→        type: EventType.RUN_ERROR,\n   359→        message: `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`,\n   360→        timestamp: Date.now(),\n   361→      });\n   362→      return;\n   363→    }\n   364→\n   365→    // Update session\n   366→    // If threadId changed, clear conversation history (new chat started)\n   367→    if (session.threadId && session.threadId !== threadId) {\n   368→      logger.info('ThreadId changed, clearing conversation history', {\n   369→        oldThreadId: session.threadId,\n   370→        newThreadId: threadId,\n   371→      });\n   372→      session.conversationHistory = [];\n   373→    }\n   374→    session.threadId = threadId;\n   375→    session.currentRunId = runId;\n   376→\n   377→    // Store MCP headers for this request (will be cleared after run completes)\n   378→    session.currentMcpHeaders = mcpHeaders;\n   379→\n   380→    // Merge client tools with MCP tools from all endpoints\n   381→    const clientTools = tools.map(t => ({\n   382→      ...t,\n   383→      parameters: t.parameters || { type: 'object', properties: {}, required: [] },\n   384→    })) as ToolDefinition[];\n   385→\n   386→    // Get tools from all MCP endpoints\n   387→    const mcpTools: RemoteToolDefinition[] = this.mcpEndpoints.flatMap(endpoint => endpoint.getTools());\n   388→\n   389→    // Merge: client tools + MCP tools\n   390→    session.tools = [...clientTools, ...mcpTools];\n   391→\n   392→    if (mcpTools.length > 0) {\n   393→      logger.debug('[MCP] Merged tools', {\n   394→        clientTools: clientTools.length,\n   395→        mcpTools: mcpTools.length,\n   396→        total: session.tools.length,\n   397→      });\n   398→    }\n   399→\n   400→    session.state = state;\n   401→\n   402→    // Types for AG-UI content blocks\n   403→    type ContentBlock = { type: 'text'; text: string } | { type: string; [key: string]: unknown };\n   404→    type MessageContent = string | ContentBlock[] | Record<string, unknown> | undefined;\n   405→\n   406→    // Type guard for tool messages with additional properties\n   407→    type ToolMessage = Message & {\n   408→      role: 'tool';\n   409→      tool_call_id?: string;\n   410→      tool_name?: string;\n   411→      toolCallId?: string;\n   412→      toolName?: string;\n   413→    };\n   414→\n   415→    const isToolMessage = (msg: Message): msg is ToolMessage => {\n   416→      return msg.role === 'tool';\n   417→    };\n   418→\n   419→    // Helper to convert content to string if it's an array (AG-UI format)\n   420→    const getStringContent = (content: MessageContent): string => {\n   421→      if (!content) return '';\n   422→      if (typeof content === 'string') return content;\n   423→      // If it's an array, extract text from text blocks\n   424→      if (Array.isArray(content)) {\n   425→        return content\n   426→          .filter((block): block is { type: 'text