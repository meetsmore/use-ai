history management:\n   479→    // - The client sends ALL messages it knows about (user + assistant messages from past turns)\n   480→    // - The server maintains the authoritative history including tool results\n   481→    // - We only append NEW user messages to avoid duplicates\n   482→    if (session.conversationHistory.length === 0) {\n   483→      // First run: initialize conversation history with incoming messages\n   484→      session.conversationHistory = incomingMessages;\n   485→    } else {\n   486→      // Subsequent runs: only append NEW user messages that aren't already in the history\n   487→      // Count how many user messages we already have\n   488→      const existingUserMessageCount = session.conversationHistory.filter(msg => msg.role === 'user').length;\n   489→      const incomingUserMessages = incomingMessages.filter(msg => msg.role === 'user');\n   490→\n   491→      // Only append user messages beyond what we already have\n   492→      const newUserMessages = incomingUserMessages.slice(existingUserMessageCount);\n   493→\n   494→      // Append only new user messages to preserve the full conversation context\n   495→      session.conversationHistory.push(...newUserMessages);\n   496→    }\n   497→\n   498→    // Build system prompt\n   499→    const systemPrompt = this.buildSystemPrompt(session, state);\n   500→\n   501→    // Create event emitter that forwards all events to client\n   502→    const eventEmitter: EventEmitter = {\n   503→      emit: <T extends AGUIEvent>(event: T) => {\n   504→        this.sendEvent(session.socket, event);\n   505→      },\n   506→    };\n   507→\n   508→    // Delegate to selected agent\n   509→    try {\n   510→      await selectedAgent.run(\n   511→        {\n   512→          session,\n   513→          runId,\n   514→          messages: session.conversationHistory,\n   515→          tools: session.tools,\n   516→          state,\n   517→          systemPrompt,\n   518→          originalInput: message.data,\n   519→        },\n   520→        eventEmitter\n   521→      );\n   522→    } finally {\n   523→      // Clear MCP headers after run completes (success or failure)\n   524→      delete session.currentMcpHeaders;\n   525→    }\n   526→  }\n   527→\n   528→  private buildSystemPrompt(session: ClientSession, state: unknown): string | undefined {\n   529→    const parts: string[] = [];\n   530→\n   531→    // Add state context if available\n   532→    if (state) {\n   533→      parts.push('You are interacting with a web application. Here is the current state:');\n   534→      parts.push('');\n   535→      parts.push(JSON.stringify(state, null, 2));\n   536→      parts.push('');\n   537→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   538→    }\n   539→\n   540→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   541→    if (confirmationTools.length > 0) {\n   542→      if (parts.length > 0) {\n   543→        parts.push('');\n   544→      }\n   545→      parts.push('CRITICAL: The following tools require user confirmation EVERY TIME before execution:');\n   546→      parts.push('');\n   547→      confirmationTools.forEach(tool => {\n   548→        parts.push(`- ${tool.name}`);\n   549→      });\n   550→      parts.push('');\n   551→      parts.push('MANDATORY CONFIRMATION WORKFLOW:');\n   552→      parts.push('1. First, explain to the user exactly what changes will be made');\n   553→      parts.push('2. Then, explicitly ask: \"Do you want me to proceed?\" or similar confirmation question');\n   554→      parts.push('3. STOP and WAIT for the user to respond with explicit confirmation');\n   555→      parts.push('4. ONLY after receiving confirmation, call the tool');\n   556→      parts.push('');\n   557→      parts.push('NEVER ASSUME CONFIRMATION:');\n   558→      parts.push('- Do NOT call these tools without receiving explicit confirmation');\n   559→      parts.push('- Each destructive operation requires its own separate confirmation');\n   560→    }\n   561→\n   562→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   563→  }\n   564→\n   565→  private handleToolResult(session: ClientSession, message: ToolResultMessage) {\n   566→    const { toolCallId, content } = message.data;\n   567→    const resolver = session.pendingToolCalls.get(toolCallId);\n   568→\n   569→    if (resolver) {\n   570→      resolver(content);\n   571→      session.pendingToolCalls.delete(toolCallId);\n   572→    }\n   573→  }\n   574→\n   575→  private handleAbortRun(session: ClientSession, message: AbortRunMessage) {\n   576→    const { runId } = message.data;\n   577→    // Clear pending tool calls for this run\n   578→    session.pendingToolCalls.clear();\n   579→    session.currentRunId = undefined;\n   580→\n   581→    logger.info('Run aborted', { clientId: session.clientId, runId });\n   582→  }\n   583→\n   584→  private sendEvent<T = unknown>(socket: Socket, event: T) {\n   585→    if (socket.connected) {\n   586→      socket.emit('event', event);\n   587→    }\n   588→  }\n   589→\n   590→  /**\n   591→   * Closes the server and cleans up resources.\n   592→   * Stops accepting new connections and terminates all existing connections.\n   593→   */\n   594→  public close() {\n   595→    clearInterval(this.cleanupInterval);\n   596→\n   597→    // Clean up all MCP endpoints\n   598→    this.mcpEndpoints.forEach(endpoint => endpoint.destroy());\n   599→\n   600→    this.io.close();\n   601→    this.httpServer.close();\n   602→  }\n   603→}\n   604→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
