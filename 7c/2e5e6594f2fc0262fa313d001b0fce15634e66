rgs: string;\n   113→  }> = new Map();\n   114→\n   115→  /**\n   116→   * Creates a new UseAI client instance.\n   117→   *\n   118→   * @param serverUrl - The WebSocket URL of the UseAI server\n   119→   */\n   120→  constructor(private serverUrl: string) {}\n   121→\n   122→  /**\n   123→   * Establishes a Socket.IO connection to the server.\n   124→   * Automatically sets up reconnection logic on disconnect.\n   125→   *\n   126→   * @returns Promise that resolves when connected\n   127→   * @throws Error if connection fails\n   128→   */\n   129→  connect(): Promise<void> {\n   130→    return new Promise((resolve, reject) => {\n   131→      try {\n   132→        this.socket = io(this.serverUrl, {\n   133→          transports: ['polling', 'websocket'],\n   134→          reconnection: true,\n   135→          reconnectionAttempts: this.maxReconnectAttempts,\n   136→          reconnectionDelay: this.reconnectDelay,\n   137→        });\n   138→\n   139→        this.socket.on('connect', () => {\n   140→          console.log('Connected to UseAI server');\n   141→          console.log('Transport:', this.socket?.io?.engine?.transport?.name);\n   142→          this.reconnectAttempts = 0;\n   143→\n   144→          // Listen for transport upgrades (only if engine is available)\n   145→          const engine = this.socket?.io?.engine;\n   146→          if (engine) {\n   147→            engine.on('upgrade', (transport: { name: string }) => {\n   148→              console.log('🚀 Upgraded to transport:', transport.name);\n   149→            });\n   150→\n   151→            engine.on('upgradeError', (err: { message: string }) => {\n   152→              console.warn('⚠️  Upgrade error:', err.message);\n   153→            });\n   154→          }\n   155→\n   156→          resolve();\n   157→        });\n   158→\n   159→        this.socket.on('event', (aguiEvent: AGUIEvent) => {\n   160→          try {\n   161→            console.log('[Client] Received event:', aguiEvent.type);\n   162→            this.handleEvent(aguiEvent);\n   163→          } catch (error) {\n   164→            console.error('Error handling event:', error);\n   165→          }\n   166→        });\n   167→\n   168→        // Listen for available agents from server\n   169→        this.socket.on('agents', (data: { agents: AgentInfo[]; defaultAgent: string }) => {\n   170→          console.log('[Client] Received available agents:', data);\n   171→          this._availableAgents = data.agents;\n   172→          this._defaultAgent = data.defaultAgent;\n   173→          // Notify listeners\n   174→          this.agentsChangeHandlers.forEach(handler => handler(data.agents, data.defaultAgent));\n   175→        });\n   176→\n   177→        this.socket.on('connect_error', (error) => {\n   178→          console.error('Socket.IO connection error:', error);\n   179→          reject(error);\n   180→        });\n   181→\n   182→        this.socket.on('disconnect', (reason) => {\n   183→          console.log('Disconnected from UseAI server:', reason);\n   184→        });\n   185→      } catch (error) {\n   186→        reject(error);\n   187→      }\n   188→    });\n   189→  }\n   190→\n   191→\n   192→  private handleEvent(event: AGUIEvent) {\n   193→    // Track assistant message lifecycle for conversation history\n   194→    if (event.type === EventType.RUN_STARTED) {\n   195→      // Start of a new assistant response - initialize message\n   196→      this._currentAssistantMessage = {\n   197→        id: uuidv4(),\n   198→        role: 'assistant' as const,\n   199→        content: '',\n   200→      };\n   201→      this._currentAssistantToolCalls = [];\n   202→    }\n   203→\n   204→    // Handle text message streaming\n   205→    if (event.type === EventType.TEXT_MESSAGE_START) {\n   206→      const e = event as TextMessageStartEvent;\n   207→      this._currentMessageId = e.messageId;\n   208→      this._currentMessageContent = '';\n   209→    } else if (event.type === EventType.TEXT_MESSAGE_CONTENT) {\n   210→      const e = event as TextMessageContentEvent;\n   211→      this._currentMessageContent += e.delta;\n   212→    } else if (event.type === EventType.TEXT_MESSAGE_END) {\n   213→      // Message complete - store content in assistant message\n   214→      if (this._currentAssistantMessage) {\n   215→        this._currentAssistantMessage.content = this._currentMessageContent;\n   216→      }\n   217→      this._currentMessageId = null;\n   218→    }\n   219→\n   220→    // Handle tool call streaming\n   221→    else if (event.type === EventType.TOOL_CALL_START) {\n   222→      const e = event as ToolCallStartEvent;\n   223→      this.currentToolCalls.set(e.toolCallId, {\n   224→        name: e.toolCallName,\n   225→        args: '',\n   226→      });\n   227→    } else if (event.type === EventType.TOOL_CALL_ARGS) {\n   228→      const e = event as ToolCallArgsEvent;\n   229→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   230→      if (toolCall) {\n   231→        toolCall.args += e.delta;\n   232→      }\n   233→    } else if (event.type === EventType.TOOL_CALL_END) {\n   234→      // Tool call args complete - add to assistant message\n   235→      const e = event as ToolCallEndEvent;\n   236→      const toolCall = this.currentToolCalls.get(e.toolCallId);\n   237→      if (toolCall) {\n   238→        this._currentAssistantToolCalls.push({\n   239→          id: e.toolCallId,\n   240→          type: 'function',\n   241→          function: {\n   242→            name: toolCall.name,\n   243→            arguments: toolCall.args,\n   244→          },\n   245→        });\n   246→      }\n   247→    }\n   248→\n   249→    // Handle run completion - finalize assistant message\n   250→    else if (event.type === EventType.RUN_FINISHED) {\n   251→      // Add completed assistant message to conversation history\n   252→      if (this._currentAssistantMessage) {\n   253→        const assistantMessage: AssistantMessageWithTools = {\n   254→          id: this._currentAssistantMessage.id!,\n   255→          role: 'assistant',\n   256→          content: this._currentAssistantMessage.content || '',\n   257→        };\n   258→\n   259→        // Add tool calls if any\n   260→        if (this._currentAssistantToolCalls.length > 0) {\n   261→          assistantMessage.toolCalls = this._currentAssistantToolCalls;\n   262→        }\n   263→\n   264→        this._messages.push(assistantMessage);\n   265→\n   266→        // Reset for next message\n   267→        this._currentAssistantMessage = null;\n   268→        this._currentAssistantToolCalls = [];\n   269→      }\n   270→    }\n   271→\n   272→    // Notify all registered handlers\n   273→    this.eventHandlers.forEach((handler) => handler(event));\n   274→  }\n   275→\n   276→  /**\n   277→   * Registers available tools and optional state with the server.\n   278→   * This updates the session state for future agent runs.\n   279→   *\n   280→   * @param tools - Array of tool definitions to register\n   281→   * @param state - Optional state object to provide to the AI.\n   282→   */\n   283→  registerTools(tools: ToolDefinition[], state?: unknown) {\n   284→    this._tools = tools;\n   285→    this._state = state;\n   286→  }\n   287→\n   288→  /**\n   289→   * Updates the state without re-registering tools.\n   290→   * Call this before sendPrompt to ensure the AI sees the latest UI state.\n   291→   *\n   292→   * @param state - The current state object to provide to the AI\n   293→   */\n   294→  updateState(state: unknown) {\n   295→    this._state = state;\n   296→  }\n   297→\n   298→  /**\n   299→   * Sets the MCP headers provider.\n   300→   * The provider will be called each time a message is sent to get fresh headers.\n   301→   *\n   302→   * @param provider - Function that returns MCP headers configuration\n   303→   */\n   304→  setMcpHeadersProvider(provider: () => McpHeadersMap | Promise<McpHeadersMap>) {\n   305→    this.mcpHeadersProvider = provider;\n   306→  }\n   307→\n   308→  /**\n   309→   * Sends a user prompt to the AI.\n   310→   *\n   311→   * @param prompt - The user's prompt/question\n   312→   */\n   313→  async sendPrompt(prompt: string) {\n   314→    // Add user message to conversation\n   315→    const userMessage: Message = {\n   316→      id: uuidv4(),\n   317→      role: 'user',\n   318→      content: prompt,\n   319→    };\n   320→    this._messages.push(userMessage);\n   321→\n   322→    // Get MCP headers if provider is set\n   323→    let mcpHeaders: McpHeadersMap | undefined;\n   324→    if (this.mcpHeadersProvider) {\n   325→      try {\n   326→        mcpHeaders = await this.mcpHeadersProvider();\n   327→      } catch (error) {\n   328→        console.error('[UseAIClient] Failed to get MCP headers:', error);\n   329→        // Continue without headers rather than blocking the request\n   330→      }\n   331→    }\n   332→\n   333→    // Create RunAgentInput\n   334→    const runInput: RunAgentInput = {\n   335→      threadId: this.threadId, // Use getter to ensure non-null\n   336→      runId: uuidv4(),\n   337→      messages: this._messages,\n   338→      tools: this._tools.map(t => ({\n   339→        name: t.name,\n   340→        description: t.description,\n   341→        parameters: t.parameters,\n   342→      })),\n   343→      state: this._state,\n   344→      context: [],\n   345→      forwardedProps: {\n   346→        ...(mcpHeaders ? { mcpHeaders } : {}),\n   347→        ...(this._selectedAgent ? { agent: this._selectedAgent } : {}),\n   348→      },\n   349→    };\n   350→\n   351→    this.send({\n   352→      type: 'run_agent',\n   353→      data: runInput,\n   354→    });\n   355→  }\n   356→\n   357→  /**\n   358→   * Sends the result of a tool execution back to the server.\n   359→   *\n   360→   * @param toolCallId - The ID of the tool call being responded to\n   361→   * @param result - The result returned by the tool execution\n   362→   * @param state - Optional updated state to send back to the AI\n   363→   */\n   364→  sendToolResponse(toolCallId: string, result: unknown, state?: unknown) {\n   365→    // Update session state if provided\n   366→    if (state !== undefined) {\n   367→      this._state = state;\n   368→    }\n   369→\n   370→    const toolResultMessage: ToolResultMessage = {\n   371→      type: 'tool_result',\n   372→      data: {\n   373→        messageId: uuidv4(),\n   374→        toolCallId,\n   375→        content: JSON.stringify(result),\n   376→        role: 'tool',\n   377→      },\n   378→    };\n   379→\n   380→    // Track tool result in conversation history\n   381→    const toolResultMsg: ToolResultMessageData = {\n   382→      id: toolResultMessage.data.messageId,\n   383→      role: 'tool',\n   384→      content: toolResultMessage.data.content,\n   385→      toolCallId,\n   386→    };\n   387→    this._messages.push(toolResultMsg);\n   388→\n   389→    this.send(toolResultMessage);\n   390→  }\n   391→\n   392→  /**\n   393→   * Retrieves accumulated tool call data for a specific tool call ID.\n   394→   * Used to get the complete tool name and arguments after they've been streamed\n   395→   * across multiple TOOL_CALL_ARGS events.\n   396→   *\n   397→   * @param toolCallId - The ID of the tool call\n   398→   * @returns Object with tool name and accumulated arguments, or undefined if not found\n   399→   */\n   400→  getToolCallData(toolCallId: string): { name: string; args: string } | undefined {\n   401→    return this.currentToolCalls.get(toolCallId);\n   402→  }\n   403→\n   404→  /**\n   405→   * Registers an AG-UI event handler for receiving server events.\n   406→   *\n   407→   * @param id - Unique identifier for this handler\n   408→   * @param handler - Callback function to handle incoming AG-UI events\n   409→   * @returns Cleanup function to unregister the handler\n   410→   */\n   411→  onEvent(id: string, handler: AGUIEventHandler) {\n   412→    this.eventHandlers.set(id, handler);\n   413→    return () => {\n   414→      this.eventHandlers.delete(id);\n   415→    };\n   416→  }\n   417→\n   418→  /**\n   419→   * Helper method to listen for text message content.\n   420→   * Aggregates TEXT_MESSAGE_CONTENT events and calls handler with complete messages.\n   421→   *\n   422→   * @param handler - Callback function to handle complete text messages\n   423→   * @returns Cleanup function\n   424→   */\n   425→  onTextMessage(handler: MessageHandler): () => void {\n   426→    return this.onEvent('text-message-handler', (event) => {\n   427→      if (event.type === EventType.TEXT_MESSAGE_END && this._currentMessageContent) {\n   428→        handler(this._currentMessageContent);\n   429→      }\n   430→    });\n   431→  }\n   432→\n   433→  /**\n   434→   * Helper method to listen for tool call requests.\n   435→   * Aggregates TOOL_CALL_* events and calls handler with complete tool calls.\n   436→   *\n   437→   * @param handler - Callback function to handle tool calls\n   438→   * @returns Cleanup function\n   439→   */\n   440→  onToolCall(handler: ToolCallHandler): () => void {\n   441→    return this.onEvent('tool-call-handler', (event) => {\n   442→      if (event.type === EventType.TOOL_CALL_END) {\n   443→        const e = event as ToolCallEndEvent;\n   444→        const toolCall = this.currentToolCalls.get(e.toolCallId);\n   445→        if (toolCall) {\n   446→          try {\n   447→            const args = JSON.parse(toolCall.args);\n   448→            handler(e.toolCallId, toolCall.name, args);\n   449→            this.currentToolCalls.delete(e.toolCallId);\n   450→          } catch (error) {\n   451→            console.error('Error parsing tool call args:', error);\n   452→          }\n   453→        }\n   454→      }\n   455→    });\n   456→  }\n   457→\n   458→  /**\n   459→   * Gets the current accumulated message content (useful during streaming).\n   460→   */\n   461→  get currentMessageContent(): string {\n   462→    return this._currentMessageContent;\n   463→  }\n   464→\n   465→  /**\n   466→   * Gets the current thread ID for this session.\n   467→   * Generates a new one if not set.\n   468→   */\n   469→  get threadId(): string {\n   470→    if (!this._threadId) {\n   471→      this._threadId = uuidv4();\n   472→    }\n   473→    return this._threadId;\n   474→  }\n   475→\n   476→  /**\n   477→   * Gets the current conversation messages.\n   478→   */\n   479→  get messages(): Message[] {\n   480→    return this._messages;\n   481→  }\n   482→\n   483→  /**\n   484→   * Gets the current state.\n   485→   */\n   486→  get state(): unknown {\n   487→    return this._state;\n   488→  }\n   489→\n   490→  /**\n   491→   * Gets the list of available agents from the server.\n   492→   */\n   493→  get availableAgents(): AgentInfo[] {\n   494→    return this._availableAgents;\n   495→  }\n   496→\n   497→  /**\n   498→   * Gets the default agent ID from the server.\n   499→   */\n   500→  get defaultAgent(): string | null {\n   501→    return this._defaultAgent;\n   502→  }\n   503→\n   504→  /**\n   505→   * Gets the currently selected agent ID.\n   506→   * Returns null if using server default.\n   507→   */\n   508→  get selectedAgent(): string | null {\n   509→    return this._selectedAgent;\n   510→  }\n   511→\n   512→  /**\n   513→   * Gets the effective agent ID (selected or default).\n   514→   */\n   515→  get currentAgent(): string | null {\n   516→    return this._selectedAgent ?? this._defaultAgent;\n   517→  }\n   518→\n   519→  /**\n   520→   * Sets the agent to use for requests.\n   521→   * Pass null to use the server default.\n   522→   *\n   523→   * @param agentId - The agent ID to use, or null for server default\n   524→   */\n   525→  setAgent(agentId: string | null) {\n   526→    this._selectedAgent = agentId;\n   527→    console.log('[Client] Agent set to:', agentId ?? 'server default');\n   528→  }\n   529→\n   530→  /**\n   531→   * Subscribes to agent changes (when server sends available agents).\n   532→   *\n   533→   * @param handler - Callback function receiving agents list and default agent\n   534→   * @returns Cleanup function to unsubscribe\n   535→   */\n   536→  onAgentsChange(handler: (agents: AgentInfo[], defaultAgent: string | null) => void): () => void {\n   537→    this.agentsChangeHandlers.add(handler);\n   538→    // Immediately call with current values if available\n   539→    if (this._availableAgents.length > 0) {\n   540→      handler(this._availableAgents, this._defaultAgent);\n   541→    }\n   542→    return () => {\n   543→      this.agentsChangeHandlers.delete(handler);\n   544→    };\n   545→  }\n   546→\n   547→  /**\n   548→   * Sets the thread ID for this session.\n   549→   * When the thread ID changes, conversation state is cleared to prevent history bleeding.\n   550→   * Use this when switching between different chat conversations.\n   551→   *\n   552→   * @param threadId - The thread/chat ID to use (typically the chatId)\n   553→   */\n   554→  setThreadId(threadId: string) {\n   555→    if (this._threadId !== threadId) {\n   556→      console.log('[Client] ThreadId changed, clearing conversation state', {\n   557→        oldThreadId: this._threadId,\n   558→        newThreadId: threadId,\n   559→      });\n   560→\n   561→      // Clear conversation state when switching threads\n   562→      this._messages = [];\n   563→      this._currentMessageContent = '';\n   564→      this._currentMessageId = null;\n   565→      this.currentToolCalls.clear();\n   566→      this._currentAssistantMessage = null;\n   567→      this._currentAssistantToolCalls = [];\n   568→    }\n   569→    this._threadId = threadId;\n   570→  }\n   571→\n   572→  /**\n   573→   * Loads messages into the conversation history (for resuming from storage).\n   574→   * @param messages - Array of messages to load\n   575→   */\n   576→  loadMessages(messages: Message[]) {\n   577→    this._messages = messages;\n   578→  }\n   579→\n   580→  /**\n   581→   * Clears the conversation history and resets the thread.\n   582→   */\n   583→  clearConversation() {\n   584→    this._messages = [];\n   585→    this._threadId = null;\n   586→    this._currentMessageContent = '';\n   587→    this._currentMessageId = null;\n   588→    this.currentToolCalls.clear();\n   589→    this._currentAssistantMessage = null;\n   590→    this._currentAssistantToolCalls = [];\n   591→  }\n   592→\n   593→  send(message: UseAIClientMessage) {\n   594→    if (this.socket && this.socket.connected) {\n   595→      this.socket.emit('message', message);\n   596→    } else {\n   597→      console.error('Socket.IO is not connected');\n   598→    }\n   599→  }\n   600→\n   601→  /**\n   602→   * Closes the Socket.IO connection to the server.\n   603→   */\n   604→  disconnect() {\n   605→    if (this.socket) {\n   606→      this.socket.disconnect();\n   607→      this.socket = null;\n   608→    }\n   609→  }\n   610→\n   611→  /**\n   612→   * Checks if the client is currently connected to the server.\n   613→   *\n   614→   * @returns true if connected, false otherwise\n   615→   */\n   616→  isConnected(): boolean {\n   617→    return this.socket !== null && this.socket.connected;\n   618→  }\n   619→}\n   620→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
