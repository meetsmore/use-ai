estComponent />\n        </UseAIProvider>\n      );\n\n      await waitFor(() => {\n        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'tool_call',\n          data: {\n            toolCallId: 'call-123',\n            name: 'addTodo',\n            input: { text: 'Buy groceries' },\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(mockFn).toHaveBeenCalledWith({ text: 'Buy groceries' });\n      });\n    });\n  });\n\n  describe('2. A component can put its state in \"prompt\" to provide current state to the AI', () => {\n    it('should send component state as context when prompt option is provided', async () => {\n      const addTodo = defineTool(\n        'Add a todo',\n        z.object({ text: z.string() }),\n        () => ({ success: true })\n      );\n\n      const TestComponent = () => {\n        const tools = useStableTools({ addTodo });\n        const currentState = 'Current todos: Buy milk, Walk dog';\n        useAI({ tools, prompt: currentState });\n        return null;\n      };\n\n      render(\n        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n          <TestComponent />\n        </UseAIProvider>\n      );\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const registerMessage = ws?.sentMessages.find((msg) => msg.type === 'register_tools');\n        expect(registerMessage).toBeDefined();\n        expect(registerMessage.data.context).toBeDefined();\n        expect(registerMessage.data.context).toContain('Current todos: Buy milk, Walk dog');\n      });\n    });\n\n    it('should update context when component state changes', async () => {\n      const addTodo = defineTool(\n        'Add a todo',\n        z.object({ text: z.string() }),\n        () => ({ success: true })\n      );\n\n      let stateVersion = 0