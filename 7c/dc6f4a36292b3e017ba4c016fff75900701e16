wMs,\n    52→    });\n    53→\n    54→    this.cleanupInterval = setInterval(() => {\n    55→      this.rateLimiter.cleanup();\n    56→    }, this.config.rateLimitWindowMs);\n    57→\n    58→    this.wss = new WebSocketServer({ port: this.config.port });\n    59→    this.setupWebSocketServer();\n    60→\n    61→    if (this.rateLimiter.isEnabled()) {\n    62→      console.log(`Rate limiting enabled: ${this.config.rateLimitMaxRequests} requests per ${this.config.rateLimitWindowMs}ms`);\n    63→    }\n    64→  }\n    65→\n    66→  private setupWebSocketServer() {\n    67→    this.wss.on('connection', (ws: WebSocket) => {\n    68→      const clientId = `client-${++this.clientIdCounter}`;\n    69→      console.log(`Client connected: ${clientId}`);\n    70→\n    71→      const session: ClientSession = {\n    72→        clientId,\n    73→        ws,\n    74→        tools: [],\n    75→        conversationHistory: [],\n    76→        pendingToolCalls: new Map(),\n    77→      };\n    78→\n    79→      this.clients.set(ws, session);\n    80→\n    81→      ws.on('message', async (data: Buffer) => {\n    82→        try {\n    83→          const message: ClientMessage = JSON.parse(data.toString());\n    84→          await this.handleClientMessage(ws, message);\n    85→        } catch (error) {\n    86→          console.error('Error handling message:', error);\n    87→          this.sendError(ws, error instanceof Error ? error.message : 'Unknown error');\n    88→        }\n    89→      });\n    90→\n    91→      ws.on('close', () => {\n    92→        console.log(`Client disconnected: ${clientId}`);\n    93→        this.rateLimiter.removeClient(clientId);\n    94→        this.clients.delete(ws);\n    95→      });\n    96→    });\n    97→\n    98→    console.log(`UseAI server listening on port ${this.config.port}`);\n    99→  }\n   100→\n   101→  private async handleClientMessage(ws: WebSocket, message: ClientMessage) {\n   102→    const session = this.clients.get(ws);\n   103→    if (!session) return;\n   104→\n   105→    switch (message.type) {\n   106→      case 'register_tools':\n   107→        this.handleRegisterTools(session, message as RegisterToolsMessage);\n   108→        break;\n   109→      case 'prompt':\n   110→        await this.handlePrompt(session, message as PromptMessage);\n   111→        break;\n   112→      case 'tool_response':\n   113→        this.handleToolResponse(session, message as ToolResponseMessage);\n   114→        break;\n   115→    }\n   116→  }\n   117→\n   118→  private handleRegisterTools(session: ClientSession, message: RegisterToolsMessage) {\n   119→    session.tools = message.data.tools;\n   120→    session.context = message.data.context;\n   121→    console.log(`Registered ${session.tools.length} tools for client`);\n   122→    if (session.context) {\n   123→      console.log(`Received UI context (${session.context.length} chars)`);\n   124→    }\n   125→  }\n   126→\n   127→  private buildSystemPrompt(session: ClientSession): string | undefined {\n   128→    const parts: string[] = [];\n   129→\n   130→    if (session.context) {\n   131→      parts.push('You are interacting with a web application. Here is the current state of the UI:');\n   132→      parts.push('');\n   133→      parts.push(session.context);\n   134→      parts.push('');\n   135→      parts.push('Use the available tools to interact with and modify the UI based on user requests.');\n   136→    }\n   137→\n   138→    const confirmationTools = session.tools.filter(tool => tool.confirmationRequired);\n   139→    if (confirmationTools.length > 0) {\n   140→      if (parts.length > 0) {\n   141→        parts.push('');\n   142→      }\n   143→      parts.push('IMPORTANT: The following tools require user confirmation before execution:');\n   144→      parts.push('');\n   145→      confirmationTools.forEach(tool => {\n   146→        parts.push(`- ${tool.name}`);\n   147→      });\n   148→      parts.push('');\n   149→      parts.push('Before calling any of these tools, you MUST:');\n   150→      parts.push('1. Explain to the user exactly what changes will be made');\n   151→      parts.push('2. Ask the user to confirm they want to proceed');\n   152→      parts.push('3. Only call the tool after receiving explicit confirmation from the user');\n   153→      parts.push('');\n   154→      parts.push('Never call these tools without first getting user confirmation in the same conversation turn.');\n   155→    }\n   156→\n   157→    return parts.length > 0 ? parts.join('\\n') : undefined;\n   158→  }\n   159→\n   160→  private async handlePrompt(session: ClientSession, message: PromptMessage) {\n   161→    const { prompt } = message.data;\n   162→\n   163→    const rateLimitCheck = this.rateLimiter.checkLimit(session.clientId);\n   164→    if (!rateLimitCheck.allowed) {\n   165→      const retryAfterSeconds = Math.ceil((rateLimitCheck.retryAfterMs || 0) / 1000);\n   166→      this.sendError(\n   167→        session.ws,\n   168→        `Rate limit exceeded. Please try again in ${retryAfterSeconds} seconds.`\n   169→      );\n   170→      return;\n   171→    }\n   172→\n   173→    session.conversationHistory.push({\n   174→      role: 'user',\n   175→      content: prompt,\n   176→    });\n   177→\n   178→    try {\n   179→      const systemPrompt = this.buildSystemPrompt(session);\n   180→\n   181→      const response = await this.anthropic.messages.create({\n   182→        model: this.config.model,\n   183→        max_tokens: 4096,\n   184→        messages: session.conversationHistory,\n   185→        tools: session.tools.length > 0 ? session.tools as Anthropic.Tool[] : undefined,\n   186→        system: systemPrompt,\n   187→      });\n   188→\n   189→      await this.processResponse(session, response);\n   190→    } catch (error) {\n   191→      console.error('Error calling Anthropic API:', error);\n   192→      this.sendError(session.ws, error instanceof Error ? error.message : 'Unknown error');\n   193→   