ebSocket> {\n  const ws = new WebSocket(`ws://localhost:${port}`);\n  await waitForConnection(ws);\n  return ws;\n}\n\n// Mock response helpers\nfunction createMockAnthropicMessage(\n  id: string,\n  content: Anthropic.ContentBlock[]\n): Anthropic.Message {\n  return {\n    id,\n    type: 'message',\n    role: 'assistant',\n    content,\n    model: 'claude-sonnet-4-20250514',\n    stop_reason: 'end_turn',\n    stop_sequence: null,\n    usage: {\n      input_tokens: 100,\n      output_tokens: 50,\n    },\n  };\n}\n\nfunction createTextResponse(id: string, text: string): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'text',\n      text,\n    },\n  ]);\n}\n\nfunction createToolUseResponse(\n  id: string,\n  toolCallId: string,\n  toolName: string,\n  input: Record<string, unknown>\n): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'tool_use',\n      id: toolCallId,\n      name: toolName,\n      input,\n    },\n  ]);\n}\n\nfunction createTextAfterToolResponse(id: string, text: string): Anthropic.Message {\n  return createMockAnthropicMessage(id, [\n    {\n      type: 'text',\n      text,\n    },\n  ]);\n}\n\n// Track all servers for cleanup\nconst allServers: UseAIServer[] = [];\nconst allWebSockets: WebSocket[] = [];\n\nafterAll(() => {\n  // Force cleanup of any remaining servers\n  allServers.forEach(server => {\n    try {\n      server.close();\n    } catch (e) {\n      // Ignore errors during cleanup\n    }\n  });\n\n  // Force close any remaining websockets\n  allWebSockets.forEach(ws => {\n    try {\n      if (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING) {\n        ws.close();\n      }\n    } catch (e) {\n      // Ignore errors during cleanup\n    }\n  });\n});\n\ndescribe('UseAIServer - Connection Management', () => {\n  let server: UseAIServer;\n  const testPort = 8081;\n\n  beforeAll(() => {\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('client can connect to the server', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n    expect(ws.readyState).toBe(WebSocket.OPEN);\n    ws.close();\n  });\n\n  test('server tracks multiple simultaneous client connections', async () => {\n    const ws1 = await createTestClient(testPort);\n    const ws2 = await createTestClient(testPort);\n    const ws3 = await createTestClient(testPort);\n    allWebSockets.push(ws1, ws2, ws3);\n\n    expect(ws1.readyState).toBe(WebSocket.OPEN);\n    expect(ws2.readyState).toBe(WebSocket.OPEN);\n    expect(ws3.readyState).toBe(WebSocket.OPEN);\n\n    ws1.close();\n    ws2.close();\n    ws3.close();\n  });\n\n  test('client disconnection cleans up session', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const closePromise = new Promise<void>((resolve) => {\n      ws.on('close', () => resolve());\n    });\n\n    ws.close();\n    await closePromise;\n\n    // If we can connect again with no issues, cleanup worked\n    const ws2 = await createTestClient(testPort);\n    allWebSockets.push(ws2);\n    expect(ws2.readyState).toBe(WebSocket.OPEN);\n    ws2.close();\n  });\n});\n\ndescribe('UseAIServer - Tool Registration', () => {\n  let server: UseAIServer;\n  const testPort = 8082;\n\n  beforeAll(() => {\n    server = new UseAIServer({\n      port: testPort,\n      anthropicApiKey: 'test-key',\n    });\n    allServers.push(server);\n  });\n\n  afterAll(() => {\n    server.close();\n  });\n\n  test('client can register tools with server', async () => {\n    const ws = await createTestClient(testPort);\n    allWebSockets.push(ws);\n\n    const tools: ToolDefinition[] = [\n      {\n        name: 'add_todo',\n        description: 'Add a new todo',\n        input_schema: {\n          type: 'object',\n          properties