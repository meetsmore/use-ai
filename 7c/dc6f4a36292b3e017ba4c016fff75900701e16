ter tools when individual hooks unmount', async () => {\n      const tool1 = defineTool('Tool 1', () => 'result1');\n      const tool2 = defineTool('Tool 2', () => 'result2');\n\n      function TestComponent({ showHook1 }: { showHook1: boolean }) {\n        if (showHook1) {\n          useAI({ tools: { tool1 } });\n        }\n        useAI({ tools: { tool2 } });\n        return null;\n      }\n\n      const { rerender } = render(\n        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n          <TestComponent showHook1={true} />\n        </UseAIProvider>\n      );\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const lastRegisterMessage = [...ws!.sentMessages]\n          .reverse()\n          .find(msg => msg.type === 'register_tools');\n        expect(lastRegisterMessage?.data.tools.length).toBe(2);\n      });\n\n      // Unmount first hook\n      rerender(\n        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n          <TestComponent showHook1={false} />\n        </UseAIProvider>\n      );\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const lastRegisterMessage = [...ws!.sentMessages]\n          .reverse()\n          .find(msg => msg.type === 'register_tools');\n        expect(lastRegisterMessage?.data.tools.length).toBe(1);\n      });\n    });\n  });\n\n  // Tool Namespacing Tests\n  describe('Tool Namespacing', () => {\n    it('should namespace tools when id option is provided', async () => {\n      const testTool = defineTool('Test tool', () => 'result');\n\n      renderHook(() => useAI({ tools: { testTool }, id: 'myComponent' }), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const registerMessage = ws?.sentMessages.find(msg => msg.type === 'register_tools');\n        expect(registerMessage).toBeDefined();\n        // Tool should be namespaced as \"myComponent_testTool\"\n        const toolName = registerMessage.data.tools[0].name;\n        expect(toolName).toBe('myComponent_testTool');\n      });\n    });\n\n    it('should not namespace tools when no id option is provided', async () => {\n      const testTool = defineTool('Test tool', () => 'result');\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const registerMessage = ws?.sentMessages.find(msg => msg.type === 'register_tools');\n        expect(registerMessage).toBeDefined();\n        const toolName = registerMessage.data.tools[0].name;\n        expect(toolName).toBe('testTool');\n      });\n    });\n  });\n\n  // Prompt Context Tests\n  describe('Prompt Context', () => {\n    it('should send updated context when prompt option changes', async () => {\n      function TestComponent() {\n        const [prompt, setPrompt] = useState('Initial prompt');\n        useAI({ prompt, tools: { testTool: defineTool('Test', () => 'result') } });\n\n        React.useEffect(() => {\n          setTimeout(() => setPrompt('Updated prompt'), 100);\n        }, []);\n\n        return null;\n      }\n\n      render(\n        <UseAIProvider serverUrl=\"ws://localhost:8080\">\n          <TestComponent />\n        </UseAIProvider>\n      );\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const messages = ws?.sentMessages.filter(msg => msg.type === 'register_tools');\n        // Should have at least 2 registration messages (initial + update)\n        expect(messages!.length).toBeGreaterThanOrEqual(1);\n      }, { timeout: 3000 });\n    });\n\n    it('should include component-specific prompt in tool registration', async () => {\n      const testTool = defineTool('Test tool', () => 'result');\n\n      renderHook(() => useAI({\n        tools: { testTool },\n        prompt: 'Component context prompt'\n      }), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.get