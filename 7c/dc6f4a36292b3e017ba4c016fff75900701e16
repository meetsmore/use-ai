terEach(() => {\n    // Restore original WebSocket\n    global.WebSocket = OriginalWebSocket;\n    MockWebSocket.reset();\n  });\n\n  const wrapper = ({ children }: { children: React.ReactNode }) => (\n    <UseAIProvider serverUrl=\"ws://localhost:8080\">{children}</UseAIProvider>\n  );\n\n  // Basic Functionality Tests\n  describe('Basic Functionality', () => {\n    it('should connect to the WebSocket server when provider mounts', async () => {\n      renderHook(() => useAI(), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        expect(ws).toBeDefined();\n        expect(ws?.url).toBe('ws://localhost:8080');\n      });\n    });\n\n    it('should register tools when useAI hook mounts with tools option', async () => {\n      const testTool = defineTool('Test tool', () => 'result');\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const registerMessage = ws?.sentMessages.find(msg => msg.type === 'register_tools');\n        expect(registerMessage).toBeDefined();\n        expect(registerMessage.data.tools).toBeDefined();\n        expect(registerMessage.data.tools.length).toBeGreaterThan(0);\n      });\n    });\n\n    it('should unregister tools when useAI hook unmounts', async () => {\n      const testTool = defineTool('Test tool', () => 'result');\n\n      const { unmount } = renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        expect(ws?.sentMessages.some(msg => msg.type === 'register_tools')).toBe(true);\n      });\n\n      unmount();\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const lastRegisterMessage = [...ws!.sentMessages]\n          .reverse()\n          .find(msg => msg.type === 'register_tools');\n        // After unmount, tools should be empty\n        expect(lastRegisterMessage?.data.tools).toBeDefined();\n      });\n    });\n\n    it('should send prompt to server when generate() is called', async () => {\n      const { result } = renderHook(() => useAI(), { wrapper });\n\n      await waitFor(() => {\n        expect(result.current.connected).toBe(true);\n      });\n\n      await act(async () => {\n        await result.current.generate('test prompt');\n      });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const promptMessage = ws?.sentMessages.find(msg => msg.type === 'prompt');\n        expect(promptMessage).toBeDefined();\n        expect(promptMessage.data.prompt).toBe('test prompt');\n      });\n    });\n\n    it('should receive and display response from server', async () => {\n      const { result } = renderHook(() => useAI(), { wrapper });\n\n      await waitFor(() => {\n        expect(result.current.connected).toBe(true);\n      });\n\n      await act(async () => {\n        await result.current.generate('test prompt');\n      });\n\n      // Simulate server response\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'response',\n          data: {\n            content: 'AI response',\n            conversationId: 'test-conversation',\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(result.current.response).toBe('AI response');\n        expect(result.current.loading).toBe(false);\n      });\n    });\n\n    it('should update loading state correctly during prompt/response cycle', async () => {\n      const { result } = renderHook(() => useAI(), { wrapper });\n\n      await waitFor(() => {\n        expect(result.current.connected).toBe(true);\n      });\n\n      expect(result.current.loading).toBe(false);\n\n      await act(async () => {\n        await result.current.generate('test prompt');\n      });\n\n      expect(result.current.loading).toBe(true);\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'response',\n          data: {\n            content: 'AI response',\n            conversationId: 'test-conversation',\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n    });\n  });\n\n  // Tool Execution Flow Tests\n  describe('Tool Execution Flow', () => {\n    it('should execute tool when server sends tool_call message', async () => {\n      const mockFn = mock(() => 'tool result');\n      const testTool = defineTool('Test tool', mockFn);\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'tool_call',\n          data: {\n            toolCallId: 'call-123',\n            name: 'testTool',\n            input: {},\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(mockFn).toHaveBeenCalled();\n      });\n    });\n\n    it('should send tool result back to server after tool execution', async () => {\n      const testTool = defineTool('Test tool', () => 'tool result');\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'tool_call',\n          data: {\n            toolCallId: 'call-123',\n            name: 'testTool',\n            input: {},\n          },\n        });\n      });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const toolResponseMessage = ws?.sentMessages.find(\n          msg => msg.type === 'tool_response' && msg.data.toolCallId === 'call-123'\n        );\n        expect(toolResponseMessage).toBeDefined();\n        expect(toolResponseMessage.data.result).toBe('tool result');\n      });\n    });\n\n    it('should execute tool with correct input parameters', async () => {\n      const schema = z.object({ name: z.string(), age: z.number() });\n      const mockFn = mock((input: z.infer<typeof schema>) =>\n        `${input.name} is ${input.age} years old`\n      );\n      const testTool = defineTool('Test tool', schema, mockFn);\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'tool_call',\n          data: {\n            toolCallId: 'call-123',\n            name: 'testTool',\n            input: { name: 'Alice', age: 30 },\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(mockFn).toHaveBeenCalledWith({ name: 'Alice', age: 30 });\n      });\n    });\n\n    it('should handle tool execution errors gracefully', async () => {\n      const testTool = defineTool('Test tool', () => {\n        throw new Error('Tool execution failed');\n      });\n\n      renderHook(() => useAI({ tools: { testTool } }), { wrapper });\n\n      await waitFor(() => {\n        expect(MockWebSocket.getMostRecent()?.readyState).toBe(WebSocket.OPEN);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'tool_call',\n          data: {\n            toolCallId: 'call-123',\n            name: 'testTool',\n            input: {},\n          },\n        });\n      });\n\n      await waitFor(() => {\n        const ws = MockWebSocket.getMostRecent();\n        const toolResponseMessage = ws?.sentMessages.find(\n          msg => msg.type === 'tool_response' && msg.data.toolCallId === 'call-123'\n        );\n        expect(toolResponseMessage).toBeDefined();\n        expect(toolResponseMessage.data.result.error).toBeDefined();\n      });\n    });\n  });\n\n  // Error Handling Tests\n  describe('Error Handling', () => {\n    it('should handle server error messages and call onError callback', async () => {\n      const onError = mock((error: Error) => {});\n\n      const { result } = renderHook(() => useAI({ onError }), { wrapper });\n\n      await waitFor(() => {\n        expect(result.current.connected).toBe(true);\n      });\n\n      await act(async () => {\n        const ws = MockWebSocket.getMostRecent();\n        ws?.simulateMessage({\n          type: 'error',\n          data: {\n            message: 'Server error occurred',\n          },\n        });\n      });\n\n      await waitFor(() => {\n        expect(onError).toHaveBeenCalled();\n        expect(onError.mock.calls[0][0].message).toBe('Server error occurred');\n        expect(result.current.error?.message).toBe('Server error occurred');\n      });\n    });\n\n    it('should set error state when generate() is called while disconnected', async () => {\n      const onError = mock((error: Error) => {});\n\n      const { result } = renderHook(() => useAI({ onError }), { wrapper });\n\n      // Don't wait for connection\n      await act(async () => {\n        // Force disconnect\n        const ws = MockWebSocket.getMostRecent();\n        if (ws) {\n          ws.readyState = WebSocket.CLOSED;\n        }\n      });\n\n      await act(async () => {\n        await result.current.generate('test prompt');\n      });\n\n      expect(result.current.error?.message).toBe('Not connected to server');\n      expect(onError).toHaveBeenCalled();\n    });\n\n    it('should handle WebSocket connection errors', async () => {\n      // This test verifies error handling