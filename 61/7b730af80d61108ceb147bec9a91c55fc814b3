        .toLowerCase()\n    84→          .replace(/_/g, '-'); // Convert underscores to hyphens\n    85→        workflows[workflowName] = process.env[key]!;\n    86→      }\n    87→    });\n    88→\n    89→    runners.set(\n    90→      'dify',\n    91→      new DifyWorkflowRunner({\n    92→        apiBaseUrl: difyUrl,\n    93→        workflows,\n    94→      })\n    95→    );\n    96→\n    97→    const workflowNames = Object.keys(workflows).join(', ');\n    98→    enabledRunners.push(\n    99→      `dify (${difyUrl}${workflowNames ? `, workflows: ${workflowNames}` : ''})`\n   100→    );\n   101→  }\n   102→\n   103→  if (logFormat === 'pretty' && enabledRunners.length > 0) {\n   104→    console.log(`✓ Enabled workflow runners: ${enabledRunners.join(', ')}`);\n   105→  } else if (enabledRunners.length > 0) {\n   106→    logger.info('Workflow runners configured', { enabledRunners });\n   107→  }\n   108→\n   109→  return runners;\n   110→}\n   111→\n   112→/**\n   113→ * Create MCP endpoint configurations from environment variables.\n   114→ * Returns an array of MCP endpoint configs.\n   115→ */\n   116→function createMcpEndpoints(): McpEndpointConfig[] {\n   117→  const endpoints: McpEndpointConfig[] = [];\n   118→\n   119→  // Collect all MCP_ENDPOINT_*_URL environment variables\n   120→  Object.keys(process.env).forEach((key) => {\n   121→    if (key.startsWith('MCP_ENDPOINT_') && key.endsWith('_URL')) {\n   122→      const url = process.env[key];\n   123→      if (!url) return;\n   124→\n   125→      // Extract the name (e.g., 'MYNAME' from 'MCP_ENDPOINT_MYNAME_URL')\n   126→      const name = key.slice(13, -4); // Remove 'MCP_ENDPOINT_' prefix and '_URL' suffix\n   127→\n   128→      // Look for corresponding namespace and timeout\n   129→      const namespaceKey = `MCP_ENDPOINT_${name}_NAMESPACE`;\n   130→      const timeoutKey = `MCP_ENDPOINT_${name}_TIMEOUT`;\n   131→\n   132→      const namespace = process.env[namespaceKey] || name.toLowerCase().replace(/_/