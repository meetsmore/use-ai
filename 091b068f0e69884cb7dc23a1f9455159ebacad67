          "text": "     1→import type { ToolDefinition, ToolRegistration, ServerMessage } from './types';\n     2→\n     3→export class UseAIClient {\n     4→  private ws: WebSocket | null = null;\n     5→  private messageHandlers: Map<string, (message: ServerMessage) => void> = new Map();\n     6→  private reconnectAttempts = 0;\n     7→  private maxReconnectAttempts = 5;\n     8→  private reconnectDelay = 1000;\n     9→\n    10→  constructor(private serverUrl: string) {}\n    11→\n    12→  connect(): Promise<void> {\n    13→    return new Promise((resolve, reject) => {\n    14→      try {\n    15→        this.ws = new WebSocket(this.serverUrl);\n    16→\n    17→        this.ws.onopen = () => {\n    18→          console.log('Connected to UseAI server');\n    19→          this.reconnectAttempts = 0;\n    20→          resolve();\n    21→        };\n    22→\n    23→        this.ws.onmessage = (event) => {\n    24→          try {\n    25→            const message: ServerMessage = JSON.parse(event.data);\n    26→            this.messageHandlers.forEach((handler) => handler(message));\n    27→          } catch (error) {\n    28→            console.error('Error parsing message:', error);\n    29→          }\n    30→        };\n    31→\n    32→        this.ws.onerror = (error) => {\n    33→          console.error('WebSocket error:', error);\n    34→          reject(error);\n    35→        };\n    36→\n    37→        this.ws.onclose = () => {\n    38→          console.log('Disconnected from UseAI server');\n    39→          this.attemptReconnect();\n    40→        };\n    41→      } catch (error) {\n    42→        reject(error);\n    43→      }\n    44→    });\n    45→  }\n    46→\n    47→  private attemptReconnect() {\n    48→    if (this.reconnectAttempts < this.maxReconnectAttempts) {\n    49→      this.reconnectAttempts++;\n    50→      console.log(`Attempting to reconnect (${this.reconnectAttempts}/${this.maxReconnectAttempts})...`);\n    51→\n    52→      setTimeout(() => {\n    53→        this.connect().catch((error) => {\n    54→          console.error('Reconnection failed:', error);\n    55→        });\n    56→      }, this.reconnectDelay * this.reconnectAttempts);\n    57→    }\n    58→  }\n    59→\n    60→  registerTools(tools: ToolDefinition[], context?: string) {\n    61→    const data: ToolRegistration = { tools };\n    62→    if (context) {\n    63→      data.context = context;\n    64→    }\n    65→    this.send({\n    66→      type: 'register_tools',\n    67→      data,\n    68→    });\n    69→  }\n    70→\n    71→  sendPrompt(prompt: string, conversationId?: string) {\n    72→    this.send({\n    73→      type: 'prompt',\n    74→      data: { prompt, conversationId },\n    75→    });\n    76→  }\n    77→\n    78→  sendToolResponse(toolCallId: string, result: unknown, context?: string) {\n    79→    const data: { toolCallId: string; result: unknown; context?: string } = { toolCallId, result };\n    80→    if (context) {\n    81→      data.context = context;\n    82→    }\n    83→    this.send({\n    84→      type: 'tool_response',\n    85→      data,\n    86→    });\n    87→  }\n    88→\n    89→  onMessage(id: string, handler: (message: ServerMessage) => void) {\n    90→    this.messageHandlers.set(id, handler);\n    91→    return () => {\n    92→      this.messageHandlers.delete(id);\n    93→    };\n    94→  }\n    95→\n    96→  private send(message: unknown) {\n    97→    if (this.ws && this.ws.readyState === WebSocket.OPEN) {\n    98→      this.ws.send(JSON.stringify(message));\n    99→    } else {\n   100→      console.error('WebSocket is not connected');\n   101→    }\n   102→  }\n   103→\n   104→  disconnect() {\n   105→    if (this.ws) {\n   106→      this.ws.close();\n   107→      this.ws = null;\n   108→    }\n   109→  }\n   110→\n   111→  isConnected(): boolean {\n   112→    return this.ws !== null && this.ws.readyState === WebSocket.OPEN;\n   113→  }\n   114→}\n   115→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n",
