   53→  const [connected, setConnected] = useState(false);\n    54→  const [isChatOpen, setIsChatOpen] = useState(false);\n    55→  const [messages, setMessages] = useState<Message[]>([]);\n    56→  const [loading, setLoading] = useState(false);\n    57→  const toolRegistryRef = useRef<Map<string, ToolsDefinition>>(new Map());\n    58→  const [toolRegistryVersion, setToolRegistryVersion] = useState(0);\n    59→  const promptsRef = useRef<Map<string, string>>(new Map());\n    60→  const renderWaitersRef = useRef<Map<string, () => Promise<void>>>(new Map());\n    61→  const toolOwnershipRef = useRef<Map<string, string>>(new Map());\n    62→\n    63→  const clientRef = useRef<UseAIClient | null>(null);\n    64→\n    65→  const registerTools = useCallback((\n    66→    id: string,\n    67→    tools: ToolsDefinition,\n    68→    waitForRender?: () => Promise<void>\n    69→  ) => {\n    70→    const existingTools = toolRegistryRef.current.get(id);\n    71→\n    72→    // Always update the ref to capture latest closures\n    73→    toolRegistryRef.current.set(id, tools);\n    74→\n    75→    // Only increment version if tool names changed (added/removed tools)\n    76→    if (existingTools) {\n    77→      const existingKeys = Object.keys(existingTools).sort().join(',');\n    78→      const newKeys = Object.keys(tools).sort().join(',');\n    79→      if (existingKeys !== newKeys) {\n    80→        setToolRegistryVersion(v => v + 1);\n    81→      }\n    82→    } else {\n    83→      // First registration\n    84→      setToolRegistryVersion(v => v + 1);\n    85→    }\n    86→\n    87→    Object.keys(tools).forEach(toolName => {\n    88→      toolOwnershipRef.current.set(toolName, id);\n    89→    });\n    90→\n    91→    if (waitForRender) {\n    92→      renderWaitersRef.current.set(id, waitForRender);\n    93→    }\n    94→  }, []);\n    95→\n    96→  const updatePrompt = useCallback((id: string, prompt?: string) => {\n    97→    if (prompt) {\n    98→      promptsRef.current.set(id, prompt);\n    99→    } else {\n   100→      promptsRef.current.delete(id);\n   101→    }\n   102→  }, []);\n   103→\n   104→  const unregisterTools = useCallback((id: string) => {\n   105→    const tools = toolRegistryRef.current.get(id);\n   106→    if (tools) {\n   107→      Object.keys(tools).forEach(toolName => {\n   108→        toolOwnershipRef.current.delete(toolName);\n   109→      });\n   110→    }\n   111→\n   112→    toolRegistryRef.current.delete(id);\n   113→    setToolRegistryVersion(v => v + 1);\n   114→    promptsRef.current.delete(id);\n   115→    renderWaitersRef.current.delete(id);\n   116→  }, []);\n   117→\n   118→  const aggregatedTools = React.useMemo(() => {\n   119→    const tools: ToolsDefinition = {};\n   120→    toolRegistryRef.current.forEach((toolSet) => {\n   121→      Object.assign(tools, toolSet);\n   122→    });\n   123→    return tools;\n   124→  }, [toolRegistryVersion]);\n   125→\n   126→  const hasTools = toolRegistryRef.current.size > 0;\n   127→  const aggregatedToolsRef = useRef(aggregatedTools);\n   128→  aggregatedToolsRef.current = aggregatedTools;\n   129→\n   130→  useEffect(() => {\n   131→    const client = new UseAIClient(serverUrl);\n   132→\n   133→    client.connect()\n   134→      .then(() => {\n   135→        setConnected(true);\n   136→      })\n   137→      .catch((err) => {\n   138→        console.error('Failed to connect client:', err);\n   139→        setConnected(false);\n   140→      });\n   141→\n   142→    const unsubscribe = client.onMessage('globalChat', async (message: ServerMessage) => {\n   143→      if (message.type === 'tool_call') {\n   144→        const toolCall = message as ToolCallMessage;\n   145→        const { toolCallId, name, input } = toolCall.data;\n   146→\n   147→        try {\n   148→          const ownerId = toolOwnershipRef.current.get(name);\n   149→          console.log(`[useAI] Tool \"${name}\" owned by component:`, ownerId);\n   150→\n   151→          let renderPromise: Promise<void> | undefined;\n   152→          if (ownerId) {\n   153→            const waitForRender = renderWaitersRef.current.get(ownerId);\n   154→            if (waitForRender) {\n   155→              console.log(`[useAI] Setting up render listener for ${ownerId}...`);\n   156→              renderPromise = waitForRender();\n   157→            }\n   158→          }\n   159→\n   160→          console.log('[useAI] Executing tool...');\n   161→          const result = await executeDefinedTool(aggregatedToolsRef.current, name, input);\n   162→\n   163→          if (renderPromise) {\n   164→            console.log('[useAI] Tool executed, waiting for render...');\n   165→            await renderPromise;\n   166→            console.log('[useAI] Render complete');\n   167→          } else {\n   168→            console.log('[useAI] No render to wait for');\n   169→          }\n   170→\n   171→          let updatedPrompt: string | undefined;\n   172→          if (ownerId) {\n   173→            updatedPrompt = promptsRef.current.get(ownerId);\n   174→            if (updatedPrompt) {\n   175→              console.log(`[useAI] Updated prompt from ${ownerId}:`, updatedPrompt.substring(0, 100));\n   176→            }\n   177→          }\n   178→\n   179→          client.sendToolResponse(toolCallId, result, updatedPrompt);\n   180→        } catch (err) {\n   181→          console.error('Tool execution error:', err);\n   182→          client.sendToolResponse(toolCallId, {\n   183→            error: err instanceof Error ? err.message : 'Unknown error',\n   184→          });\n   185→        }\n   186→      } else if (message.type === 'response') {\n   187→        const responseMsg = message as ResponseMessage;\n   188→        setMessages((prev) => [\n   189→          ...prev,\n   190→          {\n   191→            id: responseMsg.data.conversationId,\n   192→            role: 'assistant',\n   193→            content: responseMsg.data.content,\n   194→            timestamp: new Date(),\n   195→          },\n   196→        ]);\n   197→        setLoading(false);\n   198→      }\n   199→    });\n   200→\n   201→    clientRef.current = client;\n   202→\n   203→    return () => {\n   204→      unsubscribe();\n   205→      client.disconnect();\n   206→      setConnected(false);\n   207→    };\n   208→  }, [serverUrl]);\n   209→\n   210→  const lastRegisteredToolsRef = useRef<string>('');\n   211→\n   212→  useEffect(() => {\n   213→    const client = clientRef.current;\n   214→    if (!client || !client.isConnected() || !hasTools) return;\n   215→\n   216→    const toolKeys = Object.keys(aggregatedTools).sort().join(',');\n   217→    if (toolKeys === lastRegisteredToolsRef.current) {\n   218→      console.log('[Provider] Skipping re-registration, tools unchanged');\n   219→      return;\n   220→    }\n   221→\n   222→    lastRegisteredToolsRef.current = toolKeys;\n   223→    console.log('[Provider] Registering tools:', toolKeys);\n   224→\n   225→    (async () => {\n   226→      try {\n   227→        const toolDefinitions = convertToolsToDefinitions(aggregatedTools);\n   228→\n   229→        const contextParts: string[] = [];\n   230→\n   231→        if (systemPrompt) {\n   232→          contextParts.push(systemPrompt);\n   233→        }\n   234→\n   235→        for (const [id, prompt] of promptsRef.current.entries()) {\n   236→          if (prompt) {\n   237→            contextParts.push(prompt);\n   238→          }\n   239→        }\n   240→\n   241→        const aggregatedContext = contextParts.length > 0 ? contextParts.join('\\n\\n---\\n\\n') : undefined;\n   242→        client.registerTools(toolDefinitions, aggregatedContext);\n   243→      } catch (err) {\n   244→        console.error('Failed to register tools:', err);\n   245→      }\n   246→    })();\n   247→  }, [hasTools, aggregatedTools, systemPrompt]);\n   248→\n   249→  const handleSendMessage = useCallback((message: string) => {\n   250→    if (!clientRef.current) return;\n   251→\n   252→    setMessages((prev) => [\n   253→      ...prev,\n   254→      {\n   255→        id: Date.now().toString(),\n   256→        role: 'user',\n   257→        content: message,\n   258→        timestamp: new Date(),\n   259→      },\n   260→    ]);\n   261→\n   262→    setLoading(true);\n   263→    clientRef.current.sendPrompt(message);\n   264→  }, []);\n   265→\n   266→  const value: UseAIContextValue = {\n   267→    serverUrl,\n   268→    connected,\n   269→    registerTools,\n   270→    unregisterTools,\n   271→    updatePrompt,\n   272→    client: clientRef.current,\n   273→  };\n   274→\n   275→  const ButtonComponent = CustomButton || UseAIFloatingButton;\n   276→  const ChatComponent = CustomChat || UseAIChatPanel;\n   277→\n   278→  return (\n   279→    <UseAIContext.Provider value={value}>\n   280→      {children}\n   281→      {hasTools && (\n   282→        <>\n   283→          <ButtonComponent\n   284→            onClick={() => setIsChatOpen(true)}\n   285→            connected={connected}\n   286→          />\n   287→          <ChatComponent\n   288→            isOpen={isChatOpen}\n   289→            onClose={() => setIsChatOpen(false)}\n   290→            onSendMessage={handleSendMessage}\n   291→            messages={messages}\n   292→            loading={loading}\n   293→            connected={connected}\n   294→          />\n   295→        </>\n   296→      )}\n   297→    </UseAIContext.Provider>\n   298→  );\n   299→}\n   300→\n   301→export function useAIContext(): UseAIContextValue {\n   302→  const context = useContext(UseAIContext);\n   303→  if (!context) {\n   304→    throw new Error('useAIContext must be used within a UseAIProvider');\n   305→  }\n   306→  return context;\n   307→}\n   308→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze 