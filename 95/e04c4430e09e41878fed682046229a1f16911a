nt = useCallback(async (event: AGUIEvent) => {\n   201→    switch (event.type) {\n   202→      case EventType.TEXT_MESSAGE_END: {\n   203→        const content = client?.currentMessageContent;\n   204→        if (content) {\n   205→          setResponse(content);\n   206→          setLoading(false);\n   207→        }\n   208→        break;\n   209→      }\n   210→\n   211→      case EventType.RUN_ERROR: {\n   212→        const errorEvent = event as RunErrorEvent;\n   213→        const error = new Error(errorEvent.message);\n   214→        setError(error);\n   215→        setLoading(false);\n   216→        options.onError?.(error);\n   217→        break;\n   218→      }\n   219→    }\n   220→  }, [client, options.onError]);\n   221→\n   222→  const generate = useCallback(async (prompt: string) => {\n   223→    if (!enabled) {\n   224→      const error = new Error('AI features are disabled');\n   225→      setError(error);\n   226→      options.onError?.(error);\n   227→      return;\n   228→    }\n   229→\n   230→    if (!client?.isConnected()) {\n   231→      const error = new Error('Not connected to server');\n   232→      setError(error);\n   233→      options.onError?.(error);\n   234→      return;\n   235→    }\n   236→\n   237→    setLoading(true);\n   238→    setError(null);\n   239→    setResponse(null);\n   240→\n   241→    try {\n   242→      client.sendPrompt(prompt);\n   243→    } catch (err) {\n   244→      const error = err instanceof Error ? err : new Error('Unknown error');\n   245→      setError(error);\n   246→      setLoading(false);\n   247→      options.onError?.(error);\n   248→    }\n   249→  }, [enabled, client, options.onError]);\n   250→\n   251→  return {\n   252→    response,\n   253→    loading,\n   254→    error,\n   255→    generate,\n   256→    connected: enabled && connected,\n   257→    ref: componentRef,\n   258→  };\n   259→}\n   260→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered