f={ref}>\n    99→ *       <button onClick={() => generate('Add a todo for groceries')}>\n   100→ *         Ask AI\n   101→ *       </button>\n   102→ *       {loading && <p>Loading...</p>}\n   103→ *       {response && <p>{response}</p>}\n   104→ *     </div>\n   105→ *   );\n   106→ * }\n   107→ *\n   108→ * // Example 2: Invisible provider component (no UI state)\n   109→ * function AIToolsProvider({ children }) {\n   110→ *   useAI({\n   111→ *     tools: {\n   112→ *       sendEmail: defineTool(\n   113→ *         'Send an email',\n   114→ *         z.object({ to: z.string(), subject: z.string() }),\n   115→ *         async (input) => {\n   116→ *           await sendEmail(input);\n   117→ *           return { success: true };\n   118→ *         }\n   119→ *       )\n   120→ *     },\n   121→ *     invisible: true  // Skip render wait since this has no visual state\n   122→ *   });\n   123→ *\n   124→ *   return <>{children}</>;\n   125→ * }\n   126→ * ```\n   127→ */\n   128→export function useAI(options: UseAIOptions = {}): UseAIResult {\n   129→  const { enabled = true } = options;\n   130→  const { connected, registerTools, unregisterTools, updatePrompt, client } = useAIContext();\n   131→  const [response, setResponse] = useState<string | null>(null);\n   132→  const [loading, setLoading] = useState(false);\n   133→  const [error, setError] = useState<Error | null>(null);\n   134→\n   135→  const hookId = useRef(`useAI-${Math.random().toString(36).substr(2, 9)}`);\n   136→  const toolsRef = useRef<ToolsDefinition>({});\n   137→  const componentRef = useRef<HTMLDivElement>(null);\n   138→  const renderResolvers = useRef<Array<() => void>>([]);\n   139→\n   140→  useEffect(() => {\n   141→    if (componentRef.current) {\n   142→      componentRef.current.setAttribute('data-useai-context', 'true');\n   143→    }\n   144→  }, []);\n   145→\n   146→  useEffect(() => {\n   147→    const count = renderResolvers.current.length;\n   148→    if (count > 0) {\n   149→