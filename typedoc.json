{
  "entryPoints": [
    "packages/core",
    "packages/client",
    "packages/server",
    "packages/plugin-workflows"
  ],
  "entryPointStrategy": "packages",
  "out": "docs/api",
  "name": "use-ai",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "exclude": ["**/node_modules/zod/**"],
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "hideGenerator": true
}
